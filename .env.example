# Database
DATABASE_URL="postgres://tovitu:tovitu_dev@localhost:5432/tovitu_development"
POSTGRES_USER="tovitu"
POSTGRES_PASSWORD="tovitu_dev"
POSTGRES_DB="tovitu_development"
POSTGRES_PORT="5432"

# LocalStack (emulates S3, SQS, SES, Cognito, Secrets Manager, Scheduler, ...)
LOCALSTACK_PORT="4566"
LOCALSTACK_ACCESS_KEY="test"
LOCALSTACK_SECRET_KEY="test"
# Optional LocalStack student/Pro footprint (enables cognito-idp, sesv2, and
# state persistence). Requires BOTH the Pro image and a license token:
#   LOCALSTACK_IMAGE="localstack/localstack-pro:4"
#   LOCALSTACK_AUTH_TOKEN="ls-..."
# Leave LOCALSTACK_IMAGE at the community default and LOCALSTACK_AUTH_TOKEN
# blank to run the free image (Pro-only services are skipped gracefully).
LOCALSTACK_IMAGE="localstack/localstack:4"
LOCALSTACK_AUTH_TOKEN=""
AWS_REGION="us-east-1"

# AWS emulation layer (LocalStack). Same code runs against real AWS in prod —
# just drop AWS_ENDPOINT_URL and use IAM role credentials there.
AWS_ENDPOINT_URL="http://localhost:4566"
AWS_ACCESS_KEY_ID="test"
AWS_SECRET_ACCESS_KEY="test"
S3_BUCKET="tovitu-development"
SQS_QUEUE_PREFIX="tovitu"
# Which SQS queues the worker polls. Blank = all queues in one process
# (default, mailers, variants). To run a dedicated worker for image variant
# generation, use `SQS_QUEUES=variants bin/rails queuing:work` — see
# lib/queuing/queue_registry.rb.
SQS_QUEUES=""
AWS_LOG_LEVEL="info"

# OpenAI
OPENAI_API_KEY=""

# WhatsApp Business API
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""

# Rails
RAILS_ENV="development"
