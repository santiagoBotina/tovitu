# Database
DATABASE_URL="postgres://tovitu:tovitu_dev@localhost:5432/tovitu_development"
POSTGRES_USER="tovitu"
POSTGRES_PASSWORD="tovitu_dev"
POSTGRES_DB="tovitu_development"
POSTGRES_PORT="5432"

# Redis
REDIS_URL="redis://localhost:6379/0"
REDIS_PORT="6379"

# MinIO (S3-compatible local storage for Active Storage dev)
# MinIO container is started automatically by `make docker-up`.
MINIO_ENABLED="true"
MINIO_PORT="9000"
MINIO_CONSOLE_PORT="9001"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET="tovitu-development"

# LocalStack (S3-compatible local storage for Active Storage dev)
LOCALSTACK_PORT="4566"
LOCALSTACK_ACCESS_KEY="test"
LOCALSTACK_SECRET_KEY="test"
AWS_REGION="us-east-1"

# Cloudflare R2 (Active Storage)
R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="tovitu"

# OpenAI
OPENAI_API_KEY=""

# WhatsApp Business API
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""

# Rails
RAILS_ENV="development"
