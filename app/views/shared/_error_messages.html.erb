<% if resource&.errors&.any? %>
  <div class="bg-danger/5 border border-danger/20 rounded-xl p-4" role="alert">
    <h3 class="text-danger font-semibold text-sm mb-2">
      <%= pluralize(resource.errors.count, "error") %> prohibited this from being saved:
    </h3>
    <ul class="list-disc list-inside text-danger text-sm space-y-1">
      <% resource.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
  </div>
<% end %>
