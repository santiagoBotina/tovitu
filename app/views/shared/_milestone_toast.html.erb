<%# A single success toast, used for milestone-unlocked feedback. Mirrors the
    positioning and styling of shared/_flash so the celebration looks consistent
    with the rest of the app. Appended inline via turbo_stream for AJAX actions
    (save pet); redirect-based actions surface the same message through the
    regular shared/_flash path instead. %>
<div class="fixed top-16 right-4 z-40 max-w-sm">
  <div class="bg-success flex items-start gap-3 p-4 rounded-xl shadow-lg" role="alert" data-controller="dismiss">
    <div class="flex-shrink-0 mt-0.5">
      <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
      </svg>
    </div>
    <p class="text-sm font-medium text-white flex-1"><%= message %></p>
    <button type="button" data-action="click->dismiss#hide" class="flex-shrink-0 text-white/70 hover:text-white transition" aria-label="<%= t("shared.toast.dismiss") %>">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>
  </div>
</div>
