<header class="sticky top-0 z-20 bg-white/80 backdrop-blur-md border-b border-neutral-200/60">
  <div class="flex items-center justify-between h-16 px-4 md:px-6">

    <%# ─── Left: Hamburger + Logo ─── %>
    <div class="flex items-center gap-3">
      <% if signed_in? %>
        <button data-action="click->sidebar#toggle"
                class="flex items-center justify-center w-10 h-10 rounded-xl text-neutral-500 hover:text-primary-600 hover:bg-primary-50 transition-colors duration-150 focus:outline-none focus:ring-2 focus:ring-primary-300"
                aria-label="Toggle sidebar">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 12h18"/><path d="M3 6h18"/><path d="M3 18h18"/>
          </svg>
        </button>
      <% end %>

      <%= link_to root_path, class: "flex items-center gap-2 group md:hidden" do %>
        <%= render "shared/logo", class_name: "w-7 h-7" %>
        <span class="font-display text-xl font-extrabold tracking-tight text-primary-600">Tovitu</span>
      <% end %>
    </div>

    <%# ─── Center: Search (desktop) ─── %>
    <div class="hidden md:flex flex-1 max-w-md mx-6">
      <div class="relative w-full">
        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none">
          <svg class="w-4 h-4 text-neutral-400" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
          </svg>
        </div>
        <input type="search"
               placeholder="Search pets, shelters..."
               class="w-full h-10 pl-10 pr-4 text-sm bg-neutral-100 border-0 rounded-xl text-neutral-700 placeholder-neutral-400 focus:outline-none focus:ring-2 focus:ring-primary-300 focus:bg-white transition-all duration-200"
               aria-label="Search pets and shelters">
      </div>
    </div>

    <%# ─── Right: Actions ─── %>
    <div class="flex items-center gap-2.5">
      <% if signed_in? %>
        <%# Notification Bell %>
        <div data-controller="notification-bell" class="relative">
          <button data-action="click->notification-bell#toggle"
                  data-notification-bell-target="button"
                  class="relative flex items-center justify-center w-10 h-10 rounded-xl text-neutral-500 hover:text-primary-600 hover:bg-primary-50 transition-colors duration-150"
                  aria-label="Notifications"
                  aria-expanded="false"
                  aria-haspopup="true">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
              <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
            </svg>
            <%= render "notifications/badge", count: Notifications::GetUnreadCount.call(recipient: current_user)&.data || 0 %>
          </button>

          <%= render "notifications/dropdown", notifications: current_user.notifications.unread.recent.limit(5) %>
        </div>

        <%# Saved Pets Heart %>
        <%= link_to saved_pets_path, class: "relative flex items-center justify-center w-10 h-10 rounded-xl text-neutral-500 hover:text-accent-pink hover:bg-accent-pink/5 transition-colors duration-150", aria: { label: t("shared.navbar.saved_pets") } do %>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
          </svg>
          <% if saved_pets_count > 0 %>
            <span class="absolute -top-0.5 -right-0.5 w-4.5 h-4.5 rounded-full bg-accent-pink text-white text-[10px] font-bold flex items-center justify-center shadow-sm transition-transform duration-200 hover:scale-110"><%= saved_pets_count %></span>
          <% end %>
        <% end %>

        <%# User Avatar + Dropdown Menu %>
        <div data-controller="profile-dropdown" class="relative">
          <button data-action="click->profile-dropdown#toggle"
                  class="group flex items-center gap-2.5 pl-2.5 border-l border-neutral-200 cursor-pointer"
                  aria-expanded="false"
                  aria-haspopup="true"
                  aria-label="<%= t('shared.navbar.user_menu') %>">
            <span class="hidden sm:inline text-sm font-medium text-neutral-700 group-hover:text-primary-600 transition-colors duration-150"><%= current_user.name %></span>
            <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-primary-500 to-primary-600 flex items-center justify-center text-white text-sm font-bold shadow-sm shrink-0 transition-transform duration-200 group-hover:scale-105 group-hover:shadow-md">
              <%= current_user.name.first.upcase %>
            </div>
          </button>

          <%# ─── Dropdown Menu ─── %>
          <div data-profile-dropdown-target="menu"
               class="hidden absolute right-0 top-full mt-2 w-56 rounded-xl bg-white shadow-lg border border-neutral-200/80 py-1.5 opacity-0 scale-95 transition-all duration-150 origin-top-right z-dropdown"
               role="menu"
               aria-label="<%= t('shared.navbar.user_options') %>">
            <%# User Info Header %>
            <div class="px-4 py-3 border-b border-neutral-100">
              <p class="text-sm font-semibold text-neutral-800 truncate"><%= current_user.name %></p>
              <p class="text-xs text-neutral-500 truncate"><%= current_user.email %></p>
            </div>

            <%# Settings %>
            <%= link_to edit_profile_path,
                data: { action: "click->profile-dropdown#hide" },
                class: "flex items-center gap-3 px-4 py-2.5 text-sm text-neutral-700 hover:bg-primary-50 hover:text-primary-700 transition-colors duration-150 first-of-type:mt-1.5",
                role: "menuitem" do %>
              <svg class="w-4 h-4 text-neutral-400 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="3"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/>
              </svg>
              <span><%= t("shared.sidebar.settings") %></span>
            <% end %>

            <%# Sign Out %>
            <%= link_to session_path,
                data: { turbo_method: :delete, turbo_confirm: t("shared.sidebar.sign_out_confirm"), action: "click->profile-dropdown#hide" },
                class: "group flex items-center gap-3 px-4 py-2.5 text-sm text-neutral-700 hover:bg-danger/5 hover:text-danger transition-colors duration-150",
                role: "menuitem" do %>
              <svg class="w-4 h-4 text-neutral-400 shrink-0 group-hover:text-danger transition-colors duration-200" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/>
              </svg>
              <span><%= t("shared.sidebar.sign_out") %></span>
            <% end %>
          </div>
        </div>
      <% else %>
        <%= link_to saved_pets_path, class: "relative flex items-center justify-center w-10 h-10 rounded-xl text-neutral-500 hover:text-accent-pink hover:bg-accent-pink/5 transition-colors duration-150", aria: { label: t("shared.navbar.saved_pets") } do %>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
          </svg>
          <% if saved_pets_count > 0 %>
            <span class="absolute -top-0.5 -right-0.5 w-4.5 h-4.5 rounded-full bg-accent-pink text-white text-[10px] font-bold flex items-center justify-center shadow-sm"><%= saved_pets_count %></span>
          <% end %>
        <% end %>
        <%= link_to t("shared.navbar.sign_in"), new_session_path,
            class: "inline-flex items-center px-4 py-2 text-sm font-medium text-primary-600 hover:text-primary-700 hover:bg-primary-50 rounded-xl transition-colors duration-150" %>
        <%= link_to t("shared.navbar.create_account"), new_registration_path(role: "individual"),
            class: "inline-flex items-center px-4 py-2 text-sm font-semibold text-white bg-primary-500 hover:bg-primary-600 active:bg-primary-700 active:scale-[0.97] rounded-xl transition-all duration-150 shadow-sm" %>
      <% end %>
    </div>

  </div>
</header>
