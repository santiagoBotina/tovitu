<header class="sticky top-0 z-20 bg-white/80 backdrop-blur-md border-b border-neutral-200/60">
  <div class="flex items-center justify-between h-16 px-4 md:px-6">

    <div class="flex items-center gap-3">
      <% if signed_in? %>
        <button data-action="click->sidebar#toggle"
                class="flex items-center justify-center w-10 h-10 rounded-xl text-neutral-500 hover:text-primary-600 hover:bg-primary-50 transition-colors duration-150 focus:outline-none focus:ring-2 focus:ring-primary-300"
                aria-label="Toggle sidebar">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 12h18"/><path d="M3 6h18"/><path d="M3 18h18"/>
          </svg>
        </button>
      <% end %>

      <%= link_to root_path, class: "flex items-center gap-1.5 group" do %>
        <span class="font-display text-2xl font-extrabold tracking-wide leading-none">
          <span class="text-primary-500">t</span>
          <span class="text-secondary-500">o</span>
          <span class="text-accent-pink">v</span>
          <span class="text-accent-yellow">i</span>
          <span class="text-accent-orange">t</span>
          <span class="text-primary-500">u</span>
        </span>

        <svg class="w-5 h-5 text-primary-400 -mt-1 group-hover:scale-110 transition-transform duration-200" fill="currentColor" viewBox="0 0 24 24">
          <path d="M5.5 10.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Zm13 0a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5ZM12 20a4.5 4.5 0 0 0 4.5-4.5c0-1.6-1.2-3.8-2.7-5.2a2.5 2.5 0 0 0-3.6 0C8.7 11.7 7.5 13.9 7.5 15.5A4.5 4.5 0 0 0 12 20Zm-5.5-6.5a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm11 0a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z"/>
        </svg>
      <% end %>
    </div>

    <div class="flex items-center gap-3">
      <% if signed_in? %>
        <div class="flex items-center gap-2.5">
          <span class="hidden sm:inline text-sm font-medium text-neutral-700"><%= current_user.name %></span>
          <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-primary-400 to-primary-600 flex items-center justify-center text-white text-sm font-semibold shadow-sm shrink-0">
            <%= current_user.name.first.upcase %>
          </div>
        </div>
      <% else %>
        <%= link_to t("shared.navbar.sign_in"), new_session_path,
            class: "inline-flex items-center px-4 py-2 text-sm font-medium text-primary-600 hover:text-primary-700 hover:bg-primary-50 rounded-xl transition-colors duration-150" %>
        <%= link_to t("shared.navbar.create_account"), new_registration_path,
            class: "inline-flex items-center px-4 py-2 text-sm font-semibold text-white bg-primary-500 hover:bg-primary-600 rounded-xl transition-colors duration-150 shadow-sm" %>
      <% end %>
    </div>

  </div>
</header>
