<% if flash.any? %>
  <div class="fixed top-16 right-4 z-40 flex flex-col gap-3 max-w-sm">
    <% flash.each do |type, message| %>
      <% next if message.blank? || type == "timedout" %>

      <%
        bg_class = case type.to_sym
          when :notice, :success then "bg-success"
          when :alert, :error, :danger then "bg-danger"
          when :warning then "bg-warning"
          else "bg-primary-500"
        end
      %>

      <div class="<%= bg_class %> flex items-start gap-3 p-4 rounded-xl shadow-lg" role="alert" data-controller="dismiss">
        <div class="flex-shrink-0 mt-0.5">
          <% case type.to_sym %>
          <% when :notice, :success %>
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          <% when :alert, :error, :danger %>
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          <% when :warning %>
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z"/>
            </svg>
          <% else %>
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          <% end %>
        </div>
        <p class="text-sm font-medium text-white flex-1"><%= message %></p>
        <button type="button" data-action="click->dismiss#hide" class="flex-shrink-0 text-white/70 hover:text-white transition">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>
    <% end %>
  </div>
<% end %>
