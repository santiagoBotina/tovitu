<%# ─── Shared Section Header ─── %>
<%# Renders a page title, an optional one-sentence explanation, an optional
    back link, and an optional CTA slot. %>
<%# Usage: render "shared/section_header", title: ..., subtitle: ..., back_link_path: ... do ... end %>
<%# The block (if given) is rendered to the right of the title as the CTA slot. %>
<%# Locals: %>
<%#   - title          (required) h1 text %>
<%#   - subtitle       (optional) one-sentence explanation of the section %>
<%#   - back_link_path (optional) when present, renders shared/back_link above
                        the title row. Resolve it with safe_back_path(fallback)
                        in the CALLER — this partial stays dumb. %>
<%#   - back_label     (optional) back link label (default: t("shared.back")) %>
<%#   - centered       (optional) true centers the header block (Explorer hero) %>
<%#   - header_class   (optional) header element classes. A top margin is always
                        prepended so the section explanation clears the navbar
                        (default: "mb-6", centered: "text-center mb-8") %>
<%#   - title_class    (optional) h1 classes (default: "font-display text-2xl md:text-3xl font-bold text-neutral-900") %>
<%#   - subtitle_class (optional) p classes (default: "text-neutral-500 text-sm md:text-base mt-1 max-w-2xl") %>
<%#   - content_class  (optional) wrapper div classes (default: "min-w-0") %>
<%#   - cta_class      (optional) CTA container classes (default: "flex items-center gap-3 shrink-0") %>
<%# ⚠️ Translation scope footgun: this partial captures its block with
    `capture { yield }`, which runs with @virtual_path = "shared/section_header".
    Any LAZY key (t(".…")) inside a caller's block therefore resolves against
    shared.section_header.* and shows "translation missing".
    Callers that pass a block MUST precompute their translations as local
    variables BEFORE the render call (locals are captured by the block). %>
<%
  centered = local_assigns[:centered]
  # Always add top margin so the title + explanation clears the sticky navbar
  # (main-content carries no top padding so page heroes can sit flush).
  top_margin = centered ? "mt-8" : "mt-6"
  header_class = "#{top_margin} #{local_assigns[:header_class] || (centered ? "text-center mb-8" : "mb-6")}"
  title_class = local_assigns[:title_class] || (centered ? "font-display text-3xl md:text-4xl font-bold text-neutral-900 mb-3 text-balance" : "font-display text-2xl md:text-3xl font-bold text-neutral-900")
  subtitle_class = local_assigns[:subtitle_class] || (centered ? "text-neutral-600 text-lg max-w-2xl mx-auto" : "text-neutral-500 text-sm md:text-base mt-1 max-w-2xl")
  content_class = local_assigns[:content_class] || "min-w-0"
  cta_class = local_assigns[:cta_class] || "flex items-center gap-3 shrink-0"
  cta_content = capture { yield }
  has_cta = cta_content.present?
  has_back_link = local_assigns[:back_link_path].present?
%>

<header class="<%= header_class %>">
  <% if has_back_link %>
    <div class="mb-3">
      <%= render "shared/back_link", path: back_link_path, label: local_assigns[:back_label] %>
    </div>
    <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4">
      <div class="<%= content_class %>">
        <h1 class="<%= title_class %>"><%= title %></h1>
        <% if local_assigns[:subtitle].present? %>
          <p class="<%= subtitle_class %>"><%= subtitle %></p>
        <% end %>
      </div>
      <% if has_cta %>
        <div class="<%= cta_class %>">
          <%= cta_content %>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="<%= content_class %>">
      <h1 class="<%= title_class %>"><%= title %></h1>
      <% if local_assigns[:subtitle].present? %>
        <p class="<%= subtitle_class %>"><%= subtitle %></p>
      <% end %>
    </div>
    <% if has_cta %>
      <div class="<%= cta_class %>">
        <%= cta_content %>
      </div>
    <% end %>
  <% end %>
</header>
