<%# Tovitu Logo Mark - references the official branded vector asset at
    app/assets/images/tovitu.svg (instead of inlining it) so the mark can be
    updated in one place. Sized via the class_name local. Decorative: empty
    alt + aria-hidden, because adjacent text always supplies the label. %>
<%= image_tag "tovitu.svg",
    class: local_assigns[:class_name] || "w-8 h-8",
    alt: "",
    aria: { hidden: true } %>
