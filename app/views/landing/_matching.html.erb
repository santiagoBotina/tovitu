<%# ── How Matching Works ── %>
<%# Asymmetric trio: the AI "weigh the fit" moment is the saturated hero card
    (primary-500, hard offset shadow, raised above its neighbors), flanked by
    two quiet white cards. No identical grid, no hero-metric numbers — the
    drama is color, scale, and one deliberate accent per card. %>
<section id="matching" class="bg-primary-50 px-4 sm:px-6 lg:px-8 py-20 sm:py-24">
  <div class="max-w-7xl mx-auto">
    <div class="text-center max-w-2xl mx-auto mb-14">
      <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold text-neutral-900 mb-4 text-balance">
        <%= t("landing.index.matching.title") %>
      </h2>
      <p class="text-lg text-neutral-700 leading-relaxed text-pretty">
        <%= t("landing.index.matching.subtitle") %>
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-6 lg:gap-8 items-stretch">
      <div class="bg-white rounded-xl border-2 border-neutral-200 shadow-sm p-8">
        <div class="w-14 h-14 rounded-2xl bg-primary-100 flex items-center justify-center mb-6">
          <svg class="w-7 h-7 text-primary-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
          </svg>
        </div>
        <h3 class="font-display text-xl font-bold text-neutral-900 mb-2 text-balance">
          <%= t("landing.index.matching.step1_title") %>
        </h3>
        <p class="text-neutral-700 leading-relaxed text-pretty">
          <%= t("landing.index.matching.step1_desc") %>
        </p>
      </div>

      <div class="bg-primary-500 rounded-xl border-2 border-primary-700 shadow-button-primary p-8 md:-translate-y-6">
        <span class="inline-flex items-center px-3 py-1 rounded-full bg-white/15 text-white text-xs font-bold mb-5"><%= t("landing.index.matching.ai_badge") %></span>
        <div class="w-14 h-14 rounded-2xl bg-white flex items-center justify-center mb-6">
          <svg class="w-7 h-7 text-primary-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.455 2.456L21.75 6l-1.036.259a3.375 3.375 0 00-2.455 2.456z"/>
          </svg>
        </div>
        <h3 class="font-display text-xl font-bold text-white mb-2 text-balance">
          <%= t("landing.index.matching.step2_title") %>
        </h3>
        <p class="text-primary-50 leading-relaxed text-pretty">
          <%= t("landing.index.matching.step2_desc") %>
        </p>
      </div>

      <div class="bg-white rounded-xl border-2 border-neutral-200 shadow-sm p-8">
        <div class="w-14 h-14 rounded-2xl bg-accent-pink/10 flex items-center justify-center mb-6">
          <svg class="w-7 h-7 text-accent-pink" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4.318 6.318a4.5 4.5 0 0 0 0 6.364L12 20.364l7.682-7.682a4.5 4.5 0 0 0-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 0 0-6.364 0Z"/>
          </svg>
        </div>
        <h3 class="font-display text-xl font-bold text-neutral-900 mb-2 text-balance">
          <%= t("landing.index.matching.step3_title") %>
        </h3>
        <p class="text-neutral-700 leading-relaxed text-pretty">
          <%= t("landing.index.matching.step3_desc") %>
        </p>
      </div>
    </div>
  </div>
</section>