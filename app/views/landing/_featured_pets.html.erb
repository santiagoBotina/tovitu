<%# ── Featured Pets ── %>
<%# Real adoptable pets pulled from the public pets query. Never fake data,
    never fabricated match scores — only status chips from the real record. %>
<section class="bg-secondary-50 px-4 sm:px-6 lg:px-8 py-20 sm:py-24">
  <div class="max-w-7xl mx-auto">
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-10">
      <div class="max-w-2xl">
        <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold text-neutral-900 mb-3 text-balance">
          <%= t("landing.index.featured.title") %>
        </h2>
        <p class="text-lg text-neutral-600 leading-relaxed">
          <%= t("landing.index.featured.subtitle") %>
        </p>
      </div>
      <%= link_to pets_path, class: "inline-flex items-center gap-2 shrink-0 px-6 py-3 bg-white text-primary-600 font-semibold text-base rounded-xl border-2 border-primary-200 hover:border-primary-300 hover:bg-primary-50 active:scale-[0.97] transition-all duration-200 shadow-sm" do %>
        <%= t("landing.index.featured.view_all") %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/>
        </svg>
      <% end %>
    </div>

    <% if @presented_featured_pets.any? %>
      <div class="flex gap-5 overflow-x-auto snap-x snap-mandatory pb-4 -mx-4 px-4 scrollbar-none" role="list" aria-label="<%= t("landing.index.featured.title") %>">
        <% @presented_featured_pets.each_with_index do |pet, idx| %>
          <% delay = ((idx % 6) + 1).clamp(1, 8) %>
          <div role="listitem" class="w-72 sm:w-80 shrink-0 snap-start">
            <div class="relative bg-white rounded-xl border border-neutral-200 shadow-sm hover:shadow-md hover:border-secondary-200 transition-all duration-200 overflow-hidden group card-lift bento-enter bento-enter-d#{delay}">
              <%= link_to pet_path(pet, back_to: root_path), class: "block focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-inset" do %>
                <div class="aspect-[4/3] bg-neutral-100 overflow-hidden relative">
                  <% if pet.primary_photo.present? %>
                    <%= image_tag pet.primary_photo_url(variant: :medium),
                        alt: t("landing.index.featured.pet_photo", name: pet.name),
                        class: "w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 image-reveal" %>
                  <% else %>
                    <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-primary-50 to-secondary-50">
                      <svg class="w-16 h-16 text-primary-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                      </svg>
                    </div>
                  <% end %>
                  <div class="absolute top-3 left-3">
                    <%= render "pets/status_badge", status: pet.status %>
                  </div>
                </div>

                <div class="p-5">
                  <div class="flex items-start justify-between mb-2">
                    <h3 class="font-display text-xl font-bold text-neutral-900 group-hover:text-primary-600 transition"><%= pet.name %></h3>
                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-medium bg-primary-50 text-primary-700 shrink-0 ml-3">
                      <%= pet.age_display %>
                    </span>
                  </div>

                  <div class="flex items-center gap-2 text-sm text-neutral-600 mb-2">
                    <span><%= pet.species_label %></span>
                    <% if pet.breed.present? %>
                      <span class="text-neutral-300" aria-hidden="true">·</span>
                      <span><%= pet.breed %></span>
                    <% end %>
                  </div>

                  <div class="flex items-center gap-1.5 text-sm text-neutral-500">
                    <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                    </svg>
                    <span><%= pet.shelter&.city %>, <%= pet.shelter&.state %></span>
                  </div>
                </div>
              <% end %>

              <%# Interest button sits outside the link — no interactive elements nested inside an anchor. %>
              <%= render "pets/save_button", pet: pet, saved: false %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="bg-white rounded-xl border border-neutral-200 shadow-sm p-10 text-center">
        <p class="text-neutral-600 mb-4"><%= t("landing.index.featured.subtitle") %></p>
        <%= link_to t("landing.index.featured.browse_all"), pets_path,
            class: "inline-flex items-center gap-2 px-6 py-3 bg-primary-500 text-white font-semibold rounded-xl hover:bg-primary-600 active:scale-[0.97] transition-all duration-200 shadow-sm" %>
      </div>
    <% end %>
  </div>
</section>
