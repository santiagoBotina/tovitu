<div class="relative min-h-[80dvh] flex flex-col items-center justify-center overflow-hidden">
  <div class="absolute inset-0 bg-gradient-to-b from-primary-50/30 via-transparent to-secondary-50/30 pointer-events-none"></div>

  <div class="absolute top-1/4 -left-32 w-96 h-96 bg-primary-200/20 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute bottom-1/4 -right-32 w-96 h-96 bg-secondary-200/20 rounded-full blur-3xl pointer-events-none"></div>

  <div class="relative z-10 text-center max-w-2xl mx-auto mb-16">
    <div class="flex items-center justify-center gap-1.5 mb-6">
      <span class="font-display text-5xl sm:text-6xl font-extrabold tracking-tight">
        <span class="text-primary-500">t</span>
        <span class="text-secondary-500">o</span>
        <span class="text-[#FF5DA8]">v</span>
        <span class="text-[#FFC83D]">i</span>
        <span class="text-[#FF7A30]">t</span>
        <span class="text-primary-500">u</span>
      </span>
    </div>
    <h1 class="font-display text-4xl sm:text-5xl font-bold text-neutral-900 mb-4 text-balance">
      <%= t("landing.index.title") %>
    </h1>
    <p class="text-lg text-neutral-500 max-w-md mx-auto leading-relaxed text-balance">
      <%= t("landing.index.subtitle") %>
    </p>
  </div>

  <div class="relative z-10 grid grid-cols-1 md:grid-cols-2 gap-6 w-full max-w-2xl">
    <%= link_to login_adopter_path, class: "group relative block p-8 bg-white/90 backdrop-blur-sm rounded-xl shadow-md hover:shadow-lg border-2 border-primary-100 hover:border-primary-400 hover:-translate-y-1 active:scale-[0.98] transition-all duration-200 text-center" do %>
      <div class="absolute inset-0 bg-gradient-to-b from-primary-50/50 to-transparent opacity-0 group-hover:opacity-100 rounded-xl transition-opacity duration-200 pointer-events-none"></div>
      <div class="relative">
        <div class="w-16 h-16 bg-gradient-to-br from-primary-100 to-primary-50 rounded-2xl flex items-center justify-center mx-auto mb-5 group-hover:scale-110 group-hover:rotate-3 transition-transform duration-200">
          <svg class="w-8 h-8 text-primary-500" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
          </svg>
        </div>
        <h2 class="font-display text-2xl font-bold text-neutral-800 mb-2 group-hover:text-primary-600 transition-colors">
          <%= t("landing.index.adopter_title") %>
        </h2>
        <p class="text-neutral-500 text-sm">
          <%= t("landing.index.adopter_desc") %>
        </p>
      </div>
    <% end %>

    <%= link_to login_shelter_path, class: "group relative block p-8 bg-white/90 backdrop-blur-sm rounded-xl shadow-md hover:shadow-lg border-2 border-neutral-200 hover:border-secondary-400 hover:-translate-y-1 active:scale-[0.98] transition-all duration-200 text-center" do %>
      <div class="absolute inset-0 bg-gradient-to-b from-secondary-50/50 to-transparent opacity-0 group-hover:opacity-100 rounded-xl transition-opacity duration-200 pointer-events-none"></div>
      <div class="relative">
        <div class="w-16 h-16 bg-gradient-to-br from-secondary-100 to-secondary-50 rounded-2xl flex items-center justify-center mx-auto mb-5 group-hover:scale-110 group-hover:-rotate-3 transition-transform duration-200">
          <svg class="w-8 h-8 text-secondary-500" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 21h16.5M4.5 3h15M5.25 3v18m13.5-18v18M9 6.75h1.5m-1.5 3h1.5m-1.5 3h1.5m3-6H15m-1.5 3H15m-1.5 3H15M9 21v-3.375c0-.621.504-1.125 1.125-1.125h3.75c.621 0 1.125.504 1.125 1.125V21" />
          </svg>
        </div>
        <h2 class="font-display text-2xl font-bold text-neutral-800 mb-2 group-hover:text-secondary-600 transition-colors">
          <%= t("landing.index.shelter_title") %>
        </h2>
        <p class="text-neutral-500 text-sm">
          <%= t("landing.index.shelter_desc") %>
        </p>
      </div>
    <% end %>
  </div>
</div>
