<div class="full-width">

  <%# ── Hero (always visible, no reveal animation) ── %>
  <section class="bg-primary-500 px-4 sm:px-6 lg:px-8 py-20 sm:py-24 lg:py-28 relative overflow-hidden">
    <div class="max-w-7xl mx-auto relative z-10">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">

        <div class="text-center lg:text-left">
          <div class="flex items-center justify-center lg:justify-start gap-1.5 mb-8">
            <span class="font-display text-5xl sm:text-6xl font-extrabold tracking-tight leading-none">
              <span class="text-accent-yellow">t</span>
              <span class="text-secondary-500">o</span>
              <span class="text-accent-pink">v</span>
              <span class="text-accent-yellow">i</span>
              <span class="text-accent-orange">t</span>
              <span class="text-white">u</span>
            </span>
          </div>

          <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-extrabold text-white mb-4 text-balance leading-[1.1]">
            <%= t("landing.index.title") %>
          </h1>

          <p class="text-lg text-primary-100 max-w-lg mx-auto lg:mx-0 mb-8 leading-relaxed">
            <%= t("landing.index.subtitle") %>
          </p>

          <%# ── Hero search (public discovery entry point) ── %>
          <%= form_tag pets_path, method: :get, role: "search", class: "w-full max-w-xl mx-auto lg:mx-0 mb-6" do %>
            <div class="relative">
              <div class="absolute inset-y-0 left-0 pl-5 flex items-center pointer-events-none" aria-hidden="true">
                <svg class="w-6 h-6 text-primary-400" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
                </svg>
              </div>
              <%= text_field_tag :query, nil,
                    type: "search",
                    placeholder: t("landing.index.discovery.search_placeholder"),
                    aria: { label: t("landing.index.discovery.search") },
                    autocomplete: "off",
                    class: "w-full pl-14 pr-32 sm:pr-40 py-4 sm:py-5 bg-white rounded-2xl border-2 border-white text-base sm:text-lg text-neutral-800 placeholder-neutral-400 shadow-lg focus:outline-none focus:ring-4 focus:ring-primary-200 focus:border-primary-500 transition-all duration-200" %>
              <%= submit_tag t("landing.index.discovery.search_button"),
                    class: "absolute right-2 top-1/2 -translate-y-1/2 px-5 sm:px-6 py-2.5 sm:py-3 bg-primary-500 text-white font-semibold text-sm sm:text-base rounded-xl hover:bg-primary-600 focus-visible:ring-2 focus-visible:ring-white active:scale-[0.97] transition-all duration-150 cursor-pointer shadow-sm" %>
            </div>
          <% end %>

          <%# ── Species quick-pick ── %>
          <div class="flex flex-wrap items-center justify-center lg:justify-start gap-2 mb-10">
            <span class="text-sm text-primary-200 font-medium mr-1"><%= t("landing.index.discovery.quick_species_label") %></span>
            <%= link_to t("landing.index.discovery.quick_dog"), pets_path(species: "dog"),
                class: "px-4 py-2 rounded-full text-sm font-semibold text-white bg-white/15 border border-white/25 hover:bg-white/25 active:scale-[0.97] transition-all duration-150" %>
            <%= link_to t("landing.index.discovery.quick_cat"), pets_path(species: "cat"),
                class: "px-4 py-2 rounded-full text-sm font-semibold text-white bg-white/15 border border-white/25 hover:bg-white/25 active:scale-[0.97] transition-all duration-150" %>
            <%= link_to t("landing.index.discovery.quick_other"), pets_path(species: "other"),
                class: "px-4 py-2 rounded-full text-sm font-semibold text-white bg-white/15 border border-white/25 hover:bg-white/25 active:scale-[0.97] transition-all duration-150" %>
          </div>

          <div class="flex flex-col sm:flex-row items-center gap-4 justify-center lg:justify-start">
            <%= link_to pets_path, class: "inline-flex items-center px-8 py-4 bg-white text-primary-600 font-bold text-base rounded-xl border-2 border-primary-700 hover:bg-primary-50 active:scale-[0.97] transition-all duration-150 shadow-button-primary hover:shadow-button-primary-hover active:shadow-button-primary-active" do %>
              <svg class="w-5 h-5 mr-2 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
              </svg>
              <%= t("landing.index.adopter_cta") %>
            <% end %>

            <%= link_to new_session_path(role: "shelter"), class: "inline-flex items-center px-6 py-4 text-white font-semibold text-base rounded-xl border-2 border-white/30 hover:border-white hover:bg-white/10 active:scale-[0.97] transition-all duration-150" do %>
              <%= t("landing.index.shelter_cta") %>
              <svg class="w-4 h-4 ml-2 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
              </svg>
            <% end %>
          </div>
        </div>

        <div class="flex justify-center lg:justify-end">
          <div class="relative">
            <div class="w-72 h-72 sm:w-80 sm:h-80 lg:w-96 lg:h-96 rounded-[32px] border-4 border-white shadow-hero-card overflow-hidden">
              <%= image_tag "https://images.unsplash.com/photo-1552053831-71594a27632d?auto=format&fit=crop&w=600&q=80",
                  alt: t("landing.index.hero_pet_alt"),
                  class: "w-full h-full object-cover",
                  loading: "eager" %>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <%# ── Pick up where you left off (revealed by exploration_memory) ── %>
  <%= render "landing/resume_exploration" %>

  <%# ── Featured Pets ── %>
  <%= render "landing/featured_pets" %>

  <%# ── How It Works ── %>
  <%# A playground journey: oversized Baloo 2 numerals as texture, thick
      borders + hard offset shadows (Playground Standard), a bold teal track
      connecting the steps, and a saturated purple "destination" card for
      Adopt. The numbers earn their place — this is a real sequence. %>
  <section id="how-it-works" class="bg-white px-4 sm:px-6 lg:px-8 py-20 sm:py-24">
    <div class="max-w-7xl mx-auto">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold text-neutral-900 mb-4 text-balance">
          <%= t("landing.index.how_it_works.title") %>
        </h2>
        <p class="text-lg text-neutral-700 leading-relaxed text-pretty">
          <%= t("landing.index.how_it_works.subtitle") %>
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-8 lg:gap-10 relative">
        <div class="hidden md:block absolute top-14 left-[calc(16.67%+2rem)] right-[calc(16.67%+2rem)] h-1.5 bg-secondary-500 rounded-full" aria-hidden="true"></div>

        <div class="relative z-10 bg-white rounded-xl border-2 border-primary-200 p-8 shadow-button-primary">
          <span aria-hidden="true" class="absolute top-2 right-4 font-display text-7xl font-extrabold leading-none text-primary-100 select-none pointer-events-none">1</span>
          <div class="w-12 h-12 rounded-xl bg-primary-500 flex items-center justify-center mb-6">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
            </svg>
          </div>
          <h3 class="font-display text-xl font-bold text-neutral-900 mb-2 text-balance">
            <%= t("landing.index.how_it_works.step1_title") %>
          </h3>
          <p class="text-neutral-700 leading-relaxed text-pretty">
            <%= t("landing.index.how_it_works.step1_desc") %>
          </p>
        </div>

        <div class="relative z-10 bg-white rounded-xl border-2 border-secondary-300 p-8 shadow-button-secondary">
          <span aria-hidden="true" class="absolute top-2 right-4 font-display text-7xl font-extrabold leading-none text-secondary-100 select-none pointer-events-none">2</span>
          <div class="w-12 h-12 rounded-xl bg-secondary-500 flex items-center justify-center mb-6">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.455 2.456L21.75 6l-1.036.259a3.375 3.375 0 00-2.455 2.456z"/>
            </svg>
          </div>
          <h3 class="font-display text-xl font-bold text-neutral-900 mb-2 text-balance">
            <%= t("landing.index.how_it_works.step2_title") %>
          </h3>
          <p class="text-neutral-700 leading-relaxed text-pretty">
            <%= t("landing.index.how_it_works.step2_desc") %>
          </p>
        </div>

        <div class="relative z-10 bg-primary-500 rounded-xl border-2 border-primary-700 p-8 shadow-button-primary">
          <span aria-hidden="true" class="absolute top-2 right-4 font-display text-7xl font-extrabold leading-none text-white/10 select-none pointer-events-none">3</span>
          <div class="w-12 h-12 rounded-xl bg-white flex items-center justify-center mb-6">
            <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4.318 6.318a4.5 4.5 0 0 0 0 6.364L12 20.364l7.682-7.682a4.5 4.5 0 0 0-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 0 0-6.364 0Z"/>
            </svg>
          </div>
          <h3 class="font-display text-xl font-bold text-white mb-2 text-balance">
            <%= t("landing.index.how_it_works.step3_title") %>
          </h3>
          <p class="text-primary-50 leading-relaxed text-pretty">
            <%= t("landing.index.how_it_works.step3_desc") %>
          </p>
        </div>
      </div>
    </div>
  </section>

  <%# ── How Matching Works ── %>
  <%= render "landing/matching" %>

  <%# ── Adoption Process ── %>
  <%= render "landing/process" %>

  <%# ── Benefits of an Account ── %>
  <%= render "landing/benefits" %>

  <%# ── For Shelters ── %>
  <%# A deliberate bento: one large AI-match card, a request-inbox card with a
      real card body + miniature UI mock, a team card, and a wide analytics
      card. Each feature gets exactly one accent. The mini UIs are decorative
      (aria-hidden) — shapes only, no fabricated data claims. %>
  <section id="for-shelters" class="bg-primary-50 px-4 sm:px-6 lg:px-8 py-20 sm:py-24">
    <div class="max-w-7xl mx-auto">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold text-neutral-900 mb-4 text-balance">
          <%= t("landing.index.for_shelters.title") %>
        </h2>
        <p class="text-lg text-neutral-700 leading-relaxed text-pretty">
          <%= t("landing.index.for_shelters.subtitle") %>
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
        <%# feature1: AI-Powered Matching (large) %>
        <div class="bg-white rounded-xl border-2 border-primary-200 shadow-sm p-8 sm:col-span-2">
          <div class="flex flex-col sm:flex-row items-start gap-5">
            <div class="w-12 h-12 rounded-xl bg-primary-500 flex items-center justify-center shrink-0">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.455 2.456L21.75 6l-1.036.259a3.375 3.375 0 00-2.455 2.456z"/>
              </svg>
            </div>
            <div>
              <h3 class="font-display text-xl font-bold text-neutral-900 mb-2 text-balance">
                <%= t("landing.index.for_shelters.feature1_title") %>
              </h3>
              <p class="text-neutral-700 leading-relaxed text-pretty">
                <%= t("landing.index.for_shelters.feature1_desc") %>
              </p>
            </div>
          </div>
          <%# Decorative match visual: adopter ↔ pet, connected by a fit badge. %>
          <div aria-hidden="true" class="mt-6 rounded-xl bg-primary-50 border border-primary-100 p-5">
            <div class="flex items-center justify-center gap-3">
              <div class="w-10 h-10 rounded-full bg-primary-200 flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-primary-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                </svg>
              </div>
              <div class="flex-1 relative h-0.5 bg-primary-200">
                <div class="absolute inset-0 flex items-center justify-center">
                  <div class="w-8 h-8 rounded-full bg-secondary-500 border-2 border-white flex items-center justify-center shadow-sm">
                    <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M4.318 6.318a4.5 4.5 0 0 0 0 6.364L12 20.364l7.682-7.682a4.5 4.5 0 0 0-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 0 0-6.364 0Z"/>
                    </svg>
                  </div>
                </div>
              </div>
              <div class="w-10 h-10 rounded-full bg-secondary-200 flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-secondary-700" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5.5 10.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5zm13 0a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5zM12 20a4.5 4.5 0 0 0 4.5-4.5c0-1.6-1.2-3.8-2.7-5.2a2.5 2.5 0 0 0-3.6 0C8.7 11.7 7.5 13.9 7.5 15.5A4.5 4.5 0 0 0 12 20z"/>
                </svg>
              </div>
            </div>
          </div>
        </div>

        <%# feature2: Application Management (real card body + request-inbox mock) %>
        <div class="bg-white rounded-xl border-2 border-secondary-200 shadow-sm p-8">
          <div class="w-12 h-12 rounded-xl bg-secondary-500 flex items-center justify-center mb-5">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z"/>
            </svg>
          </div>
          <h3 class="font-display text-xl font-bold text-neutral-900 mb-2 text-balance">
            <%= t("landing.index.for_shelters.feature2_title") %>
          </h3>
          <p class="text-neutral-700 leading-relaxed text-pretty">
            <%= t("landing.index.for_shelters.feature2_desc") %>
          </p>
          <%# Decorative request-inbox mock: applicant rows with status dots. %>
          <div aria-hidden="true" class="mt-6 rounded-xl bg-secondary-50 border border-secondary-100 p-4 space-y-3">
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-full bg-secondary-200 shrink-0"></div>
              <div class="flex-1 space-y-1.5">
                <div class="h-2 w-3/4 rounded-full bg-secondary-200"></div>
                <div class="h-2 w-1/2 rounded-full bg-secondary-100"></div>
              </div>
              <span class="w-2.5 h-2.5 rounded-full bg-warning shrink-0"></span>
            </div>
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-full bg-secondary-200 shrink-0"></div>
              <div class="flex-1 space-y-1.5">
                <div class="h-2 w-2/3 rounded-full bg-secondary-200"></div>
                <div class="h-2 w-1/3 rounded-full bg-secondary-100"></div>
              </div>
              <span class="w-2.5 h-2.5 rounded-full bg-secondary-500 shrink-0"></span>
            </div>
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-full bg-secondary-200 shrink-0"></div>
              <div class="flex-1 space-y-1.5">
                <div class="h-2 w-3/4 rounded-full bg-secondary-200"></div>
                <div class="h-2 w-1/2 rounded-full bg-secondary-100"></div>
              </div>
              <span class="w-2.5 h-2.5 rounded-full bg-primary-400 shrink-0"></span>
            </div>
          </div>
        </div>

        <%# feature3: Team Collaboration %>
        <div class="bg-white rounded-xl border-2 border-accent-yellow/40 shadow-sm p-8">
          <div class="w-12 h-12 rounded-xl bg-accent-yellow flex items-center justify-center mb-5">
            <svg class="w-6 h-6 text-neutral-900" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.173-.786-3.057M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z"/>
            </svg>
          </div>
          <h3 class="font-display text-xl font-bold text-neutral-900 mb-2 text-balance">
            <%= t("landing.index.for_shelters.feature3_title") %>
          </h3>
          <p class="text-neutral-700 leading-relaxed text-pretty">
            <%= t("landing.index.for_shelters.feature3_desc") %>
          </p>
        </div>

        <%# feature4: Success Analytics (wide) %>
        <div class="bg-white rounded-xl border-2 border-accent-pink/30 shadow-sm p-8 sm:col-span-2">
          <div class="flex flex-col sm:flex-row items-start gap-5">
            <div class="w-12 h-12 rounded-xl bg-accent-pink flex items-center justify-center shrink-0">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z"/>
              </svg>
            </div>
            <div>
              <h3 class="font-display text-xl font-bold text-neutral-900 mb-2 text-balance">
                <%= t("landing.index.for_shelters.feature4_title") %>
              </h3>
              <p class="text-neutral-700 leading-relaxed text-pretty">
                <%= t("landing.index.for_shelters.feature4_desc") %>
              </p>
            </div>
          </div>
          <%# Decorative analytics mock: rounded bars trending up. %>
          <div aria-hidden="true" class="mt-6 rounded-xl bg-accent-pink/5 border border-accent-pink/20 p-5">
            <div class="flex items-end justify-between gap-2 h-20">
              <div class="w-6 rounded-t-lg bg-primary-200 h-8"></div>
              <div class="w-6 rounded-t-lg bg-primary-300 h-12"></div>
              <div class="w-6 rounded-t-lg bg-primary-400 h-10"></div>
              <div class="w-6 rounded-t-lg bg-secondary-400 h-16"></div>
              <div class="w-6 rounded-t-lg bg-secondary-500 h-14"></div>
              <div class="w-6 rounded-t-lg bg-accent-pink h-20"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <%# ── Final CTA ── %>
  <section class="bg-secondary-600 px-4 sm:px-6 lg:px-8 py-16 sm:py-20 relative overflow-hidden">
    <div class="max-w-7xl mx-auto text-center relative z-10">
      <div class="max-w-2xl mx-auto">
        <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold text-white mb-4 text-balance">
          <%= t("landing.index.cta.title") %>
        </h2>
        <p class="text-lg text-secondary-100 mb-10 leading-relaxed">
          <%= t("landing.index.cta.subtitle") %>
        </p>
