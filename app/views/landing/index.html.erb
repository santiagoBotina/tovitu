<div class="full-width">

  <%# ── Hero (always visible, no reveal animation) ── %>
  <section class="bg-primary-500 px-4 sm:px-6 lg:px-8 py-20 sm:py-24 lg:py-28 relative overflow-hidden">
    <div class="max-w-7xl mx-auto relative z-10">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">

        <div class="text-center lg:text-left">
          <div class="flex items-center justify-center lg:justify-start gap-1.5 mb-8">
            <span class="font-display text-5xl sm:text-6xl font-extrabold tracking-tight leading-none">
              <span class="text-accent-yellow">t</span>
              <span class="text-secondary-500">o</span>
              <span class="text-accent-pink">v</span>
              <span class="text-accent-yellow">i</span>
              <span class="text-accent-orange">t</span>
              <span class="text-white">u</span>
            </span>
          </div>

          <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-extrabold text-white mb-4 text-balance leading-[1.1]">
            <%= t("landing.index.title") %>
          </h1>

          <p class="text-lg text-primary-100 max-w-lg mx-auto lg:mx-0 mb-10 leading-relaxed">
            <%= t("landing.index.subtitle") %>
          </p>

          <div class="flex flex-col sm:flex-row items-center gap-4 justify-center lg:justify-start">
            <%= link_to pets_path, class: "inline-flex items-center px-8 py-4 bg-white text-primary-600 font-bold text-base rounded-xl border-2 border-primary-700 hover:bg-primary-50 active:scale-[0.97] transition-all duration-150 shadow-button-primary hover:shadow-button-primary-hover active:shadow-button-primary-active" do %>
              <svg class="w-5 h-5 mr-2 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
              </svg>
              <%= t("landing.index.adopter_cta") %>
            <% end %>

            <%= link_to login_shelter_path, class: "inline-flex items-center px-6 py-4 text-white font-semibold text-base rounded-xl border-2 border-white/30 hover:border-white hover:bg-white/10 active:scale-[0.97] transition-all duration-150" do %>
              <%= t("landing.index.shelter_cta") %>
              <svg class="w-4 h-4 ml-2 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
              </svg>
            <% end %>
          </div>
        </div>

        <div class="flex justify-center lg:justify-end">
          <div class="relative">
            <div class="w-72 h-72 sm:w-80 sm:h-80 lg:w-96 lg:h-96 rounded-[32px] border-4 border-white shadow-hero-card overflow-hidden">
              <%= image_tag "https://images.unsplash.com/photo-1552053831-71594a27632d?auto=format&fit=crop&w=600&q=80",
                  alt: t("landing.index.hero_pet_alt"),
                  class: "w-full h-full object-cover",
                  loading: "eager" %>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <%# ── How It Works ── %>
  <section class="bg-white px-4 sm:px-6 lg:px-8 py-20 sm:py-24">
    <div class="max-w-7xl mx-auto">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold text-neutral-900 mb-4 text-balance">
          <%= t("landing.index.how_it_works.title") %>
        </h2>
        <p class="text-lg text-neutral-600 leading-relaxed">
          <%= t("landing.index.how_it_works.subtitle") %>
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-12 md:gap-8 relative">
        <div class="hidden md:block absolute top-10 left-[calc(16.67%+2rem)] right-[calc(16.67%+2rem)] h-0.5 bg-secondary-200"></div>

        <div class="text-center relative">
          <div class="w-14 h-14 rounded-full bg-secondary-500 flex items-center justify-center mx-auto mb-6 relative z-10 shadow-md">
            <span class="text-white font-display font-bold text-xl">1</span>
          </div>
          <h3 class="font-display text-xl font-semibold text-neutral-900 mb-3">
            <%= t("landing.index.how_it_works.step1_title") %>
          </h3>
          <p class="text-neutral-600 leading-relaxed max-w-xs mx-auto">
            <%= t("landing.index.how_it_works.step1_desc") %>
          </p>
        </div>

        <div class="text-center relative">
          <div class="w-14 h-14 rounded-full bg-secondary-500 flex items-center justify-center mx-auto mb-6 relative z-10 shadow-md">
            <span class="text-white font-display font-bold text-xl">2</span>
          </div>
          <h3 class="font-display text-xl font-semibold text-neutral-900 mb-3">
            <%= t("landing.index.how_it_works.step2_title") %>
          </h3>
          <p class="text-neutral-600 leading-relaxed max-w-xs mx-auto">
            <%= t("landing.index.how_it_works.step2_desc") %>
          </p>
        </div>

        <div class="text-center relative">
          <div class="w-14 h-14 rounded-full bg-secondary-500 flex items-center justify-center mx-auto mb-6 relative z-10 shadow-md">
            <span class="text-white font-display font-bold text-xl">3</span>
          </div>
          <h3 class="font-display text-xl font-semibold text-neutral-900 mb-3">
            <%= t("landing.index.how_it_works.step3_title") %>
          </h3>
          <p class="text-neutral-600 leading-relaxed max-w-xs mx-auto">
            <%= t("landing.index.how_it_works.step3_desc") %>
          </p>
        </div>
      </div>
    </div>
  </section>

  <%# ── For Shelters ── %>
  <section class="bg-primary-50 px-4 sm:px-6 lg:px-8 py-20 sm:py-24">
    <div class="max-w-7xl mx-auto">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold text-neutral-900 mb-4 text-balance">
          <%= t("landing.index.for_shelters.title") %>
        </h2>
        <p class="text-lg text-neutral-600 leading-relaxed">
          <%= t("landing.index.for_shelters.subtitle") %>
        </p>
      </div>

      <div class="max-w-4xl mx-auto space-y-8 sm:space-y-10">
        <div class="bg-white rounded-xl shadow-sm border border-secondary-200 p-6 sm:p-8 flex flex-col sm:flex-row items-start gap-5">
          <div class="w-12 h-12 rounded-xl bg-secondary-500 flex items-center justify-center shrink-0">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.455 2.456L21.75 6l-1.036.259a3.375 3.375 0 00-2.455 2.456z" />
            </svg>
          </div>
          <div class="flex-1">
            <h3 class="font-display text-xl font-bold text-neutral-900 mb-1.5">
              <%= t("landing.index.for_shelters.feature1_title") %>
            </h3>
            <p class="text-neutral-600 leading-relaxed">
              <%= t("landing.index.for_shelters.feature1_desc") %>
            </p>
          </div>
        </div>

        <div class="grid sm:grid-cols-2 gap-8 sm:gap-10">
          <div class="bg-primary-50 rounded-xl p-6 text-center">
            <div class="w-12 h-12 rounded-xl bg-primary-200 flex items-center justify-center mx-auto mb-4">
              <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
              </svg>
            </div>
            <h3 class="font-display text-lg font-semibold text-neutral-900 mb-2">
              <%= t("landing.index.for_shelters.feature2_title") %>
            </h3>
            <p class="text-neutral-600 leading-relaxed text-sm">
              <%= t("landing.index.for_shelters.feature2_desc") %>
            </p>
          </div>

          <div class="bg-white rounded-xl shadow-sm border border-neutral-200 p-6 flex flex-col items-start gap-4">
            <div class="w-10 h-10 rounded-lg bg-secondary-100 flex items-center justify-center">
              <svg class="w-5 h-5 text-secondary-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.173-.786-3.057M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" />
              </svg>
            </div>
            <div>
              <h3 class="font-display text-lg font-semibold text-neutral-900 mb-1.5">
                <%= t("landing.index.for_shelters.feature3_title") %>
              </h3>
              <p class="text-neutral-600 leading-relaxed text-sm">
                <%= t("landing.index.for_shelters.feature3_desc") %>
              </p>
            </div>
          </div>
        </div>

        <div class="bg-white rounded-xl shadow-sm border border-neutral-200 p-6 sm:p-8 flex flex-col sm:flex-row items-center gap-5 text-center sm:text-left">
          <div class="w-14 h-14 rounded-full bg-secondary-500 flex items-center justify-center shrink-0">
            <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" />
            </svg>
          </div>
          <div class="flex-1">
            <h3 class="font-display text-xl font-bold text-neutral-900 mb-1.5">
              <%= t("landing.index.for_shelters.feature4_title") %>
            </h3>
            <p class="text-neutral-600 leading-relaxed">
              <%= t("landing.index.for_shelters.feature4_desc") %>
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <%# ── Final CTA ── %>
  <section class="bg-secondary-600 px-4 sm:px-6 lg:px-8 py-16 sm:py-20 relative overflow-hidden">
    <div class="max-w-7xl mx-auto text-center relative z-10">
      <div class="max-w-2xl mx-auto">
        <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold text-white mb-4 text-balance">
          <%= t("landing.index.cta.title") %>
        </h2>
        <p class="text-lg text-secondary-100 mb-10 leading-relaxed">
          <%= t("landing.index.cta.subtitle") %>
        </p>
        <div class="flex flex-col sm:flex-row items-center gap-4 justify-center">
          <%= link_to pets_path, class: "inline-flex items-center px-8 py-4 bg-white text-secondary-700 font-bold text-base rounded-xl border-2 border-secondary-700 hover:bg-secondary-50 active:scale-[0.97] transition-all duration-150 shadow-button-secondary hover:shadow-button-secondary-hover active:shadow-button-secondary-active" do %>
            <svg class="w-5 h-5 mr-2 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
            </svg>
            <%= t("landing.index.cta.adopter_cta") %>
          <% end %>

          <%= link_to login_shelter_path, class: "inline-flex items-center px-8 py-4 text-white font-semibold text-base rounded-xl border-2 border-white/30 hover:border-white hover:bg-white/10 active:scale-[0.97] transition-all duration-150" do %>
            <svg class="w-5 h-5 mr-2 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 21h16.5M4.5 3h15M5.25 3v18m13.5-18v18M9 6.75h1.5m-1.5 3h1.5m-1.5 3h1.5m3-6H15m-1.5 3H15m-1.5 3H15M9 21v-3.375c0-.621.504-1.125 1.125-1.125h3.75c.621 0 1.125.504 1.125 1.125V21" />
            </svg>
            <%= t("landing.index.cta.shelter_cta") %>
          <% end %>
        </div>
      </div>
    </div>
  </section>

</div>
