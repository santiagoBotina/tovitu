<%# ─── Adoption Request Confirmation Email ─── %>
<% party_name = @shelter&.name || @request.responsible_party_name %>

<h1><%= t(".greeting", name: @adopter.name) %></h1>

<div class="pet-card">
  <p class="pet-name"><%= @pet.name %></p>
  <p class="pet-detail">
    <%= @pet.breed.presence || t("adoption_requests.show.unknown_breed") %>
    · <%= @pet.species&.humanize %>
  </p>
</div>

<p><%= t(".body", pet_name: @pet.name, party_name: party_name) %></p>

<div class="info-box">
  <p><%= t(".next_steps") %></p>
</div>

<div class="email-cta">
  <a href="<%= adoption_request_url(@request, locale: @locale) %>"><%= t(".view_request") %></a>
</div>

<p><%= t(".thanks") %></p>
