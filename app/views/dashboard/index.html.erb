<%# ─── Setup: determine subtitle and tip ─── %>
<% subtitle_key = if @show_onboarding
                    ".welcome.subtitle_onboarding"
                  elsif @adoption_requests.any?
                    ".welcome.subtitle_active"
                  else
                    ".welcome.subtitle"
                  end %>

<% tip_key = if @adoption_requests.any?
               ".tip.text_requests"
             elsif !@show_onboarding
               ".tip.text_active"
             else
               ".tip.text"
             end %>

<div class="max-w-7xl mx-auto">

  <%# ─── Page Header ─── %>
  <%# NOTE: translate the CTA label HERE (caller scope), not inside the block.
      The section_header partial captures its block with `capture { yield }`,
      so lazy keys (t(".…")) inside the block resolve against
      shared/section_header and would show "translation missing". %>
  <% browse_cta = t(".welcome.cta_browse") %>
  <%= render "shared/section_header",
             title: t(".welcome.title", name: current_user.name),
             subtitle: t(subtitle_key),
             header_class: "mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4",
             subtitle_class: "text-neutral-500 mt-1 text-balance max-w-xl" do %>
    <div class="flex items-center gap-3 shrink-0">
      <%= link_to pets_path,
          class: "inline-flex items-center gap-2 px-5 py-2.5 bg-primary-500 text-white font-semibold text-sm rounded-xl hover:bg-primary-600 focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 transition-all duration-200 active:scale-[0.97] shadow-sm" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
        </svg>
        <%= browse_cta %>
      <% end %>
    </div>
  <% end %>

  <%# ════════════════════════════════════════════════════════════════ %>
  <%# BENTO GRID                                                     %>
  <%# ════════════════════════════════════════════════════════════════ %>
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">

    <%# ─── LEFT COLUMN ─── %>
    <div class="space-y-5">

      <%# Card: Adoption Journey (explains, celebrates, drives a next action) %>
      <% journey = current_user_journey %>
      <section class="bg-gradient-to-br from-primary-50 via-primary-50/70 to-white rounded-xl p-5 sm:p-6 shadow-sm border border-primary-100 bento-enter bento-enter-d1"
               aria-label="<%= t(".readiness.title") %>">
        <%# Header: icon + title + percent %>
        <div class="flex items-center justify-between mb-3">
          <div class="flex items-center gap-3 min-w-0">
            <div class="shrink-0 w-10 h-10 rounded-xl bg-primary-100 flex items-center justify-center" aria-hidden="true">
              <svg class="w-5 h-5 text-primary-600" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" y1="22" x2="4" y2="15"/>
              </svg>
            </div>
            <h2 class="font-display text-lg font-bold text-neutral-800 truncate"><%= t(".readiness.title") %></h2>
          </div>
          <span class="font-display text-2xl font-bold text-primary-600 shrink-0"><%= t(".readiness.percent", percent: @readiness_percent) %></span>
        </div>

        <%# One-sentence explanation, adapted to the user's state %>
        <p class="text-sm text-neutral-700 mb-4"><%= t(".journey_card.explanation.#{journey.card_variant}") %></p>

        <%# ─── Hybrid Journey Rail ─── %>
        <%# ONE continuous track for the readiness fill, with the four stage
            checkpoints + labels in a wrapping grid below it. The old duplicate
            bar + stepper are gone; labels wrap so nothing gets clipped. %>
        <div class="mt-4 mb-5">
          <div class="h-2 rounded-full bg-neutral-100 overflow-hidden"
               role="progressbar"
               aria-valuenow="<%= @readiness_percent %>" aria-valuemin="0" aria-valuemax="100"
               aria-label="<%= t(".readiness.stages_label") %>">
            <div class="progress-shimmer h-full rounded-full transition-all duration-1000 ease-out"
                 style="width: <%= @readiness_percent %>%"></div>
          </div>

          <ol class="mt-3 grid grid-cols-4 gap-1 sm:gap-2" aria-label="<%= t(".readiness.stages_label") %>">
            <% journey.stages.each do |stage| %>
              <% current = stage[:key] == journey.current_stage[:key] %>
              <li class="flex flex-col items-center gap-1 text-center min-w-0">
                <span class="w-2.5 h-2.5 rounded-full shrink-0 <%= current ? 'bg-primary-500' : (stage[:reached] ? 'bg-secondary-500' : 'bg-neutral-300') %>"
                      aria-hidden="true"></span>
                <span class="text-[10px] sm:text-[11px] font-medium leading-tight <%= current ? 'text-primary-700' : (stage[:reached] ? 'text-neutral-700' : 'text-neutral-400') %>">
                  <%= t(".readiness.stage.#{stage[:key]}") %>
                </span>
              </li>
            <% end %>
          </ol>
        </div>

        <%# What the user has achieved %>
        <p class="text-sm font-semibold text-neutral-800 mb-2">
          <%= t(".journey_card.achieved", done: journey.completed_milestone_count, total: journey.total_milestone_count) %>
        </p>
        <ul class="flex flex-wrap gap-1.5 mb-4">
          <% journey.milestones.each do |milestone| %>
            <li class="inline-flex items-center gap-1 px-2 py-1 rounded-full text-[11px] font-semibold <%= milestone[:done] ? 'bg-secondary-500 text-white' : 'bg-white text-neutral-500 border border-neutral-200' %>">
              <% if milestone[:done] %>
                <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>
              <% else %>
                <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="<%= milestone_icon_path(milestone[:icon]) %>"/></svg>
              <% end %>
              <span><%= t(".journey.milestone.#{milestone[:key]}") %></span>
            </li>
          <% end %>
        </ul>

        <%# Current stage + next step %>
        <p class="text-sm font-semibold text-neutral-800 mb-1">
          <%= t(".readiness.stage.#{journey.current_stage[:key]}") %>
        </p>
        <p class="text-sm text-neutral-600">
          <span class="inline-block w-2 h-2 rounded-full bg-secondary-500 mr-2 align-middle" aria-hidden="true"></span>
          <%= t(".readiness.next_step.#{journey.next_step_key}") %>
        </p>

        <%# Clear next-action CTA (full-width for a comfortable tap target) %>
        <div class="mt-5">
          <%= link_to send(journey.card_cta_path),
              class: "inline-flex items-center justify-center gap-2 w-full px-5 py-2.5 bg-primary-500 text-white font-semibold text-sm rounded-xl hover:bg-primary-600 focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 transition-all duration-200 active:scale-[0.97] shadow-sm" do %>
            <%= t(".journey_card.cta.#{journey.card_cta_key}") %>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
            </svg>
          <% end %>
        </div>

        <%# Accompaniment %>
        <p class="flex items-center justify-center gap-1.5 text-xs text-primary-600 mt-3">
          <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
          </svg>
          <%= t(".journey_card.accompaniment") %>
        </p>
      </section>

      <%# Card: Life Preview Goal %>
      <section class="bg-gradient-to-br from-secondary-50 to-white rounded-xl p-6 shadow-sm border border-secondary-100 bento-enter bento-enter-d2">
        <div class="flex items-start gap-4 mb-4">
          <div class="shrink-0 w-12 h-12 rounded-xl bg-secondary-100 flex items-center justify-center" aria-hidden="true">
            <svg class="w-6 h-6 text-secondary-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/>
            </svg>
          </div>
          <div>
            <h2 class="font-display text-lg font-bold text-neutral-800"><%= t(".preview.title") %></h2>
            <p class="text-sm text-neutral-500 mt-1"><%= t(".preview.description") %></p>
          </div>
        </div>

        <%# Active previews count %>
        <div class="flex items-center justify-between mb-4 p-3 rounded-xl bg-white/70 border border-secondary-100">
          <span class="text-sm font-medium text-neutral-700"><%= t(".preview.active") %></span>
          <span class="text-sm font-semibold text-secondary-600"><%= t(".preview.count", count: @saved_pets.length.clamp(0, 3)) %></span>
        </div>

        <%= link_to pets_path,
            class: "flex items-center justify-center gap-2 w-full px-5 py-2.5 bg-white border-2 border-secondary-300 text-secondary-700 font-semibold text-sm rounded-xl hover:bg-secondary-50 hover:border-secondary-400 transition-all duration-200 active:scale-[0.97] card-lift" do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/>
          </svg>
          <%= t(".preview.cta") %>
        <% end %>
      </section>

      <%# Card: Your Journey (milestones) %>
      <section class="bg-white rounded-xl p-6 shadow-sm border border-neutral-200 bento-enter bento-enter-d3" aria-label="<%= t(".journey.title") %>">
        <div class="flex items-center justify-between mb-4">
          <h2 class="font-display text-lg font-bold text-neutral-800"><%= t(".journey.title") %></h2>
          <span class="text-xs font-medium text-neutral-400">
            <%= t(".journey.progress", done: current_user_journey.completed_milestone_count, total: current_user_journey.total_milestone_count) %>
          </span>
        </div>

        <ul class="space-y-2">
          <% current_user_journey.milestones.each do |milestone| %>
            <li class="flex items-center gap-3 p-3 rounded-xl <%= milestone[:done] ? 'bg-secondary-50/60 border border-secondary-100' : 'bg-neutral-50 border border-neutral-100' %>">
              <span class="shrink-0 w-8 h-8 rounded-full flex items-center justify-center <%= milestone[:done] ? 'bg-secondary-500' : 'bg-neutral-200' %>" aria-hidden="true">
                <% if milestone[:done] %>
                  <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/>
                  </svg>
                <% else %>
                  <svg class="w-4 h-4 text-neutral-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                    <path d="<%= milestone_icon_path(milestone[:icon]) %>"/>
                  </svg>
                <% end %>
              </span>
              <div class="flex-1 min-w-0">
                <p class="text-sm font-medium <%= milestone[:done] ? 'text-neutral-800' : 'text-neutral-600' %>">
                  <%= t(".journey.milestone.#{milestone[:key]}") %>
                </p>
                <% unless milestone[:done] %>
                  <p class="text-xs text-neutral-400 mt-0.5"><%= t(".journey.hint.#{milestone[:hint]}") %></p>
                <% end %>
              </div>
              <% if milestone[:done] %>
                <span class="shrink-0 px-2 py-0.5 rounded-full text-[11px] font-semibold bg-secondary-500 text-white">
                  <%= t(".journey.unlocked") %>
                </span>
              <% end %>
            </li>
          <% end %>
        </ul>
      </section>

      <%# Card: Recent Activity %>
      <section class="bg-white rounded-xl p-6 shadow-sm border border-neutral-200 bento-enter bento-enter-d6">
        <div class="flex items-center justify-between mb-4">
          <h2 class="font-display text-lg font-bold text-neutral-800"><%= t(".activity.title") %></h2>
          <% if @adoption_requests.any? || @saved_pets.any? %>
            <button class="text-xs font-medium text-neutral-400 hover:text-primary-500 transition-colors">
              <%= t(".activity.mark_all_read") %>
            </button>
          <% end %>
        </div>

        <div class="space-y-4">
          <% if @adoption_requests.any? %>
            <% @adoption_requests.first(2).each do |req| %>
              <div class="flex items-start gap-3">
                <div class="shrink-0 w-8 h-8 rounded-lg bg-primary-50 flex items-center justify-center mt-0.5" aria-hidden="true">
                  <svg class="w-4 h-4 text-primary-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"/>
                  </svg>
                </div>
                <div class="flex-1 min-w-0">
                  <p class="text-sm text-neutral-700">
                    <strong><%= t(".activity.request_update", status: req.status.humanize.downcase, name: req.pet&.name || t(".activity.a_pet")) %></strong>
                  </p>
                  <p class="text-xs text-neutral-400 mt-0.5"><%= t(".activity.time_ago", time: distance_of_time_in_words(req.updated_at, Time.current)) %></p>
                </div>
              </div>
            <% end %>
          <% end %>

          <% if @saved_pets.any? %>
            <div class="flex items-start gap-3">
              <div class="shrink-0 w-8 h-8 rounded-lg bg-accent-pink/10 flex items-center justify-center mt-0.5" aria-hidden="true">
                <svg class="w-4 h-4 text-accent-pink" fill="currentColor" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
                </svg>
              </div>
              <div class="flex-1">
                <p class="text-sm text-neutral-700">
                  <%= t(".activity.pets_saved", count: @saved_pets.length) %>
                </p>
                <p class="text-xs text-neutral-400 mt-0.5"><%= t(".activity.top_matches_ready") %></p>
              </div>
            </div>
          <% end %>

          <div class="flex items-start gap-3">
            <div class="shrink-0 w-8 h-8 rounded-lg bg-secondary-50 flex items-center justify-center mt-0.5" aria-hidden="true">
              <svg class="w-4 h-4 text-secondary-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/>
              </svg>
            </div>
            <div class="flex-1">
              <p class="text-sm text-neutral-600"><%= t(tip_key) %></p>
              <p class="text-xs text-neutral-400 mt-0.5"><%= t(".activity.tovitu_tip") %></p>
            </div>
          </div>
        </div>

        <% if @adoption_requests.none? && @saved_pets.none? %>
          <div class="text-center py-6">
            <p class="text-sm text-neutral-400"><%= t(".activity.empty") %></p>
          </div>
        <% end %>
      </section>

    </div>

    <%# ─── RIGHT COLUMN ─── %>
    <div class="space-y-5">

      <%# Card: Top Matches %>
      <section class="bg-white rounded-xl p-6 shadow-sm border border-neutral-200 bento-enter bento-enter-d5">
        <div class="flex items-center justify-between mb-4">
          <h2 class="font-display text-lg font-bold text-neutral-800"><%= t(".matches.title") %></h2>
          <%= link_to saved_pets_path, class: "text-sm font-medium text-primary-500 hover:text-primary-600 transition-colors" do %>
            <%= t(".matches.view_all") %>
            <span aria-hidden="true">→</span>
          <% end %>
        </div>

        <% if @saved_pets.any? %>
          <div class="space-y-5">
            <% @saved_pets.each do |pet| %>
              <% pet_presenter = PetPresenter.new(pet) %>
              <div class="group card-lift rounded-xl p-3 hover:bg-neutral-50"
                   data-controller="image-prefetch"
                   data-image-prefetch-url-value="<%= pet.primary_photo.present? ? pet_presenter.primary_photo_url(variant: :large) : '' %>"
                   data-action="mouseenter->image-prefetch#prefetch mouseleave->image-prefetch#cancel">
                <%= link_to pet_path(pet), class: "block" do %>
                  <div class="relative rounded-xl overflow-hidden bg-neutral-100 aspect-[16/10] mb-3" data-controller="image-loader">
                    <div data-image-loader-target="skeleton" class="absolute inset-0 img-skeleton" aria-hidden="true"></div>
                    <% if pet.primary_photo.present? %>
                      <%= image_tag pet.primary_photo.variant(resize_to_limit: [500, 350], format: :webp, saver: { quality: 80 }), loading: "lazy", decoding: "async", width: 500, height: 350,
                          data: { image_loader_target: "image", action: "load->image-loader#loaded error->image-loader#failed" },
                          class: "relative w-full h-full object-cover group-hover:scale-105 transition duration-500 opacity-0",
                          alt: pet.name %>
                    <% else %>
                      <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-primary-50 to-secondary-50">
                        <span class="font-display text-4xl font-bold text-primary-200"><%= pet.name.first.upcase %></span>
                      </div>
                    <% end %>

                    <%# Saved badge (honest — no fabricated match score) %>
                    <span class="absolute top-2 left-2 px-2 py-1 rounded-lg bg-white/90 backdrop-blur-sm text-xs font-bold text-accent-pink shadow-sm">
                      <span class="inline-flex items-center gap-1">
                        <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                          <path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
                        </svg>
                        <%= t(".matches.saved") %>
                      </span>
                    </span>

                    <%# Saved heart %>
                    <span class="absolute top-2 right-2 w-8 h-8 rounded-full bg-white/90 backdrop-blur-sm flex items-center justify-center shadow-sm" aria-label="<%= t(".matches.saved") %>">
                      <svg class="w-4 h-4 text-accent-pink" fill="currentColor" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
                      </svg>
                    </span>
                  </div>

                  <div class="flex items-start justify-between gap-2">
                    <div>
                      <h3 class="font-semibold text-neutral-800 group-hover:text-primary-600 transition-colors"><%= pet.name %></h3>
                      <p class="text-sm text-neutral-500"><%= pet.breed.presence || pet.species&.humanize %></p>
                    </div>
                    <div class="shrink-0 text-right text-xs text-neutral-400">
                      <div class="flex items-center gap-1">
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                          <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
                        </svg>
                        <%= pet_presenter.age_display %>
                      </div>
                    </div>
                  </div>

                  <div class="mt-3 pt-3 border-t border-neutral-100">
                    <span class="inline-flex items-center gap-1.5 text-xs font-medium text-primary-500 group-hover:text-primary-600 transition-colors">
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                        <polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/>
                      </svg>
                      <%= t(".matches.preview", name: pet.name.split.first) %>
                    </span>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="text-center py-8">
            <div class="w-16 h-16 mx-auto mb-3 rounded-xl bg-orange-light flex items-center justify-center" aria-hidden="true">
              <svg class="w-8 h-8 text-accent-orange" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5.5 10.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Zm13 0a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5ZM12 20a4.5 4.5 0 0 0 4.5-4.5c0-1.6-1.2-3.8-2.7-5.2a2.5 2.5 0 0 0-3.6 0C8.7 11.7 7.5 13.9 7.5 15.5A4.5 4.5 0 0 0 12 20Z"/>
              </svg>
            </div>
            <h3 class="font-display text-base font-bold text-neutral-700 mb-1"><%= t(".matches.empty_title") %></h3>
            <p class="text-sm text-neutral-500 mb-4 max-w-xs mx-auto"><%= t(".matches.empty_description") %></p>
            <%= link_to pets_path,
                class: "inline-flex items-center gap-2 px-5 py-2.5 bg-primary-500 text-white font-semibold text-sm rounded-xl hover:bg-primary-600 transition-all duration-200 active:scale-[0.97]" do %>
              <%= t(".matches.empty_cta") %>
            <% end %>
          </div>
        <% end %>
      </section>

      <% if current_user.individual? && @published_pets.present? %>
        <section class="bg-white rounded-xl p-6 shadow-sm border border-neutral-200 bento-enter bento-enter-d3">
          <div class="flex items-center justify-between mb-4">
            <h2 class="font-display text-lg font-bold text-neutral-800"><%= t(".published_pets") %></h2>
            <%= link_to my_pets_path, class: "text-sm font-medium text-primary-500 hover:text-primary-600 transition-colors" do %>
              <%= t(".view_all_published") %>
              <span aria-hidden="true">→</span>
            <% end %>
          </div>

          <div class="space-y-3">
            <% @published_pets.first(3).each do |pet| %>
              <div class="flex items-center gap-3 p-3 rounded-xl bg-neutral-50">
                <div class="shrink-0 w-10 h-10 rounded-lg overflow-hidden bg-neutral-200">
                  <% if pet.primary_photo.present? %>
                    <%= image_tag pet.primary_photo.variant(resize_to_limit: [40, 40]), class: "w-full h-full object-cover", alt: pet.name, loading: "lazy", decoding: "async", width: 40, height: 40 %>
                  <% else %>
                    <div class="w-full h-full flex items-center justify-center text-neutral-500 text-xs font-bold"><%= pet.name.first.upcase %></div>
                  <% end %>
                </div>
                <div class="flex-1 min-w-0">
                  <p class="text-sm font-semibold text-neutral-800 truncate"><%= pet.name %></p>
                  <p class="text-xs text-neutral-500"><%= pet.species_label %></p>
                </div>
                <%= render "pets/status_badge", status: pet.status %>
              </div>
            <% end %>
          </div>
        </section>
      <% end %>

      <% if current_user.individual? && @pending_requests.present? %>
        <section class="bg-white rounded-xl p-6 shadow-sm border border-neutral-200 bento-enter bento-enter-d3">
          <div class="flex items-center justify-between mb-4">
            <h2 class="font-display text-lg font-bold text-neutral-800"><%= t(".incoming_requests") %></h2>
            <%= link_to my_adoption_requests_path, class: "text-sm font-medium text-primary-500 hover:text-primary-600 transition-colors" do %>
              <%= t(".view_all_requests") %>
              <span aria-hidden="true">→</span>
            <% end %>
          </div>

          <div class="space-y-3">
            <% @pending_requests.first(3).each do |req| %>
              <div class="flex items-center gap-3 p-3 rounded-xl bg-neutral-50">
                <div class="flex-1 min-w-0">
                  <p class="text-sm font-semibold text-neutral-800 truncate"><%= req.adopter.name %></p>
                  <p class="text-xs text-neutral-500"><%= t(".for_pet", pet_name: req.pet.name) %></p>
                </div>
                <span class="px-2 py-0.5 rounded-full text-xs font-medium bg-warning text-white"><%= t(".status_pending") %></span>
              </div>
            <% end %>
          </div>
        </section>
      <% end %>

      <%# Card: My Requests %>
      <section class="bg-white rounded-xl p-6 shadow-sm border border-neutral-200 bento-enter bento-enter-d3">
        <div class="flex items-center justify-between mb-4">
          <h2 class="font-display text-lg font-bold text-neutral-800"><%= t(".requests.title") %></h2>
          <% if @adoption_requests.any? %>
            <%= link_to adoption_requests_path, class: "text-sm font-medium text-primary-500 hover:text-primary-600 transition-colors" do %>
              <%= t(".requests.view_all", count: @total_requests_count) %>
            <% end %>
          <% end %>
        </div>

        <% if @adoption_requests.any? %>
          <div class="space-y-3">
            <% @adoption_requests.each do |req| %>
              <% pet = req.pet %>
              <% status_class, status_label = case req.status
                when "pending"       then ["bg-warning", t(".requests.status_pending")]
                when "in_validation" then ["bg-info",  t(".requests.status_under_review")]
                when "accepted"      then ["bg-secondary-500", t(".requests.status_approved")]
                when "declined"      then ["bg-neutral-400",   t(".requests.status_rejected")]
                else ["bg-neutral-400", t("adoptions.requests.statuses.#{req.status}", default: req.status.humanize)]
                end %>

              <%= link_to adoption_request_path(req), class: "group flex items-center gap-3 p-3 -mx-2 rounded-xl hover:bg-neutral-50 transition-all duration-200 card-lift" do %>
                <div class="shrink-0 w-11 h-11 rounded-xl overflow-hidden bg-neutral-100 flex items-center justify-center shadow-sm relative" data-controller="image-loader">
                  <div data-image-loader-target="skeleton" class="absolute inset-0 rounded-xl img-skeleton" aria-hidden="true"></div>
                  <% if pet&.primary_photo.present? %>
                    <%= image_tag pet.primary_photo.variant(resize_to_limit: [44, 44]),
                        class: "relative w-full h-full object-cover opacity-0 transition-opacity duration-500",
                        loading: "lazy", decoding: "async", width: 44, height: 44,
                        data: { image_loader_target: "image", action: "load->image-loader#loaded error->image-loader#failed" },
                        alt: pet.name %>
                  <% else %>
                    <span class="font-display text-base font-bold text-neutral-400"><%= pet&.name&.first&.upcase || "?" %></span>
                  <% end %>
                </div>
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2">
                    <h3 class="text-sm font-semibold text-neutral-800 truncate group-hover:text-primary-600 transition-colors">
                      <%= pet&.name || t(".requests.unknown_pet") %>
                    </h3>
                    <span class="shrink-0 px-2 py-0.5 rounded-full text-[11px] font-medium text-white <%= status_class %>"><%= status_label %></span>
                  </div>
                  <p class="text-xs text-neutral-400 mt-0.5">
                    <%= t(".requests.submitted", time: distance_of_time_in_words(req.created_at, Time.current)) %>
                  </p>
                </div>
                <svg class="w-4 h-4 text-neutral-300 group-hover:text-primary-400 transition-colors shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="9 18 15 12 9 6"/>
                </svg>
              <% end %>
            <% end %>
          </div>
        <% else %>
          <div class="text-center py-6">
            <div class="w-14 h-14 mx-auto mb-3 rounded-xl bg-primary-50 flex items-center justify-center" aria-hidden="true">
              <svg class="w-7 h-7 text-primary-300" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5.5 10.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Zm13 0a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5ZM12 20a4.5 4.5 0 0 0 4.5-4.5c0-1.6-1.2-3.8-2.7-5.2a2.5 2.5 0 0 0-3.6 0C8.7 11.7 7.5 13.9 7.5 15.5A4.5 4.5 0 0 0 12 20Z"/>
              </svg>
            </div>
            <h3 class="font-display text-base font-bold text-neutral-700 mb-1"><%= t(".requests.empty_title") %></h3>
            <p class="text-sm text-neutral-500 mb-4 max-w-xs mx-auto"><%= t(".requests.empty_description") %></p>
            <%= link_to pets_path,
                class: "inline-flex items-center gap-2 px-5 py-2.5 bg-secondary-500 text-white font-semibold text-sm rounded-xl hover:bg-secondary-600 transition-all duration-200 active:scale-[0.97]" do %>
              <%= t(".requests.empty_cta") %>
            <% end %>
          </div>
        <% end %>
      </section>

      <%# Onboarding Card (appears when profile incomplete) %>
      <% if @show_onboarding %>
        <% missing = current_user_journey.missing_step %>
        <section class="bg-gradient-to-br from-primary-50 to-white rounded-xl p-6 shadow-sm border border-primary-100 bento-enter bento-enter-d4">
          <div class="flex items-start gap-4">
            <div class="shrink-0 w-12 h-12 rounded-xl bg-primary-100 flex items-center justify-center" aria-hidden="true">
              <svg class="w-6 h-6 text-primary-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
              </svg>
            </div>
            <div class="flex-1">
              <h2 class="font-display text-lg font-bold text-neutral-800 mb-1"><%= t(".onboarding.title") %></h2>
              <p class="text-sm text-neutral-500 mb-4"><%= t(".onboarding.missing.#{missing[:key]}") %></p>
              <%= link_to send(missing[:path]),
                  class: "inline-flex items-center gap-2 px-5 py-2.5 bg-primary-500 text-white font-semibold text-sm rounded-xl hover:bg-primary-600 focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 transition-all duration-200 active:scale-[0.97]" do %>
                <%= t(".onboarding.cta.#{missing[:key]}") %>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
                </svg>
              <% end %>
            </div>
          </div>
        </section>
      <% end %>

      <%# Card: Home Prep / AR %>
      <section class="bg-gradient-to-br from-orange-light to-white rounded-xl p-6 shadow-sm border border-orange-200 bento-enter bento-enter-d7">
        <div class="shrink-0 w-12 h-12 rounded-xl bg-accent-orange/10 flex items-center justify-center mb-4" aria-hidden="true">
          <svg class="w-6 h-6 text-accent-orange" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 9.5 12 3l9 6.5V20a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1Z"/>
          </svg>
        </div>
        <h2 class="font-display text-lg font-bold text-neutral-800 mb-2"><%= t(".home_prep.title") %></h2>
        <p class="text-sm text-neutral-600 mb-5"><%= t(".home_prep.description") %></p>
        <button class="flex items-center justify-center gap-2 w-full px-5 py-2.5 bg-accent-orange text-white font-semibold text-sm rounded-xl hover:bg-accent-orange/90 transition-all duration-200 active:scale-[0.97] shadow-sm card-lift" disabled>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="5 3 19 12 5 21 5 3"/>
          </svg>
          <%= t(".home_prep.cta") %>
        </button>
        <p class="text-xs text-neutral-400 mt-2 text-center"><%= t(".home_prep.coming_soon") %></p>
      </section>

    </div>

  </div>

</div>
