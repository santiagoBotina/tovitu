<% subtitle_key = if @show_onboarding
                    ".welcome.subtitle_new"
                  elsif @adoption_requests.any?
                    ".welcome.subtitle_active"
                  else
                    ".welcome.subtitle_ready"
                  end %>

<% tip_key = if @adoption_requests.any?
               ".tip.text_requests"
             elsif !@show_onboarding
               ".tip.text_active"
             else
               ".tip.text"
             end %>

<div class="w-full max-w-2xl mx-auto space-y-6">

  <%# ──────────────────────────────────────────────────────────── %>
  <%# SECTION 1: Welcome Banner                                    %>
  <%# ──────────────────────────────────────────────────────────── %>
  <section class="bg-primary-50 rounded-xl shadow-sm border border-primary-100 p-6 md:p-8">
    <div class="flex items-start gap-4">
      <div class="shrink-0 w-12 h-12 bg-primary-100 rounded-full flex items-center justify-center" aria-hidden="true">
        <svg class="w-6 h-6 text-primary-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5.5 10.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Zm13 0a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5ZM12 20a4.5 4.5 0 0 0 4.5-4.5c0-1.6-1.2-3.8-2.7-5.2a2.5 2.5 0 0 0-3.6 0C8.7 11.7 7.5 13.9 7.5 15.5A4.5 4.5 0 0 0 12 20Z"/>
        </svg>
      </div>
      <div class="flex-1 min-w-0">
        <h1 class="font-display text-2xl md:text-3xl font-bold text-neutral-900 text-balance">
          <%= t(".welcome.title", name: current_user.name) %>
        </h1>
        <p class="text-neutral-500 mt-1.5 text-balance max-w-lg"><%= t(subtitle_key) %></p>
      </div>
    </div>

    <% unless @adoption_requests.any? %>
      <div class="mt-5">
        <%= link_to pets_path,
            class: "inline-flex items-center gap-2 px-5 py-2.5 bg-secondary-500 text-white font-medium rounded-xl hover:bg-secondary-600 focus-visible:ring-2 focus-visible:ring-secondary-500 focus-visible:ring-offset-2 transition-all duration-150 active:scale-[0.97]" do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5.5 10.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Zm13 0a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5ZM12 20a4.5 4.5 0 0 0 4.5-4.5c0-1.6-1.2-3.8-2.7-5.2a2.5 2.5 0 0 0-3.6 0C8.7 11.7 7.5 13.9 7.5 15.5A4.5 4.5 0 0 0 12 20Z"/>
          </svg>
          <%= t(".welcome.cta_browse") %>
        <% end %>
      </div>
    <% end %>
  </section>

  <%# ──────────────────────────────────────────────────────────── %>
  <%# SECTION 2: Onboarding Progress (conditional)                 %>
  <%# ──────────────────────────────────────────────────────────── %>
  <% if @show_onboarding %>
    <% adopter_profile = current_user.adopter_profile %>
    <% onboarding_count = adopter_profile&.respond_to?(:total_questions) ? adopter_profile.total_questions : 8 %>
    <% answered_count   = adopter_profile&.respond_to?(:questions_answered) ? adopter_profile.questions_answered : 0 %>
    <% percent = onboarding_count > 0 ? ((answered_count.to_f / onboarding_count) * 100).to_i : 0 %>
    <% remaining = onboarding_count - answered_count %>

    <section class="bg-white rounded-xl shadow-sm border border-neutral-200 p-6">
      <div class="flex items-center gap-3 mb-4">
        <div class="w-10 h-10 bg-primary-50 rounded-full flex items-center justify-center" aria-hidden="true">
          <svg class="w-5 h-5 text-primary-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
          </svg>
        </div>
        <h2 class="font-display text-lg font-bold text-neutral-800"><%= t(".onboarding.title") %></h2>
      </div>

      <div class="mb-3">
        <div class="flex justify-between items-center mb-2">
          <span class="text-sm text-neutral-500">
            <%= t(".onboarding.questions_remaining_plural", count: remaining) %>
          </span>
          <span class="font-display text-lg font-bold text-primary-500">
            <%= t(".onboarding.progress", percent: percent) %>
          </span>
        </div>
        <div class="w-full bg-neutral-100 rounded-full h-2.5" role="progressbar" aria-valuenow="<%= percent %>" aria-valuemin="0" aria-valuemax="100">
          <div class="bg-primary-500 h-2.5 rounded-full transition-all duration-500" style="width: <%= percent %>%"></div>
        </div>
      </div>

      <p class="text-sm text-neutral-500 mb-4"><%= t(".onboarding.description") %></p>

      <%= link_to profile_onboarding_path,
          class: "inline-flex items-center justify-center w-full sm:w-auto px-5 py-2.5 bg-primary-500 text-white font-medium rounded-xl hover:bg-primary-600 focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 transition-all duration-150 active:scale-[0.97]" do %>
        <%= t(".onboarding.cta") %>
      <% end %>
    </section>
  <% end %>

  <%# ──────────────────────────────────────────────────────────── %>
  <%# SECTION 3: My Requests                                       %>
  <%# ──────────────────────────────────────────────────────────── %>
  <section>
    <div class="flex items-center gap-2 mb-4">
      <div class="w-8 h-8 bg-primary-50 rounded-full flex items-center justify-center" aria-hidden="true">
        <svg class="w-4 h-4 text-primary-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/>
        </svg>
      </div>
      <h2 class="font-display text-lg font-bold text-neutral-800"><%= t(".requests.title") %></h2>
    </div>

    <% if @adoption_requests.any? %>
      <div class="space-y-3">
        <% @adoption_requests.each do |req| %>
          <% pet = req.pet %>
          <% status_class, status_label = case req.status
            when "pending"       then ["bg-amber-500", t(".requests.status_pending")]
            when "in_validation" then ["bg-blue-500",  t(".requests.status_under_review")]
            when "accepted"      then ["bg-secondary-500", t(".requests.status_approved")]
            when "declined"      then ["bg-neutral-400",   t(".requests.status_rejected")]
            else ["bg-neutral-400", t("adoptions.requests.statuses.#{req.status}", default: req.status.humanize)]
            end %>

          <%= link_to adoption_request_path(req), class: "group block bg-white rounded-xl shadow-sm border border-neutral-200 p-4 hover:border-primary-100 hover:shadow-md transition-all duration-200" do %>
            <div class="flex items-center gap-4">
              <div class="shrink-0 w-12 h-12 rounded-full overflow-hidden bg-neutral-100 flex items-center justify-center">
                <% if pet&.primary_photo&.attached? %>
                  <%= image_tag pet.primary_photo.variant(resize_to_limit: [48, 48]),
                      class: "w-full h-full object-cover",
                      alt: pet.name %>
                <% else %>
                  <span class="font-display text-lg font-bold text-neutral-400"><%= pet&.name&.first&.upcase || "?" %></span>
                <% end %>
              </div>

              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 mb-0.5">
                  <h3 class="font-semibold text-neutral-800 truncate group-hover:text-primary-600 transition-colors">
                    <%= pet&.name || "Unknown Pet" %>
                  </h3>
                  <span class="px-2 py-0.5 rounded-full text-xs font-medium text-white <%= status_class %>" aria-label="<%= status_label %>">
                    <%= status_label %>
                  </span>
                </div>
                <p class="text-sm text-neutral-500 truncate">
                  <% if pet&.breed.present? %>
                    <%= pet.breed %>
                  <% end %>
                  <% if pet&.shelter %>
                    <span class="text-neutral-300 mx-1">·</span>
                    <%= pet.shelter.name %>
                  <% end %>
                </p>
                <p class="text-xs text-neutral-400 mt-0.5">
                  <%= t(".requests.submitted", time: distance_of_time_in_words(req.created_at, Time.current)) %>
                </p>
              </div>

              <svg class="w-4 h-4 text-neutral-300 group-hover:text-primary-400 transition-colors shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="9 18 15 12 9 6"/>
              </svg>
            </div>
          <% end %>
        <% end %>
      </div>

      <% if @total_requests_count > 3 %>
        <div class="mt-3 text-center">
          <%= link_to adoption_requests_path, class: "inline-flex items-center gap-1 text-sm font-medium text-primary-500 hover:text-primary-600 transition-colors" do %>
            <%= t(".requests.view_all", count: @total_requests_count) %>
          <% end %>
        </div>
      <% end %>

    <% else %>
      <div class="bg-primary-50/30 rounded-xl border border-dashed border-primary-100 p-8 text-center">
        <div class="w-14 h-14 mx-auto mb-4 bg-primary-50 rounded-full flex items-center justify-center" aria-hidden="true">
          <svg class="w-7 h-7 text-primary-300" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5.5 10.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Zm13 0a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5ZM12 20a4.5 4.5 0 0 0 4.5-4.5c0-1.6-1.2-3.8-2.7-5.2a2.5 2.5 0 0 0-3.6 0C8.7 11.7 7.5 13.9 7.5 15.5A4.5 4.5 0 0 0 12 20Z"/>
          </svg>
        </div>
        <h3 class="font-display text-lg font-bold text-neutral-700 mb-1"><%= t(".requests.empty_title") %></h3>
        <p class="text-sm text-neutral-500 max-w-sm mx-auto mb-5"><%= t(".requests.empty_description") %></p>
        <%= link_to pets_path,
            class: "inline-flex items-center gap-2 px-5 py-2.5 bg-secondary-500 text-white font-medium rounded-xl hover:bg-secondary-600 focus-visible:ring-2 focus-visible:ring-secondary-500 focus-visible:ring-offset-2 transition-all duration-150 active:scale-[0.97]" do %>
          <%= t(".requests.empty_cta") %>
        <% end %>
      </div>
    <% end %>
  </section>

  <%# ──────────────────────────────────────────────────────────── %>
  <%# SECTION 4: Quick Actions                                     %>
  <%# ──────────────────────────────────────────────────────────── %>
  <section>
    <h2 class="font-display text-lg font-bold text-neutral-800 mb-4"><%= t(".actions.title") %></h2>
    <div class="grid grid-cols-2 gap-3 md:grid-cols-4">
      <%= link_to pets_path,
          class: "group p-4 bg-white rounded-xl shadow-sm border border-neutral-200 hover:border-primary-100 hover:shadow-md transition-all duration-200 hover:-translate-y-0.5" do %>
        <div class="w-10 h-10 bg-primary-50 rounded-full flex items-center justify-center mb-3 group-hover:bg-primary-100 transition-colors" aria-hidden="true">
          <svg class="w-5 h-5 text-primary-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5.5 10.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Zm13 0a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5ZM12 20a4.5 4.5 0 0 0 4.5-4.5c0-1.6-1.2-3.8-2.7-5.2a2.5 2.5 0 0 0-3.6 0C8.7 11.7 7.5 13.9 7.5 15.5A4.5 4.5 0 0 0 12 20Z"/>
          </svg>
        </div>
        <h3 class="font-semibold text-sm text-neutral-800 group-hover:text-primary-600 transition-colors"><%= t(".actions.browse.title") %></h3>
        <p class="text-xs text-neutral-500 mt-0.5"><%= t(".actions.browse.description") %></p>
      <% end %>

      <%= link_to edit_profile_path,
          class: "group p-4 bg-white rounded-xl shadow-sm border border-neutral-200 hover:border-primary-100 hover:shadow-md transition-all duration-200 hover:-translate-y-0.5" do %>
        <div class="w-10 h-10 bg-primary-50 rounded-full flex items-center justify-center mb-3 group-hover:bg-primary-100 transition-colors" aria-hidden="true">
          <svg class="w-5 h-5 text-primary-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 4-7 8-7s8 3 8 7"/>
          </svg>
        </div>
        <h3 class="font-semibold text-sm text-neutral-800 group-hover:text-primary-600 transition-colors"><%= t(".actions.profile.title") %></h3>
        <p class="text-xs text-neutral-500 mt-0.5"><%= t(".actions.profile.description") %></p>
      <% end %>

      <%= link_to adoption_requests_path,
          class: "group p-4 bg-white rounded-xl shadow-sm border border-neutral-200 hover:border-primary-100 hover:shadow-md transition-all duration-200 hover:-translate-y-0.5" do %>
        <div class="w-10 h-10 bg-primary-50 rounded-full flex items-center justify-center mb-3 group-hover:bg-primary-100 transition-colors" aria-hidden="true">
          <svg class="w-5 h-5 text-primary-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/>
          </svg>
        </div>
        <h3 class="font-semibold text-sm text-neutral-800 group-hover:text-primary-600 transition-colors"><%= t(".actions.requests.title") %></h3>
        <p class="text-xs text-neutral-500 mt-0.5"><%= t(".actions.requests.description") %></p>
      <% end %>

      <%= link_to "#",
          class: "group p-4 bg-white rounded-xl shadow-sm border border-neutral-200 hover:border-primary-100 hover:shadow-md transition-all duration-200 hover:-translate-y-0.5" do %>
        <div class="w-10 h-10 bg-primary-50 rounded-full flex items-center justify-center mb-3 group-hover:bg-primary-100 transition-colors" aria-hidden="true">
          <svg class="w-5 h-5 text-primary-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
            <path d="M19 14c1.5-2.5 2-5.5 2-8 0-3-2-5-5-5-1.8 0-3.4.9-4.3 2.3C10.4 1.9 8.8 1 7 1 4 1 2 3 2 6c0 2.5.5 5.5 2 8M12 23c-4-3-8-6-8-10a4 4 0 0 1 8 0 4 4 0 0 1 8 0c0 4-4 7-8 10Z"/>
          </svg>
        </div>
        <h3 class="font-semibold text-sm text-neutral-800 group-hover:text-primary-600 transition-colors"><%= t(".actions.learn.title") %></h3>
        <p class="text-xs text-neutral-500 mt-0.5"><%= t(".actions.learn.description") %></p>
      <% end %>
    </div>
  </section>

  <%# ──────────────────────────────────────────────────────────── %>
  <%# SECTION 5: Tip of the Day                                     %>
  <%# ──────────────────────────────────────────────────────────── %>
  <section class="bg-primary-50/40 rounded-xl border border-primary-100 p-5">
    <div class="flex items-start gap-3">
      <div class="shrink-0 w-8 h-8 bg-primary-100 rounded-full flex items-center justify-center mt-0.5" aria-hidden="true">
        <svg class="w-4 h-4 text-primary-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/>
        </svg>
      </div>
      <div>
        <h3 class="font-semibold text-sm text-neutral-800 mb-0.5"><%= t(".tip.title") %></h3>
        <p class="text-sm text-neutral-600"><%= t(tip_key) %></p>
      </div>
    </div>
  </section>

</div>
