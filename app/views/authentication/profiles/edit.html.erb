<%# ─── Profile Settings Page ─── %>
<%# Design: Dashboard-level bento cards with micro-interactions %>
<div class="w-full max-w-2xl mx-auto space-y-5">

  <%# ─── Back link ─── %>
  <div class="bento-enter bento-enter-d1">
    <%= render "shared/back_link", path: root_path, label: t(".back") %>
  </div>

  <%# ─── Page Header ─── %>
  <header class="bento-enter bento-enter-d1">
    <h1 class="font-display text-2xl md:text-3xl font-bold text-neutral-900"><%= t(".title") %></h1>
    <p class="text-neutral-500 mt-1 text-sm"><%= t(".subtitle") %></p>
  </header>

  <%# ─── Onboarding Completion Banner ─── %>
  <% if !current_user.onboarding_completed? %>
    <section class="bg-gradient-to-br from-primary-50 to-white rounded-xl p-6 shadow-sm border border-primary-100 bento-enter bento-enter-d2" aria-label="<%= t(".complete_onboarding") %>">
      <div class="flex items-start gap-4">
        <div class="shrink-0 w-12 h-12 rounded-xl bg-primary-100 flex items-center justify-center" aria-hidden="true">
          <svg class="w-6 h-6 text-primary-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
          </svg>
        </div>
        <div class="flex-1">
          <h2 class="font-display text-lg font-bold text-neutral-800 mb-1"><%= t(".complete_onboarding") %></h2>
          <p class="text-sm text-neutral-500 mb-4"><%= t(".complete_onboarding_desc") %></p>

          <%# Dashboard-style progress bar %>
          <div class="w-full bg-neutral-100 rounded-full h-3 mb-4 overflow-hidden" role="progressbar" aria-valuenow="50" aria-valuemin="0" aria-valuemax="100">
            <div class="progress-shimmer h-full rounded-full transition-all duration-1000 ease-out" style="width: 50%"></div>
          </div>

          <% if current_user.adopter? %>
            <%= link_to profile_onboarding_path,
                class: "inline-flex items-center gap-2 px-5 py-2.5 bg-primary-500 text-white font-semibold text-sm rounded-xl hover:bg-primary-600 focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 transition-all duration-200 active:scale-[0.97]" do %>
              <%= t(".complete_onboarding") %>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
              </svg>
            <% end %>
          <% elsif current_user.shelter_user? %>
            <%= link_to profile_shelter_onboarding_path,
                class: "inline-flex items-center gap-2 px-5 py-2.5 bg-primary-500 text-white font-semibold text-sm rounded-xl hover:bg-primary-600 focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 transition-all duration-200 active:scale-[0.97]" do %>
              <%= t(".complete_onboarding") %>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
              </svg>
            <% end %>
          <% end %>
        </div>
      </div>
    </section>
  <% end %>

  <%# ─── Account Info Card ─── %>
  <section class="bg-white rounded-xl p-6 shadow-sm border border-neutral-200 bento-enter bento-enter-d3">
    <div class="flex items-start justify-between gap-4 mb-6">
      <h2 class="font-display text-lg font-bold text-neutral-800"><%= t(".account_info_title") %></h2>
      <%# Verification status badge lives in the upper-right corner of the card %>
      <div class="shrink-0">
        <% if current_user.verified? %>
          <%= render "shared/verified_badge", label: t(".verified") %>
        <% else %>
          <span role="status"
                aria-label="<%= t(".pending_verification") %>"
                class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold rounded-lg bg-warning/10 text-warning">
            <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <span><%= t(".pending_verification") %></span>
          </span>
        <% end %>
      </div>
    </div>

    <%= form_with model: @user, url: profile_path, method: :patch, class: "space-y-5" do |f| %>
      <%= render "shared/error_messages", resource: @user %>

      <div>
        <%= f.label :name, t(".name_label"), class: "block text-sm font-medium text-neutral-700 mb-1.5" %>
        <%= f.text_field :name, required: true,
              class: "w-full px-4 py-3 border border-neutral-300 rounded-xl shadow-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 text-neutral-800 placeholder-neutral-400 transition" %>
      </div>

      <div>
        <%= f.label :email, t(".email_label"), class: "block text-sm font-medium text-neutral-700 mb-1.5" %>
        <%= f.email_field :email, required: true, autocomplete: "email",
              class: "w-full px-4 py-3 border border-neutral-300 rounded-xl shadow-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 text-neutral-800 placeholder-neutral-400 transition" %>
      </div>

      <%= f.submit t(".submit"),
          class: "w-full bg-primary-500 text-white font-semibold py-3 px-4 rounded-xl hover:bg-primary-600 focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 transition-all duration-200 active:scale-[0.97] cursor-pointer shadow-sm" %>
    <% end %>
  </section>

  <%# ─── Preferences Card ─── %>
  <% if current_user.onboarding_completed? %>
    <div class="bg-white rounded-xl p-6 shadow-sm border border-neutral-200 bento-enter bento-enter-d4 card-lift">
      <div class="flex items-start justify-between">
        <div>
          <h2 class="font-display text-lg font-bold text-neutral-800"><%= t(".edit_preferences_title") %></h2>
          <p class="text-neutral-500 text-sm mt-1"><%= t(".edit_preferences_desc") %></p>
        </div>
        <div class="shrink-0">
          <% if current_user.adopter? %>
            <%= link_to profile_onboarding_path(from_profile: true),
                class: "inline-flex items-center gap-2 px-5 py-2.5 bg-white border-2 border-primary-200 text-primary-700 font-semibold text-sm rounded-xl hover:bg-primary-50 hover:border-primary-300 focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 transition-all duration-200 active:scale-[0.97]" do %>
              <%= t(".edit_preferences") %>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
              </svg>
            <% end %>
          <% elsif current_user.shelter_user? %>
            <%= link_to profile_shelter_onboarding_path(from_profile: true),
                class: "inline-flex items-center gap-2 px-5 py-2.5 bg-white border-2 border-primary-200 text-primary-700 font-semibold text-sm rounded-xl hover:bg-primary-50 hover:border-primary-300 focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 transition-all duration-200 active:scale-[0.97]" do %>
              <%= t(".edit_preferences") %>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
              </svg>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <%# ─── Language Preference Card ─── %>
  <section class="bg-white rounded-xl p-6 shadow-sm border border-neutral-200 bento-enter bento-enter-d5">
    <h2 class="font-display text-lg font-bold text-neutral-800 mb-2"><%= t(".language_title") %></h2>
    <p class="text-neutral-500 text-sm mb-4"><%= t(".language_desc") %></p>

    <% current_locale = @user.locale.presence || I18n.locale.to_s %>

    <%# Custom language selector: auto-saves the locale on selection.
        The native <select> is kept in the DOM as the no-JS fallback; once the
        Stimulus controller connects it is hidden in favor of the custom control. %>
    <%= form_with model: @user, url: profile_path, method: :patch, class: "space-y-4",
                  data: { controller: "language-select" } do |f| %>

      <%= f.label :locale, t(".language_label"),
            id: "language-select-label",
            class: "block text-sm font-medium text-neutral-700 mb-1.5" %>

      <%# Native fallback (hidden after JS upgrade) %>
      <%= f.select :locale,
          options_for_select([[t("shared.language_selector.option_english"), "en"], [t("shared.language_selector.option_spanish"), "es"]], current_locale),
          {},
          data: { language_select_target: "native" },
          class: "w-full px-4 py-3 border border-neutral-300 rounded-xl shadow-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 text-neutral-800 transition bg-white" %>

      <%# Custom control (revealed after JS upgrade) %>
      <div class="hidden" data-language-select-target="control">
        <div class="relative">
          <button type="button"
                  role="combobox"
                  data-language-select-target="trigger"
                  data-action="language-select#toggle language-select#onKeydown"
                  aria-haspopup="listbox"
                  aria-expanded="false"
                  aria-controls="language-select-listbox"
                  aria-labelledby="language-select-label"
                  class="w-full flex items-center justify-between gap-3 px-4 py-3 border border-neutral-300 rounded-xl shadow-sm bg-white text-neutral-800 font-medium hover:border-neutral-400 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 transition cursor-pointer">
            <span data-language-select-target="triggerLabel"><%= current_locale == "es" ? t("shared.language_selector.option_spanish") : t("shared.language_selector.option_english") %></span>
            <svg class="w-4 h-4 text-neutral-400 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5"/>
            </svg>
          </button>

          <ul id="language-select-listbox"
              data-language-select-target="menu"
              role="listbox"
              aria-labelledby="language-select-label"
              class="hidden absolute z-dropdown mt-2 w-full bg-white border border-neutral-200 rounded-xl shadow-md py-1.5 overflow-hidden">
            <li id="language-option-en"
                data-language-select-target="option"
                data-value="en"
                role="option"
                aria-selected="<%= current_locale == "en" %>"
                data-action="language-select#select"
                class="flex items-center justify-between px-4 py-2.5 text-sm font-medium text-neutral-700 hover:bg-primary-50 cursor-pointer <%= current_locale == "en" ? "bg-primary-500 text-white" : "" %>">
              <span><%= t("shared.language_selector.option_english") %></span>
              <svg data-language-select-target="check" class="w-4 h-4 shrink-0 <%= current_locale == "en" ? "" : "hidden" %>" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"/>
              </svg>
            </li>
            <li id="language-option-es"
                data-language-select-target="option"
                data-value="es"
                role="option"
                aria-selected="<%= current_locale == "es" %>"
                data-action="language-select#select"
                class="flex items-center justify-between px-4 py-2.5 text-sm font-medium text-neutral-700 hover:bg-primary-50 cursor-pointer <%= current_locale == "es" ? "bg-primary-500 text-white" : "" %>">
              <span><%= t("shared.language_selector.option_spanish") %></span>
              <svg data-language-select-target="check" class="w-4 h-4 shrink-0 <%= current_locale == "es" ? "" : "hidden" %>" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"/>
              </svg>
            </li>
          </ul>
        </div>
      </div>

      <%# Save button is the no-JS fallback; with JS, selecting a language auto-saves %>
      <div data-language-select-target="submit">
        <%= f.submit t(".language_save"),
            class: "w-full bg-primary-500 text-white font-semibold py-3 px-4 rounded-xl hover:bg-primary-600 focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 transition-all duration-200 active:scale-[0.97] cursor-pointer shadow-sm" %>
      </div>
    <% end %>
  </section>

  <%# ─── Shelter Information Card (shelter admins only) ─── %>
  <% if current_user.shelter_user? && current_user.shelter_id.present? && current_user.shelter.present? && policy(current_user.shelter).manage? %>
    <div class="bg-white rounded-xl p-6 shadow-sm border border-neutral-200 bento-enter bento-enter-d6 card-lift">
      <div class="flex items-start justify-between">
        <div>
          <h2 class="font-display text-lg font-bold text-neutral-800"><%= t(".shelter_info_title") %></h2>
          <p class="text-neutral-500 text-sm mt-1"><%= t(".shelter_info_desc") %></p>
        </div>
        <div class="shrink-0">
          <%= link_to edit_shelter_path(id: current_user.shelter_id),
              class: "inline-flex items-center gap-2 px-5 py-2.5 bg-white border-2 border-primary-200 text-primary-700 font-semibold text-sm rounded-xl hover:bg-primary-50 hover:border-primary-300 focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 transition-all duration-200 active:scale-[0.97]" do %>
            <%= t(".edit_shelter_info") %>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
            </svg>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
</div>
