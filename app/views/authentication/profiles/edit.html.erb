<div class="w-full max-w-md mx-auto space-y-6">
  <%# --- Account Info Card --- %>
  <div class="bg-white rounded-xl shadow-md p-8">
    <h1 class="font-display text-4xl font-bold text-center text-neutral-900 mb-8"><%= t(".title") %></h1>

    <% if !current_user.onboarding_completed? %>
      <div class="mb-8 p-4 bg-primary-50 border border-primary-200 rounded-xl">
        <p class="text-sm font-medium text-primary-700 mb-1"><%= t(".complete_onboarding") %></p>
        <p class="text-xs text-primary-500 mb-3"><%= t(".complete_onboarding_desc") %></p>
        <% if current_user.adopter? %>
          <%= link_to t(".complete_onboarding"), profile_onboarding_path,
              class: "inline-flex items-center px-4 py-2 text-sm font-semibold text-white bg-primary-500 hover:bg-primary-600 active:bg-primary-700 rounded-xl transition shadow-sm" %>
        <% elsif current_user.shelter_user? %>
          <%= link_to t(".complete_onboarding"), profile_shelter_onboarding_path,
              class: "inline-flex items-center px-4 py-2 text-sm font-semibold text-white bg-primary-500 hover:bg-primary-600 active:bg-primary-700 rounded-xl transition shadow-sm" %>
        <% end %>
      </div>
    <% end %>

    <%= form_with model: @user, url: profile_path, method: :patch, class: "space-y-6" do |f| %>
      <%= render "shared/error_messages", resource: @user %>

      <div>
        <%= f.label :name, t(".name_label"), class: "block text-sm font-medium text-neutral-700 mb-1" %>
        <%= f.text_field :name, required: true,
              class: "w-full px-4 py-3 border border-neutral-300 rounded-xl shadow-sm focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500 text-neutral-800 placeholder-neutral-400 transition" %>
      </div>

      <div>
        <%= f.label :email, t(".email_label"), class: "block text-sm font-medium text-neutral-700 mb-1" %>
        <%= f.email_field :email, required: true, autocomplete: "email",
              class: "w-full px-4 py-3 border border-neutral-300 rounded-xl shadow-sm focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500 text-neutral-800 placeholder-neutral-400 transition" %>
        <% if current_user.verified? %>
          <span class="inline-flex items-center gap-1 px-2.5 py-1 mt-2 text-xs font-semibold rounded-full bg-success/10 text-success">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/>
            </svg>
            <%= t(".verified") %>
          </span>
        <% else %>
          <span class="inline-flex items-center gap-1 px-2.5 py-1 mt-1.5 text-xs font-semibold rounded-full bg-warning/10 text-warning">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <%= t(".pending_verification") %>
          </span>
        <% end %>
      </div>

      <%= f.submit t(".submit"), class: "w-full bg-primary-500 text-white font-semibold py-3 px-4 rounded-xl hover:bg-primary-600 active:bg-primary-700 transition cursor-pointer shadow-sm" %>
    <% end %>
  </div>

  <%# --- Preferences Card (always visible when onboarding completed) --- %>
  <% if current_user.onboarding_completed? %>
    <div class="bg-white rounded-xl shadow-md p-8">
      <h2 class="font-display text-2xl font-bold text-neutral-900 mb-2"><%= t(".edit_preferences_title") %></h2>
      <p class="text-neutral-500 text-sm mb-4"><%= t(".edit_preferences_desc") %></p>
      <% if current_user.adopter? %>
        <%= link_to t(".edit_preferences"), profile_onboarding_path(from_profile: true),
            class: "inline-flex items-center px-4 py-2 text-sm font-semibold text-primary-700 bg-primary-50 hover:bg-primary-100 active:bg-primary-200 rounded-xl transition shadow-sm" %>
      <% elsif current_user.shelter_user? %>
        <%= link_to t(".edit_preferences"), profile_shelter_onboarding_path(from_profile: true),
            class: "inline-flex items-center px-4 py-2 text-sm font-semibold text-primary-700 bg-primary-50 hover:bg-primary-100 active:bg-primary-200 rounded-xl transition shadow-sm" %>
      <% end %>
    </div>
  <% end %>

  <%# --- Language Preference Card --- %>
  <div class="bg-white rounded-xl shadow-md p-8">
    <h2 class="font-display text-2xl font-bold text-neutral-900 mb-2"><%= t(".language_title") %></h2>
    <p class="text-neutral-500 text-sm mb-4"><%= t(".language_desc") %></p>

    <%= form_with model: @user, url: profile_path, method: :patch, class: "space-y-4" do |f| %>
      <div>
        <%= f.label :locale, t(".language_label"), class: "block text-sm font-medium text-neutral-700 mb-1" %>
        <%= f.select :locale,
            options_for_select([["English", "en"], ["Español", "es"]], @user.locale.presence || I18n.locale),
            {}, class: "w-full px-4 py-3 border border-neutral-300 rounded-xl shadow-sm focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500 text-neutral-800 transition" %>
      </div>
      <%= f.submit t(".language_save"),
          class: "w-full bg-primary-500 text-white font-semibold py-3 px-4 rounded-xl hover:bg-primary-600 active:bg-primary-700 transition cursor-pointer shadow-sm" %>
    <% end %>
  </div>

  <%# --- Shelter Information Card (shelter users only) --- %>
  <% if current_user.shelter_user? && current_user.shelter_id.present? %>
    <div class="bg-white rounded-xl shadow-md p-8">
      <h2 class="font-display text-2xl font-bold text-neutral-900 mb-2"><%= t(".shelter_info_title") %></h2>
      <p class="text-neutral-500 text-sm mb-4"><%= t(".shelter_info_desc") %></p>
      <%= link_to t(".edit_shelter_info"), edit_shelter_path(id: current_user.shelter_id),
          class: "inline-flex items-center px-4 py-2 text-sm font-semibold text-primary-700 bg-primary-50 hover:bg-primary-100 active:bg-primary-200 rounded-xl transition shadow-sm" %>
    </div>
  <% end %>

  <%# --- Back link --- %>
  <div class="text-center">
    <%= link_to t(".back"), root_path, class: "text-sm text-neutral-500 hover:text-neutral-700 transition" %>
  </div>
</div>
