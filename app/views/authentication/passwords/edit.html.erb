<div class="w-full max-w-md mx-auto">
  <div class="bg-white rounded-xl shadow-md p-8">
    <h1 class="font-display text-4xl font-bold text-center text-neutral-900 mb-2"><%= t(".title") %></h1>
    <p class="text-neutral-500 text-center mb-8"><%= t(".subtitle") %></p>

    <%= form_with url: password_reset_path(params[:id]), method: :patch, local: true, class: "space-y-6" do |f| %>
      <div>
        <%= f.label :password, t(".password_label"), name: "user[password]", class: "block text-sm font-medium text-neutral-700 mb-1" %>
        <%= f.password_field :password, name: "user[password]", required: true, autocomplete: "new-password",
              class: "w-full px-4 py-3 border border-neutral-300 rounded-xl shadow-sm focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500 text-neutral-800 placeholder-neutral-400 transition" %>
        <p class="text-xs text-neutral-500 mt-1"><%= t(".password_hint") %></p>
      </div>

      <div>
        <%= f.label :password_confirmation, t(".confirm_label"), name: "user[password_confirmation]", class: "block text-sm font-medium text-neutral-700 mb-1" %>
        <%= f.password_field :password_confirmation, name: "user[password_confirmation]", required: true, autocomplete: "new-password",
              class: "w-full px-4 py-3 border border-neutral-300 rounded-xl shadow-sm focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500 text-neutral-800 placeholder-neutral-400 transition" %>
      </div>

      <%= f.submit t(".submit"), class: "w-full bg-primary-500 text-white font-semibold py-3 px-4 rounded-xl hover:bg-primary-600 active:bg-primary-700 transition cursor-pointer shadow-sm" %>
    <% end %>
  </div>
</div>
