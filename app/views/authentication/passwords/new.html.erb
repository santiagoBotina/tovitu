<div class="w-full max-w-md mx-auto">
  <div class="bg-white rounded-xl shadow-md p-8">
    <h1 class="font-display text-4xl font-bold text-center text-neutral-900 mb-2">Forgot your password?</h1>
    <p class="text-neutral-500 text-center mb-8">Enter your email and we'll send you a reset link</p>

    <%= form_with url: password_resets_path, scope: :password_reset, class: "space-y-6" do |f| %>
      <div>
        <%= f.label :email, "Email address", class: "block text-sm font-medium text-neutral-700 mb-1" %>
        <%= f.email_field :email, required: true, autocomplete: "email",
              class: "w-full px-4 py-3 border border-neutral-300 rounded-xl shadow-sm focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500 text-neutral-800 placeholder-neutral-400 transition" %>
      </div>

      <%= f.submit "Send reset link", class: "w-full bg-primary-500 text-white font-semibold py-3 px-4 rounded-xl hover:bg-primary-600 active:bg-primary-700 transition cursor-pointer shadow-sm" %>
    <% end %>
  </div>

  <p class="text-center text-sm text-neutral-500 mt-8">
    Remember your password?
    <%= link_to "Log in", new_session_path, class: "text-primary-600 hover:text-primary-800 font-medium transition" %>
  </p>
</div>
