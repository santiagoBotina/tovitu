<%
  # The UI toggle speaks display roles ("individual" | "shelter") while the
  # registration API accepts real roles ("individual" | "shelter_admin").
  # Map the real role from the URL to the display role for the initial UI state.
  display_role = case @role
                 when "shelter_admin", "shelter_staff" then "shelter"
                 else "individual"
                 end
  # Role-scoped palette: purple (primary) for individual, teal (secondary) for
  # shelter. The role-toggle Stimulus controller swaps these on toggle.
  input_accent = display_role == "shelter" ? "focus:ring-secondary-500 focus:border-secondary-500" : "focus:ring-primary-500 focus:border-primary-500"
  submit_accent = display_role == "shelter" ? "bg-secondary-500 hover:bg-secondary-600 active:bg-secondary-700" : "bg-primary-500 hover:bg-primary-600 active:bg-primary-700"
%>
<div class="w-full max-w-md mx-auto"
     data-controller="role-toggle"
     data-role-toggle-role="<%= display_role %>"
     data-role-toggle-submit-role="shelter_admin">

  <div class="bg-white rounded-xl shadow-md p-8">
    <%# Brand lockup: official Tovitu logo + wordmark %>
    <%= render "shared/auth_brand" %>

    <div class="mb-8">
      <%= render "authentication/role_toggle", current_role: display_role %>
    </div>

    <h1 class="font-display text-3xl font-bold text-center text-neutral-900 mb-1">
      <span data-role-toggle-target="toggleable"
            data-role="individual"
            class="<%= display_role == 'individual' ? '' : 'hidden' %>">
        <%= t(".title_individual") %>
      </span>
      <span data-role-toggle-target="toggleable"
            data-role="shelter"
            class="<%= display_role == 'shelter' ? '' : 'hidden' %>">
        <%= t(".title_shelter") %>
      </span>
    </h1>

    <p class="text-neutral-500 text-center mb-8">
      <span data-role-toggle-target="toggleable"
            data-role="individual"
            class="<%= display_role == 'individual' ? '' : 'hidden' %>">
        <%= t(".subtitle_individual") %>
      </span>
      <span data-role-toggle-target="toggleable"
            data-role="shelter"
            class="<%= display_role == 'shelter' ? '' : 'hidden' %>">
        <%= t(".subtitle_shelter") %>
      </span>
    </p>

    <%= form_with model: @user, url: registration_path, class: "space-y-5" do |f| %>
      <%= f.hidden_field :role,
            value: @role,
            data: { role_toggle_role_field: true } %>
      <%= render "shared/error_messages", resource: @user %>

      <div>
        <%= f.label :name, t(".name_label"), class: "block text-sm font-medium text-neutral-700 mb-1.5" %>
        <%= f.text_field :name, required: true,
              class: "w-full px-4 py-3 border border-neutral-300 rounded-xl shadow-sm focus:outline-none focus:ring-2 #{input_accent} text-neutral-800 placeholder-neutral-400 transition",
              data: { role_toggle_target: "accent",
                      role_toggle_accent_primary: "focus:ring-primary-500 focus:border-primary-500",
                      role_toggle_accent_secondary: "focus:ring-secondary-500 focus:border-secondary-500" } %>
      </div>

      <div>
        <%= f.label :email, t(".email_label"), class: "block text-sm font-medium text-neutral-700 mb-1.5" %>
        <%= f.email_field :email, required: true, autocomplete: "email",
              class: "w-full px-4 py-3 border border-neutral-300 rounded-xl shadow-sm focus:outline-none focus:ring-2 #{input_accent} text-neutral-800 placeholder-neutral-400 transition",
              data: { role_toggle_target: "accent",
                      role_toggle_accent_primary: "focus:ring-primary-500 focus:border-primary-500",
                      role_toggle_accent_secondary: "focus:ring-secondary-500 focus:border-secondary-500" } %>
      </div>

      <div>
        <%= f.label :password, t(".password_label"), class: "block text-sm font-medium text-neutral-700 mb-1.5" %>
        <%= f.password_field :password, required: true, autocomplete: "new-password",
              class: "w-full px-4 py-3 border border-neutral-300 rounded-xl shadow-sm focus:outline-none focus:ring-2 #{input_accent} text-neutral-800 placeholder-neutral-400 transition",
              data: { role_toggle_target: "accent",
                      role_toggle_accent_primary: "focus:ring-primary-500 focus:border-primary-500",
                      role_toggle_accent_secondary: "focus:ring-secondary-500 focus:border-secondary-500" } %>
        <p class="text-xs text-neutral-500 mt-1"><%= t(".password_hint") %></p>
      </div>

      <div>
        <%= f.label :password_confirmation, t(".confirm_label"), class: "block text-sm font-medium text-neutral-700 mb-1.5" %>
        <%= f.password_field :password_confirmation, required: true, autocomplete: "new-password",
              class: "w-full px-4 py-3 border border-neutral-300 rounded-xl shadow-sm focus:outline-none focus:ring-2 #{input_accent} text-neutral-800 placeholder-neutral-400 transition",
              data: { role_toggle_target: "accent",
                      role_toggle_accent_primary: "focus:ring-primary-500 focus:border-primary-500",
                      role_toggle_accent_secondary: "focus:ring-secondary-500 focus:border-secondary-500" } %>
      </div>

      <%= f.submit t(".submit"),
            class: "w-full #{submit_accent} text-white font-semibold py-3 px-4 rounded-xl active:scale-[0.98] transition cursor-pointer shadow-sm",
            data: { role_toggle_target: "accent",
                    role_toggle_accent_primary: "bg-primary-500 hover:bg-primary-600 active:bg-primary-700",
                    role_toggle_accent_secondary: "bg-secondary-500 hover:bg-secondary-600 active:bg-secondary-700" } %>
    <% end %>
  </div>

  <p class="text-center text-sm text-neutral-500 mt-8">
    <%= t(".login_prompt") %>
    <%= link_to t(".login_link"), new_session_path, class: "text-primary-600 hover:text-primary-800 font-medium transition" %>
  </p>
</div>
