<%= render "shared/auth_shell" do %>
  <div class="bg-white rounded-xl shadow-md p-8 text-center">
    <%= render "shared/auth_brand" %>
    <h1 class="font-display text-3xl font-bold text-neutral-900 mb-2"><%= t("authentication.verifications.expired.title") %></h1>
    <p class="text-neutral-600 mb-6">
      <%= t("authentication.verifications.expired.body") %>
    </p>
    <%= link_to t("authentication.verifications.expired.resend"), new_session_path, class: "inline-block bg-primary-500 text-white font-semibold py-3 px-6 rounded-xl hover:bg-primary-600 active:bg-primary-700 transition shadow-sm" %>
    <p class="text-sm text-neutral-600 mt-4">
      <%= link_to t("authentication.verifications.expired.back"), new_session_path, class: "text-primary-600 hover:text-primary-800 font-medium transition" %>
    </p>
  </div>
<% end %>
