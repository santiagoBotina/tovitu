<div class="w-full max-w-md mx-auto">
  <div class="bg-white rounded-xl shadow-md p-8 text-center">
    <div class="w-16 h-16 bg-warning/10 rounded-full flex items-center justify-center mx-auto mb-4">
      <svg class="w-8 h-8 text-warning" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
      </svg>
    </div>
    <h1 class="font-display text-3xl font-bold text-neutral-900 mb-2">Link expired</h1>
    <p class="text-neutral-600 mb-6">
      This verification link has expired. Verification links are valid for 24 hours.
    </p>
    <%= link_to "Resend verification email", new_session_path, class: "inline-block bg-primary-500 text-white font-semibold py-3 px-6 rounded-xl hover:bg-primary-600 active:bg-primary-700 transition shadow-sm" %>
    <p class="text-sm text-neutral-500 mt-4">
      <%= link_to "Back to login", new_session_path, class: "text-primary-600 hover:text-primary-800 font-medium transition" %>
    </p>
  </div>
</div>
