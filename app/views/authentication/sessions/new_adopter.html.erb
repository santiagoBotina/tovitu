<div class="w-full max-w-md mx-auto">
  <div class="bg-white rounded-xl shadow-md p-8">
    <div class="text-center mb-8">
      <div class="w-14 h-14 bg-primary-50 rounded-2xl flex items-center justify-center mx-auto mb-4">
        <svg class="w-7 h-7 text-primary-500" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
        </svg>
      </div>
      <h1 class="font-display text-3xl font-bold text-neutral-900 mb-1"><%= t(".title") %></h1>
      <p class="text-neutral-500"><%= t(".subtitle") %></p>
    </div>

    <%= form_with url: session_path, scope: :session, class: "space-y-5" do |f| %>
      <%= f.hidden_field :role, value: "adopter" %>

      <div>
        <%= f.label :email, t(".email_label"), class: "block text-sm font-medium text-neutral-700 mb-1.5" %>
        <%= f.email_field :email, required: true, autocomplete: "email",
              class: "w-full px-4 py-3 border border-neutral-300 rounded-xl shadow-sm focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500 text-neutral-800 placeholder-neutral-400 transition" %>
      </div>

      <div>
        <%= f.label :password, t(".password_label"), class: "block text-sm font-medium text-neutral-700 mb-1.5" %>
        <%= f.password_field :password, required: true, autocomplete: "current-password",
              class: "w-full px-4 py-3 border border-neutral-300 rounded-xl shadow-sm focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500 text-neutral-800 placeholder-neutral-400 transition" %>
      </div>

      <div class="flex items-center justify-end">
        <%= link_to t(".forgot_password"), new_password_reset_path, class: "text-sm text-primary-600 hover:text-primary-800 font-medium transition" %>
      </div>

      <%= f.submit t(".submit"), class: "w-full bg-primary-500 text-white font-semibold py-3 px-4 rounded-xl hover:bg-primary-600 active:bg-primary-700 transition cursor-pointer shadow-sm" %>
    <% end %>
  </div>

  <p class="text-center text-sm text-neutral-500 mt-8">
    <%= t(".signup_prompt") %>
    <%= link_to t(".signup_link"), new_registration_path(role: "adopter"), class: "text-primary-600 hover:text-primary-800 font-medium transition" %>
  </p>
</div>
