<div class="w-full max-w-md mx-auto"
     data-controller="role-toggle"
     data-role-toggle-role="<%= @role %>">

  <div class="relative">
    <%# Subtle repeating Tovitu paw pattern behind the card (decorative only) %>
    <div class="login-paw-pattern absolute -inset-3 rounded-3xl pointer-events-none select-none"
         aria-hidden="true"></div>

    <div class="relative bg-white rounded-xl shadow-md p-8">
      <%# Brand lockup: official Tovitu logo + wordmark %>
      <%= render "shared/auth_brand" %>

      <div class="mb-8">
        <%= render "authentication/role_toggle", current_role: @role %>
      </div>

      <div data-role-toggle-target="toggleable"
           data-role="individual"
           class="<%= @role == 'individual' || @role == 'adopter' ? '' : 'hidden' %>">
        <%= render "authentication/sessions/individual_form" %>
      </div>

      <div data-role-toggle-target="toggleable"
           data-role="shelter"
           class="<%= @role == 'shelter' ? '' : 'hidden' %>">
        <%= render "authentication/sessions/shelter_form" %>
      </div>
    </div>
  </div>

  <p data-role-toggle-target="toggleable"
     data-role="individual"
     class="text-center text-sm text-neutral-500 mt-8 <%= @role == 'individual' || @role == 'adopter' ? '' : 'hidden' %>">
    <%= t("authentication.sessions.new_individual.signup_prompt") %>
    <%= link_to t("authentication.sessions.new_individual.signup_link"),
                new_registration_path(role: "individual"),
                class: "text-primary-600 hover:text-primary-800 font-medium transition" %>
  </p>

  <p data-role-toggle-target="toggleable"
     data-role="shelter"
     class="text-center text-sm text-neutral-500 mt-8 <%= @role == 'shelter' ? '' : 'hidden' %>">
    <%= t("authentication.sessions.new_shelter.signup_prompt") %>
    <%= link_to t("authentication.sessions.new_shelter.signup_link"),
                new_registration_path(role: "shelter_admin"),
                class: "text-secondary-600 hover:text-secondary-700 font-medium transition" %>
  </p>
</div>
