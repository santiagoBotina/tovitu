<%= render "shared/auth_shell" do %>
  <div data-controller="role-toggle"
       data-role-toggle-role="<%= @role %>">

    <div class="bg-white rounded-xl shadow-md p-8">
      <%# Brand lockup: official Tovitu logo + wordmark %>
      <%= render "shared/auth_brand" %>

      <%# Friendly reason when a signed-out visitor was sent here mid-flow
          (e.g. tapping "Solicitar adopción" on a pet profile). %>
      <% if (intent_pet = auth_intent_pet) %>
        <div class="mb-6 rounded-xl bg-primary-50 border border-primary-100 p-4 flex items-start gap-3" role="status">
          <div class="w-9 h-9 rounded-lg bg-primary-100 flex items-center justify-center shrink-0" aria-hidden="true">
            <svg class="w-5 h-5 text-primary-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z"/>
            </svg>
          </div>
          <div>
            <p class="text-sm font-semibold text-primary-800"><%= t("authentication.sessions.new.apply_intent_title") %></p>
            <p class="text-sm text-primary-700"><%= t("authentication.sessions.new.apply_intent_body", pet_name: intent_pet.name) %></p>
          </div>
        </div>
      <% end %>

      <div class="mb-8">
        <%= render "authentication/role_toggle", current_role: @role %>
      </div>

      <div data-role-toggle-target="toggleable"
           data-role="individual"
           class="<%= @role == 'individual' || @role == 'adopter' ? '' : 'hidden' %>">
        <%= render "authentication/sessions/individual_form" %>
      </div>

      <div data-role-toggle-target="toggleable"
           data-role="shelter"
           class="<%= @role == 'shelter' ? '' : 'hidden' %>">
        <%= render "authentication/sessions/shelter_form" %>
      </div>
    </div>

    <p data-role-toggle-target="toggleable"
       data-role="individual"
       class="text-center text-sm text-neutral-600 mt-8 <%= @role == 'individual' || @role == 'adopter' ? '' : 'hidden' %>">
      <%= t("authentication.sessions.new_individual.signup_prompt") %>
      <%= link_to t("authentication.sessions.new_individual.signup_link"),
                  new_registration_path(role: "individual"),
                  class: "text-primary-600 hover:text-primary-800 font-medium transition" %>
    </p>

    <p data-role-toggle-target="toggleable"
       data-role="shelter"
       class="text-center text-sm text-neutral-600 mt-8 <%= @role == 'shelter' ? '' : 'hidden' %>">
      <%= t("authentication.sessions.new_shelter.signup_prompt") %>
      <%= link_to t("authentication.sessions.new_shelter.signup_link"),
                  new_registration_path(role: "shelter_admin"),
                  class: "text-secondary-600 hover:text-secondary-700 font-medium transition" %>
    </p>
  </div>
<% end %>