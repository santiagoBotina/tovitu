<div class="w-full max-w-md mx-auto text-center">
  <div class="bg-white rounded-xl shadow-md p-8">
    <h1 class="font-display text-3xl font-bold text-neutral-900 mb-2"><%= t(".title") %></h1>
    <p class="text-neutral-500 mb-8"><%= t(".subtitle") %></p>

    <div class="space-y-4">
      <%= link_to login_adopter_path, class: "block w-full py-4 px-6 bg-primary-50 text-primary-700 font-semibold rounded-xl hover:bg-primary-100 border-2 border-primary-200 hover:border-primary-400 transition-all" do %>
        <span class="text-lg"><%= t("landing.index.adopter_title") %></span>
      <% end %>
      <%= link_to login_shelter_path, class: "block w-full py-4 px-6 bg-neutral-50 text-neutral-700 font-semibold rounded-xl hover:bg-neutral-100 border-2 border-neutral-200 hover:border-neutral-400 transition-all" do %>
        <span class="text-lg"><%= t("landing.index.shelter_title") %></span>
      <% end %>
    </div>
  </div>
</div>
