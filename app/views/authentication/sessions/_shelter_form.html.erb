<div class="text-center mb-8">
  <div class="w-14 h-14 rounded-2xl flex items-center justify-center mx-auto mb-4" style="background-color: #ECFDF5;">
    <svg class="w-7 h-7 text-secondary-500" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 21h16.5M4.5 3h15M5.25 3v18m13.5-18v18M9 6.75h1.5m-1.5 3h1.5m-1.5 3h1.5m3-6H15m-1.5 3H15m-1.5 3H15M9 21v-3.375c0-.621.504-1.125 1.125-1.125h3.75c.621 0 1.125.504 1.125 1.125V21" />
    </svg>
  </div>
  <h1 class="font-display text-3xl font-bold text-neutral-900 mb-1"><%= t("authentication.sessions.new_shelter.title") %></h1>
  <p class="text-neutral-500"><%= t("authentication.sessions.new_shelter.subtitle") %></p>
</div>

<%= form_with url: session_path, scope: :session, class: "space-y-5" do |f| %>
  <%= f.hidden_field :role, value: "shelter" %>

  <div>
    <%= f.label :email, t("authentication.sessions.new_shelter.email_label"), class: "block text-sm font-medium text-neutral-700 mb-1.5" %>
    <%= f.email_field :email, required: true, autocomplete: "email",
          class: "w-full px-4 py-3 border border-neutral-300 rounded-xl shadow-sm focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500 text-neutral-800 placeholder-neutral-400 transition" %>
  </div>

  <div>
    <%= f.label :password, t("authentication.sessions.new_shelter.password_label"), class: "block text-sm font-medium text-neutral-700 mb-1.5" %>
    <%= f.password_field :password, required: true, autocomplete: "current-password",
          class: "w-full px-4 py-3 border border-neutral-300 rounded-xl shadow-sm focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500 text-neutral-800 placeholder-neutral-400 transition" %>
  </div>

  <div class="flex items-center justify-end">
    <%= link_to t("authentication.sessions.new_shelter.forgot_password"), new_password_reset_path, class: "text-sm text-primary-600 hover:text-primary-800 font-medium transition" %>
  </div>

  <%= f.submit t("authentication.sessions.new_shelter.submit"), class: "w-full bg-secondary-500 text-white font-semibold py-3 px-4 rounded-xl hover:bg-secondary-600 active:bg-secondary-700 active:scale-[0.98] transition cursor-pointer shadow-sm" %>
<% end %>
