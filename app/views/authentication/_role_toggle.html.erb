<% current_role = local_assigns[:current_role] || "adopter" %>

<div class="flex rounded-xl bg-neutral-100 p-1 w-full"
     role="group"
     aria-label="<%= t('authentication.role_toggle.aria_label') %>">
  <button type="button"
          data-action="click->role-toggle#selectRole"
          data-role="adopter"
          data-role-toggle-target="button"
          aria-pressed="<%= current_role == 'adopter' ? 'true' : 'false' %>"
          class="flex-1 py-2.5 px-4 rounded-lg text-sm font-semibold transition-all duration-150 outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 focus-visible:ring-offset-neutral-100
                 <%= current_role == 'adopter' ? 'bg-primary-500 text-white shadow-sm' : 'bg-transparent text-neutral-600 hover:text-neutral-800' %>">
    <span class="flex items-center justify-center gap-2">
      <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
      </svg>
      <%= t('authentication.role_toggle.adopter') %>
    </span>
  </button>

  <button type="button"
          data-action="click->role-toggle#selectRole"
          data-role="shelter"
          data-role-toggle-target="button"
          aria-pressed="<%= current_role == 'shelter' ? 'true' : 'false' %>"
          class="flex-1 py-2.5 px-4 rounded-lg text-sm font-semibold transition-all duration-150 outline-none focus-visible:ring-2 focus-visible:ring-secondary-500 focus-visible:ring-offset-2 focus-visible:ring-offset-neutral-100
                 <%= current_role == 'shelter' ? 'bg-secondary-500 text-white shadow-sm' : 'bg-transparent text-neutral-600 hover:text-neutral-800' %>">
    <span class="flex items-center justify-center gap-2">
      <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 21h16.5M4.5 3h15M5.25 3v18m13.5-18v18M9 6.75h1.5m-1.5 3h1.5m-1.5 3h1.5m3-6H15m-1.5 3H15m-1.5 3H15M9 21v-3.375c0-.621.504-1.125 1.125-1.125h3.75c.621 0 1.125.504 1.125 1.125V21" />
      </svg>
      <%= t('authentication.role_toggle.shelter') %>
    </span>
  </button>
</div>
