<div data-controller="faq" data-faq-application-token="<%= application.token %>" class="bg-white rounded-xl shadow-sm border border-neutral-200 p-6 mb-6">
  <h2 class="font-display text-lg font-bold text-neutral-800 mb-4"><%= t(".ask_about_application") %></h2>

  <div class="flex gap-2 mb-4">
    <input type="text"
           data-faq-target="input"
           data-action="keydown.enter->faq#ask"
           placeholder="<%= t(".question_placeholder") %>"
           class="flex-1 px-4 py-2 border border-neutral-300 rounded-lg text-sm focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
    <button data-action="faq#ask"
            class="px-4 py-2 bg-primary-500 text-white text-sm font-medium rounded-lg hover:bg-primary-600 transition">
      <%= t(".ask") %>
    </button>
  </div>

  <div data-faq-target="answer" class="hidden">
    <div data-faq-target="loading" class="flex items-center gap-2 text-neutral-500 text-sm py-3">
      <div class="animate-pulse w-4 h-4 bg-neutral-300 rounded-full"></div>
      <%= t(".generating") %>
    </div>
    <div data-faq-target="content" class="text-neutral-700 text-sm leading-relaxed prose prose-sm max-w-none"></div>
    <div data-faq-target="error" class="hidden text-red-500 text-sm py-2">
      <%= t(".error") %>
      <button data-action="faq#ask" class="text-primary-500 hover:text-primary-600 underline ml-1"><%= t(".retry") %></button>
    </div>
  </div>
</div>
