<div class="max-w-3xl mx-auto px-4 py-8">
  <div class="bg-white rounded-xl shadow-sm border border-neutral-200 p-8 mb-6">
    <h1 class="font-display text-2xl font-bold text-neutral-900 mb-2"><%= t(".title") %></h1>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
    <div class="bg-white rounded-xl shadow-sm border border-neutral-200 p-6">
      <h2 class="font-display text-lg font-bold text-neutral-800 mb-4"><%= t(".application_status") %></h2>
      <span class="inline-flex px-3 py-1 rounded-full text-sm font-medium
        <%= "bg-yellow-100 text-yellow-700" %>">
        <%= @application.status.humanize %>
      </span>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-neutral-200 p-6">
      <h2 class="font-display text-lg font-bold text-neutral-800 mb-4"><%= t(".pet_info") %></h2>
      <p class="text-neutral-700"><%= @application.pet.name %></p>
      <p class="text-sm text-neutral-500"><%= "#{@application.pet.species.humanize} · #{@application.pet.breed.presence || 'Mixed'}" %></p>
    </div>
  </div>

  <%= render "qa", application: @application %>
</div>
