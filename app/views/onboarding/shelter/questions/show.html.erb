<div class="w-full max-w-lg mx-auto"
     data-controller="onboarding confetti"
     data-onboarding-current-step-value="<%= @current_step %>"
     data-onboarding-total-steps-value="<%= @total_questions %>"
     data-onboarding-save-url-value="<%= onboarding_shelter_questions_path %>"
     data-onboarding-complete-url-value="<%= onboarding_shelter_completion_path %>"
     data-onboarding-role-value="shelter"
     data-action="wizard:complete@document->confetti#fire"
     data-tip1="<%= t('onboarding.shelter.progress_tips.tip1') %>"
     data-tip2="<%= t('onboarding.shelter.progress_tips.tip2') %>"
     data-tip3="<%= t('onboarding.shelter.progress_tips.tip3') %>"
     data-tip4="<%= t('onboarding.shelter.progress_tips.tip4') %>">

  <%= form_with url: onboarding_shelter_completion_path, method: :post,
                data: { onboarding_target: "completeForm" },
                class: "hidden" do |f| %>
    <%= f.hidden_field :skip, value: "false", data: { onboarding_target: "skipField" } %>
    <% if local_assigns[:from_profile] || @from_profile %>
      <%= f.hidden_field :redirect_to, value: edit_profile_path %>
      <%= f.hidden_field :from_profile, value: "true" %>
    <% end %>
  <% end %>

  <%# ─── Mascot Companion ─── %>
  <div data-onboarding-target="mascot"
       class="hidden sm:block fixed bottom-6 right-6 z-30 w-16 h-16 pointer-events-none select-none"
       aria-hidden="true">
    <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-full">
      <!-- Geometric cat-dog hybrid mascot in Tovitu purple/teal -->
      <!-- Body -->
      <circle cx="32" cy="36" r="18" fill="var(--color-primary-100)"/>
      <!-- Ears -->
      <path d="M18 22 L14 8 L26 18 Z" fill="var(--color-primary-400)"/>
      <path d="M46 22 L50 8 L38 18 Z" fill="var(--color-primary-400)"/>
      <!-- Eyes -->
      <circle cx="26" cy="32" r="3" fill="var(--color-primary-700)"/>
      <circle cx="38" cy="32" r="3" fill="var(--color-primary-700)"/>
      <!-- Eye shine -->
      <circle cx="27" cy="31" r="1" fill="white" opacity="0.8"/>
      <circle cx="39" cy="31" r="1" fill="white" opacity="0.8"/>
      <!-- Nose -->
      <path d="M30 38 L34 38 L32 41 Z" fill="var(--color-secondary-500)"/>
      <!-- Mouth -->
      <path d="M28 42 C30 44, 34 44, 36 42" stroke="var(--color-primary-600)" stroke-width="1.5" stroke-linecap="round" fill="none"/>
      <!-- Whiskers -->
      <line x1="12" y1="35" x2="22" y2="36" stroke="var(--color-primary-300)" stroke-width="1" stroke-linecap="round"/>
      <line x1="12" y1="39" x2="22" y2="38" stroke="var(--color-primary-300)" stroke-width="1" stroke-linecap="round"/>
      <line x1="52" y1="35" x2="42" y2="36" stroke="var(--color-primary-300)" stroke-width="1" stroke-linecap="round"/>
      <line x1="52" y1="39" x2="42" y2="38" stroke="var(--color-primary-300)" stroke-width="1" stroke-linecap="round"/>
      <!-- Paws -->
      <ellipse cx="22" cy="52" rx="5" ry="3" fill="var(--color-primary-200)"/>
      <ellipse cx="42" cy="52" rx="5" ry="3" fill="var(--color-primary-200)"/>
    </svg>
  </div>

  <div class="text-center mb-8">
    <div class="w-14 h-14 rounded-2xl bg-secondary-50 flex items-center justify-center mx-auto mb-4">
      <svg class="w-7 h-7 text-secondary-500" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 21h16.5M4.5 3h15M5.25 3v18m13.5-18v18M9 6.75h1.5m-1.5 3h1.5m-1.5 3h1.5m3-6H15m-1.5 3H15m-1.5 3H15M9 21v-3.375c0-.621.504-1.125 1.125-1.125h3.75c.621 0 1.125.504 1.125 1.125V21" />
      </svg>
    </div>
    <h1 class="font-display text-3xl font-bold text-neutral-900 mb-1"><%= t("onboarding.shelter.title") %></h1>
    <p class="text-neutral-500"><%= t(@from_profile ? "onboarding.shelter.from_profile_subtitle" : "onboarding.shelter.subtitle") %></p>
    <% if @from_profile %>
      <div class="mt-4">
        <%= link_to t("onboarding.shelter.review.back_to_review"),
            onboarding_shelter_questions_path(from_profile: true),
            class: "inline-flex items-center gap-1.5 text-sm font-medium text-primary-600 hover:text-primary-700 transition-colors" do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18"/></svg>
          <%= t("onboarding.shelter.review.back_to_review") %>
        <% end %>
      </div>
    <% end %>
  </div>

  <div class="bg-white rounded-xl shadow-sm border border-neutral-200 p-6 sm:p-8">
    <%# ─── Enhanced Progress Bar ─── %>
    <div class="mb-6">
      <div class="flex items-center justify-between mb-2">
        <span class="text-sm font-medium text-neutral-500" data-onboarding-target="progressText">
          🐾 <%= t("onboarding.shelter.progress", current: @current_step, total: @total_questions) %>
        </span>
        <span class="text-xs text-neutral-500" data-onboarding-target="selectedCount"></span>
      </div>
      <div class="relative w-full h-3 bg-neutral-100 rounded-full overflow-hidden">
        <div class="h-full rounded-full transition-all duration-600 ease-out progress-shimmer"
             data-onboarding-target="progressBar"
             style="width: <%= ((@current_step - 1).to_f / @total_questions * 100) %>%"></div>

        <%# Milestone dots %>
        <div class="absolute inset-0 flex items-center justify-between px-0.5 pointer-events-none">
          <% [25, 50, 75, 100].each do |pct| %>
            <div data-onboarding-target="milestoneDot"
                 data-threshold="<%= pct %>"
                 class="w-3 h-3 rounded-sm bg-neutral-200 border-2 border-white transform rotate-45 transition-all duration-300"
                 style="<%= "visibility:hidden" if pct == 100 %>">
            </div>
          <% end %>
        </div>
      </div>

      <%# Rotating tips %>
      <div data-onboarding-target="progressTips" class="mt-2 text-center">
        <p data-tip="1" class="text-xs text-neutral-400 active transition-opacity duration-500"><%= t("onboarding.shelter.progress_tips.tip1") %></p>
        <p data-tip="2" class="text-xs text-neutral-400 hidden transition-opacity duration-500"><%= t("onboarding.shelter.progress_tips.tip2") %></p>
        <p data-tip="3" class="text-xs text-neutral-400 hidden transition-opacity duration-500"><%= t("onboarding.shelter.progress_tips.tip3") %></p>
        <p data-tip="4" class="text-xs text-neutral-400 hidden transition-opacity duration-500"><%= t("onboarding.shelter.progress_tips.tip4") %></p>
      </div>
    </div>

    <%# ─── Questions ─── %>
    <div data-onboarding-target="questionContainer" class="min-h-[320px]">
      <% @questions_data.each_with_index do |question, idx| %>
        <div data-question="<%= question[:number] %>"
             data-type="<%= question[:type] %>"
             data-key="<%= question[:key] %>"
             data-max-length="<%= question[:max_length] || 0 %>"
             class="<%= idx + 1 == @current_step ? 'block' : 'hidden' %> question-step transition-all duration-300"
             data-onboarding-target="question">
          <div class="flex items-start gap-3 mb-6">
            <span class="text-2xl"><%= shelter_question_icon(question[:number]) %></span>
            <div>
              <p class="font-display text-xl font-bold text-neutral-800 mb-1">
                <%= t("onboarding.shelter.questions.q#{question[:number]}.text") %>
              </p>
              <% if question[:type] == "multi_select" %>
                <p class="text-xs text-neutral-500"><%= t("onboarding.shelter.questions.q#{question[:number]}.placeholder") %></p>
              <% end %>
            </div>
          </div>

          <div class="space-y-3">
            <% if question[:type] == "multi_select" %>
              <div data-controller="multi-select"
                   data-multi-select-selected-value="<%= @profile.send(question[:key]).to_json %>">
                <div class="flex flex-wrap gap-2.5" data-multi-select-target="container">
                  <% question[:options].each do |option| %>
                    <button type="button"
                            data-action="click->multi-select#toggle"
                            data-multi-select-target="chip"
                            data-value="<%= option %>"
                            class="px-4 py-2.5 rounded-full text-sm font-medium border-2 transition-all duration-150
                                   <%= @profile.send(question[:key])&.include?(option) ? 'bg-primary-100 border-primary-400 text-primary-700' : 'bg-white border-neutral-200 text-neutral-600 hover:border-primary-300 hover:text-primary-600' %>">
                      <%= t("onboarding.shelter.questions.q#{question[:number]}.options.#{option}") %>
                    </button>
                  <% end %>
                </div>
                <p class="text-xs text-danger hidden mt-2" data-multi-select-target="errorMessage">
                  <%= t("onboarding.shelter.questions.q#{question[:number]}.placeholder") %>
                </p>
              </div>

            <% elsif question[:type] == "single_select" %>
              <div data-controller="single-select"
                   data-single-select-selected-value="<%= @profile.send(question[:key]) %>">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3" data-single-select-target="container">
                  <% question[:options].each do |option| %>
                    <button type="button"
                            data-action="click->single-select#select"
                            data-single-select-target="option"
                            data-value="<%= option %>"
                            class="px-4 py-3.5 rounded-xl text-sm font-medium border-2 text-left transition-all duration-150
                                   <%= @profile.send(question[:key]) == option ? 'bg-primary-50 border-primary-400 text-primary-700' : 'bg-white border-neutral-200 text-neutral-600 hover:border-primary-300 hover:text-primary-600 hover:bg-primary-50/50' %>">
                      <span class="option-icon text-lg mr-2"><%= shelter_option_icon(question[:number], option) %></span>
                      <%= t("onboarding.shelter.questions.q#{question[:number]}.options.#{option}") %>
                    </button>
                  <% end %>
                </div>
              </div>

            <% elsif question[:type] == "text" %>
              <div data-controller="character-count"
                   data-character-count-max-length-value="<%= question[:max_length] || 200 %>">
                <textarea data-character-count-target="input"
                          data-action="input->character-count#update"
                          data-onboarding-target="textInput"
                          maxlength="<%= question[:max_length] || 200 %>"
                          rows="4"
                          placeholder="<%= t("onboarding.shelter.questions.q#{question[:number]}.placeholder") %>"
                          class="w-full px-4 py-3 border border-neutral-300 rounded-xl shadow-sm focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500 text-neutral-800 placeholder-neutral-400 transition resize-none"><%= @profile.send(question[:key]) %></textarea>
                <div class="flex items-center justify-between mt-2">
                  <span class="text-xs text-neutral-500"><%= t("onboarding.shelter.questions.q#{question[:number]}.max_length") %></span>
                  <span class="text-xs text-neutral-500 tabular-nums"
                        data-character-count-target="counter">
                    <span data-character-count-target="count"><%= @profile.send(question[:key])&.length || 0 %></span>/<%= question[:max_length] || 200 %>
                  </span>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

    <%# ─── Personality Card (hidden until completion) ─── %>
    <div data-onboarding-target="personalityCard"
         class="hidden mt-6 p-6 bg-gradient-to-br from-primary-50 to-secondary-50 rounded-xl border-2 border-primary-200 text-center">
      <% profile = @profile %>
      <% personality = Onboarding::Shelter::Personality.call(profile) rescue nil %>
      <% if personality %>
        <p class="text-3xl mb-2"><%= personality[:icon] %></p>
        <p class="font-display text-xl font-bold text-neutral-800 mb-1"><%= personality[:name] %></p>
        <p class="text-sm text-neutral-600 mb-4"><%= personality[:description] %></p>
      <% else %>
        <p class="text-3xl mb-2">🏆</p>
        <p class="font-display text-xl font-bold text-neutral-800 mb-1"><%= t("onboarding.shelter.personality.guardian.name") %></p>
        <p class="text-sm text-neutral-600 mb-4"><%= t("onboarding.shelter.personality.guardian.description") %></p>
      <% end %>
      <div class="text-sm text-neutral-500">
        <%= t("onboarding.shelter.celebration.complete") %>
      </div>
    </div>

    <%# ─── Navigation ─── %>
    <div class="flex items-center justify-between mt-8 pt-6 border-t border-neutral-100">
      <button type="button"
              data-action="click->onboarding#previousQuestion"
              data-onboarding-target="backButton"
              class="px-5 py-2.5 text-sm font-medium text-neutral-500 hover:text-neutral-700 hover:bg-neutral-50 rounded-xl transition <%= @current_step == 1 ? 'invisible' : '' %>">
        <span class="flex items-center gap-1.5">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5"/></svg>
          <%= t("onboarding.shelter.back") %>
        </span>
      </button>

      <div class="flex items-center gap-3">
        <% unless @from_profile %>
          <button type="button"
                  data-action="click->onboarding#skipOnboarding"
                  data-onboarding-target="skipButton"
                  class="px-4 py-2.5 text-sm font-medium text-neutral-500 hover:text-neutral-700 transition rounded-xl">
            <%= t("onboarding.shelter.skip") %>
          </button>
        <% end %>

        <button type="button"
                data-action="click->onboarding#nextQuestion"
                data-onboarding-target="nextButton"
                data-next-text="<%= t('onboarding.shelter.next') %>"
                data-complete-text="<%= t('onboarding.shelter.complete') %>"
                data-completing-text="<%= t('onboarding.shelter.loading.button') %>"
                class="px-6 py-2.5 bg-primary-500 text-white font-semibold rounded-xl hover:bg-primary-600 active:bg-primary-700 transition disabled:opacity-40 disabled:cursor-not-allowed shadow-sm">
          <span data-onboarding-target="nextButtonText"><%= t("onboarding.shelter.next") %></span>
        </button>
      </div>
    </div>
  </div>
</div>
