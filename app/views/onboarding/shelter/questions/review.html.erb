<div class="w-full max-w-3xl mx-auto space-y-6">

  <header class="text-center">
    <div class="w-14 h-14 rounded-2xl bg-secondary-50 flex items-center justify-center mx-auto mb-4" aria-hidden="true">
      <svg class="w-7 h-7 text-secondary-500" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 21h16.5M4.5 3h15M5.25 3v18m13.5-18v18M9 6.75h1.5m-1.5 3h1.5m-1.5 3h1.5m3-6H15m-1.5 3H15m-1.5 3H15M9 21v-3.375c0-.621.504-1.125 1.125-1.125h3.75c.621 0 1.125.504 1.125 1.125V21" />
      </svg>
    </div>
    <h1 class="font-display text-3xl font-bold text-neutral-900 mb-1"><%= t("onboarding.shelter.review.title") %></h1>
    <p class="text-neutral-500"><%= t("onboarding.shelter.review.subtitle") %></p>
  </header>

  <% if @profile.onboarding_step.to_i > 0 %>
    <% personality = Onboarding::Shelter::Personality.call(@profile) %>
    <div class="p-5 bg-gradient-to-br from-primary-50 to-secondary-50 rounded-xl border-2 border-primary-200 flex items-center gap-4" data-review-personality="true">
      <span class="text-3xl shrink-0"><%= personality[:icon] %></span>
      <div class="min-w-0">
        <p class="font-display text-lg font-bold text-neutral-800"><%= personality[:name] %></p>
        <p class="text-sm text-neutral-600"><%= personality[:description] %></p>
      </div>
    </div>
  <% end %>

  <div class="flex items-center justify-between gap-3">
    <%= link_to edit_profile_path,
        class: "inline-flex items-center gap-1.5 text-sm font-medium text-neutral-500 hover:text-neutral-700 transition-colors" do %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
      <%= t("onboarding.shelter.review.back_to_profile") %>
    <% end %>

    <%= link_to onboarding_shelter_questions_path(from_profile: true, start: 1, edit_all: true),
        class: "inline-flex items-center gap-1.5 text-sm font-medium text-primary-600 hover:text-primary-700 transition-colors" do %>
      <%= t("onboarding.shelter.review.edit_all") %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
    <% end %>
  </div>

  <div class="space-y-4">
    <% @questions_data.each do |question| %>
      <%= render "onboarding/review/question",
          question: question,
          profile: @profile,
          i18n_prefix: "onboarding.shelter.questions.q#{question[:number]}",
          form_url: onboarding_shelter_questions_path,
          icon: shelter_question_icon(question[:number]),
          edit_all: params[:edit_all] == "true" %>
    <% end %>
  </div>
</div>
