<%# Single-select edit form for the onboarding review page.
    Locals: question, profile, i18n_prefix, form_url %>
<% selected = profile.send(question[:key]).to_s %>
<%= form_with url: form_url, method: :patch, class: "space-y-3" do |f| %>
  <%= f.hidden_field :question_number, value: question[:number] %>
  <%= f.hidden_field :from_profile, value: "true" %>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
    <% question[:options].each do |option| %>
      <label class="flex items-center gap-2.5 px-4 py-3 rounded-xl border-2 text-sm font-medium cursor-pointer transition-all duration-150
                    <%= selected == option ? 'bg-primary-50 border-primary-400 text-primary-700' : 'bg-white border-neutral-200 text-neutral-600 hover:border-primary-300 hover:bg-primary-50/40' %>">
        <%= f.radio_button :answer, option, checked: selected == option, class: "h-4 w-4 text-primary-500 border-neutral-300 focus:ring-primary-500" %>
        <span class="option-icon text-lg"><%= option_icon(question[:number], option) %></span>
        <%= t("#{i18n_prefix}.options.#{option}") %>
      </label>
    <% end %>
  </div>

  <%= f.submit t("onboarding.review.save"),
      class: "px-5 py-2.5 bg-primary-500 text-white text-sm font-semibold rounded-xl hover:bg-primary-600 focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 transition-all duration-150 active:scale-[0.97] cursor-pointer shadow-sm" %>
<% end %>
