<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || t("layouts.application.title") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Tovitu">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%= favicon_link_tag 'favicon.png', rel: 'icon', type: 'image/png' %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;600;700;800&family=Poppins:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="font-sans bg-neutral-50 text-neutral-800 antialiased min-h-screen"
        data-controller="sidebar">

    <%= render "shared/flash" %>

    <% if signed_in? && !local_assigns[:hide_nav] && !@hide_nav %>
      <div data-sidebar-target="overlay"
           class="fixed inset-0 z-20 bg-black/20 backdrop-blur-sm hidden md:hidden"
           data-action="click->sidebar#closeMobile"></div>

      <%= render "shared/sidebar" %>
    <% end %>

    <div data-sidebar-target="mainWrapper"
         class="min-h-screen flex flex-col transition-all duration-300 ease-in-out
                <%= (signed_in? && !local_assigns[:hide_nav] && !@hide_nav) ? 'md:ml-16' : '' %>">

      <% unless local_assigns[:hide_nav] || @hide_nav %>
        <%= render "shared/navbar" %>
      <% end %>

      <main class="flex-1 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8">
        <%= yield %>
      </main>

      <footer class="text-center text-xs text-neutral-400 py-6 border-t border-neutral-100">
        &copy; <%= Time.current.year %> Tovitu
      </footer>
    </div>

    <div class="fixed bottom-4 right-4 z-50">
      <div class="bg-white rounded-full shadow-md border border-neutral-200 px-3 py-1.5">
        <% if I18n.locale == :en %>
          <%= link_to "Español", url_for(locale: :es), class: "text-sm font-medium text-primary-500 hover:text-primary-600 transition" %>
        <% else %>
          <%= link_to "English", url_for(locale: :en), class: "text-sm font-medium text-primary-500 hover:text-primary-600 transition" %>
        <% end %>
      </div>
    </div>
  </body>
</html>
