<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || t("layouts.application.title") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Tovitu">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="turbo-scroll-position" content="top">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <% if signed_in? %>
      <meta name="turbo-cache-control" content="no-cache">
    <% end %>

    <%= yield :head %>

    <%= favicon_link_tag 'tovitu.svg', rel: 'icon', type: 'image/svg+xml' %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;600;700;800&family=Poppins:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="font-sans bg-neutral-50 text-neutral-800 antialiased min-h-screen"
        data-controller="sidebar confirm-modal"
        data-confirm-modal-confirm-text-value="<%= t('shared.confirm_modal.confirm') %>"
        data-confirm-modal-cancel-text-value="<%= t('shared.confirm_modal.cancel') %>">

    <a href="#main-content"
       class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:px-4 focus:py-2 focus:bg-white focus:text-primary-600 focus:rounded-xl focus:shadow-lg focus:outline-none focus:ring-2 focus:ring-primary-500">
      <%= t("layouts.skip_to_content") %>
    </a>

    <div class="fixed inset-0 pointer-events-none z-0 bg-[url('data:image/svg+xml;base64,')] opacity-50"></div>

    <div id="flash-container">
      <%= render "shared/flash" %>
    </div>

    <% if signed_in? && !local_assigns[:hide_nav] && !@hide_nav %>
      <div data-sidebar-target="overlay"
           class="fixed inset-0 z-20 bg-black/20 backdrop-blur-sm hidden md:hidden"
           data-action="click->sidebar#closeMobile"></div>

      <%= render "shared/sidebar" %>
    <% end %>

    <div data-sidebar-target="mainWrapper"
         class="min-h-screen flex flex-col transition-all duration-300 ease-in-out relative z-10
                <%= (signed_in? && !local_assigns[:hide_nav] && !@hide_nav) ? 'md:ml-16' : '' %>">

      <% unless local_assigns[:hide_nav] || @hide_nav %>
        <%= render "shared/navbar" %>
      <% end %>

      <main id="main-content" class="flex-1 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-6 sm:pb-8">
        <%= yield %>
      </main>

      <footer class="text-center text-xs text-neutral-500 py-8 border-t border-neutral-100">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="flex flex-col sm:flex-row items-center justify-center gap-2 sm:gap-6 mb-3">
            <%= link_to t("layouts.privacy"), "#", class: "hover:text-neutral-600 transition" %>
            <%= link_to t("layouts.terms"), "#", class: "hover:text-neutral-600 transition" %>
            <span class="hidden sm:inline text-neutral-200">·</span>
            <span>&copy; <%= Time.current.year %> Tovitu</span>
          </div>
        </div>
      </footer>
    </div>

    <% if !signed_in? %>
      <%# ─── Conversion prompt modal (signed-out visitors only) ─── %>
      <%# Lives at body level, outside the sticky navbar. The navbar's
          backdrop-blur-md would otherwise become the containing block for
          this fixed dialog and clip it to the navbar's height. %>
      <div data-controller="interest-prompt">
        <div data-interest-prompt-target="dialog"
             class="hidden fixed inset-0 z-[100] flex items-center justify-center p-4"
             role="dialog"
             aria-modal="true"
             aria-labelledby="interest-prompt-title"
             aria-hidden="true">
          <div class="absolute inset-0 bg-neutral-900/50"
               data-action="click->interest-prompt#hideFromEvent"></div>
          <div class="relative w-full max-w-md bg-white rounded-2xl border border-neutral-200 shadow-lg p-8 text-center">
            <button type="button"
                    data-interest-prompt-target="closeButton"
                    data-action="click->interest-prompt#hideFromEvent"
                    class="absolute top-4 right-4 w-9 h-9 rounded-full text-neutral-400 hover:text-neutral-600 hover:bg-neutral-100 flex items-center justify-center transition-colors duration-150"
                    aria-label="<%= t('shared.interests.close') %>">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M6 18L18 6M6 6l12 12"/>
              </svg>
            </button>

            <div class="w-16 h-16 mx-auto mb-5 rounded-2xl bg-accent-pink/10 flex items-center justify-center" aria-hidden="true">
              <svg class="w-8 h-8 text-accent-pink" fill="currentColor" viewBox="0 0 24 24">
                <path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
              </svg>
            </div>

            <h2 id="interest-prompt-title" class="font-display text-2xl font-bold text-neutral-900 mb-2">
              <%= t("shared.interests.prompt_title") %>
            </h2>
            <p class="text-neutral-600 mb-2 leading-relaxed">
              <%= t("shared.interests.prompt_body") %>
            </p>
            <p class="text-sm text-neutral-400 mb-6 leading-relaxed">
              <%= t("shared.interests.prompt_benefit") %>
            </p>

            <%= link_to t("shared.interests.create_account"), new_registration_path(role: "individual"),
                class: "block w-full px-6 py-3.5 bg-primary-500 text-white font-semibold rounded-xl hover:bg-primary-600 focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 active:scale-[0.97] transition-all duration-150 shadow-sm mb-3" %>
            <%= link_to t("shared.interests.sign_in"), new_session_path,
                class: "block w-full px-6 py-3 text-sm font-medium text-primary-600 hover:text-primary-700 hover:bg-primary-50 rounded-xl transition-colors duration-150 mb-4" %>
            <button type="button"
                    data-action="click->interest-prompt#hideFromEvent"
                    class="text-sm font-medium text-neutral-500 hover:text-neutral-700 transition-colors">
              <%= t("shared.interests.keep_browsing") %>
            </button>
          </div>
        </div>
      </div>
    <% end %>


  </body>
</html>
