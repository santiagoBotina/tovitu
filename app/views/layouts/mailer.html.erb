<%# ─── Tovitu Branded Email Layout ─── %>
<%# Colors from DESIGN.md:
    Primary: #6C30FF (purple)
    Secondary: #00C9A7 (teal)
    Neutral-50: #FAFAFC, Neutral-100: #F3F4F8, Neutra-200: #E7E8EF
    Neutral-500: #6B7280, Neutral-700: #374151, Neutral-900: #111827
    Font: Poppins (body), Baloo 2 (display) %>
<!DOCTYPE html>
<html>
<head>
  <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Tovitu</title>
  <style type="text/css">
    /* ─── Reset ─── */
    body, table, td, p, a, li, blockquote {
      -webkit-text-size-adjust: 100%;
      -ms-text-size-adjust: 100%;
    }
    table, td {
      mso-table-lspace: 0pt;
      mso-table-rspace: 0pt;
    }
    img {
      -ms-interpolation-mode: bicubic;
      border: 0;
      height: auto;
      line-height: 100%;
      outline: none;
      text-decoration: none;
    }
    body {
      margin: 0;
      padding: 0;
      width: 100% !important;
      height: 100% !important;
    }

    /* ─── Typography ─── */
    @import url('https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&family=Poppins:wght@400;500;600;700&display=swap');

    body {
      font-family: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      background-color: #F3F4F8;
    }

    .email-wrapper {
      width: 100%;
      table-layout: fixed;
      background-color: #F3F4F8;
      padding: 20px 0;
    }

    .email-container {
      max-width: 600px;
      margin: 0 auto;
      background-color: #FFFFFF;
      border-radius: 16px;
      overflow: hidden;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
    }

    /* ─── Header ─── */
    .email-header {
      background-color: #6C30FF;
      padding: 32px 40px 28px;
    }

    .email-header h1 {
      font-family: 'Baloo 2', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      font-size: 28px;
      font-weight: 700;
      color: #FFFFFF;
      margin: 0;
      letter-spacing: -0.02em;
      line-height: 1.1;
    }

    .email-header h1 .t {
      color: #FF5DA8;
    }
    .email-header h1 .o1 {
      color: #00C9A7;
    }
    .email-header h1 .v {
      color: #FFC83D;
    }
    .email-header h1 .i {
      color: #FF7A30;
    }
    .email-header h1 .t2 {
      color: #6C30FF;
    }
    .email-header h1 .u {
      color: #00C9A7;
    }

    /* ─── Content ─── */
    .email-content {
      padding: 32px 40px;
      background-color: #FFFFFF;
    }

    .email-content h1 {
      font-family: 'Baloo 2', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      font-size: 24px;
      font-weight: 700;
      color: #111827;
      margin: 0 0 16px 0;
      line-height: 1.15;
      letter-spacing: -0.02em;
    }

    .email-content h2 {
      font-family: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      font-size: 18px;
      font-weight: 600;
      color: #111827;
      margin: 0 0 12px 0;
      line-height: 1.3;
    }

    .email-content p {
      font-family: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      font-size: 15px;
      font-weight: 400;
      color: #374151;
      margin: 0 0 16px 0;
      line-height: 1.6;
    }

    .email-content p:last-child {
      margin-bottom: 0;
    }

    .email-content ul {
      margin: 0 0 16px 0;
      padding: 0 0 0 20px;
    }

    .email-content li {
      font-family: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      font-size: 14px;
      font-weight: 400;
      color: #374151;
      line-height: 1.6;
      margin-bottom: 4px;
    }

    /* ─── CTA Button ─── */
    .email-cta {
      text-align: center;
      margin: 24px 0 16px;
    }

    .email-cta a {
      display: inline-block;
      font-family: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      font-size: 14px;
      font-weight: 600;
      color: #FFFFFF !important;
      text-decoration: none;
      background-color: #6C30FF;
      padding: 14px 32px;
      border-radius: 12px;
      mso-padding-alt: 0;
    }

    /* ─── Status Badge ─── */
    .status-badge {
      display: inline-block;
      font-size: 12px;
      font-weight: 600;
      padding: 4px 12px;
      border-radius: 9999px;
      background-color: #F3EEFF;
      color: #6C30FF;
    }

    .status-badge.accepted {
      background-color: #ECFDF5;
      color: #00C9A7;
    }

    .status-badge.declined {
      background-color: #FEF2F2;
      color: #EF4444;
    }

    .status-badge.pending {
      background-color: #FFFBEB;
      color: #F59E0B;
    }

    /* ─── Divider ─── */
    .email-divider {
      height: 1px;
      background-color: #E7E8EF;
      margin: 24px 0;
    }

    /* ─── Info Box ─── */
    .info-box {
      background-color: #F3EEFF;
      border-radius: 12px;
      padding: 16px 20px;
      margin: 16px 0;
    }

    .info-box p {
      font-size: 14px;
      color: #4A1CC3;
      margin: 0;
    }

    .info-box.success {
      background-color: #ECFDF5;
    }

    .info-box.success p {
      color: #047857;
    }

    .info-box.warning {
      background-color: #FFFBEB;
    }

    .info-box.warning p {
      color: #92400E;
    }

    /* ─── Pet Card ─── */
    .pet-card {
      background-color: #FAFAFC;
      border-radius: 12px;
      padding: 16px 20px;
      margin: 16px 0;
      border: 1px solid #E7E8EF;
    }

    .pet-card p {
      margin-bottom: 4px;
    }

    .pet-card .pet-name {
      font-size: 16px;
      font-weight: 600;
      color: #111827;
    }

    .pet-card .pet-detail {
      font-size: 13px;
      color: #6B7280;
    }

    /* ─── Footer ─── */
    .email-footer {
      padding: 24px 40px;
      background-color: #FAFAFC;
      border-top: 1px solid #E7E8EF;
      text-align: center;
    }

    .email-footer p {
      font-family: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      font-size: 12px;
      font-weight: 400;
      color: #9CA3AF;
      margin: 0 0 8px 0;
      line-height: 1.5;
    }

    .email-footer a {
      color: #6C30FF;
      text-decoration: underline;
      font-weight: 500;
    }

    .email-footer .footer-links {
      margin-bottom: 8px;
    }

    .email-footer .footer-links a {
      font-size: 12px;
      color: #6B7280;
      text-decoration: none;
      padding: 0 8px;
    }

    .email-footer .footer-links span.sep {
      color: #D1D4DD;
    }

    /* ─── Mobile ─── */
    @media only screen and (max-width: 620px) {
      .email-container {
        border-radius: 0;
      }
      .email-header {
        padding: 24px 24px 20px;
      }
      .email-header h1 {
        font-size: 24px;
      }
      .email-content {
        padding: 24px;
      }
      .email-footer {
        padding: 20px 24px;
      }
    }

    /* ─── Dark Mode ─── */
    @media (prefers-color-scheme: dark) {
      .email-container {
        background-color: #1F2937;
      }
      .email-content {
        background-color: #1F2937;
      }
      .email-content h1,
      .email-content h2 {
        color: #F3F4F8;
      }
      .email-content p,
      .email-content li {
        color: #D1D4DD;
      }
      .email-footer {
        background-color: #111827;
        border-top-color: #374151;
      }
      .pet-card {
        background-color: #374151;
        border-color: #4B5563;
      }
      .pet-card .pet-name {
        color: #F3F4F8;
      }
      .pet-card .pet-detail {
        color: #9CA3AF;
      }
    }
  </style>
</head>
<body style="margin:0; padding:0; background-color:#F3F4F8; font-family:'Poppins',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">

  <!-- ─── Email Wrapper ─── -->
  <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="background-color:#F3F4F8; padding:20px 0;">
    <tr>
      <td align="center" style="padding:0;">

        <!-- ─── Email Container ─── -->
        <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="600" style="max-width:600px; width:100%; background-color:#FFFFFF; border-radius:16px; overflow:hidden; box-shadow:0 2px 8px rgba(0,0,0,0.06);">
          <tr>
            <td>

              <!-- ─── Header ─── -->
              <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="background-color:#6C30FF; padding:32px 40px 28px;">
                <tr>
                  <td style="text-align:center;">
                    <h1 style="font-family:'Baloo 2',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif; font-size:28px; font-weight:700; color:#FFFFFF; margin:0; letter-spacing:-0.02em; line-height:1.1;">
                      <span style="color:#FF5DA8;">T</span><span style="color:#00C9A7;">o</span><span style="color:#FFC83D;">v</span><span style="color:#FF7A30;">i</span><span style="color:#FFFFFF;">t</span><span style="color:#00C9A7;">u</span>
                    </h1>
                  </td>
                </tr>
              </table>

              <!-- ─── Content ─── -->
              <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="background-color:#FFFFFF;">
                <tr>
                  <td style="padding:32px 40px;">
                    <%= yield %>
                  </td>
                </tr>
              </table>

              <!-- ─── Footer ─── -->
              <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="background-color:#FAFAFC; border-top:1px solid #E7E8EF;">
                <tr>
                  <td style="padding:24px 40px; text-align:center;">
                    <div style="margin-bottom:8px;">
                      <a href="<%= root_url %>" style="font-family:'Poppins',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif; font-size:12px; color:#6B7280; text-decoration:none; padding:0 8px;">
                        Tovitu
                      </a>
                      <span style="font-family:'Poppins',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif; font-size:12px; color:#D1D4DD; padding:0 4px;">·</span>
                      <a href="#" style="font-family:'Poppins',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif; font-size:12px; color:#6B7280; text-decoration:none; padding:0 8px;">
                        Privacy Policy
                      </a>
                      <span style="font-family:'Poppins',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif; font-size:12px; color:#D1D4DD; padding:0 4px;">·</span>
                      <a href="#" style="font-family:'Poppins',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif; font-size:12px; color:#6B7280; text-decoration:none; padding:0 8px;">
                        Terms of Service
                      </a>
                    </div>
                    <p style="font-family:'Poppins',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif; font-size:12px; font-weight:400; color:#9CA3AF; margin:0 0 4px 0; line-height:1.5;">
                      &copy; <%= Time.current.year %> Tovitu. All rights reserved.
                    </p>
                    <p style="font-family:'Poppins',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif; font-size:11px; font-weight:400; color:#D1D4DD; margin:0; line-height:1.5;">
                      Making pet adoptions stick, one match at a time.
                    </p>
                  </td>
                </tr>
              </table>

            </td>
          </tr>
        </table>

      </td>
    </tr>
  </table>

</body>
</html>
