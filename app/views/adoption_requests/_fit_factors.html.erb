<%# ─── Zone 2: Fit factors ─── %>
<%# Icon-led factor cells (icon + short label + status pill + one-line evidence) %>
<%# plus the pet-fit summary as a compact bottom line with a Read-more expander. %>
<div class="mb-4 bento-enter bento-enter-d2" data-testid="insight-fit-factors">
  <h3 class="text-xs font-semibold text-neutral-500 uppercase tracking-wide mb-2"><%= t("ai.adopter_insight.card.fit_title") %></h3>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
    <% presenter.fit_indicators.each do |indicator| %>
      <div class="rounded-xl border border-neutral-100 bg-white p-3 card-lift transition-colors hover:border-neutral-200">
        <div class="flex items-center gap-2.5">
          <span class="w-7 h-7 rounded-lg flex items-center justify-center shrink-0 <%= adopter_insight_status_tint(indicator[:status]) %>" aria-hidden="true">
            <%= adopter_insight_factor_icon(indicator[:key]) %>
          </span>
          <p class="text-sm font-medium text-neutral-800 flex-1 min-w-0 truncate"><%= indicator[:label] %></p>
          <span class="px-2 py-0.5 text-xs font-medium rounded-full shrink-0 <%= case indicator[:status]
               when "strong_fit" then "bg-secondary-50 text-secondary-700"
               when "possible_mismatch" then "bg-warning/10 text-warning"
               else "bg-neutral-100 text-neutral-500"
             end %>"><%= indicator[:status_label] %></span>
        </div>

        <p class="text-xs text-neutral-500 mt-2 truncate" title="<%= indicator[:evidence] %>"><%= indicator[:evidence] %></p>

        <% if adopter_insight_evidence_long?(indicator[:evidence]) %>
          <details class="insight-details mt-1">
            <summary class="inline-flex items-center gap-1 text-xs font-medium text-primary-600 hover:text-primary-700 rounded focus-visible:ring-2 focus-visible:ring-primary-200 focus-visible:outline-none">
              <%= t("ai.adopter_insight.card.why") %>
              <svg class="insight-chevron w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m6 9 6 6 6-6"/>
              </svg>
            </summary>
            <p class="insight-details-body text-xs text-neutral-600 leading-relaxed mt-1.5"><%= indicator[:evidence] %></p>
          </details>
        <% end %>
      </div>
    <% end %>
  </div>

  <% if presenter.summary.present? %>
    <div class="mt-3 rounded-xl bg-secondary-50 border border-secondary-100 p-4">
      <h3 class="text-xs font-semibold text-secondary-700 uppercase tracking-wide mb-1.5"><%= t("ai.adopter_insight.card.summary_title") %></h3>
      <% if adopter_insight_summary_long?(presenter.summary) %>
        <div data-controller="insight-expand">
          <p id="insight-summary-content" class="text-sm text-neutral-700 leading-relaxed line-clamp-3" data-insight-expand-target="content"><%= presenter.summary %></p>
          <button type="button"
                  class="mt-1.5 inline-flex items-center gap-1 text-xs font-medium text-secondary-700 hover:text-secondary-800 rounded focus-visible:ring-2 focus-visible:ring-secondary-500 focus-visible:ring-offset-2 focus-visible:outline-none"
                  data-action="insight-expand#toggle"
                  data-insight-expand-target="trigger"
                  aria-expanded="false"
                  aria-controls="insight-summary-content">
            <span data-insight-expand-target="moreLabel"><%= t("ai.adopter_insight.card.read_more") %></span>
            <span data-insight-expand-target="lessLabel" hidden><%= t("ai.adopter_insight.card.show_less") %></span>
            <svg class="insight-chevron w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m6 9 6 6 6-6"/>
            </svg>
          </button>
        </div>
      <% else %>
        <p class="text-sm text-neutral-700 leading-relaxed"><%= presenter.summary %></p>
      <% end %>
    </div>
  <% end %>
</div>
