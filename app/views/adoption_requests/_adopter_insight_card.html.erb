<%# ─── Adopter Insight Card ─── %>
<%# Shared between shelter and individual-publisher request review pages. %>
<%# AI-generated, advisory only. Renders three states: ready / loading / unavailable. %>
<%# Ready state is composed of four visual zones (archetype hero, fit factors, %>
<%# signals, check-ins) with staggered reveal motion (disabled under reduced motion). %>
<% presenter = AdopterInsightPresenter.new(request: insight_request, adopter: insight_adopter) %>

<section class="bg-white rounded-xl shadow-sm border border-neutral-200 p-6 mb-6" data-testid="adopter-insight-card">
  <div class="flex items-start justify-between gap-3 mb-4">
    <div class="flex items-center gap-2">
      <span class="w-8 h-8 rounded-xl bg-primary-50 text-primary-600 flex items-center justify-center shrink-0" aria-hidden="true">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09ZM18.259 8.715 18 9.75l-.259-1.035a3.375 3.375 0 0 0-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 0 0 2.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 0 0 2.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 0 0-2.456 2.456Z"/>
        </svg>
      </span>
      <h2 class="font-display text-lg font-bold text-neutral-800"><%= t("ai.adopter_insight.card.title") %></h2>
    </div>
    <span class="px-2.5 py-1 bg-primary-50 text-primary-700 text-xs font-medium rounded-full shrink-0"><%= t("ai.adopter_insight.card.ai_badge") %></span>
  </div>

  <% if presenter.ready? %>
    <%= render "adoption_requests/archetype_hero", presenter: presenter %>
    <%= render "adoption_requests/fit_factors", presenter: presenter %>
    <%= render "adoption_requests/signals", presenter: presenter %>
    <%= render "adoption_requests/checkins", presenter: presenter %>

    <%# ─── Provenance footer (single subtle line) ─── %>
    <div class="pt-4 border-t border-neutral-100 flex flex-wrap items-center justify-between gap-x-3 gap-y-1 bento-enter bento-enter-d5" data-testid="insight-provenance">
      <% if presenter.based_on.present? %>
        <details class="insight-details max-w-full" data-testid="insight-disclaimer">
          <summary class="text-xs text-neutral-500 flex items-center gap-1.5 rounded focus-visible:ring-2 focus-visible:ring-primary-200 focus-visible:outline-none">
            <span class="shrink-0">
              <%= adopter_insight_icon(:info, size: "w-4 h-4", extra_class: "text-neutral-400") %>
            </span>
            <span class="min-w-0"><%= t("ai.adopter_insight.card.based_on_short", based_on: presenter.based_on) %></span>
            <svg class="insight-chevron w-3.5 h-3.5 text-neutral-400 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m6 9 6 6 6-6"/>
            </svg>
          </summary>
          <p class="insight-details-body text-xs text-neutral-500 leading-relaxed mt-1.5"><%= presenter.disclaimer %></p>
        </details>
      <% else %>
        <p class="text-xs text-neutral-500"><%= presenter.disclaimer %></p>
      <% end %>
      <% if presenter.activity_up_to.present? %>
        <span class="text-xs text-neutral-400"><%= t("ai.adopter_insight.card.activity_up_to", date: presenter.activity_up_to) %></span>
      <% end %>
    </div>

  <% elsif presenter.loading? %>
    <%# ─── Loading state (non-blocking) ─── %>
    <div class="py-8 text-center bento-enter bento-enter-d1">
      <div class="mx-auto w-8 h-8 mb-3 rounded-full border-2 border-primary-200 border-t-primary-500 animate-spin" aria-hidden="true"></div>
      <p class="text-sm font-medium text-neutral-700"><%= t("ai.adopter_insight.card.loading") %></p>
      <p class="text-xs text-neutral-500 mt-1"><%= t("ai.adopter_insight.card.loading_hint") %></p>
    </div>

  <% else %>
    <%# ─── Unavailable / fallback state ─── %>
    <div class="py-6 text-center bento-enter bento-enter-d1">
      <p class="text-sm font-medium text-neutral-700"><%= t("ai.adopter_insight.card.unavailable") %></p>
      <p class="text-xs text-neutral-500 mt-1 max-w-md mx-auto"><%= t("ai.adopter_insight.card.unavailable_hint") %></p>
    </div>
  <% end %>
</section>
