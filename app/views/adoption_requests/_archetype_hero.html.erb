<%# ─── Zone 1: Archetype hero strip ─── %>
<%# Full-width tinted strip: archetype name in the display face, a large icon, %>
<%# the confidence chip (prominent here, not buried in the footer), the stale %>
<%# badge, and a compact "worth confirming" pill when self-report diverges. %>
<section class="relative rounded-xl bg-primary-50 border border-primary-100 p-4 sm:p-5 mb-4 bento-enter bento-enter-d1" data-testid="insight-archetype">
  <div class="flex items-start gap-3 sm:gap-4">
    <span class="hidden sm:flex w-12 h-12 rounded-xl bg-white border border-primary-100 text-primary-600 items-center justify-center shrink-0 shadow-sm" aria-hidden="true">
      <%= adopter_insight_archetype_icon(presenter.archetype_key) %>
    </span>

    <div class="flex-1 min-w-0">
      <div class="flex flex-wrap items-center gap-2">
        <p class="text-xs text-neutral-500 font-medium"><%= t("ai.adopter_insight.card.archetype_label") %></p>
        <% if presenter.pet_fit_stale? %>
          <span class="px-2 py-0.5 text-xs font-medium rounded-full bg-warning/10 text-warning shrink-0"><%= t("ai.adopter_insight.card.stale_badge") %></span>
        <% end %>
      </div>
      <p class="font-display text-xl sm:text-2xl font-bold text-primary-700 leading-snug mt-1"><%= presenter.archetype_label %></p>
      <% if presenter.self_report_present? %>
        <p class="text-xs text-neutral-600 mt-1.5">
          <%= t("ai.adopter_insight.card.self_report_label") %>:
          <span class="font-medium text-neutral-800"><%= presenter.self_report_label %></span>
        </p>
      <% end %>
    </div>

    <div class="flex flex-col items-end gap-2 shrink-0">
      <span class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold rounded-full bg-primary-500 text-white shadow-sm">
        <%= adopter_insight_icon(:sparkles, size: "w-3.5 h-3.5") %>
        <%= t("ai.adopter_insight.card.confidence_value", level: presenter.confidence_label) %>
      </span>
      <% if presenter.self_report_present? && presenter.diverges? %>
        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-warning/10 text-warning text-xs font-medium" data-testid="insight-divergence-pill">
          <%= adopter_insight_icon(:alert_triangle, size: "w-3.5 h-3.5") %>
          <%= t("ai.adopter_insight.card.divergence_pill") %>
        </span>
      <% end %>
    </div>
  </div>
</section>
