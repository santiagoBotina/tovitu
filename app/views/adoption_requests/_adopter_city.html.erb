<%# Shelter-facing city display (REQ-48-5 privacy boundary). Shows only the
    city (+ region where available) or a neutral localized "City not shared"
    state. Never renders coordinates or precision metadata.
    Locals:
      - adopter          User
      - adoption_request AdoptionRequest (optional) — prefers the
                         submission-time snapshot (REQ-48-6) which survives
                         later deletion %>
<% snapshot_city = local_assigns[:adoption_request]&.adopter_city %>
<% city = snapshot_city.presence || adopter.user_location&.city %>
<% region = snapshot_city.present? ? nil : adopter.user_location&.region %>

<% if city.present? %>
  <span class="inline-flex items-center gap-1.5">
    <svg class="w-3.5 h-3.5 shrink-0 text-neutral-400" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/>
      <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/>
    </svg>
    <%= city %><% if region.present? %>, <%= region %><% end %>
  </span>
<% else %>
  <span class="text-neutral-400"><%= t("locations.not_shared") %></span>
<% end %>