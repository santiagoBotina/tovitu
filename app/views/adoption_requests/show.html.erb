<%# ─── Adoption Request Show Page ─── %>
<%# Design: Dashboard-level bento cards, timeline with visual connectors, gradient accent cards %>
<div class="w-full max-w-4xl mx-auto">
  <%# ─── Back link ─── %>
  <%= link_to adoption_requests_path, class: "inline-flex items-center gap-1.5 text-neutral-500 hover:text-neutral-700 text-sm mb-6 transition bento-enter bento-enter-d1" do %>
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
    </svg>
    <%= t(".back_to_requests") %>
  <% end %>

  <%# ─── Request Header Card ─── %>
  <section class="bg-white rounded-xl shadow-sm border border-neutral-200 p-6 mb-6 bento-enter bento-enter-d2">
    <div class="flex items-start justify-between">
      <div>
        <h1 class="font-display text-2xl font-bold text-neutral-900"><%= t(".title", pet_name: @pet.name) %></h1>
        <p class="text-neutral-500 text-sm mt-1"><%= t(".submitted", date: l(@request.created_at.to_date, format: :long)) %></p>
      </div>
      <%= render "status_badge", status: @request.status %>
    </div>
  </section>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div class="lg:col-span-2 space-y-6">
      <%# ─── Pet Info Card ─── %>
      <section class="bg-white rounded-xl shadow-sm border border-neutral-200 p-6 bento-enter bento-enter-d3">
        <h2 class="font-display text-lg font-bold text-neutral-800 mb-4"><%= t(".pet_info") %></h2>
        <div class="flex items-center gap-4 mb-4">
          <div class="w-20 h-20 rounded-xl bg-neutral-100 overflow-hidden shrink-0 shadow-sm">
            <% if @pet.primary_photo.present? %>
              <%= image_tag @pet.primary_photo.url(variant: :medium), alt: @pet.name, class: "w-full h-full object-cover image-reveal" %>
            <% else %>
              <div class="w-full h-full flex items-center justify-center bg-primary-50">
                <svg class="w-10 h-10 text-primary-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
            <% end %>
          </div>
          <div>
            <h3 class="font-bold text-neutral-900"><%= @pet.name %></h3>
            <p class="text-sm text-neutral-500"><%= @pet.species.humanize %> · <%= @pet.breed.presence || t(".unknown_breed") %></p>
            <p class="text-sm text-neutral-500"><%= @pet.age_category.humanize %> · <%= @pet.size.presence&.humanize || t(".unknown_size") %></p>
          </div>
        </div>
        <p class="text-sm text-neutral-600"><%= @pet.description&.truncate(200) %></p>
        <%= link_to pet_path(@pet), class: "text-primary-500 text-sm font-medium hover:underline mt-2 inline-block transition-colors" do %>
          <%= t(".view_full_profile") %> →
        <% end %>
      </section>

      <%# ─── Shelter Info Card ─── %>
      <section class="bg-white rounded-xl shadow-sm border border-neutral-200 p-6 bento-enter bento-enter-d4">
        <h2 class="font-display text-lg font-bold text-neutral-800 mb-4"><%= t(".shelter_info") %></h2>
        <%= link_to shelter_path(@shelter), class: "block group" do %>
          <p class="font-medium text-primary-500 group-hover:text-primary-600 transition"><%= @shelter.name %></p>
        <% end %>
        <p class="text-sm text-neutral-500 mt-1"><%= @shelter.city %>, <%= @shelter.state %></p>
        <p class="text-sm text-neutral-500"><%= @shelter.phone %></p>
      </section>

      <%# ─── Timeline Card (with visual connector lines) ─── %>
      <section class="bg-white rounded-xl shadow-sm border border-neutral-200 p-6 bento-enter bento-enter-d5">
        <h2 class="font-display text-lg font-bold text-neutral-800 mb-4"><%= t(".timeline") %></h2>
        <% if @timeline.any? %>
          <div class="relative">
            <%# Vertical connector line %>
            <div class="absolute left-[11px] top-2 bottom-2 w-0.5 bg-neutral-200" aria-hidden="true"></div>
            <div class="space-y-6 relative">
              <% @timeline.each do |event| %>
                <% dot_color = case event.to_status
                  when "pending" then "bg-warning"
                  when "in_validation" then "bg-info"
                  when "accepted" then "bg-secondary-500"
                  when "declined" then "bg-danger"
                  when "withdrawn" then "bg-neutral-400"
                  else "bg-neutral-300"
                  end %>
                <div class="flex items-start gap-4 relative">
                  <div class="relative z-10 shrink-0">
                    <div class="w-6 h-6 rounded-full <%= dot_color %> flex items-center justify-center shadow-sm">
                      <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M5 13l4 4L19 7"/>
                      </svg>
                    </div>
                  </div>
                  <div class="flex-1 min-w-0 pt-0.5">
                    <p class="text-sm font-medium text-neutral-900">
                      <%= t(".events.#{event.to_status}", default: event.to_status.humanize) %>
                    </p>
                    <p class="text-xs text-neutral-500"><%= l(event.created_at, format: :long) %></p>
                    <% if event.metadata.present? && event.metadata["decline_reasons"].present? %>
                      <div class="mt-2 text-sm text-neutral-600 bg-neutral-50 rounded-lg p-3 border border-neutral-100">
                        <p class="font-medium text-neutral-700"><%= t(".decline_reasons_title") %>:</p>
                        <ul class="list-disc list-inside mt-1 space-y-0.5">
                          <% event.metadata["decline_reasons"].each do |reason| %>
                            <li><%= reason %></li>
                          <% end %>
                        </ul>
                      </div>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        <% else %>
          <p class="text-neutral-500 text-sm"><%= t(".no_events") %></p>
        <% end %>
      </section>
    </div>

    <%# ─── Right Sidebar ─── %>
    <div class="space-y-6">
      <%# ─── Withdraw Button (only when withdrawable) ─── %>
      <% if @request.withdrawable? %>
        <section class="bg-white rounded-xl shadow-sm border border-neutral-200 p-6 bento-enter bento-enter-d4">
          <h2 class="font-display text-lg font-bold text-neutral-800 mb-4"><%= t(".manage") %></h2>
          <p class="text-sm text-neutral-500 mb-4"><%= t(".withdraw_hint") %></p>
          <%= button_to withdraw_adoption_request_path(@request), method: :patch,
              data: { turbo_confirm: t(".confirm_withdraw"), turbo_method: :patch },
              class: "w-full px-6 py-3 bg-danger/10 hover:bg-danger/20 text-danger font-semibold rounded-xl transition-all duration-200 active:scale-[0.97] text-sm" do %>
            <div class="flex items-center justify-center gap-2">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M20 12H4"/>
              </svg>
              <%= t(".withdraw") %>
            </div>
          <% end %>
        </section>
      <% end %>

      <%# ─── Additional Answers (if any) ─── %>
      <% if @request.additional_answers.present? && @request.additional_answers.any? { |_, v| v.present? } %>
        <section class="bg-white rounded-xl shadow-sm border border-neutral-200 p-6 bento-enter bento-enter-d4">
          <h2 class="font-display text-lg font-bold text-neutral-800 mb-4"><%= t(".additional_info") %></h2>
          <div class="space-y-3">
            <% @request.additional_answers.each do |key, value| %>
              <% next if value.blank? %>
              <div>
                <p class="text-xs font-medium text-neutral-400 uppercase tracking-wider"><%= t("adoption_requests.additional_questions.#{key}", default: key.humanize) %></p>
                <p class="text-sm text-neutral-700 mt-0.5"><%= value %></p>
              </div>
            <% end %>
          </div>
        </section>
      <% end %>

      <%# Next Steps Card (gradient accent per status) %>
      <% card_gradient = case @request.status
        when "pending" then "from-primary-50 to-white border-primary-100"
        when "in_validation" then "from-info/5 to-white border-info/20"
        when "accepted" then "from-secondary-50 to-white border-secondary-100"
        when "declined" then "from-danger/5 to-white border-danger/20"
        else "from-neutral-50 to-white border-neutral-200"
        end %>
      <section class="bg-gradient-to-br <%= card_gradient %> rounded-xl shadow-sm border p-6 bento-enter bento-enter-d4">
        <h2 class="font-display text-lg font-bold text-neutral-800 mb-4"><%= t(".next_steps_title") %></h2>
        <% case @request.status %>
        <% when "pending" %>
          <div class="flex items-start gap-3">
            <div class="w-8 h-8 rounded-lg bg-primary-100 flex items-center justify-center shrink-0" aria-hidden="true">
              <svg class="w-4 h-4 text-primary-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
              </svg>
            </div>
            <p class="text-sm text-neutral-600"><%= t(".next_steps_pending") %></p>
          </div>
        <% when "in_validation" %>
          <div class="flex items-start gap-3">
            <div class="w-8 h-8 rounded-lg bg-info/10 flex items-center justify-center shrink-0" aria-hidden="true">
              <svg class="w-4 h-4 text-info" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
              </svg>
            </div>
            <p class="text-sm text-neutral-600"><%= t(".next_steps_validation") %></p>
          </div>
        <% when "accepted" %>
          <div class="flex items-start gap-3">
            <div class="w-8 h-8 rounded-lg bg-secondary-100 flex items-center justify-center shrink-0" aria-hidden="true">
              <svg class="w-4 h-4 text-secondary-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>
              </svg>
            </div>
            <p class="text-sm text-neutral-600"><%= t(".next_steps_accepted") %></p>
          </div>
        <% when "declined" %>
          <div class="flex items-start gap-3">
            <div class="w-8 h-8 rounded-lg bg-danger/10 flex items-center justify-center shrink-0" aria-hidden="true">
              <svg class="w-4 h-4 text-danger" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/>
              </svg>
            </div>
            <p class="text-sm text-neutral-600"><%= t(".next_steps_declined") %></p>
          </div>
        <% end %>
      </section>
    </div>
  </div>
</div>
