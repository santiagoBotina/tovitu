<%# ─── Zone 3: Commitment signals ─── %>
<%# Icon-coded signal rows: each signal shows its short label (the short phrase) %>
<%# plus the observation trimmed to a single line, with the full text on hover. %>
<% if presenter.commitment_signals.any? %>
  <div class="mb-4 bento-enter bento-enter-d3" data-testid="insight-signals">
    <h3 class="text-xs font-semibold text-neutral-500 uppercase tracking-wide mb-2"><%= t("ai.adopter_insight.card.commitment_title") %></h3>
    <ul class="space-y-2">
      <% presenter.commitment_signals.each do |signal| %>
        <li class="flex items-start gap-2.5">
          <span class="mt-0.5 w-6 h-6 rounded-full flex items-center justify-center shrink-0 <%= adopter_insight_signal_tint(signal[:kind]) %>" aria-hidden="true">
            <%= adopter_insight_signal_icon(signal[:kind]) %>
          </span>
          <div class="min-w-0">
            <p class="text-sm font-medium text-neutral-800"><%= signal[:label] %></p>
            <p class="text-xs text-neutral-500 truncate" title="<%= signal[:observation] %>"><%= truncate(signal[:observation], length: 110) %></p>
          </div>
        </li>
      <% end %>
    </ul>
  </div>
<% end %>
