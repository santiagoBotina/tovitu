<div class="w-full max-w-2xl mx-auto">
  <div class="mb-8">
    <h1 class="font-display text-3xl font-bold text-neutral-900"><%= t(".title") %></h1>
    <p class="text-neutral-500 mt-1"><%= t(".subtitle") %></p>
  </div>

  <div class="bg-white rounded-xl shadow-sm border border-neutral-200 overflow-hidden mb-6">
    <div class="p-6 border-b border-neutral-100">
      <h2 class="font-display text-lg font-bold text-neutral-800 mb-4"><%= t(".pet_section_title") %></h2>
      <div class="flex items-center gap-4">
        <div class="w-20 h-20 rounded-xl bg-neutral-100 overflow-hidden shrink-0">
          <% if @pet.primary_photo.present? %>
            <%= image_tag @pet.primary_photo.url(variant: :medium), alt: @pet.name, class: "w-full h-full object-cover" %>
          <% else %>
            <div class="w-full h-full flex items-center justify-center bg-primary-50">
              <svg class="w-10 h-10 text-primary-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
            </div>
          <% end %>
        </div>
        <div>
          <h3 class="font-bold text-neutral-900 text-lg"><%= @pet.name %></h3>
          <p class="text-sm text-neutral-500"><%= @pet.species.humanize %> · <%= @pet.breed.presence || t(".unknown_breed") %></p>
          <p class="text-sm text-neutral-500"><%= @shelter.name %> · <%= @shelter.city %>, <%= @shelter.state %></p>
        </div>
      </div>
    </div>

    <div class="p-6 border-b border-neutral-100">
      <div class="flex items-center justify-between mb-4">
        <h2 class="font-display text-lg font-bold text-neutral-800"><%= t(".profile_section_title") %></h2>
        <%= link_to edit_profile_path, class: "text-sm text-primary-500 hover:underline font-medium" do %>
          <%= t(".edit_profile") %>
        <% end %>
      </div>

      <%= render "adopter_profile_summary", profile: @profile %>
    </div>
  </div>

  <%= render "additional_questions", pet: @pet %>

  <%= form_tag adoption_requests_path(pet_id: @pet.id), method: :post, class: "space-y-4" do %>
    <div class="flex items-center gap-3">
      <%= submit_tag t(".submit"), class: "px-8 py-3 bg-primary-500 text-white font-semibold rounded-xl hover:bg-primary-600 active:bg-primary-700 transition-colors duration-200 cursor-pointer" %>
      <%= link_to pet_path(@pet), class: "px-8 py-3 text-neutral-600 font-medium rounded-xl border border-neutral-300 hover:bg-neutral-50 transition-colors duration-200" do %>
        <%= t(".cancel") %>
      <% end %>
    </div>
  <% end %>
</div>
