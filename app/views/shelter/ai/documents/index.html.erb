<div class="max-w-4xl mx-auto px-4 py-8">
  <div class="flex items-center justify-between mb-6">
    <h1 class="font-display text-2xl font-bold text-neutral-900"><%= t(".title") %></h1>
    <%= link_to t(".upload"), new_shelter_ai_document_path,
                class: "px-4 py-2 bg-primary-500 text-white text-sm font-medium rounded-lg hover:bg-primary-600 transition" %>
  </div>

  <% if @documents.any? %>
    <div class="space-y-3">
      <% @documents.each do |document| %>
        <div class="bg-white rounded-xl shadow-sm border border-neutral-200 p-4 flex items-center justify-between">
          <div class="flex items-center gap-3">
            <div class="flex-shrink-0">
              <% if document.source_type == "pdf" %>
                <svg class="w-8 h-8 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/>
                </svg>
              <% else %>
                <svg class="w-8 h-8 text-neutral-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                </svg>
              <% end %>
            </div>
            <div>
              <p class="font-medium text-neutral-800"><%= document.title %></p>
              <p class="text-xs text-neutral-500"><%= t("ai.status.#{document.status}") %></p>
              <% if document.status == "failed" && document.error_message.present? %>
                <p class="text-xs text-danger mt-1"><%= document.error_message %></p>
              <% end %>
            </div>
          </div>
          <div class="flex items-center gap-2">
            <span class="px-2.5 py-0.5 rounded-full text-xs font-medium
              <%= document.status == "ready" ? "bg-success/10 text-success" :
                 document.status == "failed" ? "bg-danger/10 text-danger" :
                 "bg-warning/10 text-warning" %>">
              <%= t("ai.status.#{document.status}") %>
            </span>
            <%= button_to shelter_ai_document_path(document),
                method: :delete,
                data: { confirm: t(".confirm_delete") },
                class: "p-1.5 text-neutral-500 hover:text-danger transition" do %>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
              </svg>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-12 bg-white rounded-xl shadow-sm border border-neutral-200">
      <div class="w-14 h-14 bg-neutral-100 rounded-full flex items-center justify-center mx-auto mb-4">
        <svg class="w-7 h-7 text-neutral-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
        </svg>
      </div>
      <p class="text-neutral-500"><%= t(".empty") %></p>
      <%= link_to t(".upload"), new_shelter_ai_document_path,
                  class: "mt-3 inline-flex px-4 py-2 bg-primary-500 text-white text-sm font-medium rounded-lg hover:bg-primary-600 transition" %>
    </div>
  <% end %>
</div>
