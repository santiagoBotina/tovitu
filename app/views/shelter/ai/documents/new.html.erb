<%# ─── AI Documents New Page ─── %>
<%# Design: Dashboard-level form card with consistent styling %>
<div class="max-w-2xl mx-auto px-4 py-8">

  <%# ─── Back link ─── %>
  <%= link_to shelter_ai_documents_path, class: "inline-flex items-center gap-1.5 text-neutral-500 hover:text-neutral-700 text-sm mb-6 transition bento-enter bento-enter-d1" do %>
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
    <%= t(".back") %>
  <% end %>

  <%# ─── Page Header ─── %>
  <header class="mb-6 bento-enter bento-enter-d1">
    <h1 class="font-display text-2xl font-bold text-neutral-900"><%= t(".title") %></h1>
    <p class="text-neutral-500 text-sm mt-1"><%= t(".subtitle") %></p>
  </header>

  <%= form_with model: @document, url: shelter_ai_documents_path, local: true, class: "bg-white rounded-xl p-8 shadow-sm border border-neutral-200 bento-enter bento-enter-d2" do |f| %>
    <% if @document.errors.any? %>
      <div class="bg-red-50 border border-red-200 rounded-xl p-4 mb-6">
        <h2 class="text-red-700 font-medium text-sm"><%= pluralize(@document.errors.count, "error") %> prohibited this from being saved:</h2>
        <ul class="mt-2 list-disc list-inside text-sm text-red-600">
          <% @document.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="space-y-5">
      <div>
        <%= f.label :title, t(".title_label"), class: "block text-sm font-medium text-neutral-700 mb-1.5" %>
        <%= f.text_field :title, required: true, class: "w-full px-4 py-3 border border-neutral-300 rounded-xl shadow-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 text-sm transition" %>
      </div>

      <div>
        <span class="block text-sm font-medium text-neutral-700 mb-2"><%= t(".source_type") %></span>
        <div class="flex gap-4">
          <label class="flex items-center gap-2 cursor-pointer p-2 rounded-lg hover:bg-neutral-50 transition-colors">
            <%= f.radio_button :source_type, "manual", class: "text-primary-500 focus:ring-primary-500", checked: true %>
            <span class="text-sm text-neutral-700"><%= t(".manual") %></span>
          </label>
          <label class="flex items-center gap-2 cursor-pointer p-2 rounded-lg hover:bg-neutral-50 transition-colors">
            <%= f.radio_button :source_type, "pdf", class: "text-primary-500 focus:ring-primary-500" %>
            <span class="text-sm text-neutral-700"><%= t(".pdf") %></span>
          </label>
        </div>
      </div>

      <div id="manual-content" class="space-y-4">
        <div>
          <%= f.label :content, t(".content_label"), class: "block text-sm font-medium text-neutral-700 mb-1.5" %>
          <%= f.text_area :content, rows: 12,
              class: "w-full px-4 py-3 border border-neutral-300 rounded-xl shadow-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 text-sm transition font-mono",
              placeholder: t(".content_placeholder") %>
          <p class="text-xs text-neutral-500 mt-1"><%= t(".content_hint") %></p>
        </div>
      </div>

      <div id="pdf-upload" class="hidden space-y-4">
        <div>
          <%= f.label :file, t(".file_label"), class: "block text-sm font-medium text-neutral-700 mb-1.5" %>
          <%= f.file_field :file, accept: ".pdf",
              class: "w-full px-4 py-3 border border-neutral-300 rounded-xl shadow-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 text-sm transition file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-medium file:bg-primary-50 file:text-primary-600 hover:file:bg-primary-100" %>
        </div>
      </div>
    </div>

    <div class="mt-8">
      <%= f.submit t(".submit"), class: "w-full px-6 py-3.5 bg-primary-500 text-white font-semibold rounded-xl hover:bg-primary-600 focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 transition-all duration-200 active:scale-[0.97] shadow-sm cursor-pointer" %>
    </div>
  <% end %>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    const radios = document.querySelectorAll("input[name='ai_document[source_type]']");
    const manualSection = document.getElementById("manual-content");
    const pdfSection = document.getElementById("pdf-upload");

    radios.forEach(function(radio) {
      radio.addEventListener("change", function() {
        if (this.value === "manual") {
          manualSection.classList.remove("hidden");
          pdfSection.classList.add("hidden");
        } else {
          manualSection.classList.add("hidden");
          pdfSection.classList.remove("hidden");
        }
      });
    });
  });
</script>
