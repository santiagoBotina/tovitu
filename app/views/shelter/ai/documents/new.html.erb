<div class="max-w-2xl mx-auto px-4 py-8">
  <%= link_to shelter_ai_documents_path, class: "inline-flex items-center gap-1.5 text-neutral-500 hover:text-neutral-700 text-sm mb-6 transition" do %>
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
    <%= t(".back") %>
  <% end %>

  <h1 class="font-display text-2xl font-bold text-neutral-900 mb-6"><%= t(".title") %></h1>

  <%= form_with model: @document, url: shelter_ai_documents_path, local: true, class: "space-y-6" do |f| %>
    <% if @document.errors.any? %>
      <div class="bg-red-50 border border-red-200 rounded-lg p-4 mb-6">
        <h2 class="text-red-700 font-medium text-sm"><%= pluralize(@document.errors.count, "error") %> prohibited this from being saved:</h2>
        <ul class="mt-2 list-disc list-inside text-sm text-red-600">
          <% @document.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= f.label :title, t(".title_label"), class: "block text-sm font-medium text-neutral-700 mb-1" %>
      <%= f.text_field :title, required: true, class: "w-full px-4 py-2 border border-neutral-300 rounded-lg text-sm focus:ring-2 focus:ring-primary-500 focus:border-primary-500" %>
    </div>

    <div>
      <span class="block text-sm font-medium text-neutral-700 mb-2"><%= t(".source_type") %></span>
      <div class="flex gap-4">
        <label class="flex items-center gap-2 cursor-pointer">
          <%= f.radio_button :source_type, "manual", class: "text-primary-500 focus:ring-primary-500", checked: true %>
          <span class="text-sm text-neutral-700"><%= t(".manual") %></span>
        </label>
        <label class="flex items-center gap-2 cursor-pointer">
          <%= f.radio_button :source_type, "pdf", class: "text-primary-500 focus:ring-primary-500" %>
          <span class="text-sm text-neutral-700"><%= t(".pdf") %></span>
        </label>
      </div>
    </div>

    <div id="manual-content" class="space-y-4">
      <div>
        <%= f.label :content, t(".content_label"), class: "block text-sm font-medium text-neutral-700 mb-1" %>
        <%= f.text_area :content, rows: 12,
            class: "w-full px-4 py-2 border border-neutral-300 rounded-lg text-sm focus:ring-2 focus:ring-primary-500 focus:border-primary-500 font-mono",
            placeholder: t(".content_placeholder") %>
        <p class="text-xs text-neutral-500 mt-1"><%= t(".content_hint") %></p>
      </div>
    </div>

    <div id="pdf-upload" class="hidden space-y-4">
      <div>
        <%= f.label :file, t(".file_label"), class: "block text-sm font-medium text-neutral-700 mb-1" %>
        <%= f.file_field :file, accept: ".pdf",
            class: "w-full px-4 py-2 border border-neutral-300 rounded-lg text-sm focus:ring-2 focus:ring-primary-500 focus:border-primary-500" %>
      </div>
    </div>

    <%= f.submit t(".submit"), class: "w-full px-4 py-2.5 bg-primary-500 text-white font-medium rounded-lg hover:bg-primary-600 transition" %>
  <% end %>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    const radios = document.querySelectorAll("input[name='ai_document[source_type]']");
    const manualSection = document.getElementById("manual-content");
    const pdfSection = document.getElementById("pdf-upload");

    radios.forEach(function(radio) {
      radio.addEventListener("change", function() {
        if (this.value === "manual") {
          manualSection.classList.remove("hidden");
          pdfSection.classList.add("hidden");
        } else {
          manualSection.classList.add("hidden");
          pdfSection.classList.remove("hidden");
        }
      });
    });
  });
</script>
