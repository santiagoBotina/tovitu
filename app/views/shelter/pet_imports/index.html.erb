<%# ─── Shelter Pet Imports Index ─── %>
<div class="w-full max-w-5xl mx-auto">

  <%# ─── Page Header ─── %>
  <%= render "shared/section_header",
             title: t(".title"),
             subtitle: t(".subtitle"),
             header_class: "flex items-center justify-between mb-6 bento-enter bento-enter-d1" do %>
    <%= link_to new_shelter_pet_import_path, class: "inline-flex items-center gap-2 bg-secondary-500 hover:bg-secondary-600 text-white px-5 py-2.5 rounded-xl font-semibold text-sm transition-all duration-200 active:scale-[0.97] focus-visible:ring-2 focus-visible:ring-secondary-500 focus-visible:ring-offset-2 shadow-sm" do %>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
      </svg>
      <%= t(".new_import") %>
    <% end %>
  <% end %>

  <% if @pet_imports.any? %>
    <div class="space-y-3 bento-enter bento-enter-d2">
      <% @pet_imports.each do |import| %>
        <%= link_to shelter_pet_import_path(import), class: "block bg-white rounded-xl shadow-sm border border-neutral-200 p-5 hover:border-secondary-300 hover:shadow-sm transition-all duration-200" do %>
          <div class="flex items-center justify-between gap-4">
            <div class="flex items-center gap-4 min-w-0">
              <div class="w-10 h-10 rounded-lg bg-secondary-50 flex items-center justify-center shrink-0" aria-hidden="true">
                <svg class="w-5 h-5 text-secondary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10a2 2 0 002 2h2a2 2 0 002-2M9 7a2 2 0 012-2h2a2 2 0 012 2m0 10V7m0 10a2 2 0 002 2h2a2 2 0 002-2V7a2 2 0 00-2-2h-2a2 2 0 00-2 2"/>
                </svg>
              </div>
              <div class="min-w-0">
                <p class="font-medium text-neutral-900 truncate"><%= import.file_name %></p>
                <p class="text-sm text-neutral-500"><%= t(".imported_on", date: l(import.created_at, format: :long)) %></p>
              </div>
            </div>
            <div class="flex items-center gap-3 shrink-0">
              <span class="text-sm text-neutral-600 font-medium"><%= t(".count", imported: import.imported_count, total: import.total_count) %></span>
              <span class="px-3 py-1 rounded-full text-xs font-semibold <%= import.completed? ? 'bg-secondary-50 text-secondary-700' : import.failed? ? 'bg-danger/10 text-danger' : 'bg-warning/10 text-warning-700' %>">
                <%= pet_import_status_label(import) %>
              </span>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <%# ─── Empty State ─── %>
    <div class="text-center py-16 bg-white rounded-xl shadow-sm border border-neutral-200 bento-enter bento-enter-d2">
      <div class="w-16 h-16 mx-auto mb-4 rounded-xl bg-secondary-50 flex items-center justify-center" aria-hidden="true">
        <svg class="w-8 h-8 text-secondary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/>
        </svg>
      </div>
      <h3 class="font-display text-xl font-bold text-neutral-700 mb-2"><%= t(".empty_title") %></h3>
      <p class="text-sm text-neutral-500 mb-6 max-w-sm mx-auto"><%= t(".empty_body") %></p>
      <%= link_to new_shelter_pet_import_path, class: "inline-flex items-center gap-2 bg-secondary-500 hover:bg-secondary-600 text-white px-6 py-3 rounded-xl font-semibold transition-all duration-200 active:scale-[0.97] shadow-sm" do %>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
        </svg>
        <%= t(".new_import") %>
      <% end %>
    </div>
  <% end %>
</div>