<%# ─── Pet Import Progress Notice ─── %>
<%# Server-driven import status rendered on the show page. The pet-import
    controller polls the per-import status endpoint and swaps this notice (and,
    once done, the summary) in place. data-pet-import-status drives the polling:
    pending/processing → keep polling, failed → stop (wait for retry/new import),
    completed → stop. %>
<% if pet_import.pending? %>
  <div id="pet-import-notice" data-pet-import-status="pending" role="status" class="bg-secondary-50 border border-secondary-200 rounded-xl p-5 mb-6 flex items-center gap-4">
    <div class="w-10 h-10 rounded-xl bg-secondary-100 flex items-center justify-center shrink-0" aria-hidden="true">
      <svg class="w-5 h-5 text-secondary-600 animate-spin" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 12a9 9 0 11-6.219-8.56"/>
      </svg>
    </div>
    <div class="flex-1 min-w-0">
      <p class="font-display text-base font-bold text-neutral-900"><%= t("shelter.pet_imports.progress.importing_title") %></p>
      <p class="text-sm text-neutral-600"><%= t("shelter.pet_imports.progress.importing_body") %></p>
    </div>
  </div>
<% elsif pet_import.failed? %>
  <div id="pet-import-notice" data-pet-import-status="failed" role="alert" class="bg-danger/5 border border-danger/20 rounded-xl p-5 mb-6 flex items-start gap-4">
    <div class="w-10 h-10 rounded-xl bg-danger/10 flex items-center justify-center shrink-0" aria-hidden="true">
      <svg class="w-5 h-5 text-danger" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
      </svg>
    </div>
    <div class="flex-1 min-w-0">
      <p class="font-display text-base font-bold text-neutral-900"><%= t("shelter.pet_imports.progress.failed_title") %></p>
      <p class="text-sm text-neutral-600"><%= pet_import.error.presence || t("shelter.pet_imports.progress.failed_body") %></p>
    </div>
  </div>
<% else %>
  <div id="pet-import-notice" data-pet-import-status="completed" class="hidden" aria-hidden="true"></div>
<% end %>