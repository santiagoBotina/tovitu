<%# ─── Shelter Pet Show Page ─── %>
<%# Design: Dashboard-level bento cards, photo gallery with image-reveal, micro-interactions %>
<% pet = @pet %>
<div class="w-full max-w-4xl mx-auto">
  <%# ─── Back link ─── %>
  <div class="mb-6 bento-enter bento-enter-d1">
    <%= render "shared/back_link", path: safe_back_path(shelter_pets_path), label: params[:back_to].present? ? t("shared.back") : t(".back_to_pets") %>
  </div>

  <%# ─── Pet Header Card ─── %>
  <section class="bg-white rounded-xl shadow-sm border border-neutral-200 p-6 mb-6 bento-enter bento-enter-d2">
    <div class="flex items-start justify-between">
      <div>
        <div class="flex items-center gap-3 mb-2">
          <h1 class="font-display text-3xl font-bold text-neutral-900"><%= pet.name %></h1>
          <%= render "pets/status_badge", status: pet.status %>
        </div>
        <p class="text-neutral-500 text-sm"><%= pet.species_label %><% if pet.breed.present? %> · <%= pet.breed %><% end %> · <%= pet.age_display %></p>
      </div>
      <div class="flex items-center gap-3">
        <%= link_to edit_shelter_pet_path(id: pet.id), class: "inline-flex items-center gap-2 bg-white border border-neutral-300 text-neutral-700 hover:bg-neutral-50 px-4 py-2 rounded-xl text-sm font-medium transition-all duration-200 active:scale-[0.97] focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 card-lift" do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
          </svg>
          <%= t(".edit") %>
        <% end %>
        <%= link_to shelter_pet_path(id: pet.id), data: { turbo_method: :delete, turbo_confirm: t(".delete_confirm", name: pet.name) }, class: "inline-flex items-center gap-2 bg-white border border-red-300 text-red-600 hover:bg-red-50 px-4 py-2 rounded-xl text-sm font-medium transition-all duration-200 active:scale-[0.97] card-lift" do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
          </svg>
          <%= t(".delete") %>
        <% end %>
      </div>
    </div>

    <%# ─── Status Change Actions ─── %>
    <div class="mt-6 pt-6 border-t border-neutral-200">
      <h3 class="text-sm font-semibold text-neutral-700 mb-3"><%= t(".change_status") %></h3>
      <div class="flex flex-wrap gap-2">
        <% Pet::STATUSES.each do |status| %>
          <% next if status == pet.status || status == "removed" %>
          <%= button_to change_status_shelter_pet_path(id: pet.id), method: :patch, params: { status: status }, class: "px-4 py-2 rounded-xl text-sm font-medium border transition-all duration-200 active:scale-[0.97] #{status == 'available' ? 'border-secondary-300 text-secondary-700 hover:bg-secondary-50' : status == 'on_hold' ? 'border-yellow-300 text-yellow-700 hover:bg-yellow-50' : status == 'adopted' ? 'border-blue-300 text-blue-700 hover:bg-blue-50' : 'border-red-300 text-red-700 hover:bg-red-50'}" do %>
            <%= t("pets.status.#{status}") %>
          <% end %>
        <% end %>
      </div>
    </div>
  </section>

  <%# ─── Photo Gallery ─── %>
  <section class="bg-white rounded-xl shadow-sm border border-neutral-200 p-6 mb-6 bento-enter bento-enter-d3">
    <div class="flex items-center justify-between mb-4">
      <h2 class="font-display text-lg font-bold text-neutral-800"><%= t(".photos") %></h2>
      <%= form_tag shelter_pet_photos_path(pet), method: :post, multipart: true, class: "inline-flex" do %>
        <%= file_field_tag :file, accept: "image/jpeg,image/png,image/webp", class: "hidden", id: "photo-upload", onchange: "this.form.submit()" %>
        <%= label_tag "photo-upload", class: "inline-flex items-center gap-2 bg-secondary-500 hover:bg-secondary-600 text-white px-4 py-2 rounded-xl text-sm font-medium transition-all duration-200 active:scale-[0.97] cursor-pointer shadow-sm" do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
          </svg>
          <%= t(".add_photo") %>
        <% end %>
      <% end %>
    </div>

    <% if pet.photo_gallery.any? %>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">
        <% pet.photo_gallery(variant: :medium).each_with_index do |photo_url, index| %>
          <div class="relative group aspect-square rounded-xl overflow-hidden bg-neutral-100 shadow-sm bento-enter bento-enter-d<%= ((index % 4) + 1) %> card-lift">
            <%= image_tag photo_url, alt: t(".photo_alt", name: pet.name, index: index + 1), class: "w-full h-full object-cover image-reveal" %>
            <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center gap-2">
              <%= link_to shelter_pet_photo_path(pet.id, pet.ordered_photos[index].blob_id), data: { turbo_method: :delete, turbo_confirm: t(".delete_photo_confirm") }, class: "w-8 h-8 bg-red-500 text-white rounded-full flex items-center justify-center hover:bg-red-600 transition-colors active:scale-[0.97]" do %>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                </svg>
              <% end %>
            </div>
            <% if index == 0 %>
              <span class="absolute top-2 left-2 bg-secondary-500 text-white text-xs font-medium px-2 py-0.5 rounded-full shadow-sm"><%= t(".primary_photo") %></span>
            <% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="text-center py-10 bg-neutral-50 rounded-xl">
        <svg class="w-10 h-10 text-neutral-300 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
        </svg>
        <p class="text-neutral-500 text-sm"><%= t(".no_photos") %></p>
      </div>
    <% end %>
  </section>

  <%# ─── Details & Medical Cards ─── %>
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
    <section class="bg-white rounded-xl shadow-sm border border-neutral-200 p-6 bento-enter bento-enter-d4">
      <h2 class="font-display text-lg font-bold text-neutral-800 mb-4"><%= t(".details") %></h2>
      <dl class="space-y-3">
        <div class="flex justify-between py-2 border-b border-neutral-100">
          <dt class="text-sm text-neutral-500"><%= t(".species_label") %></dt>
          <dd class="text-sm font-medium text-neutral-800"><%= pet.species_label %></dd>
        </div>
        <% if pet.breed.present? %>
          <div class="flex justify-between py-2 border-b border-neutral-100">
            <dt class="text-sm text-neutral-500"><%= t(".breed_label") %></dt>
            <dd class="text-sm font-medium text-neutral-800"><%= pet.breed %></dd>
          </div>
        <% end %>
        <div class="flex justify-between py-2 border-b border-neutral-100">
          <dt class="text-sm text-neutral-500"><%= t(".age_label") %></dt>
          <dd class="text-sm font-medium text-neutral-800"><%= pet.age_display %></dd>
        </div>
        <div class="flex justify-between py-2 border-b border-neutral-100">
          <dt class="text-sm text-neutral-500"><%= t(".size_label") %></dt>
          <dd class="text-sm font-medium text-neutral-800"><%= pet.size_label || "—" %></dd>
        </div>
        <div class="flex justify-between py-2">
          <dt class="text-sm text-neutral-500"><%= t(".sex_label") %></dt>
          <dd class="text-sm font-medium text-neutral-800"><%= pet.sex_label %></dd>
        </div>
      </dl>
    </section>

    <section class="bg-white rounded-xl shadow-sm border border-neutral-200 p-6 bento-enter bento-enter-d5">
      <h2 class="font-display text-lg font-bold text-neutral-800 mb-4"><%= t(".medical") %></h2>
      <div class="space-y-3">
        <div class="flex items-center gap-3 p-3 rounded-xl <%= pet.spayed_neutered? ? 'bg-secondary-50' : 'bg-neutral-50' %>">
          <div class="w-6 h-6 flex items-center justify-center rounded-full <%= pet.spayed_neutered? ? 'bg-secondary-100 text-secondary-600' : 'bg-neutral-200 text-neutral-400' %>">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <% if pet.spayed_neutered? %>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/>
              <% end %>
            </svg>
          </div>
          <span class="text-sm font-medium <%= pet.spayed_neutered? ? 'text-secondary-700' : 'text-neutral-500' %>"><%= t("pets.attributes.spayed_neutered") %></span>
        </div>
        <div class="flex items-center gap-3 p-3 rounded-xl <%= pet.vaccinated? ? 'bg-secondary-50' : 'bg-neutral-50' %>">
          <div class="w-6 h-6 flex items-center justify-center rounded-full <%= pet.vaccinated? ? 'bg-secondary-100 text-secondary-600' : 'bg-neutral-200 text-neutral-400' %>">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <% if pet.vaccinated? %>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/>
              <% end %>
            </svg>
          </div>
          <span class="text-sm font-medium <%= pet.vaccinated? ? 'text-secondary-700' : 'text-neutral-500' %>"><%= t("pets.attributes.vaccinated") %></span>
        </div>
        <div class="flex items-center gap-3 p-3 rounded-xl <%= pet.special_needs? ? 'bg-secondary-50' : 'bg-neutral-50' %>">
          <div class="w-6 h-6 flex items-center justify-center rounded-full <%= pet.special_needs? ? 'bg-secondary-100 text-secondary-600' : 'bg-neutral-200 text-neutral-400' %>">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <% if pet.special_needs? %>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/>
              <% end %>
            </svg>
          </div>
          <span class="text-sm font-medium <%= pet.special_needs? ? 'text-secondary-700' : 'text-neutral-500' %>"><%= t("pets.attributes.special_needs") %></span>
        </div>
      </div>
    </section>
  </div>

  <%# ─── Description Card ─── %>
  <% if pet.description.present? %>
    <section class="bg-white rounded-xl shadow-sm border border-neutral-200 p-6 mb-6 bento-enter bento-enter-d5">
      <h2 class="font-display text-lg font-bold text-neutral-800 mb-3"><%= t(".description") %></h2>
      <p class="text-neutral-600 leading-relaxed whitespace-pre-wrap"><%= pet.description %></p>
    </section>
  <% end %>

  <%# ─── Medical Notes Card ─── %>
  <% if pet.medical_notes.present? %>
    <section class="bg-white rounded-xl shadow-sm border border-neutral-200 p-6 mb-6 bento-enter bento-enter-d6">
      <h2 class="font-display text-lg font-bold text-neutral-800 mb-3"><%= t(".medical_notes") %></h2>
      <p class="text-neutral-600 leading-relaxed whitespace-pre-wrap"><%= pet.medical_notes %></p>
    </section>
  <% end %>

  <%# ─── Personality Card ─── %>
  <% if pet.personality_traits_list.any? %>
    <section class="bg-white rounded-xl shadow-sm border border-neutral-200 p-6 mb-6 bento-enter bento-enter-d6">
      <h2 class="font-display text-lg font-bold text-neutral-800 mb-3"><%= t(".personality") %></h2>
      <div class="flex flex-wrap gap-2">
        <% pet.personality_traits_list.each do |trait| %>
          <span class="px-3 py-1.5 bg-secondary-50 text-secondary-600 text-sm font-medium rounded-full capitalize"><%= trait %></span>
        <% end %>
      </div>
    </section>
  <% end %>
</div>
