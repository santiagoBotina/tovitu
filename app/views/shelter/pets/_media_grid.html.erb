<%# ─── Pet Media Grid ─── %>
<%# Ordered photo cards with primary badge, set-primary, move up/down, and
    delete controls. Every action is scoped to the passed pet. %>
<% ordered = pet.ordered_photos %>
<% urls = presented_pet.photo_gallery(variant: :medium) %>
<% primary_blob_id = pet.primary_photo&.blob_id %>
<% arrow_class = "w-7 h-7 rounded-lg bg-white/90 text-neutral-700 hover:bg-white transition-colors flex items-center justify-center disabled:opacity-40 disabled:cursor-not-allowed active:scale-[0.97]" %>

<% if ordered.any? %>
  <section class="bg-white rounded-xl shadow-sm border border-neutral-200 p-6 bento-enter bento-enter-d4">
    <div class="flex items-center justify-between mb-4">
      <h2 class="font-display text-lg font-bold text-neutral-800"><%= t(".photos_title", count: ordered.length) %></h2>
    </div>
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
      <% ordered.each_with_index do |photo, index| %>
        <div class="relative group aspect-square rounded-xl overflow-hidden bg-neutral-100 shadow-sm <%= photo.blob_id == primary_blob_id ? 'ring-2 ring-secondary-500' : '' %>">
          <%= image_tag urls[index], alt: t(".photo_alt", name: pet.name, index: index + 1), loading: "lazy", decoding: "async", width: 400, height: 400, class: "w-full h-full object-cover" %>

          <% if photo.blob_id == primary_blob_id %>
            <span class="absolute top-2 left-2 bg-secondary-500 text-white text-xs font-medium px-2 py-0.5 rounded-full shadow-sm"><%= t(".primary_badge") %></span>
          <% end %>

          <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/60 to-transparent p-2">
            <div class="flex items-center justify-between gap-1">
              <% unless photo.blob_id == primary_blob_id %>
                <%= button_to set_primary_shelter_pet_photo_path(pet, photo.blob_id), method: :post, class: "inline-flex items-center gap-1 bg-secondary-500 hover:bg-secondary-600 text-white text-xs font-semibold px-3 py-1.5 rounded-lg transition-colors active:scale-[0.97]" do %>
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                  </svg>
                  <%= t(".set_primary") %>
                <% end %>
              <% end %>

              <div class="flex items-center gap-1">
                <%= button_to move_shelter_pet_photo_path(pet, photo.blob_id), method: :post, params: { direction: "up" }, disabled: index == 0, title: t(".move_up"), class: arrow_class, "aria-label": t(".move_up") do %>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"/>
                  </svg>
                <% end %>
                <%= button_to move_shelter_pet_photo_path(pet, photo.blob_id), method: :post, params: { direction: "down" }, disabled: index == ordered.length - 1, title: t(".move_down"), class: arrow_class, "aria-label": t(".move_down") do %>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                  </svg>
                <% end %>
              </div>

              <%= button_to shelter_pet_photo_path(pet, photo.blob_id), method: :delete, data: { turbo_confirm: t(".delete_confirm") }, title: t(".delete"), class: "w-7 h-7 rounded-lg bg-red-500/90 text-white hover:bg-red-600 transition-colors flex items-center justify-center active:scale-[0.97]", "aria-label": t(".delete") do %>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                </svg>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
    <p class="mt-4 text-xs text-neutral-400"><%= t(".ordering_hint") %></p>
  </section>
<% else %>
  <%# ─── Empty State ─── %>
  <div class="text-center py-16 bg-white rounded-xl shadow-sm border border-neutral-200 bento-enter bento-enter-d4">
    <div class="w-16 h-16 mx-auto mb-4 rounded-xl bg-secondary-50 flex items-center justify-center" aria-hidden="true">
      <svg class="w-8 h-8 text-secondary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
      </svg>
    </div>
    <h3 class="font-display text-xl font-bold text-neutral-700 mb-2"><%= t(".empty_title") %></h3>
    <p class="text-sm text-neutral-500 mb-2 max-w-sm mx-auto"><%= t(".empty_body") %></p>
    <p class="text-xs text-neutral-400"><%= t(".empty_hint") %></p>
  </div>
<% end %>