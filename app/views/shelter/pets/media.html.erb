<%# ─── Pet Media Management Page ─── %>
<%# Dedicated media section: add images from the computer (multiple) or by URL,
    reorder, mark primary, delete. All actions are per-pet (no cross-association
    UI) and respond with turbo_stream that swaps the grid + shows a toast. %>
<% pet = @pet %>
<div class="w-full max-w-4xl mx-auto">

  <div class="mt-6 mb-6 bento-enter bento-enter-d1">
    <%= render "shared/back_link", path: safe_back_path(shelter_pet_path(pet)), label: t(".back_to_pet") %>
  </div>

  <%# ─── Pet Header ─── %>
  <section class="bg-white rounded-xl shadow-sm border border-neutral-200 p-6 mb-6 bento-enter bento-enter-d2">
    <div class="flex items-start justify-between gap-4">
      <div>
        <div class="flex items-center gap-3 mb-1">
          <h1 class="font-display text-2xl font-bold text-neutral-900"><%= pet.name %></h1>
          <%= render "pets/status_badge", status: pet.status %>
        </div>
        <p class="text-neutral-500 text-sm"><%= @pet.species_label %><% if pet.breed.present? %> · <%= pet.breed %><% end %></p>
      </div>
      <%= link_to shelter_pet_path(pet), class: "inline-flex items-center gap-2 bg-white border border-neutral-300 text-neutral-700 hover:bg-neutral-50 px-4 py-2 rounded-xl text-sm font-medium transition-all duration-200 active:scale-[0.97] shrink-0" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
        <%= t(".view_pet") %>
      <% end %>
    </div>
  </section>

  <%# ─── Add Photos (computer + URL) ─── %>
  <section class="bg-white rounded-xl shadow-sm border border-neutral-200 p-6 mb-6 bento-enter bento-enter-d3" data-controller="pet-media">
    <h2 class="font-display text-lg font-bold text-neutral-800 mb-1"><%= t(".add_title") %></h2>
    <p class="text-sm text-neutral-600 mb-5"><%= t(".add_body") %></p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <%# ─── Multi-upload ─── %>
      <div>
        <span class="text-sm font-medium text-neutral-700 block mb-2"><%= t(".upload_label") %></span>
        <%= form_tag shelter_pet_photos_path(pet), method: :post, multipart: true, data: { turbo_stream: true, pet_media_target: "uploadForm" } do %>
          <%= file_field_tag "files[]", multiple: true, accept: "image/jpeg,image/png,image/webp",
                id: "pet-media-files", class: "hidden",
                data: { pet_media_target: "files", action: "change->pet-media#submitFiles" } %>
          <label for="pet-media-files" class="flex flex-col items-center justify-center gap-2 w-full border-2 border-dashed border-neutral-300 rounded-xl px-4 py-8 text-center cursor-pointer hover:border-secondary-400 hover:bg-secondary-50/50 transition-colors">
            <svg class="w-8 h-8 text-neutral-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 4v16m8-8H4"/>
            </svg>
            <span class="text-sm font-medium text-neutral-600"><%= t(".upload_hint") %></span>
            <span class="text-xs text-neutral-400"><%= t(".upload_limits") %></span>
          </label>
          <p data-pet-media-target="count" data-count-template="<%= t(".selected_count", count: "%{count}") %>" class="hidden mt-2 text-sm font-medium text-secondary-700"></p>
        <% end %>
      </div>

      <%# ─── URL add ─── %>
      <div>
        <span class="text-sm font-medium text-neutral-700 block mb-2"><%= t(".url_label") %></span>
        <%= form_tag shelter_pet_photos_path(pet), method: :post, data: { turbo_stream: true }, class: "flex flex-col gap-3" do %>
          <%= url_field_tag :url, nil, placeholder: t(".url_placeholder"), class: "w-full rounded-xl border border-neutral-300 px-4 py-2.5 text-sm focus:ring-2 focus:ring-secondary-500 focus:border-secondary-500" %>
          <%= submit_tag t(".url_submit"), class: "self-start inline-flex items-center gap-2 bg-secondary-500 hover:bg-secondary-600 text-white px-5 py-2.5 rounded-xl text-sm font-semibold transition-all duration-200 active:scale-[0.97] shadow-sm" %>
        <% end %>
      </div>
    </div>
  </section>

  <%# ─── Photo Grid ─── %>
  <div id="pet-media-grid">
    <%= render "shelter/pets/media_grid", pet: pet, presented_pet: @pet %>
  </div>
</div>