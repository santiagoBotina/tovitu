<div class="w-full max-w-5xl mx-auto">
  <div class="flex items-center justify-between mb-8">
    <div>
      <h1 class="font-display text-3xl font-bold text-neutral-900"><%= t(".title") %></h1>
      <p class="text-neutral-500 mt-1"><%= t(".subtitle") %></p>
    </div>
    <%= link_to new_shelter_pet_path, class: "inline-flex items-center gap-2 bg-green-600 hover:bg-green-700 text-white px-5 py-2.5 rounded-xl font-medium transition-colors duration-200 shadow-sm" do %>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
      </svg>
      <%= t(".add_pet") %>
    <% end %>
  </div>

  <div class="flex flex-wrap gap-2 mb-6">
    <%= link_to shelter_pets_path, class: "px-4 py-2 rounded-full text-sm font-medium transition-colors #{params[:status].blank? ? 'bg-green-600 text-white' : 'bg-white text-neutral-600 border border-neutral-300 hover:border-green-300'}" do %>
      <%= t(".all") %>
    <% end %>
    <% Pet::STATUSES.each do |status| %>
      <%= link_to shelter_pets_path(status: status), class: "px-4 py-2 rounded-full text-sm font-medium transition-colors #{params[:status] == status ? 'bg-green-600 text-white' : 'bg-white text-neutral-600 border border-neutral-300 hover:border-green-300'}" do %>
        <%= t("pets.status.#{status}") %>
      <% end %>
    <% end %>
  </div>

  <% if @presented_pets.any? %>
    <div class="bg-white rounded-xl shadow-sm border border-neutral-200 overflow-hidden">
      <table class="w-full">
        <thead>
          <tr class="border-b border-neutral-200 bg-neutral-50">
            <th class="text-left px-6 py-3 text-xs font-medium text-neutral-500 uppercase tracking-wider"><%= t(".table.name") %></th>
            <th class="text-left px-6 py-3 text-xs font-medium text-neutral-500 uppercase tracking-wider"><%= t(".table.species") %></th>
            <th class="text-left px-6 py-3 text-xs font-medium text-neutral-500 uppercase tracking-wider"><%= t(".table.status") %></th>
            <th class="text-left px-6 py-3 text-xs font-medium text-neutral-500 uppercase tracking-wider"><%= t(".table.listed") %></th>
            <th class="text-right px-6 py-3 text-xs font-medium text-neutral-500 uppercase tracking-wider"><%= t(".table.actions") %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-neutral-100">
          <% @presented_pets.each do |pet| %>
            <tr class="hover:bg-neutral-50 transition-colors">
              <td class="px-6 py-4">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-lg bg-neutral-100 overflow-hidden shrink-0">
                    <% if pet.primary_photo.present? %>
                      <%= image_tag pet.primary_photo_url(variant: :thumb), alt: "", class: "w-full h-full object-cover" %>
                    <% else %>
                      <div class="w-full h-full flex items-center justify-center">
                        <svg class="w-5 h-5 text-neutral-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                      </div>
                    <% end %>
                  </div>
                  <div>
                    <p class="font-medium text-neutral-900"><%= pet.name %></p>
                    <% if pet.breed.present? %>
                      <p class="text-xs text-neutral-500"><%= pet.breed %></p>
                    <% end %>
                  </div>
                </div>
              </td>
              <td class="px-6 py-4 text-sm text-neutral-600"><%= pet.species_label %></td>
              <td class="px-6 py-4"><%= pet.status_badge.html_safe %></td>
              <td class="px-6 py-4 text-sm text-neutral-500"><%= l(pet.created_at.to_date, format: :long) rescue pet.created_at.to_date %></td>
              <td class="px-6 py-4 text-right">
                <div class="flex items-center justify-end gap-3">
                  <%= link_to shelter_pet_path(id: pet.id), class: "text-neutral-500 hover:text-green-600 transition-colors", title: t(".table.view") do %>
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                    </svg>
                  <% end %>
                  <%= link_to edit_shelter_pet_path(id: pet.id), class: "text-neutral-500 hover:text-green-600 transition-colors", title: t(".table.edit") do %>
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                    </svg>
                  <% end %>
                  <%= link_to shelter_pet_path(id: pet.id), data: { turbo_method: :delete, turbo_confirm: t(".table.delete_confirm", name: pet.name) }, class: "text-neutral-500 hover:text-red-600 transition-colors", title: t(".table.delete") do %>
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                    </svg>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="text-center py-16 bg-white rounded-xl shadow-sm border border-neutral-200">
      <div class="w-16 h-16 bg-green-50 rounded-full flex items-center justify-center mx-auto mb-4">
        <svg class="w-8 h-8 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
      </div>
      <h3 class="font-display text-xl font-bold text-neutral-800 mb-2"><%= t(".empty_title") %></h3>
      <p class="text-neutral-500 mb-6"><%= t(".empty_body") %></p>
      <%= link_to new_shelter_pet_path, class: "inline-flex items-center gap-2 bg-green-600 hover:bg-green-700 text-white px-6 py-3 rounded-xl font-medium transition-colors duration-200 shadow-sm" do %>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
        </svg>
        <%= t(".add_pet") %>
      <% end %>
    </div>
  <% end %>
</div>
