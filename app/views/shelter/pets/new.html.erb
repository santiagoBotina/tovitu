<div class="w-full max-w-3xl mx-auto">
  <%= link_to shelter_pets_path, class: "inline-flex items-center gap-1.5 text-neutral-500 hover:text-neutral-700 text-sm mb-6 transition" do %>
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
    </svg>
    <%= t(".back") %>
  <% end %>

  <div class="bg-white rounded-xl shadow-sm border border-neutral-200 p-8">
    <h1 class="font-display text-3xl font-bold text-neutral-900 mb-2"><%= t(".title") %></h1>
    <p class="text-neutral-500 mb-8"><%= t(".subtitle") %></p>

    <%= render "form", pet: @pet %>
  </div>
</div>
