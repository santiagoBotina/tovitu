<%# ─── Shelter Pet Form ─── %>
<%# Design: Dashboard-level form sections with bento cards and consistent focus rings %>
<%= form_with model: [:shelter, pet], local: true, multipart: true, class: "space-y-6" do |form| %>
  <% if pet.errors.any? %>
    <div class="bg-red-50 border border-red-200 rounded-xl p-4 mb-6">
      <h3 class="text-sm font-semibold text-red-800 mb-2"><%= t("shared.error_messages", count: pet.errors.count) %></h3>
      <ul class="list-disc list-inside text-sm text-red-600 space-y-1">
        <% pet.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%# ─── Basic Info Section ─── %>
  <section class="bg-white rounded-xl p-6 shadow-sm border border-neutral-200">
    <h2 class="font-display text-lg font-bold text-neutral-800 mb-4"><%= t(".basic_info") %></h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <%= form.label :name, class: "block text-sm font-medium text-neutral-700 mb-1.5" %>
        <%= form.text_field :name, placeholder: t("pets.placeholders.name"), class: "w-full px-4 py-3 border border-neutral-300 rounded-xl shadow-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-secondary-500 focus-visible:ring-offset-2 text-sm transition" %>
      </div>
      <div>
        <%= form.label :species, class: "block text-sm font-medium text-neutral-700 mb-1.5" %>
        <%= form.select :species, options_for_select(pet_species_options, pet.species), { include_blank: t(".select") }, class: "w-full px-4 py-3 border border-neutral-300 rounded-xl shadow-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-secondary-500 focus-visible:ring-offset-2 text-sm bg-white transition" %>
      </div>
      <div>
        <%= form.label :breed, class: "block text-sm font-medium text-neutral-700 mb-1.5" %>
        <%= form.text_field :breed, placeholder: t("pets.placeholders.breed"), class: "w-full px-4 py-3 border border-neutral-300 rounded-xl shadow-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-secondary-500 focus-visible:ring-offset-2 text-sm transition" %>
      </div>
      <div>
        <%= form.label :age_category, class: "block text-sm font-medium text-neutral-700 mb-1.5" %>
        <%= form.select :age_category, options_for_select(pet_age_category_options, pet.age_category), { include_blank: t(".select") }, class: "w-full px-4 py-3 border border-neutral-300 rounded-xl shadow-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-secondary-500 focus-visible:ring-offset-2 text-sm bg-white transition" %>
      </div>
      <div>
        <%= form.label :birth_date, class: "block text-sm font-medium text-neutral-700 mb-1.5" %>
        <%= form.date_field :birth_date, class: "w-full px-4 py-3 border border-neutral-300 rounded-xl shadow-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-secondary-500 focus-visible:ring-offset-2 text-sm transition" %>
      </div>
      <div>
        <%= form.label :sex, class: "block text-sm font-medium text-neutral-700 mb-1.5" %>
        <%= form.select :sex, options_for_select(pet_sex_options, pet.sex), { include_blank: t(".select") }, class: "w-full px-4 py-3 border border-neutral-300 rounded-xl shadow-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-secondary-500 focus-visible:ring-offset-2 text-sm bg-white transition" %>
      </div>
      <div>
        <%= form.label :size, class: "block text-sm font-medium text-neutral-700 mb-1.5" %>
        <%= form.select :size, options_for_select(pet_size_options, pet.size), { include_blank: t(".select") }, class: "w-full px-4 py-3 border border-neutral-300 rounded-xl shadow-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-secondary-500 focus-visible:ring-offset-2 text-sm bg-white transition" %>
      </div>
    </div>
  </section>

  <%# ─── About & Personality Section ─── %>
  <section class="bg-white rounded-xl p-6 shadow-sm border border-neutral-200">
    <h2 class="font-display text-lg font-bold text-neutral-800 mb-4"><%= t(".about") %></h2>
    <div class="space-y-4">
      <div>
        <%= form.label :description, class: "block text-sm font-medium text-neutral-700 mb-1.5" %>
        <%= form.text_area :description, rows: 5, placeholder: t("pets.placeholders.description"), class: "w-full px-4 py-3 border border-neutral-300 rounded-xl shadow-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-secondary-500 focus-visible:ring-offset-2 text-sm transition" %>
      </div>
      <div>
        <%= form.label :personality_traits, class: "block text-sm font-medium text-neutral-700 mb-1.5" %>
        <%= form.text_field :personality_traits, placeholder: t(".personality_placeholder"), class: "w-full px-4 py-3 border border-neutral-300 rounded-xl shadow-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-secondary-500 focus-visible:ring-offset-2 text-sm transition" %>
        <p class="text-xs text-neutral-500 mt-1"><%= t(".personality_hint") %></p>
      </div>
    </div>
  </section>

  <%# ─── Medical Section ─── %>
  <section class="bg-white rounded-xl p-6 shadow-sm border border-neutral-200">
    <h2 class="font-display text-lg font-bold text-neutral-800 mb-4"><%= t(".medical") %></h2>
    <div class="space-y-4">
      <div>
        <%= form.label :medical_notes, class: "block text-sm font-medium text-neutral-700 mb-1.5" %>
        <%= form.text_area :medical_notes, rows: 3, placeholder: t("pets.placeholders.medical_notes"), class: "w-full px-4 py-3 border border-neutral-300 rounded-xl shadow-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-secondary-500 focus-visible:ring-offset-2 text-sm transition" %>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <label class="flex items-center gap-3 p-3 bg-neutral-50 rounded-xl cursor-pointer hover:bg-secondary-50 transition-colors card-lift">
          <%= form.check_box :spayed_neutered, class: "w-4 h-4 rounded border-neutral-300 text-secondary-500 focus:ring-secondary-500" %>
          <span class="text-sm font-medium text-neutral-700"><%= t("pets.attributes.spayed_neutered") %></span>
        </label>
        <label class="flex items-center gap-3 p-3 bg-neutral-50 rounded-xl cursor-pointer hover:bg-secondary-50 transition-colors card-lift">
          <%= form.check_box :vaccinated, class: "w-4 h-4 rounded border-neutral-300 text-secondary-500 focus:ring-secondary-500" %>
          <span class="text-sm font-medium text-neutral-700"><%= t("pets.attributes.vaccinated") %></span>
        </label>
        <label class="flex items-center gap-3 p-3 bg-neutral-50 rounded-xl cursor-pointer hover:bg-secondary-50 transition-colors card-lift">
          <%= form.check_box :special_needs, class: "w-4 h-4 rounded border-neutral-300 text-secondary-500 focus:ring-secondary-500" %>
          <span class="text-sm font-medium text-neutral-700"><%= t("pets.attributes.special_needs") %></span>
        </label>
      </div>
    </div>
  </section>

  <%# ─── Compatibility Section ─── %>
  <section class="bg-white rounded-xl p-6 shadow-sm border border-neutral-200">
    <h2 class="font-display text-lg font-bold text-neutral-800 mb-4"><%= t(".compatibility") %></h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <label class="flex items-center gap-3 p-3 bg-neutral-50 rounded-xl cursor-pointer hover:bg-secondary-50 transition-colors card-lift">
        <%= form.check_box :good_with_children, class: "w-4 h-4 rounded border-neutral-300 text-secondary-500 focus:ring-secondary-500" %>
        <span class="text-sm font-medium text-neutral-700"><%= t("pets.attributes.good_with_children") %></span>
      </label>
      <label class="flex items-center gap-3 p-3 bg-neutral-50 rounded-xl cursor-pointer hover:bg-secondary-50 transition-colors card-lift">
        <%= form.check_box :good_with_dogs, class: "w-4 h-4 rounded border-neutral-300 text-secondary-500 focus:ring-secondary-500" %>
        <span class="text-sm font-medium text-neutral-700"><%= t("pets.attributes.good_with_dogs") %></span>
      </label>
      <label class="flex items-center gap-3 p-3 bg-neutral-50 rounded-xl cursor-pointer hover:bg-secondary-50 transition-colors card-lift">
        <%= form.check_box :good_with_cats, class: "w-4 h-4 rounded border-neutral-300 text-secondary-500 focus:ring-secondary-500" %>
        <span class="text-sm font-medium text-neutral-700"><%= t("pets.attributes.good_with_cats") %></span>
      </label>
    </div>
  </section>

  <%# ─── Requirements Section ─── %>
  <section class="bg-white rounded-xl p-6 shadow-sm border border-neutral-200">
    <h2 class="font-display text-lg font-bold text-neutral-800 mb-4"><%= t(".requirements") %></h2>
    <div>
      <%= form.label :requirements, class: "block text-sm font-medium text-neutral-700 mb-1.5" %>
      <%= form.text_area :requirements, rows: 4, placeholder: t("pets.placeholders.requirements"), class: "w-full px-4 py-3 border border-neutral-300 rounded-xl shadow-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-secondary-500 focus-visible:ring-offset-2 text-sm transition" %>
      <p class="text-xs text-neutral-500 mt-1"><%= t(".requirements_hint") %></p>
    </div>
  </section>

  <%# ─── AI Preview Section ─── %>
  <section class="bg-white rounded-xl p-6 shadow-sm border border-neutral-200">
    <h2 class="font-display text-lg font-bold text-neutral-800 mb-4"><%= t(".ai_preview") %></h2>
    <div class="space-y-4">
      <div>
        <%= form.label :personality_spec, class: "block text-sm font-medium text-neutral-700 mb-1.5" %>
        <%= form.text_area :personality_spec, rows: 3, placeholder: t(".personality_spec_placeholder"), class: "w-full px-4 py-3 border border-neutral-300 rounded-xl shadow-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-secondary-500 focus-visible:ring-offset-2 text-sm transition" %>
      </div>
      <div>
        <%= form.label :adopter_tips, class: "block text-sm font-medium text-neutral-700 mb-1.5" %>
        <%= form.text_area :adopter_tips, rows: 3, placeholder: t(".adopter_tips_placeholder"), class: "w-full px-4 py-3 border border-neutral-300 rounded-xl shadow-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-secondary-500 focus-visible:ring-offset-2 text-sm transition" %>
      </div>
    </div>
  </section>

  <%# ─── Photos Section ─── %>
  <section class="bg-white rounded-xl p-6 shadow-sm border border-neutral-200">
    <h2 class="font-display text-lg font-bold text-neutral-800 mb-4"><%= t(".photos") %></h2>
    <div>
      <%= form.label :photos, class: "block text-sm font-medium text-neutral-700 mb-1.5" %>
      <%= form.file_field :photos, multiple: true, accept: "image/jpeg,image/png,image/webp", class: "w-full px-4 py-3 border border-neutral-300 rounded-xl shadow-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-secondary-500 focus-visible:ring-offset-2 text-sm transition file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-medium file:bg-secondary-50 file:text-secondary-600 hover:file:bg-secondary-100" %>
      <p class="text-xs text-neutral-500 mt-1"><%= t(".photos_hint") %></p>
    </div>
  </section>

  <%# ─── Actions ─── %>
  <div class="flex items-center gap-4">
    <%= form.submit t(".submit"), class: "px-8 py-3 bg-secondary-500 hover:bg-secondary-600 active:bg-secondary-700 text-white font-semibold rounded-xl transition-all duration-200 active:scale-[0.97] focus-visible:ring-2 focus-visible:ring-secondary-500 focus-visible:ring-offset-2 shadow-sm cursor-pointer" %>
    <%= link_to t(".cancel"), shelter_pets_path, class: "text-sm text-neutral-500 hover:text-neutral-700 transition-colors" %>
  </div>
<% end %>
