<%# ─── Invite Staff Form ─── %>
<%# Single-email invite form with a required role selector (plan 46, REQ-46-2).
    The owner role is intentionally not offered: a shelter has exactly one
    owner and it cannot be assigned by invitation (BR-46-3). %>
<%# Uses full translation keys because this partial is rendered from
    shelters/staff/index; lazy keys (t(".…")) would resolve against the
    partial's own scope (shelters.staff.invite_form). %>
<%= form_tag shelter_staff_index_path(shelter_id: @shelter), method: :post, class: "flex flex-col sm:flex-row items-stretch sm:items-end gap-3" do %>
  <div class="flex-1">
    <%= label_tag :email, t("shelters.staff.index.email_label"), class: "block text-sm font-medium text-neutral-700 mb-1.5" %>
    <%= email_field_tag :email, nil, placeholder: t("shelters.staff.index.email_placeholder"), required: true, class: "w-full px-4 py-3 border border-neutral-300 rounded-xl shadow-sm focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 focus:outline-none transition" %>
  </div>
  <div class="flex-1">
    <%= label_tag :role, t("shelters.staff.index.role_label"), class: "block text-sm font-medium text-neutral-700 mb-1.5" %>
    <%= select_tag :role,
        options_for_select(User::SHELTER_ROLES.reject { |r| r == "owner" }.map { |r| [ t("shelters.staff.roles.#{r}"), r ] }),
        include_blank: t("shelters.staff.index.role_placeholder"),
        required: true,
        class: "w-full pl-4 py-3 border border-neutral-300 rounded-xl shadow-sm bg-white text-sm focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 focus:outline-none transition select-control" %>
  </div>
  <%= submit_tag t("shelters.staff.index.send_invitation"), class: "px-6 py-3 bg-primary-500 text-white font-semibold rounded-xl hover:bg-primary-600 focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 transition-all duration-200 active:scale-[0.97] cursor-pointer shadow-sm shrink-0" %>
<% end %>