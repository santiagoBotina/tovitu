<%# ─── Staff Management Page ─── %>
<%# Design: Dashboard-level bento cards, team member rows, invite disclosure with consistent styling %>
<div class="w-full max-w-2xl mx-auto">

  <%= render "shared/section_header",
             title: t(".title"),
             subtitle: t(".subtitle"),
             back_link_path: safe_back_path(shelter_dashboard_path(shelter_id: @shelter)),
             header_class: "mb-6 bento-enter bento-enter-d1" %>

  <%# ─── Invite Staff Disclosure (REQ-45-4) ─── %>
  <%# Native <details>/<summary> disclosure: a semantically sound, keyboard-accessible
      pattern that reveals the invite form without a new Stimulus controller. %>
  <% if @staff_members.any? %>
    <details class="group mb-6 bento-enter bento-enter-d2">
      <summary class="inline-flex items-center justify-center gap-2 px-5 py-2.5 bg-primary-500 text-white font-semibold text-sm rounded-xl hover:bg-primary-600 focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 transition-all duration-200 active:scale-[0.97] shadow-sm cursor-pointer list-none [&::-webkit-details-marker]:hidden">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
        </svg>
        <%= t(".invite_cta") %>
      </summary>
      <div class="mt-4 bg-white rounded-xl shadow-sm border border-neutral-200 p-6">
        <h2 class="font-display text-lg font-bold text-neutral-800 mb-4"><%= t(".invite_new") %></h2>
        <%= render "shelters/staff/invite_form" %>
      </div>
    </details>
  <% end %>

  <%# ─── Current Staff Card ─── %>
  <section class="bg-white rounded-xl shadow-sm border border-neutral-200 p-6 mb-6 bento-enter bento-enter-d2">
    <h2 class="font-display text-lg font-bold text-neutral-800 mb-4"><%= t(".current_staff") %></h2>
    <% if @staff_members.any? %>
      <div class="divide-y divide-neutral-100">
        <% @staff_members.each do |member| %>
          <div class="flex items-center justify-between gap-3 py-3">
            <div class="flex items-center gap-3 min-w-0">
              <div class="shrink-0 w-10 h-10 bg-primary-50 rounded-xl flex items-center justify-center shadow-sm" aria-hidden="true">
                <span class="font-semibold text-primary-600 text-sm"><%= member.name.first.upcase %></span>
              </div>
              <div class="min-w-0">
                <p class="font-medium text-neutral-800 text-sm truncate"><%= member.name %></p>
                <p class="text-xs text-neutral-500 truncate"><%= member.email %></p>
              </div>
            </div>
            <div class="flex items-center gap-3 shrink-0">
              <span class="px-2.5 py-0.5 rounded-full text-xs font-medium <%= member.admin? ? "bg-primary-50 text-primary-600" : "bg-neutral-50 text-neutral-500" %>">
                <%= member.role.titleize %>
              </span>
              <% if member.id != current_user.id %>
                <%= button_to shelter_staff_path(shelter_id: @shelter, id: member), method: :delete, data: { turbo_confirm: t(".remove_confirm", name: member.name) }, class: "px-3 py-1.5 text-xs font-medium text-danger hover:bg-danger/10 rounded-lg transition active:scale-[0.97] focus-visible:ring-2 focus-visible:ring-danger/40 focus-visible:ring-offset-2" do %>
                  <%= t(".remove") %>
                <% end %>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <%# Empty state (REQ-45-5a): icon + copy + invite CTA %>
      <div class="text-center py-8">
        <div class="w-14 h-14 mx-auto mb-3 rounded-xl bg-primary-50 flex items-center justify-center" aria-hidden="true">
          <svg class="w-7 h-7 text-primary-500" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 4.354a4 4 0 1 1 0 5.292M15 21H3v-1a6 6 0 0 1 12 0v1Zm0 0h6v-1a6 6 0 0 0-9-5.197"/>
          </svg>
        </div>
        <h3 class="font-display text-base font-bold text-neutral-700 mb-1"><%= t(".empty_staff_title") %></h3>
        <p class="text-sm text-neutral-500 mb-4 max-w-xs mx-auto"><%= t(".empty_staff_description") %></p>
        <details class="group inline-block">
          <summary class="inline-flex items-center justify-center gap-2 px-5 py-2.5 bg-primary-500 text-white font-semibold text-sm rounded-xl hover:bg-primary-600 focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 transition-all duration-200 active:scale-[0.97] shadow-sm cursor-pointer list-none [&::-webkit-details-marker]:hidden">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
            </svg>
            <%= t(".invite_cta") %>
          </summary>
          <div class="mt-4 text-left bg-white rounded-xl shadow-sm border border-neutral-200 p-6">
            <h4 class="font-display text-lg font-bold text-neutral-800 mb-4"><%= t(".invite_new") %></h4>
            <%= render "shelters/staff/invite_form" %>
          </div>
        </details>
      </div>
    <% end %>
  </section>

  <%# ─── Pending Invitations Card ─── %>
  <section class="bg-white rounded-xl shadow-sm border border-neutral-200 p-6 mb-6 bento-enter bento-enter-d3">
    <h2 class="font-display text-lg font-bold text-neutral-800 mb-4"><%= t(".pending_invitations") %></h2>
    <% if @pending_invitations.any? %>
      <div class="divide-y divide-neutral-100">
        <% @pending_invitations.each do |invitation| %>
          <div class="flex items-center justify-between gap-3 py-3">
            <div class="flex items-center gap-3 min-w-0">
              <div class="shrink-0 w-10 h-10 bg-warning/10 rounded-xl flex items-center justify-center" aria-hidden="true">
                <svg class="w-5 h-5 text-warning" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              </div>
              <div class="min-w-0">
                <p class="font-medium text-neutral-800 text-sm truncate"><%= invitation.email %></p>
                <p class="text-xs text-neutral-500"><%= t(".invited_ago", time: time_ago_in_words(invitation.created_at)) %></p>
              </div>
            </div>
            <span class="shrink-0 px-2.5 py-0.5 rounded-full text-xs font-medium <%= invitation.expired? ? "bg-danger/10 text-danger" : "bg-warning/10 text-warning" %>">
              <%= invitation.expired? ? t(".expired") : t(".pending") %>
            </span>
          </div>
        <% end %>
      </div>
    <% else %>
      <%# Subtle empty state (REQ-45-5b): clean line, no blank card %>
      <div class="flex items-center gap-3 py-2">
        <div class="shrink-0 w-9 h-9 rounded-xl bg-neutral-100 flex items-center justify-center" aria-hidden="true">
          <svg class="w-4 h-4 text-neutral-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
        </div>
        <p class="text-sm text-neutral-500"><%= t(".no_pending_invitations") %></p>
      </div>
    <% end %>
  </section>
</div>