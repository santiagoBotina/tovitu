<% shelter = present(@shelter) %>

<div class="w-full max-w-3xl mx-auto">
  <%= link_to shelters_path, class: "inline-flex items-center gap-1.5 text-neutral-500 hover:text-neutral-700 text-sm mb-6 transition" do %>
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
      <%= t(".back") %>
  <% end %>

  <div class="bg-white rounded-xl shadow-sm border border-neutral-200 p-8 mb-6">
    <div class="flex items-start justify-between mb-4">
      <div>
        <h1 class="font-display text-3xl font-bold text-neutral-900 mb-2"><%= @shelter.name %></h1>
        <div class="flex flex-wrap items-center gap-3">
          <%= shelter.status_badge %>
          <% @shelter.species_served.each do |species| %>
            <span class="px-3 py-1 bg-primary-50 text-primary-600 text-xs font-medium rounded-full"><%= t("pets.species.#{species}") %></span>
          <% end %>
        </div>
      </div>
    </div>

    <% if @shelter.description.present? %>
      <p class="text-neutral-600 leading-relaxed"><%= @shelter.description %></p>
    <% end %>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
    <div class="bg-white rounded-xl shadow-sm border border-neutral-200 p-6">
      <h2 class="font-display text-lg font-bold text-neutral-800 mb-4"><%= t(".location") %></h2>
      <div class="flex items-start gap-3">
        <div class="w-10 h-10 bg-primary-50 rounded-full flex items-center justify-center shrink-0">
          <svg class="w-5 h-5 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
        </div>
        <div>
          <p class="text-neutral-600"><%= @shelter.street %></p>
          <p class="text-neutral-600"><%= "#{@shelter.city}, #{@shelter.state} #{@shelter.zip}" %></p>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-neutral-200 p-6">
      <h2 class="font-display text-lg font-bold text-neutral-800 mb-4"><%= t(".contact") %></h2>
      <div class="space-y-3">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 bg-primary-50 rounded-full flex items-center justify-center shrink-0">
            <svg class="w-5 h-5 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          </div>
          <p class="text-neutral-600"><%= @shelter.phone %></p>
        </div>
        <% if @shelter.website.present? %>
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-primary-50 rounded-full flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg>
            </div>
            <%= link_to @shelter.website, safe_url(@shelter.website), target: "_blank", class: "text-primary-500 hover:text-primary-600 underline", rel: "noopener" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <% if @shelter.hours.present? %>
    <div class="bg-white rounded-xl shadow-sm border border-neutral-200 p-6 mb-6">
      <div class="flex items-start gap-3">
        <div class="w-10 h-10 bg-primary-50 rounded-full flex items-center justify-center shrink-0">
          <svg class="w-5 h-5 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        </div>
        <div>
          <h2 class="font-display text-lg font-bold text-neutral-800 mb-1"><%= t(".hours") %></h2>
          <p class="text-neutral-600"><%= @shelter.hours %></p>
        </div>
      </div>
    </div>
  <% end %>

  <% if @shelter.adoption_policies.values.any?(&:present?) %>
    <div class="bg-white rounded-xl shadow-sm border border-neutral-200 p-6 mb-6">
      <h2 class="font-display text-lg font-bold text-neutral-800 mb-4"><%= t(".adoption_process") %></h2>
      <div class="space-y-4">
        <% if @shelter.adoption_policies["adoption_fee"].present? %>
          <div class="flex items-start gap-3">
            <div class="w-8 h-8 bg-primary-50 rounded-full flex items-center justify-center shrink-0 mt-0.5">
              <span class="text-sm font-bold text-primary-600">1</span>
            </div>
            <div>
              <p class="font-medium text-neutral-800"><%= t(".adoption_fee") %></p>
              <p class="text-neutral-600 text-sm"><%= number_to_currency(@shelter.adoption_policies["adoption_fee"]) %></p>
              <% if @shelter.adoption_policies["fee_description"].present? %>
                <p class="text-neutral-500 text-sm mt-1"><%= @shelter.adoption_policies["fee_description"] %></p>
              <% end %>
            </div>
          </div>
        <% end %>
        <% if @shelter.adoption_policies["minimum_age"].present? %>
          <div class="flex items-start gap-3">
            <div class="w-8 h-8 bg-primary-50 rounded-full flex items-center justify-center shrink-0 mt-0.5">
              <span class="text-sm font-bold text-primary-600">2</span>
            </div>
            <div>
              <p class="font-medium text-neutral-800"><%= t(".minimum_age") %></p>
              <p class="text-neutral-600 text-sm"><%= t(".minimum_age_text", age: @shelter.adoption_policies["minimum_age"]) %></p>
            </div>
          </div>
        <% end %>
        <% if @shelter.adoption_policies["home_visit_required"].present? && @shelter.adoption_policies["home_visit_required"] == true %>
          <div class="flex items-start gap-3">
            <div class="w-8 h-8 bg-primary-50 rounded-full flex items-center justify-center shrink-0 mt-0.5">
              <span class="text-sm font-bold text-primary-600">3</span>
            </div>
            <div>
              <p class="font-medium text-neutral-800"><%= t(".home_visit") %></p>
              <p class="text-neutral-600 text-sm"><%= t(".home_visit_text") %></p>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <%= render "faq", shelter: @shelter if @shelter.ai_documents.ready.any? %>

  <div class="bg-white rounded-xl shadow-sm border border-neutral-200 p-6 mb-6">
    <h2 class="font-display text-lg font-bold text-neutral-800 mb-4"><%= t(".available_pets") %></h2>

    <% if @pets.any? %>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        <% @pets.each do |pet| %>
          <% pet_presenter = PetPresenter.new(pet) %>
          <%= link_to pet_path(id: pet.id), class: "block bg-neutral-50 rounded-xl overflow-hidden hover:shadow-sm hover:bg-secondary-50/50 transition-all duration-200 group border border-neutral-100" do %>
            <div class="aspect-[4/3] bg-neutral-100 overflow-hidden">
              <% if pet_presenter.primary_photo.present? %>
                <%= image_tag pet_presenter.primary_photo_url(variant: :medium), alt: pet.name, class: "w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" %>
              <% else %>
                <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-secondary-50 to-secondary-100">
                  <svg class="w-10 h-10 text-secondary-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                </div>
              <% end %>
            </div>
            <div class="p-3">
              <h3 class="font-display font-bold text-neutral-800 group-hover:text-secondary-500 transition"><%= pet.name %></h3>
              <div class="flex items-center gap-2 text-xs text-neutral-500 mt-1">
                <span><%= pet_presenter.species_label %></span>
                <span>·</span>
                <span><%= pet_presenter.age_display %></span>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <div class="text-center py-8">
        <div class="w-14 h-14 bg-secondary-50 rounded-full flex items-center justify-center mx-auto mb-3">
          <svg class="w-7 h-7 text-secondary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        </div>
        <p class="text-neutral-500"><%= t(".pets_coming_soon") %></p>
        <p class="text-neutral-500 text-sm mt-1"><%= t(".no_pets_yet") %></p>
      </div>
    <% end %>
  </div>

  <div class="text-center mb-8">
    <%= link_to shelters_path(locale: nil), class: "inline-flex items-center gap-1.5 text-primary-500 hover:text-primary-600 text-sm font-medium transition" do %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
    <%= t(".back") %>
    <% end %>
  </div>
</div>
