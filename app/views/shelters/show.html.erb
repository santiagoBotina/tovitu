<%# ─── Shelter Show Page ─── %>
<%# Design: Dashboard-level bento cards, gradient accent cards, micro-interactions %>
<% shelter = present(@shelter) %>

<div class="w-full max-w-3xl mx-auto">
  <%# ─── Back link ─── %>
  <div class="mt-6 mb-6 bento-enter bento-enter-d1">
    <%= render "shared/back_link", path: shelters_path, label: t(".back") %>
  </div>

  <%# ─── Hero/Header Card ─── %>
  <section class="bg-white rounded-xl shadow-sm border border-neutral-200 overflow-hidden mb-6 bento-enter bento-enter-d2">
    <% if @shelter.cover_image.attached? %>
      <div class="aspect-[3/1] bg-neutral-100 relative" data-controller="image-loader">
        <div data-image-loader-target="skeleton" class="absolute inset-0 img-skeleton" aria-hidden="true"></div>
        <%= image_tag shelter.cover_url(variant: :xlarge), alt: @shelter.name, fetchpriority: "high", decoding: "async",
              data: { image_loader_target: "image", action: "load->image-loader#loaded error->image-loader#failed" },
              class: "relative w-full h-full object-cover opacity-0 transition-opacity duration-500" %>
      </div>
    <% end %>

    <div class="p-6 md:p-8 <%= @shelter.cover_image.attached? ? '-mt-16 relative z-10' : '' %>">
      <div class="flex items-start justify-between mb-4">
        <div class="flex items-center gap-4">
          <% if @shelter.logo.attached? %>
            <div class="w-20 h-20 rounded-full overflow-hidden border-4 border-white shadow-sm shrink-0 bg-white relative" data-controller="image-loader">
              <div data-image-loader-target="skeleton" class="absolute inset-0 rounded-full img-skeleton" aria-hidden="true"></div>
              <%= image_tag shelter.logo_url(variant: :large), alt: @shelter.name, decoding: "async",
                    data: { image_loader_target: "image", action: "load->image-loader#loaded error->image-loader#failed" },
                    class: "relative w-full h-full object-cover opacity-0 transition-opacity duration-500" %>
            </div>
          <% end %>
          <div>
            <h1 class="font-display text-3xl font-bold text-neutral-900 mb-2"><%= @shelter.name %></h1>
            <div class="flex flex-wrap items-center gap-3">
              <%= shelter.status_badge %>
              <% @shelter.species_served.each do |species| %>
                <span class="px-3 py-1 bg-primary-50 text-primary-600 text-xs font-medium rounded-full"><%= t("pets.species.#{species}") %></span>
              <% end %>
            </div>
          </div>
        </div>
      </div>

      <% if @shelter.description.present? %>
        <p class="text-neutral-600 leading-relaxed"><%= @shelter.description %></p>
      <% end %>
    </div>
  </section>

  <%# ─── Location & Contact Cards ─── %>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
    <section class="bg-white rounded-xl shadow-sm border border-neutral-200 p-6 bento-enter bento-enter-d3 card-lift">
      <div class="flex items-start gap-3">
        <div class="w-10 h-10 bg-primary-50 rounded-xl flex items-center justify-center shrink-0" aria-hidden="true">
          <svg class="w-5 h-5 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
        </div>
        <div>
          <h2 class="font-display text-lg font-bold text-neutral-800 mb-1"><%= t(".location") %></h2>
          <p class="text-neutral-600 text-sm"><%= @shelter.street %></p>
          <p class="text-neutral-600 text-sm"><%= "#{@shelter.city}, #{@shelter.state} #{@shelter.zip}" %></p>
        </div>
      </div>
    </section>

    <section class="bg-white rounded-xl shadow-sm border border-neutral-200 p-6 bento-enter bento-enter-d4 card-lift">
      <div class="flex items-start gap-3">
        <div class="w-10 h-10 bg-primary-50 rounded-xl flex items-center justify-center shrink-0" aria-hidden="true">
          <svg class="w-5 h-5 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
        </div>
        <div>
          <h2 class="font-display text-lg font-bold text-neutral-800 mb-1"><%= t(".contact") %></h2>
          <p class="text-neutral-600 text-sm"><%= @shelter.phone %></p>
          <% if @shelter.website.present? %>
            <%= link_to @shelter.website, safe_url(@shelter.website), target: "_blank", class: "text-primary-500 hover:text-primary-600 underline text-sm transition-colors", rel: "noopener" %><span class="text-neutral-400 text-xs"> ↗</span>
          <% end %>
        </div>
      </div>
    </section>
  </div>

  <%# ─── Hours Card ─── %>
  <% if @shelter.hours.present? %>
    <section class="bg-white rounded-xl shadow-sm border border-neutral-200 p-6 mb-6 bento-enter bento-enter-d5">
      <div class="flex items-start gap-3">
        <div class="w-10 h-10 bg-primary-50 rounded-xl flex items-center justify-center shrink-0" aria-hidden="true">
          <svg class="w-5 h-5 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        </div>
        <div>
          <h2 class="font-display text-lg font-bold text-neutral-800 mb-1"><%= t(".hours") %></h2>
          <p class="text-neutral-600 text-sm"><%= @shelter.hours %></p>
        </div>
      </div>
    </section>
  <% end %>

  <%# ─── Adoption Process Card ─── %>
  <% if @shelter.adoption_policies.values.any?(&:present?) %>
    <section class="bg-white rounded-xl shadow-sm border border-neutral-200 p-6 mb-6 bento-enter bento-enter-d5">
      <h2 class="font-display text-lg font-bold text-neutral-800 mb-4"><%= t(".adoption_process") %></h2>
      <div class="space-y-4">
        <% if @shelter.adoption_policies["adoption_fee"].present? %>
          <div class="flex items-start gap-3">
            <div class="w-8 h-8 bg-primary-50 rounded-lg flex items-center justify-center shrink-0 mt-0.5">
              <span class="text-sm font-bold text-primary-600">1</span>
            </div>
            <div>
              <p class="font-medium text-neutral-800"><%= t(".adoption_fee") %></p>
              <p class="text-neutral-600 text-sm"><%= number_to_currency(@shelter.adoption_policies["adoption_fee"]) %></p>
              <% if @shelter.adoption_policies["fee_description"].present? %>
                <p class="text-neutral-500 text-sm mt-1"><%= @shelter.adoption_policies["fee_description"] %></p>
              <% end %>
            </div>
          </div>
        <% end %>
        <% if @shelter.adoption_policies["minimum_age"].present? %>
          <div class="flex items-start gap-3">
            <div class="w-8 h-8 bg-primary-50 rounded-lg flex items-center justify-center shrink-0 mt-0.5">
              <span class="text-sm font-bold text-primary-600">2</span>
            </div>
            <div>
              <p class="font-medium text-neutral-800"><%= t(".minimum_age") %></p>
              <p class="text-neutral-600 text-sm"><%= t(".minimum_age_text", age: @shelter.adoption_policies["minimum_age"]) %></p>
            </div>
          </div>
        <% end %>
        <% if @shelter.adoption_policies["home_visit_required"].present? && @shelter.adoption_policies["home_visit_required"] == true %>
          <div class="flex items-start gap-3">
            <div class="w-8 h-8 bg-primary-50 rounded-lg flex items-center justify-center shrink-0 mt-0.5">
              <span class="text-sm font-bold text-primary-600">3</span>
            </div>
            <div>
              <p class="font-medium text-neutral-800"><%= t(".home_visit") %></p>
              <p class="text-neutral-600 text-sm"><%= t(".home_visit_text") %></p>
            </div>
          </div>
        <% end %>
      </div>
    </section>
  <% end %>

  <%# ─── FAQ Section ─── %>
  <%= render "faq", shelter: @shelter if @shelter.ai_documents.ready.any? %>

  <%# ─── Available Pets Card ─── %>
  <section class="bg-white rounded-xl shadow-sm border border-neutral-200 p-6 mb-6 bento-enter bento-enter-d6">
    <h2 class="font-display text-lg font-bold text-neutral-800 mb-4"><%= t(".available_pets") %></h2>

    <% if @pets.any? %>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        <% @pets.each_with_index do |pet, idx| %>
          <% pet_presenter = PetPresenter.new(pet) %>
          <% delay = ((idx % 3) + 1) %>
          <%= link_to pet_path(id: pet.id), class: "block bg-neutral-50 rounded-xl overflow-hidden hover:shadow-sm hover:bg-secondary-50/50 transition-all duration-200 group border border-neutral-100 card-lift bento-enter bento-enter-d#{delay}" do %>
            <div class="aspect-[4/3] bg-neutral-100 overflow-hidden relative" data-controller="image-loader">
              <div data-image-loader-target="skeleton" class="absolute inset-0 img-skeleton" aria-hidden="true"></div>
              <% if pet_presenter.primary_photo.present? %>
                <%= image_tag pet_presenter.primary_photo_url(variant: :medium), alt: pet.name, loading: "lazy", decoding: "async",
                      data: { image_loader_target: "image", action: "load->image-loader#loaded error->image-loader#failed" },
                      class: "relative w-full h-full object-cover group-hover:scale-105 transition duration-500 opacity-0" %>
              <% else %>
                <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-secondary-50 to-secondary-100">
                  <svg class="w-10 h-10 text-secondary-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                </div>
              <% end %>
            </div>
            <div class="p-3">
              <h3 class="font-display font-bold text-neutral-800 group-hover:text-secondary-500 transition"><%= pet.name %></h3>
              <div class="flex items-center gap-2 text-xs text-neutral-500 mt-1">
                <span><%= pet_presenter.species_label %></span>
                <span>·</span>
                <span><%= pet_presenter.age_display %></span>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <div class="text-center py-10">
        <div class="w-14 h-14 bg-secondary-50 rounded-xl flex items-center justify-center mx-auto mb-3" aria-hidden="true">
          <svg class="w-7 h-7 text-secondary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        </div>
        <p class="text-neutral-500"><%= t(".pets_coming_soon") %></p>
        <p class="text-neutral-500 text-sm mt-1"><%= t(".no_pets_yet") %></p>
      </div>
    <% end %>
  </section>
</div>
