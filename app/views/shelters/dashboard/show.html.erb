<% shelter = present(@shelter) %>

<div class="w-full max-w-4xl mx-auto">
  <div class="mb-8">
    <h1 class="font-display text-3xl font-bold text-neutral-900"><%= t(".title", name: @shelter.name) %></h1>
    <p class="text-neutral-500 mt-1"><%= t(".subtitle") %></p>
  </div>

  <div class="bg-gradient-to-r from-primary-50 to-primary-100/60 rounded-xl shadow-sm border border-primary-100 p-6 mb-8">
    <div class="flex items-center gap-3 mb-4">
      <div class="w-10 h-10 bg-primary-100 rounded-full flex items-center justify-center">
        <svg class="w-5 h-5 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
      </div>
      <h2 class="font-display text-lg font-bold text-neutral-800"><%= t(".onboarding") %></h2>
    </div>

    <div class="mb-4">
      <div class="flex justify-between text-sm text-neutral-600 mb-2">
        <span><%= t(".progress", percent: shelter.onboarding_progress) %></span>
      </div>
      <div class="w-full bg-white/60 rounded-full h-2.5">
        <div class="bg-primary-500 h-2.5 rounded-full transition-all duration-500" style="width: <%= shelter.onboarding_progress %>%"></div>
      </div>
    </div>

    <div class="space-y-2">
      <% shelter.onboarding_steps.each do |step| %>
        <div class="flex items-center gap-3">
          <% if step[:done] %>
            <div class="w-5 h-5 bg-green-500 rounded-full flex items-center justify-center">
              <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
            </div>
            <span class="text-sm text-neutral-500 line-through"><%= step[:label] %></span>
          <% else %>
            <div class="w-5 h-5 border-2 border-neutral-300 rounded-full flex items-center justify-center">
              <span class="text-xs text-neutral-400"><%= shelter.onboarding_steps.index(step) + 1 %></span>
            </div>
            <%= link_to step[:path], class: "text-sm text-primary-500 hover:text-primary-600 font-medium" do %>
              <%= step[:label] %> &rarr;
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
    <div class="bg-white rounded-xl shadow-sm border border-neutral-200 p-6">
      <div class="flex items-center gap-3 mb-3">
        <div class="w-10 h-10 bg-teal-50 rounded-full flex items-center justify-center">
          <svg class="w-5 h-5 text-teal-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        </div>
      </div>
      <p class="font-display text-3xl font-bold text-neutral-900"><%= @total_pets %></p>
      <p class="text-neutral-500 text-sm mt-1"><%= t(".total_pets") %></p>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-neutral-200 p-6">
      <div class="flex items-center gap-3 mb-3">
        <div class="w-10 h-10 bg-pink-50 rounded-full flex items-center justify-center">
          <svg class="w-5 h-5 text-pink-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        </div>
      </div>
      <p class="font-display text-3xl font-bold text-neutral-900"><%= @active_applications %></p>
      <p class="text-neutral-500 text-sm mt-1"><%= t(".active_applications") %></p>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-neutral-200 p-6">
      <div class="flex items-center gap-3 mb-3">
        <div class="w-10 h-10 bg-amber-50 rounded-full flex items-center justify-center">
          <svg class="w-5 h-5 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        </div>
      </div>
      <p class="font-display text-3xl font-bold text-neutral-900"><%= @pending_tasks.count %></p>
      <p class="text-neutral-500 text-sm mt-1"><%= t(".pending_tasks") %></p>
    </div>
  </div>

  <div class="bg-white rounded-xl shadow-sm border border-neutral-200 p-6 mb-8">
    <h2 class="font-display text-lg font-bold text-neutral-800 mb-4"><%= t(".quick_actions") %></h2>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <%= link_to "#", class: "block p-4 bg-neutral-50 rounded-xl hover:bg-primary-50 transition-colors duration-200 border border-neutral-100 hover:border-primary-100" do %>
        <div class="w-9 h-9 bg-primary-50 rounded-full flex items-center justify-center mb-2">
          <svg class="w-4.5 h-4.5 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
        </div>
        <p class="font-medium text-neutral-800 text-sm"><%= t(".add_pet") %></p>
        <p class="text-xs text-neutral-500"><%= t(".add_pet_desc") %></p>
      <% end %>

      <%= link_to shelter_staff_index_path(shelter_id: @shelter), class: "block p-4 bg-neutral-50 rounded-xl hover:bg-primary-50 transition-colors duration-200 border border-neutral-100 hover:border-primary-100" do %>
        <div class="w-9 h-9 bg-primary-50 rounded-full flex items-center justify-center mb-2">
          <svg class="w-4.5 h-4.5 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0z"/></svg>
        </div>
        <p class="font-medium text-neutral-800 text-sm"><%= t(".manage_staff") %></p>
        <p class="text-xs text-neutral-500"><%= t(".manage_staff_desc") %></p>
      <% end %>

      <%= link_to edit_shelter_policies_path(shelter_id: @shelter), class: "block p-4 bg-neutral-50 rounded-xl hover:bg-primary-50 transition-colors duration-200 border border-neutral-100 hover:border-primary-100" do %>
        <div class="w-9 h-9 bg-primary-50 rounded-full flex items-center justify-center mb-2">
          <svg class="w-4.5 h-4.5 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
        </div>
        <p class="font-medium text-neutral-800 text-sm"><%= t(".adoption_policies") %></p>
        <p class="text-xs text-neutral-500"><%= t(".adoption_policies_desc") %></p>
      <% end %>
    </div>
  </div>
</div>
