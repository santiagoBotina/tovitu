<%# Welcome overlay for first-time dashboard visitors %>
<% shelter = local_assigns[:shelter] || present(@shelter) %>
<% steps = shelter.onboarding_steps %>
<% total_count = steps.size %>

<div id="welcome-overlay"
     data-controller="welcome-overlay"
     class="fixed inset-0 z-50 flex items-center justify-center bg-neutral-900/40 backdrop-blur-sm transition-opacity duration-300 hidden opacity-0"
     data-action="click->welcome-overlay#dismiss">
  <div class="bg-white rounded-2xl shadow-lg max-w-md w-full mx-4 p-8 text-center"
       data-action="click->welcome-overlay#stopPropagation">
    <div class="w-16 h-16 bg-primary-100 rounded-full flex items-center justify-center mx-auto mb-4">
      <svg class="w-8 h-8 text-primary-500" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15.59 14.37a6 6 0 01-5.84 7.38v-4.8m5.84-2.58a14.98 14.98 0 006.16-12.12A14.98 14.98 0 009.631 8.41m5.96 5.96a14.926 14.926 0 01-5.841 2.58m-.119-8.54a6 6 0 00-7.381 5.84h4.8m2.581-5.84a14.927 14.927 0 00-2.58 5.84m2.699 2.7c-.103.021-.207.041-.311.06a15.09 15.09 0 01-2.448-2.448 14.9 14.9 0 01.06-.312m-2.24 2.39a4.493 4.493 0 00-1.757 4.306 4.493 4.493 0 004.306-1.758M16.5 9a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0z"/>
      </svg>
    </div>

    <h2 class="font-display text-2xl font-bold text-neutral-900 mb-2">
      <%= t("shelters.dashboard.show.welcome.title") %>
    </h2>
    <p class="text-neutral-500 mb-6">
      <%= t("shelters.dashboard.show.welcome.subtitle", name: shelter.name) %>
    </p>

    <div class="bg-primary-50 rounded-xl p-4 mb-6 text-left">
      <p class="text-sm font-medium text-primary-700 mb-2"><%= t("shelters.dashboard.show.welcome.checklist_title") %></p>
      <div class="space-y-1.5">
        <% steps.first(3).each do |step| %>
          <div class="flex items-center gap-2 text-sm">
            <% if step[:done] %>
              <svg class="w-4 h-4 text-secondary-500 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/>
              </svg>
            <% else %>
              <div class="w-4 h-4 border-2 border-primary-300 rounded-sm flex items-center justify-center shrink-0">
                <span class="text-xs text-primary-400"><%= steps.index(step) + 1 %></span>
              </div>
            <% end %>
            <span class="<%= step[:done] ? 'text-neutral-400 line-through' : 'text-neutral-700' %>">
              <%= step[:label] %>
            </span>
          </div>
        <% end %>
        <% if total_count > 3 %>
          <p class="text-xs text-primary-400 pt-1"><%= t("shelters.dashboard.show.welcome.more_steps", count: total_count - 3) %></p>
        <% end %>
      </div>
    </div>

    <button type="button"
            data-action="click->welcome-overlay#dismiss"
            class="w-full px-6 py-3 bg-primary-500 text-white font-semibold rounded-xl hover:bg-primary-600 active:bg-primary-700 transition-colors duration-200 shadow-sm">
      <%= t("shelters.dashboard.show.welcome.cta") %>
    </button>
  </div>
</div>
