<%# ─── Adoption Policies (Read-only) ─── %>
<%# Design: grouped card presentation of the configured policy set. The edit
    form remains the single place to change policies; this page is the entry
    point and read-only summary. %>
<% policies = @shelter.adoption_policies %>
<% has_policy_data = policies.values.any? { |value| value.present? || value == false } %>
<% edit_cta = t(".edit_policies") %>

<div class="w-full max-w-5xl mx-auto">
  <%= render "shared/section_header",
             title: t(".title"),
             subtitle: t(".description"),
             back_link_path: safe_back_path(shelter_dashboard_path(shelter_id: @shelter)),
             header_class: "mb-6 bento-enter bento-enter-d1" do %>
    <%= link_to edit_shelter_policies_path(shelter_id: @shelter),
        class: "inline-flex items-center gap-2 px-5 py-2.5 bg-primary-500 text-white font-semibold text-sm rounded-xl hover:bg-primary-600 focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 transition-all duration-200 active:scale-[0.97] shadow-sm" do %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/>
      </svg>
      <%= edit_cta %>
    <% end %>
  <% end %>

  <% if has_policy_data %>
    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3 items-start">
      <%# ─── Adoption Fee ─── %>
      <section class="bg-white rounded-xl shadow-sm border border-neutral-200 p-6 bento-enter bento-enter-d2" aria-labelledby="policies-fee-title">
        <div class="flex items-center gap-3 mb-5">
          <div class="w-10 h-10 bg-primary-50 rounded-xl flex items-center justify-center shrink-0" aria-hidden="true">
            <svg class="w-5 h-5 text-primary-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
              <line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
            </svg>
          </div>
          <h2 id="policies-fee-title" class="font-display text-lg font-bold text-neutral-800"><%= t(".groups.fee.title") %></h2>
        </div>
        <div class="space-y-4">
          <div>
            <p class="text-sm font-medium text-neutral-500"><%= t(".fee.amount") %></p>
            <% if policies["adoption_fee"].present? %>
              <% if policies["adoption_fee"].to_i.zero? %>
                <p class="text-lg font-semibold text-neutral-900 mt-1"><%= t(".no_fee") %></p>
              <% else %>
                <p class="text-lg font-semibold text-neutral-900 mt-1"><%= number_to_currency(policies["adoption_fee"].to_f) %></p>
              <% end %>
            <% else %>
              <p class="text-lg font-semibold text-neutral-500 mt-1"><%= t(".not_set") %></p>
            <% end %>
          </div>
          <div>
            <p class="text-sm font-medium text-neutral-500"><%= t(".fee.description") %></p>
            <% if policies["fee_description"].present? %>
              <p class="text-sm text-neutral-700 mt-1 leading-relaxed"><%= policies["fee_description"] %></p>
            <% else %>
              <p class="text-sm text-neutral-500 mt-1"><%= t(".not_set") %></p>
            <% end %>
          </div>
        </div>
      </section>

      <%# ─── Applicant Requirements ─── %>
      <section class="bg-white rounded-xl shadow-sm border border-neutral-200 p-6 bento-enter bento-enter-d3" aria-labelledby="policies-requirements-title">
        <div class="flex items-center gap-3 mb-5">
          <div class="w-10 h-10 bg-primary-50 rounded-xl flex items-center justify-center shrink-0" aria-hidden="true">
            <svg class="w-5 h-5 text-primary-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
              <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
          </div>
          <h2 id="policies-requirements-title" class="font-display text-lg font-bold text-neutral-800"><%= t(".groups.requirements.title") %></h2>
        </div>
        <div class="space-y-4">
          <div>
            <p class="text-sm font-medium text-neutral-500"><%= t(".minimum_age") %></p>
            <% if policies["minimum_age"].present? %>
              <p class="text-lg font-semibold text-neutral-900 mt-1"><%= t(".minimum_age_value", age: policies["minimum_age"]) %></p>
            <% else %>
              <p class="text-lg font-semibold text-neutral-500 mt-1"><%= t(".not_set") %></p>
            <% end %>
          </div>
          <% [
            { key: "home_visit_required", label: t(".home_visit") },
            { key: "fenced_yard_required", label: t(".fenced_yard") },
            { key: "vet_reference_required", label: t(".vet_reference") }
          ].each do |requirement| %>
            <% value = policies[requirement[:key]] %>
            <div class="flex items-center justify-between gap-3">
              <p class="text-sm text-neutral-700"><%= requirement[:label] %></p>
              <% if value == true || value == "true" %>
                <span class="inline-flex items-center px-3 py-1 rounded-full bg-secondary-50 text-secondary-700 text-xs font-medium"><%= t(".required") %></span>
              <% elsif value == false || value == "false" %>
                <span class="inline-flex items-center px-3 py-1 rounded-full bg-neutral-100 text-neutral-600 text-xs font-medium"><%= t(".not_required") %></span>
              <% else %>
                <span class="inline-flex items-center px-3 py-1 rounded-full bg-neutral-100 text-neutral-500 text-xs font-medium"><%= t(".not_set") %></span>
              <% end %>
            </div>
          <% end %>
        </div>
      </section>

      <%# ─── Other Requirements ─── %>
      <section class="bg-white rounded-xl shadow-sm border border-neutral-200 p-6 md:col-span-2 lg:col-span-1 bento-enter bento-enter-d4" aria-labelledby="policies-other-title">
        <div class="flex items-center gap-3 mb-5">
          <div class="w-10 h-10 bg-primary-50 rounded-xl flex items-center justify-center shrink-0" aria-hidden="true">
            <svg class="w-5 h-5 text-primary-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
              <line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/>
            </svg>
          </div>
          <h2 id="policies-other-title" class="font-display text-lg font-bold text-neutral-800"><%= t(".groups.other.title") %></h2>
        </div>
        <% items = policies["other_requirements"].to_s.split("\n").map(&:strip).reject(&:blank?) %>
        <% if items.any? %>
          <ul class="space-y-2.5">
            <% items.each do |item| %>
              <li class="flex items-start gap-2.5 text-sm text-neutral-700 leading-relaxed">
                <span class="mt-2 w-1.5 h-1.5 rounded-full bg-primary-400 shrink-0" aria-hidden="true"></span>
                <span class="min-w-0"><%= item %></span>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="text-sm text-neutral-500"><%= t(".not_set") %></p>
        <% end %>
      </section>
    </div>
  <% else %>
    <%# ─── Empty state ─── %>
    <div class="bg-white rounded-xl shadow-sm border border-neutral-200 p-8 sm:p-12 text-center bento-enter bento-enter-d2">
      <div class="w-14 h-14 bg-primary-50 rounded-2xl flex items-center justify-center mx-auto mb-4" aria-hidden="true">
        <svg class="w-7 h-7 text-primary-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
        </svg>
      </div>
      <h2 class="font-display text-xl font-bold text-neutral-900 mb-2"><%= t(".empty.title") %></h2>
      <p class="text-neutral-500 text-sm max-w-md mx-auto mb-6 leading-relaxed"><%= t(".empty.description") %></p>
      <%= link_to edit_shelter_policies_path(shelter_id: @shelter),
          class: "inline-flex items-center gap-2 px-5 py-2.5 bg-primary-500 text-white font-semibold text-sm rounded-xl hover:bg-primary-600 focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 transition-all duration-200 active:scale-[0.97] shadow-sm" do %>
        <%= edit_cta %>
      <% end %>
    </div>
  <% end %>
</div>
