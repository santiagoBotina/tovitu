<%# ─── Automatic evaluation settings (REQ-49-11) ─── %>
<% evaluation_policies = @evaluation_policies || @shelter.evaluation_policies.includes(:rules).order(:id) %>
<% evaluation_system_rules = @evaluation_system_rules || Rails.application.config_for(:evaluation).dig(:system_rules) || {} %>
<% translated_policies = evaluation_policies.select(&:translated?) %>
<% not_evaluated_policies = evaluation_policies.select(&:not_evaluated?) %>
<% failed_policies = evaluation_policies.select(&:failed?) %>
<% draft_policies = evaluation_policies.select(&:draft?) %>
<% actionable = (draft_policies + failed_policies).any? %>
<% has_any_policies = evaluation_policies.any? %>

<section class="mt-10" data-testid="evaluation-settings">
  <div class="flex items-start gap-4 mb-5">
    <div class="w-10 h-10 bg-primary-50 rounded-xl flex items-center justify-center shrink-0" aria-hidden="true">
      <svg class="w-5 h-5 text-primary-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
      </svg>
    </div>
    <div>
      <h2 class="font-display text-lg font-bold text-neutral-800"><%= t("adoptions.evaluation.settings.title") %></h2>
      <p class="text-sm text-neutral-500 mt-0.5 max-w-xl"><%= t("adoptions.evaluation.settings.subtitle") %></p>
    </div>
  </div>

  <%# ─── Add policy form ─── %>
  <div class="bg-white rounded-xl shadow-sm border border-neutral-200 p-6 mb-4">
    <%= form_tag add_policy_shelter_policies_path(shelter_id: @shelter), method: :post, class: "space-y-3" do %>
      <h3 class="text-sm font-semibold text-neutral-700"><%= t("adoptions.evaluation.settings.add_policy_title") %></h3>
      <p class="text-xs text-neutral-500"><%= t("adoptions.evaluation.settings.add_policy_hint") %></p>
      <%= text_area_tag :policy_content, "", rows: 3,
            placeholder: t("adoptions.evaluation.settings.add_policy_placeholder"),
            class: "w-full px-4 py-3 border border-neutral-300 rounded-xl shadow-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 text-neutral-800 placeholder-neutral-400 transition resize-none" %>
      <div class="flex flex-wrap items-center gap-3">
        <%= submit_tag t("adoptions.evaluation.settings.add_policy_submit"),
            class: "inline-flex items-center gap-2 px-5 py-2.5 bg-primary-500 text-white font-semibold text-sm rounded-xl hover:bg-primary-600 focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 transition-all duration-200 active:scale-[0.97] shadow-sm cursor-pointer" %>
        <% if actionable %>
          <%= button_to t("adoptions.evaluation.settings.translate_all"), translate_shelter_policies_path(shelter_id: @shelter), method: :post,
                class: "inline-flex items-center gap-2 px-5 py-2.5 bg-white border border-neutral-300 text-neutral-700 font-semibold text-sm rounded-xl hover:bg-neutral-50 transition-all duration-200 active:scale-[0.97] shadow-sm" %>
        <% end %>
      </div>
    <% end %>
  </div>

  <% unless has_any_policies %>
    <div class="bg-white rounded-xl shadow-sm border border-neutral-200 p-8 text-center mb-4">
      <h3 class="font-display text-base font-bold text-neutral-800 mb-1"><%= t("adoptions.evaluation.settings.no_policies_title") %></h3>
      <p class="text-sm text-neutral-500 max-w-md mx-auto"><%= t("adoptions.evaluation.settings.no_policies_hint") %></p>
    </div>
  <% end %>

  <%# ─── Proposed rules review list ─── %>
  <% if translated_policies.any? %>
    <div class="bg-white rounded-xl shadow-sm border border-neutral-200 p-6 mb-4">
      <h3 class="text-sm font-semibold text-neutral-700 mb-1"><%= t("adoptions.evaluation.settings.translated_title") %></h3>
      <p class="text-xs text-neutral-500 mb-4"><%= t("adoptions.evaluation.settings.translated_hint") %></p>

      <div class="space-y-6">
        <% translated_policies.each do |policy| %>
          <div class="border border-neutral-100 rounded-xl p-4 bg-neutral-50/50">
            <p class="text-sm font-medium text-neutral-800 mb-3">
              <span class="text-neutral-400 text-xs uppercase tracking-wide"><%= t("adoptions.evaluation.settings.policy_label") %>:</span> "<%= policy.content %>"
            </p>
            <% policy.rules.each do |rule| %>
              <%= form_with url: shelter_evaluation_rule_path(@shelter, rule), method: :patch, class: "mt-2" do |f| %>
                <div class="flex flex-wrap items-center gap-3 p-3 rounded-xl border border-neutral-200 bg-white">
                  <div class="min-w-0 flex-1">
                    <p class="text-sm font-semibold text-neutral-800">
                      <%= t("adoptions.evaluation.rules.#{rule.rule_type}.label", default: rule.rule_type.humanize) %>
                    </p>
                    <p class="text-xs text-neutral-500">
                      <%= t("adoptions.evaluation.rules.#{rule.rule_type}.description", default: "") %>
                    </p>
                  </div>

                  <div class="flex items-center gap-2">
                    <% if rule_params?(rule.rule_type) %>
                      <%= render "shelters/policies/rule_param_fields", f: f, rule: rule %>
                    <% end %>

                    <div>
                      <label class="block text-xs text-neutral-500 mb-0.5"><%= t("adoptions.evaluation.settings.severity_label") %></label>
                      <%= f.select :severity,
                          [[t("adoptions.evaluation.severity.red"), "red"], [t("adoptions.evaluation.severity.yellow"), "yellow"]],
                          { selected: rule.severity },
                          class: "px-2 py-1.5 border border-neutral-300 rounded-lg text-xs focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-500" %>
                    </div>

                    <label class="flex items-center gap-1.5 text-xs font-medium text-neutral-700 cursor-pointer select-none pt-4">
                      <%= f.check_box :enabled, checked: rule.enabled, class: "rounded border-neutral-300 text-primary-500 focus:ring-primary-500" %>
                      <%= rule.enabled ? t("adoptions.evaluation.settings.rule_enabled") : t("adoptions.evaluation.settings.rule_disabled") %>
                    </label>

                    <%= f.submit t("onboarding.review.save"),
                        class: "px-3 py-1.5 bg-primary-500 text-white text-xs font-semibold rounded-lg hover:bg-primary-600 focus-visible:ring-2 focus-visible:ring-primary-500 transition cursor-pointer" %>
                  </div>

                  <%= button_to t("adoptions.evaluation.settings.delete_rule"), shelter_evaluation_rule_path(@shelter, rule), method: :delete,
                        data: { turbo_confirm: t("adoptions.evaluation.settings.delete_rule_confirm", default: t("adoptions.evaluation.settings.delete_rule")) },
                        class: "px-3 py-1.5 bg-white border border-danger/30 text-danger text-xs font-semibold rounded-lg hover:bg-danger/5 transition" %>
                </div>
              <% end %>
            <% end %>
            <% if policy.rules.empty? %>
              <p class="text-xs text-neutral-500 italic"><%= t("adoptions.evaluation.settings.no_rules_title") %></p>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <%# ─── Not auto-evaluated ─── %>
  <% if not_evaluated_policies.any? %>
    <div class="bg-white rounded-xl shadow-sm border border-neutral-200 p-6 mb-4">
      <h3 class="text-sm font-semibold text-neutral-700 mb-1"><%= t("adoptions.evaluation.settings.not_evaluated_title") %></h3>
      <p class="text-xs text-neutral-500 mb-3"><%= t("adoptions.evaluation.settings.not_evaluated_hint") %></p>
      <ul class="space-y-2">
        <% not_evaluated_policies.each do |policy| %>
          <li class="flex items-start gap-2 text-sm text-neutral-700">
            <span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-neutral-300 shrink-0" aria-hidden="true"></span>
            <span class="min-w-0">
              <%= policy.content %>
              <% if policy.reason.present? %>
                <span class="text-xs text-neutral-400">— <%= policy.reason_label %></span>
              <% end %>
            </span>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%# ─── Failed / needs retry ─── %>
  <% if failed_policies.any? %>
    <div class="bg-white rounded-xl shadow-sm border border-warning/20 p-6 mb-4">
      <div class="flex items-start justify-between gap-3 mb-1">
        <div>
          <h3 class="text-sm font-semibold text-warning mb-1"><%= t("adoptions.evaluation.settings.failed_title") %></h3>
          <p class="text-xs text-neutral-500"><%= t("adoptions.evaluation.settings.failed_hint") %></p>
        </div>
        <%= button_to t("adoptions.evaluation.settings.retry"), translate_shelter_policies_path(shelter_id: @shelter), method: :post,
              class: "inline-flex items-center gap-2 px-4 py-2 bg-white border border-warning/40 text-warning font-semibold text-xs rounded-xl hover:bg-warning/5 transition-all duration-200 active:scale-[0.97] shadow-sm shrink-0" %>
      </div>
      <ul class="space-y-2 mt-3">
        <% failed_policies.each do |policy| %>
          <li class="flex items-start gap-2 text-sm text-neutral-700">
            <span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-warning shrink-0" aria-hidden="true"></span>
            <span class="min-w-0"><%= policy.content %></span>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%# ─── System rules (read-only) ─── %>
  <div class="bg-neutral-50 rounded-xl border border-neutral-200 p-6">
    <h3 class="text-sm font-semibold text-neutral-700 mb-1"><%= t("adoptions.evaluation.settings.system_rules_title") %></h3>
    <p class="text-xs text-neutral-500 mb-3"><%= t("adoptions.evaluation.settings.system_rules_hint") %></p>
    <ul class="space-y-2">
      <% evaluation_system_rules.each do |rule_type, config| %>
        <li class="flex items-center justify-between gap-3 text-sm">
          <span class="text-neutral-700">
            <%= t("adoptions.evaluation.rules.#{rule_type}.label", default: rule_type.to_s.humanize) %>
            <span class="text-neutral-400">· <%= t("adoptions.evaluation.sources.system") %></span>
          </span>
          <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium <%= config[:severity] == "red" ? 'bg-danger/10 text-danger' : 'bg-warning/10 text-warning' %>">
            <%= t("adoptions.evaluation.severity.#{config[:severity]}") %>
          </span>
        </li>
      <% end %>
    </ul>
  </div>
</section>