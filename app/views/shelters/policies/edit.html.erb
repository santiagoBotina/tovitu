<%# ─── Adoption Policies Edit Page ─── %>
<%# Design: Dashboard-level bento card form with consistent styling %>
<div class="w-full max-w-lg mx-auto">

  <%# ─── Page Header ─── %>
  <header class="flex items-center gap-3 mb-6 bento-enter bento-enter-d1">
    <%= render "shared/back_link", path: shelter_dashboard_path(shelter_id: @shelter) %>
    <div>
      <h1 class="font-display text-3xl font-bold text-neutral-900"><%= t(".title") %></h1>
      <p class="text-neutral-500 text-sm mt-1"><%= t(".subtitle") %></p>
    </div>
  </header>

  <%= form_tag shelter_policies_path(shelter_id: @shelter), method: :patch, class: "bg-white rounded-xl p-8 shadow-sm border border-neutral-200 bento-enter bento-enter-d2" do %>
    <div class="space-y-5">
      <div class="grid grid-cols-2 gap-4">
        <div>
          <%= label_tag "shelter[adoption_policies][adoption_fee]", t(".adoption_fee"), class: "block text-sm font-medium text-neutral-700 mb-1.5" %>
          <%= number_field_tag "shelter[adoption_policies][adoption_fee]", @shelter.adoption_policies["adoption_fee"], min: 0, step: 1, placeholder: "150", class: "w-full px-4 py-3 border border-neutral-300 rounded-xl shadow-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 transition" %>
        </div>
        <div>
          <%= label_tag "shelter[adoption_policies][minimum_age]", t(".minimum_age"), class: "block text-sm font-medium text-neutral-700 mb-1.5" %>
          <%= number_field_tag "shelter[adoption_policies][minimum_age]", @shelter.adoption_policies["minimum_age"], min: 18, max: 100, placeholder: "21", class: "w-full px-4 py-3 border border-neutral-300 rounded-xl shadow-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 transition" %>
        </div>
      </div>

      <div>
        <%= label_tag "shelter[adoption_policies][fee_description]", t(".fee_description"), class: "block text-sm font-medium text-neutral-700 mb-1.5" %>
        <%= text_field_tag "shelter[adoption_policies][fee_description]", @shelter.adoption_policies["fee_description"], placeholder: t(".fee_placeholder"), class: "w-full px-4 py-3 border border-neutral-300 rounded-xl shadow-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 transition" %>
      </div>

      <div>
        <label class="flex items-center gap-3 p-3 bg-neutral-50 rounded-xl cursor-pointer hover:bg-primary-50 transition-colors card-lift">
          <%= check_box_tag "shelter[adoption_policies][home_visit_required]", "true", @shelter.adoption_policies["home_visit_required"] == true, class: "rounded border-neutral-300 text-primary-500 focus:ring-primary-500" %>
          <div>
            <span class="text-sm font-medium text-neutral-800"><%= t(".home_visit") %></span>
            <p class="text-xs text-neutral-500"><%= t(".home_visit_desc") %></p>
          </div>
        </label>
      </div>

      <div>
        <label class="flex items-center gap-3 p-3 bg-neutral-50 rounded-xl cursor-pointer hover:bg-primary-50 transition-colors card-lift">
          <%= check_box_tag "shelter[adoption_policies][fenced_yard_required]", "true", @shelter.adoption_policies["fenced_yard_required"] == true, class: "rounded border-neutral-300 text-primary-500 focus:ring-primary-500" %>
          <div>
            <span class="text-sm font-medium text-neutral-800"><%= t(".fenced_yard") %></span>
            <p class="text-xs text-neutral-500"><%= t(".fenced_yard_desc") %></p>
          </div>
        </label>
      </div>

      <div>
        <label class="flex items-center gap-3 p-3 bg-neutral-50 rounded-xl cursor-pointer hover:bg-primary-50 transition-colors card-lift">
          <%= check_box_tag "shelter[adoption_policies][vet_reference_required]", "true", @shelter.adoption_policies["vet_reference_required"] == true, class: "rounded border-neutral-300 text-primary-500 focus:ring-primary-500" %>
          <div>
            <span class="text-sm font-medium text-neutral-800"><%= t(".vet_reference") %></span>
            <p class="text-xs text-neutral-500"><%= t(".vet_reference_desc") %></p>
          </div>
        </label>
      </div>

      <div>
        <%= label_tag "shelter[adoption_policies][other_requirements]", t(".other_requirements"), class: "block text-sm font-medium text-neutral-700 mb-1.5" %>
        <%= text_area_tag "shelter[adoption_policies][other_requirements]", @shelter.adoption_policies["other_requirements"], rows: 3, placeholder: t(".other_placeholder"), class: "w-full px-4 py-3 border border-neutral-300 rounded-xl shadow-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 transition" %>
        <p class="text-xs text-neutral-500 mt-1"><%= t(".one_per_line") %></p>
      </div>
    </div>

    <div class="mt-8">
      <%= submit_tag t(".submit"), class: "w-full px-6 py-3.5 bg-primary-500 text-white font-semibold rounded-xl hover:bg-primary-600 focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 transition-all duration-200 active:scale-[0.97] shadow-sm cursor-pointer" %>
    </div>
  <% end %>
</div>
