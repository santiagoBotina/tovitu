<%# ─── Adoption Policies Edit Page ─── %>
<%# Design: Dashboard-level bento card form with consistent styling. The form
    mechanics (field names, inputs, placeholders, submit) are unchanged — only
    the presentation is grouped to match the read-only show page. %>
<div class="w-full max-w-5xl mx-auto">
  <%= render "shared/section_header",
             title: t(".title"),
             subtitle: t(".subtitle"),
             back_link_path: safe_back_path(shelter_dashboard_path(shelter_id: @shelter)),
             header_class: "mb-6 bento-enter bento-enter-d1" %>

  <%= form_tag shelter_policies_path(shelter_id: @shelter), method: :patch do %>
    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3 items-start">
      <%# ─── Adoption Fee ─── %>
      <section class="bg-white rounded-xl shadow-sm border border-neutral-200 p-6 bento-enter bento-enter-d2">
        <div class="flex items-center gap-3 mb-5">
          <div class="w-10 h-10 bg-primary-50 rounded-xl flex items-center justify-center shrink-0" aria-hidden="true">
            <svg class="w-5 h-5 text-primary-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
              <line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
            </svg>
          </div>
          <h2 class="font-display text-lg font-bold text-neutral-800"><%= t(".groups.fee.title") %></h2>
        </div>
        <div class="space-y-4">
          <div>
            <%= label_tag "shelter[adoption_policies][adoption_fee]", t(".adoption_fee"), class: "block text-sm font-medium text-neutral-700 mb-1.5" %>
            <%= number_field_tag "shelter[adoption_policies][adoption_fee]", @shelter.adoption_policies["adoption_fee"], min: 0, step: 1, placeholder: "150", class: "w-full px-4 py-3 border border-neutral-300 rounded-xl shadow-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 transition" %>
          </div>
          <div>
            <%= label_tag "shelter[adoption_policies][fee_description]", t(".fee_description"), class: "block text-sm font-medium text-neutral-700 mb-1.5" %>
            <%= text_field_tag "shelter[adoption_policies][fee_description]", @shelter.adoption_policies["fee_description"], placeholder: t(".fee_placeholder"), class: "w-full px-4 py-3 border border-neutral-300 rounded-xl shadow-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 transition" %>
          </div>
        </div>
      </section>

      <%# ─── Applicant Requirements ─── %>
      <section class="bg-white rounded-xl shadow-sm border border-neutral-200 p-6 bento-enter bento-enter-d3">
        <div class="flex items-center gap-3 mb-5">
          <div class="w-10 h-10 bg-primary-50 rounded-xl flex items-center justify-center shrink-0" aria-hidden="true">
            <svg class="w-5 h-5 text-primary-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
              <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
          </div>
          <h2 class="font-display text-lg font-bold text-neutral-800"><%= t(".groups.requirements.title") %></h2>
        </div>
        <div class="space-y-4">
          <div>
            <%= label_tag "shelter[adoption_policies][minimum_age]", t(".minimum_age"), class: "block text-sm font-medium text-neutral-700 mb-1.5" %>
            <%= number_field_tag "shelter[adoption_policies][minimum_age]", @shelter.adoption_policies["minimum_age"], min: 18, max: 100, placeholder: "21", class: "w-full px-4 py-3 border border-neutral-300 rounded-xl shadow-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 transition" %>
          </div>

          <div>
            <label class="flex items-center gap-3 p-3 bg-neutral-50 rounded-xl cursor-pointer hover:bg-primary-50 transition-colors card-lift">
              <%= check_box_tag "shelter[adoption_policies][home_visit_required]", "true", %w[true 1].include?(@shelter.adoption_policies["home_visit_required"].to_s), class: "rounded border-neutral-300 text-primary-500 focus:ring-primary-500" %>
              <div>
                <span class="text-sm font-medium text-neutral-800"><%= t(".home_visit") %></span>
                <p class="text-xs text-neutral-500"><%= t(".home_visit_desc") %></p>
              </div>
            </label>
          </div>

          <div>
            <label class="flex items-center gap-3 p-3 bg-neutral-50 rounded-xl cursor-pointer hover:bg-primary-50 transition-colors card-lift">
              <%= check_box_tag "shelter[adoption_policies][fenced_yard_required]", "true", %w[true 1].include?(@shelter.adoption_policies["fenced_yard_required"].to_s), class: "rounded border-neutral-300 text-primary-500 focus:ring-primary-500" %>
              <div>
                <span class="text-sm font-medium text-neutral-800"><%= t(".fenced_yard") %></span>
                <p class="text-xs text-neutral-500"><%= t(".fenced_yard_desc") %></p>
              </div>
            </label>
          </div>

          <div>
            <label class="flex items-center gap-3 p-3 bg-neutral-50 rounded-xl cursor-pointer hover:bg-primary-50 transition-colors card-lift">
              <%= check_box_tag "shelter[adoption_policies][vet_reference_required]", "true", %w[true 1].include?(@shelter.adoption_policies["vet_reference_required"].to_s), class: "rounded border-neutral-300 text-primary-500 focus:ring-primary-500" %>
              <div>
                <span class="text-sm font-medium text-neutral-800"><%= t(".vet_reference") %></span>
                <p class="text-xs text-neutral-500"><%= t(".vet_reference_desc") %></p>
              </div>
            </label>
          </div>
        </div>
      </section>

      <%# ─── Other Requirements ─── %>
      <section class="bg-white rounded-xl shadow-sm border border-neutral-200 p-6 md:col-span-2 lg:col-span-1 bento-enter bento-enter-d4">
        <div class="flex items-center gap-3 mb-5">
          <div class="w-10 h-10 bg-primary-50 rounded-xl flex items-center justify-center shrink-0" aria-hidden="true">
            <svg class="w-5 h-5 text-primary-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
              <line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/>
            </svg>
          </div>
          <h2 class="font-display text-lg font-bold text-neutral-800"><%= t(".groups.other.title") %></h2>
        </div>
        <div>
          <%= label_tag "shelter[adoption_policies][other_requirements]", t(".other_requirements"), class: "block text-sm font-medium text-neutral-700 mb-1.5" %>
          <%= text_area_tag "shelter[adoption_policies][other_requirements]", @shelter.adoption_policies["other_requirements"], rows: 3, placeholder: t(".other_placeholder"), class: "w-full px-4 py-3 border border-neutral-300 rounded-xl shadow-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 transition" %>
          <p class="text-xs text-neutral-500 mt-1"><%= t(".one_per_line") %></p>
        </div>
      </section>
    </div>

    <div class="mt-6 flex flex-col sm:flex-row sm:justify-end gap-3">
      <%= submit_tag t(".submit"), class: "w-full sm:w-auto px-8 py-3.5 bg-primary-500 text-white font-semibold rounded-xl hover:bg-primary-600 focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 transition-all duration-200 active:scale-[0.97] shadow-sm cursor-pointer" %>
    </div>
  <% end %>
</div>
