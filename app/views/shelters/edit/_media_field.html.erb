<%# ─── Shelter Edit: Media / Branding Field ─── %>
<%# Renders a single image attachment (logo / cover / profile picture) with a
    live preview (or neutral placeholder), a replace file input, and inline
    validation feedback. The attachment flow is untouched — only presentation. %>
<%# Locals: f (form builder), field (symbol), label, preview_url, placeholder,
    alt, wide (optional: wide-aspect preview for the cover image) %>
<%
  wide = local_assigns[:wide]
  has_attached = preview_url.present?
  error = f.object.errors[field].any?
  input_class = "w-full px-4 py-3 border rounded-xl shadow-sm bg-white text-sm transition file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-medium file:bg-primary-50 file:text-primary-600 hover:file:bg-primary-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 #{error ? 'border-danger focus-visible:ring-danger' : 'border-neutral-300'}"
%>

<div>
  <span class="block text-sm font-medium text-neutral-700 mb-2"><%= label %></span>
  <div class="flex items-start gap-4">
    <div class="<%= wide ? 'w-44 sm:w-56 h-24' : 'w-20 h-20' %> shrink-0 rounded-xl overflow-hidden border border-neutral-200 bg-neutral-50 flex items-center justify-center" aria-hidden="true">
      <% if has_attached %>
        <%= image_tag preview_url, alt: alt, class: "w-full h-full object-cover", loading: "lazy" %>
      <% else %>
        <span class="text-xs text-neutral-400 px-2 text-center"><%= placeholder %></span>
      <% end %>
    </div>
    <div class="flex-1 min-w-0">
      <%= f.file_field field, accept: "image/jpeg,image/png,image/webp", class: input_class %>
      <p class="text-xs text-neutral-500 mt-1.5">
        <%= has_attached ? t(".replace_hint") : t(".upload_hint") %>
      </p>
    </div>
  </div>
  <% if error %>
    <p class="text-danger text-sm mt-1.5"><%= f.object.errors[field].first %></p>
  <% end %>
</div>