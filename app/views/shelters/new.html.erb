<div class="w-full max-w-lg mx-auto">
  <%# ─── Journey Context Bar ─── %>
  <%= render "shelters/dashboard/journey" %>

  <h1 class="font-display text-3xl font-bold text-neutral-900 mb-2 text-center"><%= t(".title") %></h1>
  <p class="text-neutral-500 mb-8 text-center"><%= t(".subtitle") %></p>

  <%= render "shared/error_messages", resource: @shelter %>

  <%= form_with model: @shelter, local: true, multipart: true, class: "bg-white rounded-xl shadow-sm border border-neutral-200 p-8" do |f| %>
    <div class="space-y-5">
      <div class="field-focus-glow">
        <%= f.label :logo, t(".logo_label"), class: "block text-sm font-medium text-neutral-700 mb-1.5" %>
        <%= f.file_field :logo, accept: "image/jpeg,image/png,image/webp", class: "w-full px-4 py-3 border border-neutral-300 rounded-xl shadow-sm focus:ring-2 focus:ring-primary-500 focus:border-primary-500 bg-white text-sm" %>
      </div>

      <div class="field-focus-glow">
        <%= f.label :name, t(".name_label"), class: "block text-sm font-medium text-neutral-700 mb-1.5" %>
        <%= f.text_field :name, placeholder: t(".name_placeholder"), required: true, class: "w-full px-4 py-3 border border-neutral-300 rounded-xl shadow-sm focus:ring-2 focus:ring-primary-500 focus:border-primary-500" %>
      </div>

      <div class="field-focus-glow">
        <%= f.label :street, t(".street_label"), class: "block text-sm font-medium text-neutral-700 mb-1.5" %>
        <%= f.text_field :street, placeholder: t(".street_placeholder"), required: true, class: "w-full px-4 py-3 border border-neutral-300 rounded-xl shadow-sm focus:ring-2 focus:ring-primary-500 focus:border-primary-500" %>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div class="field-focus-glow">
          <%= f.label :city, t(".city_label"), class: "block text-sm font-medium text-neutral-700 mb-1.5" %>
          <%= f.text_field :city, placeholder: t(".city_placeholder"), required: true, class: "w-full px-4 py-3 border border-neutral-300 rounded-xl shadow-sm focus:ring-2 focus:ring-primary-500 focus:border-primary-500" %>
        </div>
        <div class="field-focus-glow">
          <%= f.label :state, t(".state_label"), class: "block text-sm font-medium text-neutral-700 mb-1.5" %>
          <%= f.select :state, options_for_select(us_states), { prompt: t(".state_prompt") }, required: true, class: "w-full px-4 py-3 border border-neutral-300 rounded-xl shadow-sm focus:ring-2 focus:ring-primary-500 focus:border-primary-500 bg-white" %>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div class="field-focus-glow">
          <%= f.label :zip, t(".zip_label"), class: "block text-sm font-medium text-neutral-700 mb-1.5" %>
          <%= f.text_field :zip, placeholder: t(".zip_placeholder"), required: true, class: "w-full px-4 py-3 border border-neutral-300 rounded-xl shadow-sm focus:ring-2 focus:ring-primary-500 focus:border-primary-500" %>
        </div>
        <div class="field-focus-glow">
          <%= f.label :phone, t(".phone_label"), class: "block text-sm font-medium text-neutral-700 mb-1.5" %>
          <%= f.telephone_field :phone, placeholder: t(".phone_placeholder"), required: true, class: "w-full px-4 py-3 border border-neutral-300 rounded-xl shadow-sm focus:ring-2 focus:ring-primary-500 focus:border-primary-500" %>
        </div>
      </div>

      <div class="field-focus-glow">
        <%= f.label :website, t(".website_label"), class: "block text-sm font-medium text-neutral-700 mb-1.5" %>
        <%= f.url_field :website, placeholder: t(".website_placeholder"), class: "w-full px-4 py-3 border border-neutral-300 rounded-xl shadow-sm focus:ring-2 focus:ring-primary-500 focus:border-primary-500" %>
      </div>

      <div class="field-focus-glow">
        <%= f.label :description, t(".description_label"), class: "block text-sm font-medium text-neutral-700 mb-1.5" %>
        <%= f.text_area :description, rows: 4, placeholder: t(".description_placeholder"), class: "w-full px-4 py-3 border border-neutral-300 rounded-xl shadow-sm focus:ring-2 focus:ring-primary-500 focus:border-primary-500" %>
      </div>

      <div class="field-focus-glow">
        <span class="block text-sm font-medium text-neutral-700 mb-2"><%= t(".species_label") %></span>
        <div class="flex gap-6">
          <% { "dog" => t("shelters.index.dog"), "cat" => t("shelters.index.cat"), "other" => t("shelters.index.other") }.each do |key, label| %>
            <label class="flex items-center gap-2 text-sm text-neutral-600">
              <%= f.check_box :species_served, { multiple: true, checked: Array(@shelter.species_served).include?(key), class: "rounded border-neutral-300 text-primary-500 focus:ring-primary-500" }, key, nil %>
              <%= label %>
            </label>
          <% end %>
        </div>
      </div>

      <div class="field-focus-glow">
        <%= f.label :hours, t(".hours_label"), class: "block text-sm font-medium text-neutral-700 mb-1.5" %>
        <%= f.text_field :hours, placeholder: t(".hours_placeholder"), class: "w-full px-4 py-3 border border-neutral-300 rounded-xl shadow-sm focus:ring-2 focus:ring-primary-500 focus:border-primary-500" %>
      </div>
    </div>

    <div class="mt-8">
      <%= f.submit t(".submit"),
          data: { controller: "loading", action: "click->loading#submit" },
          class: "w-full px-6 py-3.5 bg-primary-500 text-white font-semibold rounded-xl hover:bg-primary-600 active:bg-primary-700 transition-all duration-200 shadow-sm cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed" %>
    </div>
  <% end %>

  <p class="text-center text-sm text-neutral-500 mt-6">
    <%= t(".login_prompt") %> <%= link_to t(".login_link"), new_session_path, class: "text-primary-500 hover:text-primary-600 font-medium" %>
  </p>
</div>
