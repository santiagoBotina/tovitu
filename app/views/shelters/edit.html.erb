<%# ─── Shelter Edit Page ─── %>
<%# Design: Dashboard-level bento card form with consistent spacing and focus rings %>
<div class="w-full max-w-lg mx-auto">

  <%# ─── Page Header ─── %>
  <header class="flex items-center gap-3 mb-6 bento-enter bento-enter-d1">
    <%= render "shared/back_link", path: shelter_dashboard_path(shelter_id: @shelter) %>
    <div>
      <h1 class="font-display text-3xl font-bold text-neutral-900"><%= t(".title") %></h1>
      <p class="text-neutral-500 text-sm mt-1"><%= t(".subtitle") %></p>
    </div>
  </header>

  <%= render "shared/error_messages", resource: @shelter %>

  <%= form_with model: @shelter, local: true, method: :patch, multipart: true, class: "bg-white rounded-xl p-8 shadow-sm border border-neutral-200 bento-enter bento-enter-d2" do |f| %>
    <div class="space-y-5">
      <div>
        <%= f.label :logo, t(".logo_label"), class: "block text-sm font-medium text-neutral-700 mb-1.5" %>
        <%= f.file_field :logo, accept: "image/jpeg,image/png,image/webp", class: "w-full px-4 py-3 border border-neutral-300 rounded-xl shadow-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 bg-white text-sm transition file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-medium file:bg-primary-50 file:text-primary-600 hover:file:bg-primary-100" %>
        <% if @shelter.logo.attached? %>
          <p class="text-xs text-neutral-500 mt-1"><%= t(".logo_attached") %></p>
        <% end %>
      </div>

      <div>
        <%= f.label :cover_image, t(".cover_label"), class: "block text-sm font-medium text-neutral-700 mb-1.5" %>
        <%= f.file_field :cover_image, accept: "image/jpeg,image/png,image/webp", class: "w-full px-4 py-3 border border-neutral-300 rounded-xl shadow-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 bg-white text-sm transition file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-medium file:bg-primary-50 file:text-primary-600 hover:file:bg-primary-100" %>
        <% if @shelter.cover_image.attached? %>
          <p class="text-xs text-neutral-500 mt-1"><%= t(".cover_attached") %></p>
        <% end %>
      </div>

      <div>
        <%= f.label :profile_picture, t(".profile_label"), class: "block text-sm font-medium text-neutral-700 mb-1.5" %>
        <%= f.file_field :profile_picture, accept: "image/jpeg,image/png,image/webp", class: "w-full px-4 py-3 border border-neutral-300 rounded-xl shadow-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 bg-white text-sm transition file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-medium file:bg-primary-50 file:text-primary-600 hover:file:bg-primary-100" %>
        <% if @shelter.profile_picture.attached? %>
          <p class="text-xs text-neutral-500 mt-1"><%= t(".profile_attached") %></p>
        <% end %>
      </div>

      <div>
        <%= f.label :name, t(".name_label"), class: "block text-sm font-medium text-neutral-700 mb-1.5" %>
        <%= f.text_field :name, required: true, class: "w-full px-4 py-3 border border-neutral-300 rounded-xl shadow-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 transition" %>
      </div>

      <div>
        <%= f.label :street, t(".street_label"), class: "block text-sm font-medium text-neutral-700 mb-1.5" %>
        <%= f.text_field :street, required: true, class: "w-full px-4 py-3 border border-neutral-300 rounded-xl shadow-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 transition" %>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <%= f.label :city, t(".city_label"), class: "block text-sm font-medium text-neutral-700 mb-1.5" %>
          <%= f.text_field :city, required: true, class: "w-full px-4 py-3 border border-neutral-300 rounded-xl shadow-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 transition" %>
        </div>
        <div>
          <%= f.label :state, t(".state_label"), class: "block text-sm font-medium text-neutral-700 mb-1.5" %>
          <%= f.select :state, options_for_select(us_states, @shelter.state), {}, required: true, class: "w-full pl-4 py-3 border border-neutral-300 rounded-xl shadow-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 bg-white transition select-control" %>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <%= f.label :zip, t(".zip_label"), class: "block text-sm font-medium text-neutral-700 mb-1.5" %>
          <%= f.text_field :zip, required: true, class: "w-full px-4 py-3 border border-neutral-300 rounded-xl shadow-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 transition" %>
        </div>
        <div>
          <%= f.label :phone, t(".phone_label"), class: "block text-sm font-medium text-neutral-700 mb-1.5" %>
          <%= f.telephone_field :phone, required: true, class: "w-full px-4 py-3 border border-neutral-300 rounded-xl shadow-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 transition" %>
        </div>
      </div>

      <div>
        <%= f.label :website, t(".website_label"), class: "block text-sm font-medium text-neutral-700 mb-1.5" %>
        <%= f.url_field :website, class: "w-full px-4 py-3 border border-neutral-300 rounded-xl shadow-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 transition" %>
      </div>

      <div>
        <%= f.label :description, t(".description_label"), class: "block text-sm font-medium text-neutral-700 mb-1.5" %>
        <%= f.text_area :description, rows: 4, class: "w-full px-4 py-3 border border-neutral-300 rounded-xl shadow-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 transition" %>
      </div>

      <div>
        <span class="block text-sm font-medium text-neutral-700 mb-2"><%= t(".species_label") %></span>
        <div class="flex gap-6">
          <% { "dog" => t("shelters.index.dog"), "cat" => t("shelters.index.cat"), "other" => t("shelters.index.other") }.each do |key, label| %>
            <label class="flex items-center gap-2 text-sm text-neutral-600 cursor-pointer">
              <%= f.check_box :species_served, { multiple: true, checked: Array(@shelter.species_served).include?(key), class: "rounded border-neutral-300 text-primary-500 focus:ring-primary-500" }, key, nil %>
              <%= label %>
            </label>
          <% end %>
        </div>
      </div>

      <div>
        <%= f.label :hours, t(".hours_label"), class: "block text-sm font-medium text-neutral-700 mb-1.5" %>
        <%= f.text_field :hours, placeholder: t(".hours_placeholder"), class: "w-full px-4 py-3 border border-neutral-300 rounded-xl shadow-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 transition" %>
      </div>

      <div>
        <span class="block text-sm font-medium text-neutral-700 mb-2"><%= t(".status_label") %></span>
        <div class="flex gap-6">
          <% [[t(".active"), "active"], [t(".inactive"), "inactive"]].each do |label, value| %>
            <label class="flex items-center gap-2 text-sm text-neutral-600 cursor-pointer">
              <%= f.radio_button :status, value, class: "border-neutral-300 text-primary-500 focus:ring-primary-500" %>
              <%= label %>
            </label>
          <% end %>
        </div>
      </div>
    </div>

    <div class="mt-8">
      <%= f.submit t(".submit"), class: "w-full px-6 py-3.5 bg-primary-500 text-white font-semibold rounded-xl hover:bg-primary-600 focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 transition-all duration-200 active:scale-[0.97] shadow-sm cursor-pointer" %>
    </div>
  <% end %>
</div>
