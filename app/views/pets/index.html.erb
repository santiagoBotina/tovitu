<%# ─── Pets Index Page ─── %>
<%# Design: Dashboard-level bento cards, filter card, micro-interactions %>
<div class="w-full max-w-6xl mx-auto">

  <%# ─── Page Header ─── %>
  <%= render "shared/section_header",
             title: t(".title"),
             subtitle: t(".subtitle"),
             centered: true,
             header_class: "text-center mb-8 bento-enter bento-enter-d1" %>

  <%# ─── Natural Language Search (Signature Hero) ─── %>
  <%# A floating "tray + glass plate" island (Double-Bezel): the describe-your-
      ideal-companion capability reads as a first-class, premium moment —
      not another filter input. Soft structuralism: airy, diffused depth,
      ultra-thin line icons, magnetic pill CTA. %>
  <section class="relative mb-16 bento-enter bento-enter-d2" aria-labelledby="nl-search-title">
    <%# Outer shell — the machined tray %>
    <div class="p-1.5 rounded-[2rem] bg-gradient-to-b from-neutral-100 via-white to-primary-50/50 ring-1 ring-black/5 shadow-[0_36px_80px_-40px_rgba(76,29,149,0.35)]">
      <%# Inner core — the glass plate %>
      <div class="relative rounded-[calc(2rem-0.375rem)] bg-white shadow-[inset_0_1px_1px_rgba(255,255,255,0.9)] overflow-hidden">
        <%# Ambient colour orbs (decorative, GPU-light, behind content) %>
        <div aria-hidden="true" class="pointer-events-none absolute -top-28 -right-20 w-80 h-80 rounded-full bg-primary-200/30 blur-3xl"></div>
        <div aria-hidden="true" class="pointer-events-none absolute -bottom-32 -left-24 w-72 h-72 rounded-full bg-secondary-200/25 blur-3xl"></div>

        <div class="relative px-6 py-10 sm:px-12 sm:py-14 md:px-16 md:py-16">
          <%# Eyebrow tag %>
          <p class="inline-flex items-center rounded-full px-3 py-1 text-[10px] uppercase tracking-[0.2em] font-semibold bg-primary-100/60 text-primary-700 border border-primary-200/40 mb-5">
            <%= t(".natural_language.eyebrow") %>
          </p>

          <h2 id="nl-search-title" class="font-display text-3xl sm:text-4xl md:text-5xl font-bold text-neutral-900 tracking-tight text-balance max-w-2xl">
            <%= t(".natural_language.label") %>
          </h2>
          <p class="text-neutral-500 mt-3 text-sm sm:text-base max-w-xl">
            <%= t(".natural_language.example") %>
          </p>

          <%= form_tag pets_path, method: :get,
               data: { controller: "nl-search",
                       action: "submit->nl-search#submit",
                       nl_search_loading_label_value: t(".natural_language.loading") },
               class: "mt-8 sm:mt-10 flex flex-col sm:flex-row gap-3",
               aria: { busy: "false" } do %>
            <div class="relative flex-1 group">
              <svg class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-neutral-400 group-focus-within:text-primary-500 transition-colors duration-300" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6.5-6.5m1.5-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
              </svg>
              <%= text_field_tag :intent, params[:intent],
                    id: "intent",
                    aria: { labelledby: "nl-search-title" },
                    placeholder: t(".natural_language.placeholder"),
                    autocomplete: "off",
                    class: "w-full pl-12 pr-5 py-4 rounded-2xl bg-neutral-50 text-neutral-800 placeholder:text-neutral-400 border border-neutral-200/80 shadow-[inset_0_1px_2px_rgba(16,24,40,0.04)] focus:bg-white focus:border-primary-300/80 focus-visible:ring-2 focus-visible:ring-primary-400 focus-visible:ring-offset-2 focus-visible:ring-offset-white focus:outline-none transition-all duration-500 ease-[cubic-bezier(0.32,0.72,0,1)]" %>
            </div>

            <%= button_tag type: "submit",
                  data: { nl_search_target: "submit" },
                  class: "group inline-flex items-center gap-2.5 rounded-full bg-primary-500 text-white pl-6 pr-1.5 py-1.5 cursor-pointer hover:bg-primary-600 transition-all duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] active:scale-[0.98] focus-visible:ring-2 focus-visible:ring-primary-400 focus-visible:ring-offset-2 focus-visible:ring-offset-white focus:outline-none shrink-0 self-start sm:self-auto" do %>
              <span class="font-medium" data-nl-search-target="label"><%= t(".natural_language.submit") %></span>
              <svg data-nl-search-target="spinner" class="hidden w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24" aria-hidden="true">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
              <span class="w-9 h-9 rounded-full bg-white/15 flex items-center justify-center transition-transform duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] group-hover:translate-x-0.5 group-hover:-translate-y-[1px] group-hover:scale-105 group-active:scale-95" aria-hidden="true">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6l6 6-6 6"/>
                </svg>
              </span>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </section>

  <%# ─── What Tovitu Understood ─── %>
  <% if @intent.present? && @intent["understood"].present? %>
    <section class="bg-white rounded-xl border border-secondary-200 shadow-sm p-5 mb-8 bento-enter bento-enter-d3"
             aria-label="<%= t(".natural_language.understood_title") %>">
      <div class="flex flex-wrap items-center gap-3">
        <h3 class="font-display text-base font-bold text-neutral-800"><%= t(".natural_language.understood_title") %></h3>
        <div class="flex flex-wrap gap-2" role="list" aria-label="<%= t(".natural_language.understood_title") %>">
          <% @intent["understood"].each do |label| %>
            <span role="listitem" class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-secondary-100 text-secondary-800"><%= label %></span>
          <% end %>
        </div>
        <%= link_to pets_path, class: "inline-flex items-center gap-1.5 text-sm font-medium text-primary-600 hover:text-primary-700 underline transition-colors ml-auto" do %>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
          <%= t(".natural_language.clear") %>
        <% end %>
      </div>
    </section>
  <% end %>

  <%# ─── Invalid / Unreadable Description Banner ─── %>
  <% if @nl_error %>
    <div class="bg-secondary-50 border border-secondary-200 rounded-xl p-5 mb-8 flex items-start gap-3 bento-enter bento-enter-d3" role="status">
      <svg class="w-5 h-5 text-secondary-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
      </svg>
      <div>
        <h3 class="font-semibold text-neutral-800 text-sm"><%= t(".natural_language.invalid_title") %></h3>
        <p class="text-neutral-600 text-sm mt-0.5"><%= t(".natural_language.invalid_body") %></p>
      </div>
    </div>
  <% end %>

  <%# ─── Filter Section (Bento Card) ─── %>
  <section class="bg-white rounded-xl p-6 shadow-sm border border-neutral-200 mb-8 bento-enter bento-enter-d2"
           aria-label="<%= t(".filters.title") %>"
           data-controller="exploration-memory"
           data-exploration-memory-mode-value="save"
           data-exploration-memory-signed-in-value="<%= signed_in? %>">
    <%= form_tag pets_path, method: :get, class: "space-y-5" do %>
      <%# Species filter chips (dashboard pill style) %>
      <div>
        <span class="block text-sm font-semibold text-neutral-700 mb-3"><%= t(".filters.species") %></span>
        <div class="flex flex-wrap gap-2" role="group" aria-label="<%= t(".filters.species") %>">
          <% Pet::SPECIES.each do |species| %>
            <% active = params[:species] == species %>
            <%= link_to url_for(request.params.merge(species: active ? nil : species, page: nil)),
                        class: "inline-flex items-center gap-1.5 px-5 py-2.5 rounded-full text-sm font-medium transition-all duration-200 border active:scale-[0.97] #{active ? 'bg-secondary-500 text-white border-secondary-500' : 'bg-white text-neutral-700 border-neutral-300 hover:border-secondary-300 hover:text-secondary-600'}",
                        aria: { current: active ? "page" : nil } do %>
              <span aria-hidden="true"><%= Pet::SPECIES_EMOJI[species] %></span>
              <%= t("pets.species.#{species}") %>
            <% end %>
          <% end %>
          <% if params[:species].present? %>
            <%= link_to url_for(request.params.merge(species: nil, page: nil)),
                        class: "px-5 py-2.5 rounded-full text-sm font-medium bg-primary-100 text-primary-600 border border-primary-200 hover:bg-primary-200 transition-all duration-200 active:scale-[0.97]" do %>
              <svg class="w-3.5 h-3.5 inline shrink-0 -ml-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
              </svg>
              <%= t(".filters.clear") %>
            <% end %>
          <% end %>
        </div>
      </div>

      <%# Filter fields grid %>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div>
          <%= label_tag :query, t(".filters.search"), class: "block text-sm font-semibold text-neutral-700 mb-1.5" %>
          <%= text_field_tag :query, params[:query], placeholder: t(".filters.search_placeholder"),
                class: "w-full px-4 py-3 border border-neutral-300 rounded-xl focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 focus:outline-none text-sm bg-white transition" %>
        </div>

        <div>
          <%= label_tag :age_category, t(".filters.age"), class: "block text-sm font-semibold text-neutral-700 mb-1.5" %>
          <%= select_tag :age_category, options_for_select(pet_age_category_options, params[:age_category]), include_blank: t(".filters.all"),
                class: "w-full pl-4 py-3 border border-neutral-300 rounded-xl focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 focus:outline-none text-sm bg-white transition select-control" %>
        </div>

        <div>
          <%= label_tag :size, t(".filters.size"), class: "block text-sm font-semibold text-neutral-700 mb-1.5" %>
          <%= select_tag :size, options_for_select(pet_size_options, params[:size]), include_blank: t(".filters.all"),
                class: "w-full pl-4 py-3 border border-neutral-300 rounded-xl focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 focus:outline-none text-sm bg-white transition select-control" %>
        </div>

        <div>
          <%= label_tag :sex, t(".filters.sex"), class: "block text-sm font-semibold text-neutral-700 mb-1.5" %>
          <%= select_tag :sex, options_for_select(pet_sex_options, params[:sex]), include_blank: t(".filters.all"),
                class: "w-full pl-4 py-3 border border-neutral-300 rounded-xl focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 focus:outline-none text-sm bg-white transition select-control" %>
        </div>
      </div>

      <%# Action row %>
      <div class="flex items-center justify-between pt-1">
        <%= submit_tag t(".filters.apply"),
            class: "px-6 py-3 bg-primary-500 text-white font-semibold rounded-xl hover:bg-primary-600 focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 transition-all duration-200 active:scale-[0.97] cursor-pointer shadow-sm" %>
        <% if params[:query].present? || params[:species].present? || params[:age_category].present? || params[:size].present? || params[:sex].present? %>
          <%= link_to pets_path, class: "text-sm font-medium text-primary-600 hover:text-primary-700 underline transition-colors" do %>
            <%= t(".filters.clear_all") %>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </section>

  <%# ─── NL Results Header ─── %>
  <% if @intent.present? %>
    <div class="mb-6 bento-enter bento-enter-d4">
      <h2 class="font-display text-2xl font-bold text-neutral-900 mb-1"><%= t(".natural_language.search_title") %></h2>
      <p class="text-neutral-500 text-sm"><%= t(".natural_language.results_description") %></p>
    </div>
  <% end %>

  <%# ─── Pet Cards Grid ─── %>
  <% if @presented_pets.any? %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      <% lcp_emitted = false %>
      <% @presented_pets.each_with_index do |pet, idx| %>
        <% delay = ((idx % 6) + 1).clamp(1, 8) %>
        <div class="relative bg-white rounded-xl border border-neutral-200 shadow-sm hover:shadow-md hover:border-primary-200 transition-all duration-200 overflow-hidden group card-lift bento-enter bento-enter-d#{delay}"
             data-controller="image-prefetch"
             data-image-prefetch-url-value="<%= pet.primary_photo.present? ? pet.primary_photo_url(variant: :large) : '' %>"
             data-action="mouseenter->image-prefetch#prefetch mouseleave->image-prefetch#cancel">
          <%= link_to pet_path(id: pet.id), class: "block focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-inset" do %>
            <div class="aspect-[4/3] bg-neutral-100 overflow-hidden relative" data-controller="image-loader">
              <div data-image-loader-target="skeleton" class="absolute inset-0 img-skeleton" aria-hidden="true"></div>
              <% if pet.primary_photo.present? %>
                <%# The first rendered photo is the LCP: eager + high priority.
                    The rest are lazy so below-the-fold variants aren't
                    requested up front. %>
                <% is_lcp = !lcp_emitted %>
                <% lcp_emitted = true %>
                <% card_img_opts = {
                     alt: t(".pet_photo", name: pet.name),
                     width: 400, height: 300,
                     loading: is_lcp ? "eager" : "lazy",
                     decoding: "async",
                     data: { image_loader_target: "image", action: "load->image-loader#loaded error->image-loader#failed" },
                     class: "relative w-full h-full object-cover group-hover:scale-105 transition duration-500 opacity-0"
                   } %>
                <% card_img_opts[:fetchpriority] = "high" if is_lcp %>
                <%= image_tag pet.primary_photo_url(variant: :medium), **card_img_opts %>
              <% else %>
                <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-primary-50 to-secondary-50">
                  <svg class="w-16 h-16 text-primary-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                </div>
              <% end %>
            </div>

            <div class="p-5">
              <div class="flex items-start justify-between mb-2">
                <h3 class="font-display text-xl font-bold text-neutral-900 group-hover:text-primary-600 transition"><%= pet.name %></h3>
                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-medium bg-primary-50 text-primary-700 shrink-0 ml-3">
                  <%= pet.age_display %>
                </span>
              </div>

              <div class="flex items-center gap-2 text-sm text-neutral-600 mb-2">
                <span class="inline-flex items-center gap-1">
                  <span aria-hidden="true"><%= pet.species_emoji %></span>
                  <span><%= pet.species_label %></span>
                </span>
                <% if pet.breed.present? %>
                  <span class="text-neutral-300" aria-hidden="true">·</span>
                  <span><%= pet.breed %></span>
                <% end %>
                <% if pet.size_label.present? %>
                  <span class="text-neutral-300" aria-hidden="true">·</span>
                  <span><%= pet.size_label %></span>
                <% end %>
              </div>

              <div class="flex items-center gap-1.5 text-sm text-neutral-500 mb-3">
                <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
                <span><%= pet.shelter.city %>, <%= pet.shelter.state %></span>
              </div>

              <% if pet.personality_traits_list.any? %>
                <div class="flex flex-wrap gap-1.5">
                  <% pet.personality_traits_list.first(2).each do |trait| %>
                    <span class="px-2.5 py-1 bg-primary-50 text-primary-600 text-xs font-medium rounded-full capitalize"><%= trait %></span>
                  <% end %>
                  <% if pet.personality_traits_list.length > 2 %>
                    <span class="px-2.5 py-1 bg-neutral-100 text-neutral-500 text-xs font-medium rounded-full">+<%= pet.personality_traits_list.length - 2 %></span>
                  <% end %>
                </div>
              <% end %>

              <%# ─── Why This Match (NL search reasons) ─── %>
              <% if @reasons.present? && (reason = @reasons[pet.id]) %>
                <% matched = reason["matched"] || reason[:matched] || {} %>
                <% temperament = reason["temperament"] || reason[:temperament] || [] %>
                <div class="flex flex-wrap gap-1.5 mt-3"
                     title="<%= t(".natural_language.reasons_title") %>"
                     aria-label="<%= t(".natural_language.reasons_title") %>">
                  <% reason_chips = [] %>
                  <% if matched["species"] || matched[:species] %>
                    <% reason_chips << t("pets.species.#{pet.species}") %>
                  <% end %>
                  <% if (matched["size"] || matched[:size]) && pet.size_label.present? %>
                    <% reason_chips << pet.size_label %>
                  <% end %>
                  <% Array(temperament).each do |token| %>
                    <% reason_chips << t(".natural_language.match_keyword", keyword: token) %>
                  <% end %>
                  <% reason_chips.first(3).each do |chip| %>
                    <span class="px-2.5 py-1 bg-primary-50 text-primary-600 text-xs font-medium rounded-full"><%= chip %></span>
                  <% end %>
                </div>
              <% end %>
            </div>
          <% end %>

          <%# Save button sits outside the link — no interactive elements nested inside an anchor. %>
          <%= render "pets/save_button", pet: pet, saved: pet_saved?(pet) %>
        </div>
      <% end %>
    </div>

    <div class="text-center mt-10 text-sm text-neutral-500 bento-enter bento-enter-d8">
      <%= t(".showing_count", count: @presented_pets.size) %>
    </div>
  <% elsif @intent.present? %>
    <%# ─── NL Empty State (distinct from the filter empty state) ─── %>
    <div class="text-center py-16 bg-white rounded-xl border border-neutral-200 shadow-sm bento-enter bento-enter-d3">
      <div class="w-16 h-16 mx-auto mb-4 rounded-xl bg-secondary-50 flex items-center justify-center" aria-hidden="true">
        <svg class="w-8 h-8 text-secondary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
      </div>
      <h3 class="font-display text-xl font-bold text-neutral-700 mb-2"><%= t(".natural_language.empty_title") %></h3>
      <p class="text-sm text-neutral-500 mb-6 max-w-sm mx-auto"><%= t(".natural_language.empty_body") %></p>
      <%= link_to t(".natural_language.browse_all"), pets_path,
          class: "inline-flex items-center gap-2 px-6 py-3 bg-secondary-500 text-white font-semibold rounded-xl hover:bg-secondary-600 focus-visible:ring-2 focus-visible:ring-secondary-500 focus-visible:ring-offset-2 transition-all duration-200 active:scale-[0.97] shadow-sm" %>
    </div>
  <% else %>
    <%# ─── Empty State (dashboard pattern) ─── %>
    <div class="text-center py-16 bg-white rounded-xl border border-neutral-200 shadow-sm bento-enter bento-enter-d3">
      <div class="w-16 h-16 mx-auto mb-4 rounded-xl bg-primary-50 flex items-center justify-center" aria-hidden="true">
        <svg class="w-8 h-8 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
      </div>
      <h3 class="font-display text-xl font-bold text-neutral-700 mb-2"><%= t(".no_results") %></h3>
      <p class="text-sm text-neutral-500 mb-6 max-w-sm mx-auto"><%= t(".no_results_body") %></p>
      <%= link_to t(".clear_filters"), pets_path,
          class: "inline-flex items-center gap-2 px-6 py-3 bg-primary-500 text-white font-semibold rounded-xl hover:bg-primary-600 focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 transition-all duration-200 active:scale-[0.97] shadow-sm" %>
    </div>
  <% end %>
</div>