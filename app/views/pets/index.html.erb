<div class="w-full max-w-6xl mx-auto">
  <div class="text-center mb-10">
    <h1 class="font-display text-4xl font-bold text-neutral-900 mb-3 text-balance"><%= t(".title") %></h1>
    <p class="text-neutral-500 text-lg max-w-2xl mx-auto"><%= t(".subtitle") %></p>
  </div>

  <div class="bg-white rounded-xl shadow-sm border border-neutral-200 p-6 mb-8">
    <%= form_tag pets_path, method: :get, class: "space-y-6" do %>
      <div>
        <span class="block text-sm font-medium text-neutral-700 mb-3"><%= t(".filters.species") %></span>
        <div class="flex flex-wrap gap-2">
          <% %w[dog cat other].each do |species| %>
            <% active = params[:species] == species %>
            <%= link_to url_for(request.params.merge(species: active ? nil : species, page: nil)),
                        class: "px-4 py-2 rounded-full text-sm font-medium transition-all duration-200 border #{active ? 'bg-secondary-500 text-white border-secondary-500' : 'bg-white text-neutral-600 border-neutral-300 hover:border-secondary-300 hover:text-secondary-500'}" do %>
              <%= t("pets.species.#{species}") %>
            <% end %>
          <% end %>
          <% if params[:species].present? %>
            <%= link_to url_for(request.params.merge(species: nil, page: nil)),
                        class: "px-4 py-2 rounded-full text-sm font-medium bg-neutral-100 text-neutral-500 border border-neutral-200 hover:bg-neutral-200 transition-all duration-200" do %>
              ✕ <%= t(".filters.clear") %>
            <% end %>
          <% end %>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div>
          <%= label_tag :query, t(".filters.search"), class: "block text-sm font-medium text-neutral-700 mb-1" %>
          <%= text_field_tag :query, params[:query], placeholder: t(".filters.search_placeholder"), class: "w-full px-4 py-3 border border-neutral-300 rounded-xl shadow-sm focus:ring-2 focus:ring-secondary-500 focus:border-secondary-500 text-sm" %>
        </div>

        <div>
          <%= label_tag :age_category, t(".filters.age"), class: "block text-sm font-medium text-neutral-700 mb-1" %>
          <%= select_tag :age_category, options_for_select(pet_age_category_options, params[:age_category]), include_blank: t(".filters.all"), class: "w-full px-4 py-3 border border-neutral-300 rounded-xl shadow-sm focus:ring-2 focus:ring-secondary-500 focus:border-secondary-500 text-sm bg-white" %>
        </div>

        <div>
          <%= label_tag :size, t(".filters.size"), class: "block text-sm font-medium text-neutral-700 mb-1" %>
          <%= select_tag :size, options_for_select(pet_size_options, params[:size]), include_blank: t(".filters.all"), class: "w-full px-4 py-3 border border-neutral-300 rounded-xl shadow-sm focus:ring-2 focus:ring-secondary-500 focus:border-secondary-500 text-sm bg-white" %>
        </div>

        <div>
          <%= label_tag :sex, t(".filters.sex"), class: "block text-sm font-medium text-neutral-700 mb-1" %>
          <%= select_tag :sex, options_for_select(pet_sex_options, params[:sex]), include_blank: t(".filters.all"), class: "w-full px-4 py-3 border border-neutral-300 rounded-xl shadow-sm focus:ring-2 focus:ring-secondary-500 focus:border-secondary-500 text-sm bg-white" %>
        </div>
      </div>

      <div class="flex items-center justify-between pt-2">
        <%= submit_tag t(".filters.apply"), class: "px-6 py-3 bg-secondary-500 text-white font-medium rounded-xl hover:bg-secondary-600 active:bg-secondary-700 transition-colors duration-200 shadow-sm cursor-pointer" %>
        <% if params[:query].present? || params[:species].present? || params[:age_category].present? || params[:size].present? || params[:sex].present? %>
          <%= link_to pets_path, class: "text-sm text-neutral-500 hover:text-neutral-700 underline" do %>
            <%= t(".filters.clear_all") %>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>

  <% if @presented_pets.any? %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% @presented_pets.each do |pet| %>
        <%= link_to pet_path(id: pet.id), class: "block bg-white rounded-xl shadow-sm border border-neutral-200 hover:shadow-md hover:border-secondary-200 transition-all duration-200 overflow-hidden group" do %>
          <div class="aspect-[4/3] bg-neutral-100 overflow-hidden">
            <% if pet.primary_photo.present? %>
              <%= image_tag pet.primary_photo_url(variant: :medium), alt: pet.name, class: "w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" %>
            <% else %>
              <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-secondary-50 to-secondary-100">
                <svg class="w-16 h-16 text-secondary-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
            <% end %>
          </div>

          <div class="p-5">
            <div class="flex items-start justify-between mb-2">
              <h3 class="font-display text-xl font-bold text-neutral-900 group-hover:text-secondary-500 transition"><%= pet.name %></h3>
              <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium bg-secondary-50 text-secondary-700">
                <%= pet.age_display %>
              </span>
            </div>

            <div class="flex items-center gap-2 text-sm text-neutral-500 mb-2">
              <span><%= pet.species_label %></span>
              <% if pet.breed.present? %>
                <span class="text-neutral-300">·</span>
                <span><%= pet.breed %></span>
              <% end %>
              <% if pet.size_label.present? %>
                <span class="text-neutral-300">·</span>
                <span><%= pet.size_label %></span>
              <% end %>
            </div>

            <div class="flex items-center gap-1 text-sm text-neutral-500 mb-3">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
              <span><%= pet.shelter.city %>, <%= pet.shelter.state %></span>
            </div>

            <% if pet.personality_traits_list.any? %>
              <div class="flex flex-wrap gap-1.5 mb-3">
                <% pet.personality_traits_list.first(3).each do |trait| %>
                  <span class="px-2.5 py-1 bg-secondary-50 text-secondary-600 text-xs font-medium rounded-full capitalize"><%= trait %></span>
                <% end %>
                <% if pet.personality_traits_list.length > 3 %>
                  <span class="px-2.5 py-1 bg-neutral-100 text-neutral-500 text-xs font-medium rounded-full">+<%= pet.personality_traits_list.length - 3 %></span>
                <% end %>
              </div>
            <% end %>

            <div class="pt-2 border-t border-neutral-100">
              <span class="text-sm font-medium text-secondary-500 group-hover:text-secondary-600 transition"><%= t(".view_profile") %></span>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>

    <div class="text-center mt-8 text-sm text-neutral-500">
      <%= t(".showing_count", count: @presented_pets.size) %>
    </div>
  <% else %>
    <div class="text-center py-16 bg-white rounded-xl shadow-sm border border-neutral-200">
      <div class="w-16 h-16 bg-secondary-50 rounded-full flex items-center justify-center mx-auto mb-4">
        <svg class="w-8 h-8 text-secondary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
      </div>
      <h3 class="font-display text-xl font-bold text-neutral-800 mb-2"><%= t(".no_results") %></h3>
      <p class="text-neutral-500 mb-6"><%= t(".no_results_body") %></p>
      <%= link_to t(".clear_filters"), pets_path, class: "inline-flex px-6 py-3 bg-secondary-500 text-white font-medium rounded-xl hover:bg-secondary-600 active:bg-secondary-700 transition-colors duration-200" %>
    </div>
  <% end %>
</div>
