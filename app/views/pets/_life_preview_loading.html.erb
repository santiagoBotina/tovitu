<%= turbo_frame_tag "life_preview", class: "life-preview-loading" do %>
  <div class="rounded-[2rem] bg-primary-50 ring-1 ring-primary-100 p-1.5 lp-border-glow"
       data-controller="life-preview"
       data-life-preview-url-value="<%= pet_life_preview_path(pet) %>"
       data-life-preview-name-value="<%= pet.name %>"
       data-life-preview-messages-value="<%= t("pets.show.life_preview_loader_messages", name: pet.name).to_json %>"
       data-life-preview-timeout-value="<%= t("pets.show.life_preview_loader_timeout") %>">
    <div class="rounded-[calc(2rem-0.375rem)] bg-white overflow-hidden">
      <%# Hero band — mirrors the loaded state so the swap feels seamless %>
      <div class="bg-primary-500 px-6 py-6 sm:px-8">
        <div class="flex items-center gap-4">
          <span class="flex-shrink-0 w-14 h-14 rounded-2xl bg-white flex items-center justify-center shadow-[0_4px_0_rgba(58,26,142,0.9)] overflow-hidden">
            <% loading_icon = life_preview_icon_path(pet) %>
            <% if loading_icon.present? %>
              <%= image_tag loading_icon, class: "w-9 h-9 lp-float", alt: "" %>
            <% else %>
              <span class="w-9 h-9 flex items-center justify-center text-2xl leading-none lp-float" aria-hidden="true"><%= pet.species_emoji %></span>
            <% end %>
          </span>
          <div class="min-w-0">
            <h2 class="font-display text-xl sm:text-2xl font-bold text-white tracking-tight">
              <%= t("pets.show.life_preview_title", name: pet.name) %>
            </h2>
            <p class="text-primary-100 text-xs sm:text-sm mt-0.5"><%= t("pets.show.life_preview_description") %></p>
          </div>
        </div>
      </div>

      <div class="px-6 py-8 sm:px-8">
        <p class="text-primary-700 font-semibold text-sm transition-all duration-300 opacity-100"
           data-life-preview-target="message">
          <%= t("pets.show.life_preview_loader_messages", name: pet.name).first %>
        </p>

        <div class="mt-6 flex items-center gap-2" aria-hidden="true">
          <span class="w-2.5 h-2.5 rounded-full bg-primary-400 lp-loader-dot" style="animation-delay: 0s"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-secondary-400 lp-loader-dot" style="animation-delay: 0.18s"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-accent-yellow lp-loader-dot" style="animation-delay: 0.36s"></span>
        </div>
      </div>
    </div>
  </div>
<% end %>