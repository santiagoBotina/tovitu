<%= turbo_frame_tag "life_preview", class: "life-preview-loading" do %>
  <div class="bg-white rounded-xl border border-primary-100 p-6 text-center"
       data-controller="life-preview"
       data-life-preview-url-value="<%= pet_life_preview_path(pet) %>"
       data-life-preview-name-value="<%= pet.name %>">
    <div class="flex flex-col items-center gap-5 py-6">
      <div class="relative">
        <div class="absolute inset-0 rounded-full bg-primary-100 animate-ping opacity-20"></div>
        <span class="relative w-16 h-16 rounded-full bg-gradient-to-br from-secondary-300 to-primary-400 flex items-center justify-center shadow-sm">
          <svg class="w-8 h-8 text-white heart-pulse" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M11.645 20.91l-.007-.003-.022-.012a15.247 15.247 0 01-.383-.218 25.18 25.18 0 01-4.244-3.17C4.688 15.36 2.25 12.174 2.25 8.25 2.25 5.322 4.714 3 7.688 3A5.5 5.5 0 0112 5.052 5.5 5.5 0 0116.313 3c2.973 0 5.437 2.322 5.437 5.25 0 3.925-2.438 7.111-4.739 9.256a25.175 25.175 0 01-4.244 3.17 15.247 15.247 0 01-.383.219l-.022.012-.007.004-.003.001a.752.752 0 01-.704 0l-.003-.001z"/>
          </svg>
        </span>
      </div>

      <div>
        <p class="text-primary-700 font-semibold text-sm transition-all duration-300"
           data-life-preview-target="message">
          Imagining a life with <%= pet.name %>...
        </p>
        <p class="text-xs text-neutral-400 mt-1">This takes a few seconds</p>
      </div>

      <div class="flex items-center gap-1">
        <span class="w-1.5 h-1.5 rounded-full bg-primary-400 dot-pulse" style="animation-delay: 0s"></span>
        <span class="w-1.5 h-1.5 rounded-full bg-primary-400 dot-pulse" style="animation-delay: 0.2s"></span>
        <span class="w-1.5 h-1.5 rounded-full bg-primary-400 dot-pulse" style="animation-delay: 0.4s"></span>
      </div>
    </div>
  </div>
<% end %>
