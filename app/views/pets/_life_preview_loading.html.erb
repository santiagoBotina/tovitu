<%= turbo_frame_tag "life_preview", class: "life-preview-loading" do %>
  <div class="bg-white rounded-xl border border-primary-100 p-6 text-center lp-border-glow relative"
       data-controller="life-preview"
       data-life-preview-url-value="<%= pet_life_preview_path(pet) %>"
       data-life-preview-name-value="<%= pet.name %>">
    <div class="flex items-start gap-4 mb-5 text-left">
      <span class="flex-shrink-0 w-14 h-14 rounded-full bg-gradient-to-br from-secondary-300 to-primary-400 flex items-center justify-center shadow-sm overflow-hidden">
        <%= image_tag "/icons/blossom.svg", class: "w-10 h-10", alt: "" %>
      </span>
      <div class="min-w-0 pt-0.5">
        <h2 class="font-display text-lg font-bold text-neutral-800">
          <%= t("pets.show.life_preview_title", name: pet.name) %>
        </h2>
        <p class="text-sm text-neutral-500 mt-0.5"><%= t("pets.show.life_preview_description") %></p>
      </div>
    </div>

    <div class="flex flex-col items-center gap-4 py-4">
      <p class="text-primary-700 font-semibold text-sm transition-all duration-300 opacity-100"
         data-life-preview-target="message">
        Imagining a life with <%= pet.name %>...
      </p>

      <svg class="w-12 h-12 text-secondary-400" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <circle cx="4" cy="12" r="3" fill="currentColor">
          <animate id="dot1" fill="freeze" attributeName="opacity" begin="0;dot3.end-0.25s" dur="0.75s" values="1;.2"/>
        </circle>
        <circle cx="12" cy="12" r="3" fill="currentColor" opacity=".4">
          <animate fill="freeze" attributeName="opacity" begin="dot1.begin+0.15s" dur="0.75s" values="1;.2"/>
        </circle>
        <circle cx="20" cy="12" r="3" fill="currentColor" opacity=".3">
          <animate id="dot3" fill="freeze" attributeName="opacity" begin="dot1.begin+0.3s" dur="0.75s" values="1;.2"/>
        </circle>
      </svg>
    </div>
  </div>
<% end %>
