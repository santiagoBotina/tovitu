<%= turbo_frame_tag "life_preview" do %>
  <div class="bg-white rounded-xl border border-danger/20 shadow-sm p-6 text-center">
    <div class="flex flex-col items-center gap-3 py-2">
      <span class="w-12 h-12 rounded-full bg-danger/10 flex items-center justify-center text-2xl">🤖</span>
      <p class="text-sm text-neutral-600"><%= t("pets.show.life_preview_error") %></p>
      <%= link_to pet_life_preview_path(pet_id: pet), class: "inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-secondary-500 hover:bg-secondary-600 text-white text-sm font-medium transition-colors" do %>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
        </svg>
        <%= t("pets.show.life_preview_retry") %>
      <% end %>
    </div>
  </div>
<% end %>
