<%= turbo_stream.replace "save-button-#{@pet.id}" do %>
  <%= render "pets/save_button", pet: @pet, saved: true %>
<% end %>

<%# Pet profile page also renders a labeled sidebar button under its own id.
    On pages without it (explorer cards) the replace is a no-op. %>
<%= turbo_stream.replace "save-button-#{@pet.id}-label" do %>
  <%= render "pets/save_button", pet: @pet, saved: true, variant: "button" %>
<% end %>

<% if @milestone_notice %>
  <%= turbo_stream.append "flash-container" do %>
    <%= render "shared/milestone_toast", message: @milestone_notice %>
  <% end %>
<% end %>
