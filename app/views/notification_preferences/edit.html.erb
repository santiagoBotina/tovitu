<%# ─── Notification Preferences Edit ─── %>
<div class="w-full max-w-2xl mx-auto">
  <div class="mb-8 bento-enter bento-enter-d1">
    <h1 class="font-display text-2xl font-bold text-neutral-900"><%= t(".title") %></h1>
    <p class="text-neutral-500 text-sm mt-1"><%= t(".subtitle") %></p>
  </div>

  <%= form_with model: @preference, url: notification_preferences_path, method: :patch, class: "space-y-6 bento-enter bento-enter-d2" do |f| %>
    <%# ─── In-App ─── %>
    <div class="bg-white rounded-xl border border-neutral-200 p-5">
      <div class="flex items-center justify-between">
        <div>
          <h3 class="font-medium text-neutral-900"><%= t("notifications.preferences.in_app_label") %></h3>
          <p class="text-sm text-neutral-500 mt-0.5">Receive notifications inside the app</p>
        </div>
        <%= f.label :in_app, class: "relative inline-flex items-center cursor-pointer" do %>
          <%= f.check_box :in_app, class: "sr-only peer", checked: @preference.in_app %>
          <div class="w-10 h-6 bg-neutral-300 peer-focus:outline-none peer-focus:ring-2 peer-focus:ring-primary-300 rounded-full peer peer-checked:after:translate-x-full rtl:peer-checked:after:-translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-neutral-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-primary-500"></div>
        <% end %>
      </div>
    </div>

    <%# ─── Email ─── %>
    <div class="bg-white rounded-xl border border-neutral-200 p-5">
      <div class="flex items-center justify-between">
        <div>
          <h3 class="font-medium text-neutral-900"><%= t("notifications.preferences.email_label") %></h3>
          <p class="text-sm text-neutral-500 mt-0.5">Receive email notifications</p>
        </div>
        <%= f.label :email, class: "relative inline-flex items-center cursor-pointer" do %>
          <%= f.check_box :email, class: "sr-only peer", checked: @preference.email %>
          <div class="w-10 h-6 bg-neutral-300 peer-focus:outline-none peer-focus:ring-2 peer-focus:ring-primary-300 rounded-full peer peer-checked:after:translate-x-full rtl:peer-checked:after:-translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-neutral-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-primary-500"></div>
        <% end %>
      </div>
    </div>

    <%# ─── WhatsApp ─── %>
    <div class="bg-white rounded-xl border border-neutral-200 p-5">
      <div class="flex items-center justify-between mb-4">
        <div>
          <h3 class="font-medium text-neutral-900"><%= t("notifications.preferences.whatsapp_label") %></h3>
          <p class="text-sm text-neutral-500 mt-0.5"><%= t("notifications.preferences.whatsapp_hint") %></p>
        </div>
        <%= f.label :whatsapp, class: "relative inline-flex items-center cursor-pointer" do %>
          <%= f.check_box :whatsapp, class: "sr-only peer", checked: @preference.whatsapp,
                          data: { action: "change->notification-bell#toggleWhatsapp" } %>
          <div class="w-10 h-6 bg-neutral-300 peer-focus:outline-none peer-focus:ring-2 peer-focus:ring-primary-300 rounded-full peer peer-checked:after:translate-x-full rtl:peer-checked:after:-translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-neutral-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-primary-500"></div>
        <% end %>
      </div>

      <div data-controller="reveal" data-reveal-hidden-class="hidden" class="<%= 'hidden' unless @preference.whatsapp? %>" data-reveal-target="item">
        <div class="flex items-end gap-3">
          <div class="flex-1">
            <%= f.label :whatsapp_phone, t("notifications.preferences.whatsapp_phone"), class: "block text-sm font-medium text-neutral-700 mb-1.5" %>
            <%= f.telephone_field :whatsapp_phone,
                placeholder: "+1 (555) 000-0000",
                class: "w-full px-4 py-3 border border-neutral-300 rounded-xl focus:ring-2 focus:ring-primary-500 focus:border-primary-500 text-sm",
                value: @preference.whatsapp_phone %>
          </div>
          <% if @preference.whatsapp_verified_at.present? %>
            <span class="px-4 py-3 text-sm font-medium text-secondary-600 bg-secondary-50 rounded-xl">
              <%= t("notifications.preferences.verified") %>
            </span>
          <% else %>
            <%= button_tag type: "button",
                class: "px-4 py-3 text-sm font-medium text-primary-600 bg-primary-50 hover:bg-primary-100 rounded-xl transition-colors",
                data: { action: "click->notification-bell#verifyWhatsapp" } do %>
              <%= t("notifications.preferences.verify") %>
            <% end %>
          <% end %>
        </div>
        <p class="text-xs text-neutral-400 mt-2"><%= t("notifications.preferences.opt_in_info") %></p>
      </div>
    </div>

    <%# ─── Submit ─── %>
    <div class="flex items-center gap-3">
      <%= f.submit t("notifications.preferences.save"), class: "px-8 py-3 bg-primary-500 text-white font-semibold rounded-xl hover:bg-primary-600 active:bg-primary-700 transition-colors cursor-pointer" %>
      <%= link_to :back, class: "px-8 py-3 text-neutral-600 font-medium rounded-xl border border-neutral-300 hover:bg-neutral-50 transition-colors" do %>
        <%= t("shared.cancel") %>
      <% end %>
    </div>
  <% end %>
</div>
