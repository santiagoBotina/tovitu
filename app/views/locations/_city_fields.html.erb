<%# Shared city/region/country fields for the manual location entry, wrapped in
    the city autocomplete combobox. When a suggested city is picked the region
    (state) and country fields are auto-filled.
    Locals:
      - f  The form builder (form_with do |f|)
      - form_id  Unique id used to scope the listbox ARIA ids.
      - initial (optional) UserLocation for pre-filling on edit %>
<% initial = local_assigns[:initial] %>
<% city_value = initial&.city %>
<% region_value = initial&.region %>
<% country_value = initial&.country %>

<div data-controller="city-autocomplete"
     data-city-autocomplete-country-value="<%= t("locations.default_country") %>"
     id="city-autocomplete-<%= form_id %>">
  <div>
    <%= f.label :city, t("locations.settings.city_label"), class: "block text-sm font-medium text-neutral-700 mb-1.5" %>
    <div class="relative">
      <%= f.text_field :city, required: true, autocomplete: "off",
            value: city_value,
            placeholder: t("locations.settings.city_placeholder"),
            role: "combobox",
            aria: { expanded: "false", haspopup: "listbox", controls: "city-listbox-#{form_id}" },
            data: {
              city_autocomplete_target: "city",
              action: "input->city-autocomplete#filter keydown->city-autocomplete#onKeydown"
            },
            class: "w-full px-4 py-3 border border-neutral-300 rounded-xl shadow-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 text-neutral-800 placeholder-neutral-400 transition" %>
      <ul id="city-listbox-<%= form_id %>"
          data-city-autocomplete-target="listbox"
          role="listbox"
          aria-label="<%= t("locations.settings.city_suggestions") %>"
          class="hidden absolute z-dropdown mt-1 w-full bg-white border border-neutral-200 rounded-xl shadow-md py-1.5 max-h-64 overflow-y-auto"></ul>
    </div>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
    <div>
      <%= f.label :region, t("locations.settings.region_label"), class: "block text-sm font-medium text-neutral-700 mb-1.5" %>
      <%= f.text_field :region, value: region_value,
            placeholder: t("locations.settings.region_placeholder"),
            data: { city_autocomplete_target: "region" },
            class: "w-full px-4 py-3 border border-neutral-300 rounded-xl shadow-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 text-neutral-800 placeholder-neutral-400 transition" %>
    </div>
    <div>
      <%= f.label :country, t("locations.settings.country_label"), class: "block text-sm font-medium text-neutral-700 mb-1.5" %>
      <%= f.text_field :country, value: country_value,
            placeholder: t("locations.settings.country_placeholder"),
            data: { city_autocomplete_target: "country" },
            class: "w-full px-4 py-3 border border-neutral-300 rounded-xl shadow-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 text-neutral-800 placeholder-neutral-400 transition" %>
    </div>
  </div>
</div>