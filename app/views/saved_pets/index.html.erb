<div class="w-full max-w-6xl mx-auto">
  <div class="text-center mb-10">
    <h1 class="font-display text-4xl font-bold text-neutral-900 mb-3 text-balance"><%= t(".title") %></h1>
    <p class="text-neutral-600 text-lg max-w-2xl mx-auto"><%= t(".subtitle") %></p>
  </div>

  <% if @presented_pets.any? %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      <% @presented_pets.each do |pet| %>
        <%= link_to pet_path(id: pet.id), class: "block bg-white rounded-xl border border-neutral-200 hover:shadow-md hover:border-primary-200 transition-all duration-200 overflow-hidden group relative" do %>
          <div class="aspect-[4/3] bg-neutral-100 overflow-hidden relative">
            <%= render "pets/save_button", pet: pet, saved: pet_saved?(pet) %>
            <% if pet.primary_photo.present? %>
              <%= image_tag pet.primary_photo_url(variant: :medium), alt: t(".pet_photo", name: pet.name), class: "w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" %>
            <% else %>
              <div class="w-full h-full flex items-center justify-center bg-primary-50">
                <svg class="w-16 h-16 text-primary-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
            <% end %>
          </div>

          <div class="p-5">
            <div class="flex items-start justify-between mb-2">
              <h3 class="font-display text-xl font-bold text-neutral-900 group-hover:text-primary-600 transition"><%= pet.name %></h3>
              <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-medium bg-primary-50 text-primary-700 shrink-0 ml-3">
                <%= pet.age_display %>
              </span>
            </div>

            <div class="flex items-center gap-2 text-sm text-neutral-600 mb-2">
              <span><%= pet.species_label %></span>
              <% if pet.breed.present? %>
                <span class="text-neutral-300" aria-hidden="true">·</span>
                <span><%= pet.breed %></span>
              <% end %>
              <% if pet.size_label.present? %>
                <span class="text-neutral-300" aria-hidden="true">·</span>
                <span><%= pet.size_label %></span>
              <% end %>
            </div>

            <div class="flex items-center gap-1.5 text-sm text-neutral-500 mb-3">
              <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
              <span><%= pet.shelter.city %>, <%= pet.shelter.state %></span>
            </div>

            <% if pet.personality_traits_list.any? %>
              <div class="flex flex-wrap gap-1.5">
                <% pet.personality_traits_list.first(2).each do |trait| %>
                  <span class="px-2.5 py-1 bg-primary-50 text-primary-600 text-xs font-medium rounded-full capitalize"><%= trait %></span>
                <% end %>
                <% if pet.personality_traits_list.length > 2 %>
                  <span class="px-2.5 py-1 bg-neutral-100 text-neutral-500 text-xs font-medium rounded-full">+<%= pet.personality_traits_list.length - 2 %></span>
                <% end %>
              </div>
            <% end %>
          </div>
        <% end %>
      <% end %>
    </div>

    <div class="mt-10 text-center">
      <%= link_to pets_path, class: "inline-flex items-center gap-2 px-6 py-3 bg-primary-500 text-white font-semibold rounded-xl hover:bg-primary-600 active:bg-primary-700 transition-colors duration-200" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
        <%= t(".browse_pets") %>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-16 bg-white rounded-xl border border-neutral-200">
      <div class="w-16 h-16 bg-accent-pink/10 rounded-full flex items-center justify-center mx-auto mb-4">
        <svg class="w-8 h-8 text-accent-pink" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
        </svg>
      </div>
      <h3 class="font-display text-xl font-bold text-neutral-800 mb-2"><%= t(".empty_title") %></h3>
      <p class="text-neutral-600 mb-6"><%= t(".empty_body") %></p>
      <%= link_to t(".browse_pets"), pets_path, class: "inline-flex px-6 py-3 bg-primary-500 text-white font-semibold rounded-xl hover:bg-primary-600 active:bg-primary-700 transition-colors duration-200" %>
    </div>
  <% end %>
</div>
