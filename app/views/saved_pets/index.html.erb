<%# ─── Saved Pets Index Page ─── %>
<%# Design: Dashboard-level cards, bento-enter animations, contextual empty state.
    The favorites-import controller polls import_status while a background
    import is pending and swaps the notice + list when it lands. %>
<div class="w-full max-w-6xl mx-auto">

  <%# ─── Page Header ─── %>
  <header class="mt-8 text-center mb-8 bento-enter bento-enter-d1">
    <h1 class="font-display text-3xl md:text-4xl font-bold text-neutral-900 mb-3 text-balance"><%= t(".title") %></h1>
    <p class="text-neutral-600 text-lg max-w-2xl mx-auto"><%= t(".subtitle") %></p>
  </header>

  <div data-controller="favorites-import"
       data-favorites-import-status-url-value="<%= import_status_saved_pets_path %>"
       data-favorites-import-signed-in-value="<%= signed_in? %>">

    <%# Import status notice (pending / failed / completed-hidden). %>
    <div id="favorites-import-notice">
      <%= render "saved_pets/import_notice", favorites_import: @favorites_import if @favorites_import %>
    </div>

    <%# Grid + empty state. Replaced wholesale by import_status when the import
        completes so the list updates without a manual refresh. %>
    <div id="saved-pets-grid">
      <%= render "saved_pets/grid", presented_pets: @presented_pets %>
    </div>
  </div>
</div>