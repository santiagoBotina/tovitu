<%# ─── Favorites Import Status Notice ─── %>
<%# Server-driven import status, rendered on the Saved pets page while a
    background favorites import is pending or failed. The favorites-import
    controller polls import_status and swaps this notice (plus the list) when
    the import lands. The data-favorites-import-status attribute drives the
    polling loop: pending → keep polling, failed → wait for retry, completed →
    stop. %>
<% if favorites_import.pending? %>
  <div id="favorites-import-notice" data-favorites-import-status="pending" role="status" class="bg-secondary-50 border border-secondary-200 rounded-xl p-5 mb-6 flex items-center gap-4">
    <div class="w-10 h-10 rounded-xl bg-secondary-100 flex items-center justify-center shrink-0" aria-hidden="true">
      <svg class="w-5 h-5 text-secondary-600 animate-spin" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 12a9 9 0 11-6.219-8.56"/>
      </svg>
    </div>
    <div class="flex-1 min-w-0">
      <p class="font-display text-base font-bold text-neutral-900"><%= t("saved_pets.import.importing_title") %></p>
      <p class="text-sm text-neutral-600"><%= t("saved_pets.import.importing_body") %></p>
    </div>
  </div>
<% elsif favorites_import.failed? %>
  <div id="favorites-import-notice" data-favorites-import-status="failed" role="alert" class="bg-danger/5 border border-danger/20 rounded-xl p-5 mb-6 flex items-center gap-4">
    <div class="w-10 h-10 rounded-xl bg-danger/10 flex items-center justify-center shrink-0" aria-hidden="true">
      <svg class="w-5 h-5 text-danger" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
      </svg>
    </div>
    <div class="flex-1 min-w-0">
      <p class="font-display text-base font-bold text-neutral-900"><%= t("saved_pets.import.failed_title") %></p>
      <p class="text-sm text-neutral-600"><%= t("saved_pets.import.failed_body") %></p>
    </div>
    <%= form_tag retry_import_saved_pets_path, method: :post, data: { turbo_stream: true } do %>
      <input type="hidden" name="favorites_import_id" value="<%= favorites_import.id %>">
      <%= submit_tag t("saved_pets.import.retry"),
          class: "shrink-0 inline-flex items-center px-4 py-2 bg-primary-500 text-white text-sm font-semibold rounded-xl hover:bg-primary-600 active:scale-[0.97] transition-all duration-150 cursor-pointer" %>
    <% end %>
  </div>
<% else %>
  <div id="favorites-import-notice" data-favorites-import-status="completed" class="hidden" aria-hidden="true"></div>
<% end %>