<%# ─── Individual Publisher Incoming Requests Index ─── %>
<% pending_count = @requests.count(&:pending?) %>
<% pending_count_label = t(".pending_count", count: pending_count) %>
<% total_count_label = t(".total_count", count: @requests.count) %>

<div class="max-w-4xl mx-auto">
  <%# ─── Header with counts ─── %>
  <%= render "shared/section_header",
             title: t(".title"),
             subtitle: t(".subtitle"),
             header_class: "flex flex-col sm:flex-row sm:items-end sm:justify-between gap-2 mb-6" do %>
    <% if @requests.any? %>
      <div class="flex items-center gap-3 shrink-0">
        <% if pending_count > 0 %>
          <span class="px-3 py-1.5 rounded-full bg-warning/10 text-warning text-xs font-semibold flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-warning animate-pulse" aria-hidden="true"></span>
            <%= pending_count_label %>
          </span>
        <% end %>
        <span class="text-xs text-neutral-400"><%= total_count_label %></span>
      </div>
    <% end %>
  <% end %>

  <% if @requests.any? %>
    <%# ─── Request List ─── %>
    <div class="space-y-3">
      <% @requests.each do |req| %>
        <% status_config = case req.status
          when "pending"
            { dot: "bg-warning",   bg: "bg-warning/10", text: "text-warning",  label: t("adoptions.requests.statuses.pending") }
          when "in_validation"
            { dot: "bg-info",      bg: "bg-info/10",    text: "text-info",     label: t("adoptions.requests.statuses.in_validation") }
          when "accepted"
            { dot: "bg-secondary-500", bg: "bg-secondary-50", text: "text-secondary-700", label: t("adoptions.requests.statuses.accepted") }
          when "declined"
            { dot: "bg-danger",    bg: "bg-danger/10",  text: "text-danger",   label: t("adoptions.requests.statuses.declined") }
          when "withdrawn"
            { dot: "bg-neutral-400", bg: "bg-neutral-100", text: "text-neutral-500", label: t("adoptions.requests.statuses.withdrawn") }
          end %>

        <%= link_to my_adoption_request_path(req),
            class: "group block bg-white rounded-xl shadow-sm border border-neutral-200 p-4 hover:shadow-md hover:border-primary-100 transition-all duration-200 active:scale-[0.99]" do %>
          <div class="flex items-center gap-4">
            <%# ─── Pet Photo ─── %>
            <div class="shrink-0 w-14 h-14 rounded-xl overflow-hidden bg-neutral-100 shadow-sm">
              <% if req.pet.primary_photo.present? %>
                <%= image_tag req.pet.primary_photo.variant(resize_to_limit: [56, 56]),
                    class: "w-full h-full object-cover group-hover:scale-105 transition-transform duration-300",
                    loading: "lazy", decoding: "async", width: 56, height: 56,
                    alt: req.pet.name %>
              <% else %>
                <div class="w-full h-full flex items-center justify-center text-neutral-400 text-lg font-bold">
                  <%= req.pet.name.first.upcase %>
                </div>
              <% end %>
            </div>

            <%# ─── Request Info ─── %>
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 flex-wrap">
                <h3 class="font-semibold text-neutral-900 truncate group-hover:text-primary-600 transition-colors">
                  <%= t(".from", name: req.adopter.name) %>
                </h3>
                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium <%= status_config[:bg] %> <%= status_config[:text] %>">
                  <span class="w-1.5 h-1.5 rounded-full <%= status_config[:dot] %>" aria-hidden="true"></span>
                  <%= status_config[:label] %>
                </span>
              </div>
              <p class="text-sm text-neutral-500 mt-0.5">
                <%= t(".for_pet", pet_name: req.pet.name) %>
              </p>
              <p class="text-xs text-neutral-400 mt-0.5">
                <%= t(".submitted", time: distance_of_time_in_words(req.created_at, Time.current)) %>
              </p>
            </div>

            <%# ─── Chevron ─── %>
            <div class="shrink-0 text-neutral-300 group-hover:text-primary-400 transition-colors">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="9 18 15 12 9 6"/>
              </svg>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <%# ─── Empty State ─── %>
    <div class="text-center py-20 bg-white rounded-xl border-2 border-dashed border-neutral-200">
      <div class="w-20 h-20 bg-primary-50 rounded-2xl flex items-center justify-center mx-auto mb-5">
        <svg class="w-10 h-10 text-primary-400" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
          <polyline points="14 2 14 8 20 8"/>
          <line x1="16" y1="13" x2="8" y2="13"/>
          <line x1="16" y1="17" x2="8" y2="17"/>
        </svg>
      </div>
      <h3 class="font-display text-xl font-bold text-neutral-800 mb-2"><%= t(".empty_title") %></h3>
      <p class="text-neutral-500 max-w-sm mx-auto mb-6"><%= t(".empty_body") %></p>
      <%= link_to my_pets_path,
          class: "inline-flex items-center gap-2 px-5 py-2.5 bg-primary-500 text-white font-semibold text-sm rounded-xl hover:bg-primary-600 transition-all duration-200 active:scale-[0.97] shadow-sm" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
        </svg>
        <%= t(".browse_pets") %>
      <% end %>
    </div>
  <% end %>
</div>
