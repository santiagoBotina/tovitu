<div class="max-w-4xl mx-auto">
  <%= link_to my_adoption_requests_path, class: "inline-flex items-center gap-1.5 text-sm text-neutral-500 hover:text-neutral-700 mb-4 transition" do %>
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
    <%= t(".back") %>
  <% end %>

  <%# ─── Pending Requests Alert ─── %>
  <% if @other_pending_count > 0 %>
    <div class="mb-6 px-4 py-3 rounded-xl bg-warning/10 border border-warning/20 flex items-center gap-3">
      <span class="w-2 h-2 rounded-full bg-warning animate-pulse shrink-0" aria-hidden="true"></span>
      <p class="text-sm text-warning font-medium">
        <%= t(".other_pending", count: @other_pending_count) %>
      </p>
      <%= link_to my_adoption_requests_path, class: "ml-auto text-sm font-semibold text-warning underline hover:no-underline shrink-0" do %>
        <%= t(".view_all_requests") %>
      <% end %>
    </div>
  <% end %>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div class="lg:col-span-2 space-y-6">
      <div class="bg-white rounded-xl shadow-sm border border-neutral-200 p-6">
        <div class="flex items-start justify-between mb-4">
          <div>
            <h1 class="font-display text-2xl font-bold text-neutral-900"><%= t(".request_from", name: @request.adopter.name) %></h1>
            <p class="text-neutral-500 text-sm"><%= t(".for_pet", pet_name: @request.pet.name) %></p>
          </div>
          <%= render "adoption_requests/status_badge", status: @request.status %>
        </div>

        <p class="text-sm text-neutral-500 mb-6"><%= t(".submitted", time: distance_of_time_in_words(@request.created_at, Time.current)) %></p>

        <% if @request.available_for_review? %>
          <div class="flex items-center gap-3 pt-4 border-t border-neutral-100">
            <%= link_to new_my_adoption_request_decision_path(@request, decision: "accepted"), class: "px-5 py-2.5 bg-secondary-500 text-white font-semibold text-sm rounded-xl hover:bg-secondary-600 transition shadow-sm", data: { turbo_method: :post } do %>
              <%= t(".accept") %>
            <% end %>
            <%= link_to new_my_adoption_request_decision_path(@request, decision: "declined"), class: "px-5 py-2.5 bg-danger text-white font-semibold text-sm rounded-xl hover:bg-danger/90 transition shadow-sm" do %>
              <%= t(".decline") %>
            <% end %>
          </div>
        <% end %>
      </div>

      <%# ─── Timeline Card ─── %>
      <section class="bg-white rounded-xl shadow-sm border border-neutral-200 p-6">
        <h2 class="font-display text-lg font-bold text-neutral-800 mb-4"><%= t(".timeline") %></h2>
        <% if @timeline.any? %>
          <div class="relative">
            <div class="absolute left-[11px] top-2 bottom-2 w-0.5 bg-neutral-200" aria-hidden="true"></div>
            <div class="space-y-6 relative">
              <% @timeline.each do |event| %>
                <% dot_color = case event.to_status
                  when "pending" then "bg-warning"
                  when "in_validation" then "bg-info"
                  when "accepted" then "bg-secondary-500"
                  when "declined" then "bg-danger"
                  when "withdrawn" then "bg-neutral-400"
                  else "bg-neutral-300"
                  end %>
                <div class="flex items-start gap-4 relative">
                  <div class="relative z-10 shrink-0">
                    <div class="w-6 h-6 rounded-full <%= dot_color %> flex items-center justify-center shadow-sm">
                      <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M5 13l4 4L19 7"/>
                      </svg>
                    </div>
                  </div>
                  <div class="flex-1 min-w-0 pt-0.5">
                    <p class="text-sm font-medium text-neutral-900">
                      <%= t("adoptions.requests.timeline.#{event.to_status}", default: event.to_status.humanize) %>
                    </p>
                    <p class="text-xs text-neutral-500">
                      <%= l(event.created_at, format: :long) %>
                      <% if event.actor.present? %>
                        · <%= event.actor.name %>
                      <% end %>
                    </p>
                    <% if event.metadata.present? && event.metadata["decline_reasons"].present? %>
                      <div class="mt-2 text-sm text-neutral-600 bg-neutral-50 rounded-lg p-3 border border-neutral-100">
                        <p class="font-medium text-neutral-700"><%= t("adoption_requests.show.decline_reasons_title") %>:</p>
                        <ul class="list-disc list-inside mt-1 space-y-0.5">
                          <% event.metadata["decline_reasons"].each do |reason| %>
                            <li><%= reason %></li>
                          <% end %>
                        </ul>
                      </div>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        <% else %>
          <p class="text-neutral-500 text-sm"><%= t("adoption_requests.show.no_events") %></p>
        <% end %>
      </section>
    </div>

    <div class="space-y-6">
      <div class="bg-white rounded-xl shadow-sm border border-neutral-200 p-6">
        <h2 class="font-display text-lg font-bold text-neutral-800 mb-4"><%= t(".adopter_info") %></h2>
        <p class="font-medium text-neutral-800"><%= @request.adopter.name %></p>
        <p class="text-sm text-neutral-500"><%= @request.adopter.email %></p>
      </div>

      <%= render "adoption_requests/adopter_insight_card",
                 insight_request: @request,
                 insight_adopter: @request.adopter %>

      <% if @adopter_profile %>
        <div class="bg-white rounded-xl shadow-sm border border-neutral-200 p-6">
          <h2 class="font-display text-lg font-bold text-neutral-800 mb-4"><%= t(".adopter_profile") %></h2>
          <%= render "adoption_requests/adopter_profile_summary", profile: @adopter_profile %>
        </div>
      <% end %>

      <div class="bg-white rounded-xl shadow-sm border border-neutral-200 p-6">
        <h2 class="font-display text-lg font-bold text-neutral-800 mb-4"><%= t(".pet_details") %></h2>
        <div class="flex items-center gap-3">
          <div class="shrink-0 w-12 h-12 rounded-xl overflow-hidden bg-neutral-100">
            <% if @request.pet.primary_photo.present? %>
              <%= image_tag PetPresenter.new(@request.pet).primary_photo_url(variant: :thumb), class: "w-full h-full object-cover", alt: @request.pet.name, loading: "lazy", decoding: "async", width: 48, height: 48 %>
            <% else %>
              <div class="w-full h-full flex items-center justify-center text-neutral-400 font-bold"><%= @request.pet.name.first.upcase %></div>
            <% end %>
          </div>
          <div>
            <p class="font-medium text-neutral-800"><%= @request.pet.name %></p>
            <p class="text-sm text-neutral-500"><%= @request.pet.species.humanize %></p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
