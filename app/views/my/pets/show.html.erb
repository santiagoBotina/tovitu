<div class="max-w-4xl mx-auto">
  <%= link_to my_pets_path, class: "inline-flex items-center gap-1.5 text-sm text-neutral-500 hover:text-neutral-700 mb-6 transition" do %>
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
    <%= t(".back") %>
  <% end %>

  <div class="bg-white rounded-xl shadow-sm border border-neutral-200 overflow-hidden mb-6">
    <% if @pet.primary_photo&.attached? %>
      <div class="aspect-[16/10] bg-neutral-100">
        <%= image_tag @pet.primary_photo.variant(resize_to_limit: [800, 500]), alt: @pet.name, class: "w-full h-full object-cover" %>
      </div>
    <% end %>

    <div class="p-6">
      <div class="flex items-start justify-between mb-4">
        <div>
          <h1 class="font-display text-3xl font-bold text-neutral-900"><%= @pet.name %></h1>
          <p class="text-neutral-500"><%= @pet.species_label %><%= " · #{@pet.breed}" if @pet.breed.present? %></p>
        </div>
        <%= @pet.status_badge.html_safe %>
      </div>

      <div class="flex items-center gap-3 mb-6">
        <%= link_to edit_my_pet_path(@pet), class: "px-4 py-2 bg-primary-500 text-white font-semibold text-sm rounded-xl hover:bg-primary-600 transition shadow-sm" do %>
          <%= t(".edit") %>
        <% end %>
        <%= link_to my_pet_path(@pet), method: :delete, data: { turbo_confirm: t(".delete_confirm") }, class: "px-4 py-2 bg-danger/10 text-danger font-medium text-sm rounded-xl hover:bg-danger/20 transition" do %>
          <%= t(".delete") %>
        <% end %>
      </div>

      <% if @pet.description.present? %>
        <div class="mb-6">
          <h2 class="font-display text-lg font-bold text-neutral-800 mb-2"><%= t(".description") %></h2>
          <p class="text-neutral-600 whitespace-pre-wrap"><%= @pet.description %></p>
        </div>
      <% end %>

      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-6">
        <div class="text-center p-3 bg-neutral-50 rounded-xl">
          <p class="text-xs text-neutral-500 font-medium"><%= t(".age") %></p>
          <p class="font-semibold text-neutral-800"><%= @pet.age_display %></p>
        </div>
        <div class="text-center p-3 bg-neutral-50 rounded-xl">
          <p class="text-xs text-neutral-500 font-medium"><%= t(".size") %></p>
          <p class="font-semibold text-neutral-800"><%= @pet.size_label || "—" %></p>
        </div>
        <div class="text-center p-3 bg-neutral-50 rounded-xl">
          <p class="text-xs text-neutral-500 font-medium"><%= t(".sex") %></p>
          <p class="font-semibold text-neutral-800"><%= @pet.sex_label %></p>
        </div>
        <div class="text-center p-3 bg-neutral-50 rounded-xl">
          <p class="text-xs text-neutral-500 font-medium"><%= t(".status") %></p>
          <p class="font-semibold text-neutral-800"><%= @pet.status.humanize %></p>
        </div>
      </div>
    </div>
  </div>

  <% if @incoming_requests.any? %>
    <div class="bg-white rounded-xl shadow-sm border border-neutral-200 p-6">
      <h2 class="font-display text-lg font-bold text-neutral-800 mb-4"><%= t(".incoming_requests") %></h2>
      <div class="space-y-3">
        <% @incoming_requests.each do |req| %>
          <div class="flex items-center justify-between p-3 rounded-xl bg-neutral-50">
            <div>
              <p class="font-medium text-neutral-800"><%= req.adopter.name %></p>
              <p class="text-sm text-neutral-500"><%= t(".submitted", time: distance_of_time_in_words(req.created_at, Time.current)) %></p>
            </div>
            <div class="flex items-center gap-2">
              <%= req.status_badge.html_safe %>
              <% if req.available_for_review? %>
                <%= link_to new_my_adoption_request_decision_path(req), class: "px-3 py-1.5 text-sm font-medium bg-primary-500 text-white rounded-lg hover:bg-primary-600 transition" do %>
                  <%= t(".review") %>
                <% end %>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <div class="mt-6">
    <%= form_with url: change_status_my_pet_path(@pet), method: :patch, local: true, class: "bg-white rounded-xl shadow-sm border border-neutral-200 p-6" do |f| %>
      <h2 class="font-display text-lg font-bold text-neutral-800 mb-4"><%= t(".change_status") %></h2>
      <div class="flex items-center gap-3">
        <%= f.select :status, options_for_select(Pet::STATUSES.map { |s| [s.humanize, s] }, @pet.status), {}, class: "px-4 py-2.5 border border-neutral-300 rounded-xl text-sm bg-white" %>
        <%= f.submit t(".update_status"), class: "px-4 py-2.5 bg-secondary-500 text-white font-semibold text-sm rounded-xl hover:bg-secondary-600 transition cursor-pointer" %>
      </div>
    <% end %>
  </div>
</div>
