<div class="max-w-2xl mx-auto">
  <%= render "shared/section_header",
             title: t(".title"),
             subtitle: t(".subtitle"),
             back_link_path: safe_back_path(my_pets_path),
             back_label: t(".back") %>

  <div class="bg-white rounded-xl shadow-sm border border-neutral-200 p-6 sm:p-8">
    <%= form_with model: @pet, url: my_pets_path, local: true, class: "space-y-6" do |f| %>
      <%= render "shared/error_messages", resource: @pet %>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <%= f.label :name, t(".name_label"), class: "block text-sm font-medium text-neutral-700 mb-1.5" %>
          <%= f.text_field :name, required: true, class: "w-full px-4 py-3 border border-neutral-300 rounded-xl focus:ring-2 focus:ring-primary-500 focus:border-primary-500 text-sm" %>
        </div>

        <div>
          <%= f.label :species, t(".species_label"), class: "block text-sm font-medium text-neutral-700 mb-1.5" %>
          <%= f.select :species, options_for_select(Pet::SPECIES.map { |s| ["#{Pet::SPECIES_EMOJI[s]} #{t("pets.species.#{s}")}", s] }), {}, class: "w-full pl-4 py-3 border border-neutral-300 rounded-xl focus:ring-2 focus:ring-primary-500 focus:border-primary-500 text-sm bg-white select-control" %>
        </div>

        <div>
          <%= f.label :breed, t(".breed_label"), class: "block text-sm font-medium text-neutral-700 mb-1.5" %>
          <%= f.text_field :breed, class: "w-full px-4 py-3 border border-neutral-300 rounded-xl focus:ring-2 focus:ring-primary-500 focus:border-primary-500 text-sm" %>
        </div>

        <div>
          <%= f.label :age_category, t(".age_label"), class: "block text-sm font-medium text-neutral-700 mb-1.5" %>
          <%= f.select :age_category, options_for_select(Pet::AGE_CATEGORIES.map { |a| [t("pets.age_categories.#{a}"), a] }), {}, class: "w-full pl-4 py-3 border border-neutral-300 rounded-xl focus:ring-2 focus:ring-primary-500 focus:border-primary-500 text-sm bg-white select-control" %>
        </div>

        <div>
          <%= f.label :size, t(".size_label"), class: "block text-sm font-medium text-neutral-700 mb-1.5" %>
          <%= f.select :size, options_for_select(Pet::SIZES.map { |s| [t("pets.sizes.#{s}"), s] }), { include_blank: t(".size_placeholder") }, class: "w-full pl-4 py-3 border border-neutral-300 rounded-xl focus:ring-2 focus:ring-primary-500 focus:border-primary-500 text-sm bg-white select-control" %>
        </div>

        <div>
          <%= f.label :sex, t(".sex_label"), class: "block text-sm font-medium text-neutral-700 mb-1.5" %>
          <%= f.select :sex, options_for_select(Pet::SEXES.map { |s| [t("pets.sexes.#{s}"), s] }), {}, class: "w-full pl-4 py-3 border border-neutral-300 rounded-xl focus:ring-2 focus:ring-primary-500 focus:border-primary-500 text-sm bg-white select-control" %>
        </div>
      </div>

      <div>
        <%= f.label :description, t(".description_label"), class: "block text-sm font-medium text-neutral-700 mb-1.5" %>
        <%= f.text_area :description, rows: 4, class: "w-full px-4 py-3 border border-neutral-300 rounded-xl focus:ring-2 focus:ring-primary-500 focus:border-primary-500 text-sm resize-none" %>
      </div>

      <div>
        <%= f.label :recommendation, t(".recommendation_label"), class: "block text-sm font-medium text-neutral-700 mb-1.5" %>
        <%= f.text_area :recommendation, rows: 4, maxlength: 600, placeholder: t(".recommendation_placeholder"), class: "w-full px-4 py-3 border border-neutral-300 rounded-xl focus:ring-2 focus:ring-primary-500 focus:border-primary-500 text-sm resize-none" %>
        <p class="text-xs text-neutral-500 mt-1"><%= t(".recommendation_hint") %></p>
      </div>

      <div>
        <%= f.label :photos, t(".photos_label"), class: "block text-sm font-medium text-neutral-700 mb-1.5" %>
        <%= f.file_field :photos, multiple: true, accept: "image/jpeg,image/png,image/webp", class: "w-full px-4 py-3 border border-neutral-300 rounded-xl focus:ring-2 focus:ring-primary-500 focus:border-primary-500 text-sm bg-white" %>
        <p class="text-xs text-neutral-500 mt-1"><%= t(".photos_hint") %></p>
      </div>

      <div class="flex items-center gap-3 pt-4">
        <%= f.submit t(".submit"), class: "px-6 py-3 bg-primary-500 text-white font-semibold rounded-xl hover:bg-primary-600 active:bg-primary-700 transition shadow-sm cursor-pointer" %>
        <%= link_to t(".cancel"), my_pets_path, class: "px-6 py-3 text-sm font-medium text-neutral-600 hover:bg-neutral-50 rounded-xl transition" %>
      </div>
    <% end %>
  </div>
</div>
