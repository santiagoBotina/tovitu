<div class="max-w-2xl mx-auto">
  <div class="mb-6">
    <%= link_to my_pet_path(@pet), class: "inline-flex items-center gap-1.5 text-sm text-neutral-500 hover:text-neutral-700 transition" do %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
      <%= t(".back") %>
    <% end %>
  </div>

  <div class="bg-white rounded-xl shadow-sm border border-neutral-200 p-6 sm:p-8">
    <h1 class="font-display text-2xl font-bold text-neutral-900 mb-1"><%= t(".title", name: @pet.name) %></h1>
    <p class="text-neutral-500 text-sm mb-6"><%= t(".subtitle") %></p>

    <%= form_with model: @pet, url: my_pet_path(@pet), method: :patch, local: true, class: "space-y-6" do |f| %>
      <%= render "shared/error_messages", resource: @pet %>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <%= f.label :name, t(".name_label"), class: "block text-sm font-medium text-neutral-700 mb-1.5" %>
          <%= f.text_field :name, required: true, class: "w-full px-4 py-3 border border-neutral-300 rounded-xl focus:ring-2 focus:ring-primary-500 focus:border-primary-500 text-sm" %>
        </div>
        <div>
          <%= f.label :species, t(".species_label"), class: "block text-sm font-medium text-neutral-700 mb-1.5" %>
          <%= f.select :species, options_for_select(Pet::SPECIES.map { |s| [t("pets.species.#{s}"), s] }, @pet.species), {}, class: "w-full px-4 py-3 border border-neutral-300 rounded-xl focus:ring-2 focus:ring-primary-500 focus:border-primary-500 text-sm bg-white" %>
        </div>
        <div>
          <%= f.label :breed, t(".breed_label"), class: "block text-sm font-medium text-neutral-700 mb-1.5" %>
          <%= f.text_field :breed, class: "w-full px-4 py-3 border border-neutral-300 rounded-xl focus:ring-2 focus:ring-primary-500 focus:border-primary-500 text-sm" %>
        </div>
        <div>
          <%= f.label :age_category, t(".age_label"), class: "block text-sm font-medium text-neutral-700 mb-1.5" %>
          <%= f.select :age_category, options_for_select(Pet::AGE_CATEGORIES.map { |a| [t("pets.age_categories.#{a}"), a] }, @pet.age_category), {}, class: "w-full px-4 py-3 border border-neutral-300 rounded-xl focus:ring-2 focus:ring-primary-500 focus:border-primary-500 text-sm bg-white" %>
        </div>
        <div>
          <%= f.label :size, t(".size_label"), class: "block text-sm font-medium text-neutral-700 mb-1.5" %>
          <%= f.select :size, options_for_select(Pet::SIZES.map { |s| [t("pets.sizes.#{s}"), s] }, @pet.size), { include_blank: t(".size_placeholder") }, class: "w-full px-4 py-3 border border-neutral-300 rounded-xl focus:ring-2 focus:ring-primary-500 focus:border-primary-500 text-sm bg-white" %>
        </div>
        <div>
          <%= f.label :sex, t(".sex_label"), class: "block text-sm font-medium text-neutral-700 mb-1.5" %>
          <%= f.select :sex, options_for_select(Pet::SEXES.map { |s| [t("pets.sexes.#{s}"), s] }, @pet.sex), {}, class: "w-full px-4 py-3 border border-neutral-300 rounded-xl focus:ring-2 focus:ring-primary-500 focus:border-primary-500 text-sm bg-white" %>
        </div>
      </div>

      <div>
        <%= f.label :description, t(".description_label"), class: "block text-sm font-medium text-neutral-700 mb-1.5" %>
        <%= f.text_area :description, rows: 4, class: "w-full px-4 py-3 border border-neutral-300 rounded-xl focus:ring-2 focus:ring-primary-500 focus:border-primary-500 text-sm resize-none" %>
      </div>

      <div class="flex items-center gap-3 pt-4">
        <%= f.submit t(".submit"), class: "px-6 py-3 bg-primary-500 text-white font-semibold rounded-xl hover:bg-primary-600 active:bg-primary-700 transition shadow-sm cursor-pointer" %>
        <%= link_to t(".cancel"), my_pet_path(@pet), class: "px-6 py-3 text-sm font-medium text-neutral-600 hover:bg-neutral-50 rounded-xl transition" %>
      </div>
    <% end %>
  </div>
</div>
