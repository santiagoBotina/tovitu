.idea/

# Rails generated
/config/master.key
/config/credentials/*.key

# Environment
.env
.env.local
.env.production
.env.staging

# Logs
log/
tmp/

# Storage (Active Storage local disk)
storage/
tmp/storage/

# Node modules (if any JS deps are added)
node_modules/

# TailwindCSS build output
app/assets/builds/

# Precompiled assets (build output — deployment is decoupled, regenerate as needed)
/public/assets/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# LocalStack
# Init scripts (`.localstack/*.sh`) are the provisioning hooks mounted into the
# container at `/etc/localstack/init/ready.d` and MUST be tracked. Everything
# else under `.localstack/` (generated state, logs) is local-only.
.localstack/*
!.localstack/*.sh

# OS
.DS_Store

/app/assets/builds/*
!/app/assets/builds/.keep
